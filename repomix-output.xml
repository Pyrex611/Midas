<file path="server/routes/townCrier.routes.ts">
import { Router } from 'express';
import {
  getTownCrierAnalytics,
  exportRecipients,
  listRecipients,
  addRecipient,
  importRecipients,
  deleteRecipient,
  listBroadcasts,
  createBroadcast,
  queueBroadcast,
  deleteBroadcast,
  triggerNewsletterSweep,
  listGongs,
  createGong,
  updateGong,
  deleteGong,
} from '../controllers/townCrier.controller';

const router = Router();

// Audience Analytics & Contacts Dump
router.get('/analytics', getTownCrierAnalytics);
router.get('/recipients/export', exportRecipients);

// Gong Channel CRUD (authenticated dashboard)
router.get('/gongs', listGongs);
router.post('/gongs', createGong);
router.put('/gongs/:id', updateGong);
router.delete('/gongs/:id', deleteGong);

// Recipients (Subscribers)
router.get('/recipients', listRecipients);
router.post('/recipients', addRecipient);
router.post('/recipients/import', ...importRecipients);
router.delete('/recipients/:id', deleteRecipient);

// Broadcasts
router.get('/broadcasts', listBroadcasts);
router.post('/broadcasts', createBroadcast);
router.post('/broadcasts/:id/queue', queueBroadcast);
router.delete('/broadcasts/:id', deleteBroadcast);

// Manual Bounded Sweep (<= 5 sends)
router.post('/sweep', triggerNewsletterSweep);

export default router;
</file>

<file path="src/components/campaigns/SequenceCanvas.tsx">
import React from 'react';
import { Icons } from '../../lib/icons';

interface FollowUpStep {
  id?: string;
  stepNumber: number;
  delayDays: number;
}

interface SequenceCanvasProps {
  steps: FollowUpStep[];
  drafts?: any[];
  canEdit: boolean;
  onAddStep: () => void;
  onUpdateDelay: (index: number, days: number) => void;
  onRemoveStep: (index: number) => void;
  onGenerateDraft: (stepNumber: number) => void;
  generatingDraftFor: number | null;
}

export const SequenceCanvas: React.FC<SequenceCanvasProps> = ({
  steps,
  drafts = [],
  canEdit,
  onAddStep,
  onUpdateDelay,
  onRemoveStep,
  onGenerateDraft,
  generatingDraftFor,
}) => {
  const initialDrafts = drafts.filter(d => d.useCase === 'initial' && d.isActive);

  return (
    <div className="space-y-6">
      {/* Node 1: Initial Touchpoint */}
      <div className="flex items-start gap-4">
        <div className="flex flex-col items-center">
          <div className="w-10 h-10 rounded-2xl bg-royal-700 text-gold-300 border border-gold-400/60 font-black text-sm flex items-center justify-center shadow-md">
            1
          </div>
          <div className="w-0.5 h-16 bg-gold-500/45" />
        </div>
        <div className="flex-1 p-5 card-midas rounded-2xl space-y-2">
          <div className="flex items-center justify-between flex-wrap gap-2">
            <span className="text-xs font-bold text-royal-700 uppercase tracking-wider">Step 1: Initial Cold Outreach</span>
            <span className="text-[10px] bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded font-bold border border-emerald-200">
              {initialDrafts.length} Draft Variant(s) Ready
            </span>
          </div>
          <p className="text-xs text-royal-950/75">
            {initialDrafts[0]?.subject ? (
              <span>Template: <strong className="text-royal-950 font-semibold font-sans">"{initialDrafts[0].subject}"</strong></span>
            ) : (
              'Outreach fires automatically based on mailbox warmup quotas and active sending hours.'
            )}
          </p>
        </div>
      </div>

      {/* Dynamic Subsequent Steps */}
      {steps.map((step, index) => {
        const stepDrafts = drafts.filter(d => d.useCase === 'followup' && d.stepNumber === step.stepNumber && d.isActive);
        const hasDraft = stepDrafts.length > 0;

        return (
          <div key={index} className="flex items-start gap-4">
            <div className="flex flex-col items-center">
              <div className="w-10 h-10 rounded-2xl bg-royal-950 text-gold-400 border border-gold-500/40 font-black text-sm flex items-center justify-center shadow-md">
                {step.stepNumber + 1}
              </div>
              {index < steps.length - 1 && <div className="w-0.5 h-16 bg-gold-500/45" />}
            </div>

            <div className="flex-1 p-5 card-midas rounded-2xl space-y-3">
              <div className="flex items-center justify-between flex-wrap gap-2">
                <div className="flex items-center gap-2">
                  <span className="text-xs font-bold text-royal-800 uppercase tracking-wider">
                    Follow-Up Step #{step.stepNumber}
                  </span>
                  {hasDraft ? (
                    <span className="text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded font-bold inline-flex items-center gap-1">
                      <Icons.CheckCircle className="text-[11px]" />
                      <span>{stepDrafts.length} Copy Draft Ready</span>
                    </span>
                  ) : (
                    <span className="text-[10px] bg-amber-50 text-amber-800 border border-gold-400/50 px-2 py-0.5 rounded font-bold inline-flex items-center gap-1">
                      <Icons.Warning className="text-[11px]" />
                      <span>No Draft Attached</span>
                    </span>
                  )}
                </div>

                {canEdit && (
                  <button
                    onClick={() => onRemoveStep(index)}
                    className="text-xs text-thistle-500 hover:text-rose-600 transition-colors font-semibold"
                  >
                    Remove Step
                  </button>
                )}
              </div>

              {hasDraft && (
                <div className="p-3 bg-thistle-50/70 border border-gold-500/30 rounded-xl text-xs space-y-0.5">
                  <p className="text-[10px] font-bold text-thistle-500 uppercase">Attached Copy Subject</p>
                  <p className="font-semibold text-royal-950 truncate font-sans">"{stepDrafts[0].subject}"</p>
                </div>
              )}

              <div className="flex flex-wrap items-center gap-3 text-xs text-royal-950/75">
                <span>Send after</span>
                <input
                  type="number"
                  min={1}
                  max={60}
                  value={step.delayDays}
                  disabled={!canEdit}
                  onChange={(e) => onUpdateDelay(index, Number(e.target.value))}
                  className="w-16 px-2.5 py-1 bg-thistle-50 border border-gold-500/40 rounded-lg text-center font-bold text-royal-950 focus:outline-none focus:border-gold-500"
                />
                <span>days if prospect has not replied.</span>
              </div>

              {canEdit && (
                <div className="pt-2 border-t border-gold-500/30 flex items-center justify-between flex-wrap gap-2">
                  <span className="text-[11px] text-thistle-500">
                    {hasDraft ? 'Generate additional tonal variations:' : 'Required: Generate a draft before step can dispatch'}
                  </span>
                  <button
                    onClick={() => onGenerateDraft(step.stepNumber)}
                    disabled={generatingDraftFor === step.stepNumber}
                    className="text-xs font-bold text-royal-700 hover:text-royal-950 disabled:opacity-50 flex items-center gap-1.5"
                  >
                    <Icons.Sparkles className="text-gold-600" />
                    <span>{generatingDraftFor === step.stepNumber ? 'Synthesizing Copy...' : 'Generate AI Follow-Up Draft'}</span>
                  </button>
                </div>
              )}
            </div>
          </div>
        );
      })}

      {canEdit && (
        <div className="pl-14">
          <button
            onClick={onAddStep}
            className="px-4 py-2 bg-white hover:bg-thistle-100 border border-gold-500/40 text-xs font-bold text-royal-800 rounded-xl glow-gold-hover flex items-center gap-1.5"
          >
            <Icons.Plus className="text-gold-600" />
            <span>Add Follow-Up Stage</span>
          </button>
        </div>
      )}
    </div>
  );
};
</file>

<file path="src/pages/Home.tsx">
import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { leadAPI, campaignAPI, domainAPI, diagnosticsAPI, aiAPI } from '../services/api';
import { UploadArea } from '../components/UploadArea';
import { useToast } from '../context/ToastContext';
import { Icons } from '../lib/icons';

interface SystemAlert {
  component: 'DATABASE' | 'AI' | 'MAILBOX';
  severity: 'error' | 'warning';
  title: string;
  message: string;
  actionLabel: string;
  actionPath: string;
}

export const Home: React.FC = () => {
  const navigate = useNavigate();
  const { toast } = useToast();
  const [blocklist, setBlocklist] = useState<any[]>([]);
  const [newBlock, setNewBlock] = useState('');
  const [stats, setStats] = useState({ campaignsCount: 0, leadsCount: 0, domainsCount: 0 });
  const [systemAlerts, setSystemAlerts] = useState<SystemAlert[]>([]);

  const runSystemHealthChecks = async () => {
    const alerts: SystemAlert[] = [];

    try {
      try {
        const dbRes = await diagnosticsAPI.health();
        if (dbRes.data?.status !== 'healthy') {
          alerts.push({
            component: 'DATABASE',
            severity: 'error',
            title: 'PostgreSQL Database Connection Degraded',
            message: 'Neon database responded with non-healthy status. Writes may fail.',
            actionLabel: 'Check Neon Console',
            actionPath: '/admin',
          });
        }
      } catch {
        alerts.push({
          component: 'DATABASE',
          severity: 'error',
          title: 'Database Unreachable',
          message: 'Unable to communicate with PostgreSQL. Check DATABASE_URL in Vercel.',
          actionLabel: 'Open Operator Admin',
          actionPath: '/admin',
        });
      }

      try {
        const aiRes = await aiAPI.diagnostics();
        if (aiRes.data?.status === 'ERROR') {
          alerts.push({
            component: 'AI',
            severity: 'warning',
            title: `AI Provider (${aiRes.data?.configuredProvider}) Rejected Test Call`,
            message: aiRes.data?.errorDetail || 'Check AI API keys and model configuration in settings.',
            actionLabel: 'AI Provider Settings',
            actionPath: '/profile?tab=settings',
          });
        }
      } catch {}

      try {
        const domainsRes = await domainAPI.getAll();
        const domains = domainsRes.data || [];
        const activeCount = domains.filter((d: any) => d.status === 'active' && d.sendTestPassedAt).length;
        const pausedForHealth = domains.filter((d: any) => d.status === 'paused_health_risk').length;

        if (domains.length === 0) {
          alerts.push({
            component: 'MAILBOX',
            severity: 'warning',
            title: 'No Sending Domains Connected',
            message: 'You have not connected an authenticated domain. Outbound campaigns cannot send.',
            actionLabel: 'Connect Domain',
            actionPath: '/domains',
          });
        } else if (activeCount === 0) {
          alerts.push({
            component: 'MAILBOX',
            severity: 'error',
            title: 'All Connected Domains Are Inactive or Unverified',
            message: 'None of your domains have passed their live send test. Outreach is halted.',
            actionLabel: 'Review Domains',
            actionPath: '/domains',
          });
        } else if (pausedForHealth > 0) {
          alerts.push({
            component: 'MAILBOX',
            severity: 'error',
            title: `${pausedForHealth} Domain(s) Paused Due to Deliverability Risk`,
            message: 'Automated circuit breaker tripped due to bounce or spam complaint threshold.',
            actionLabel: 'Deliverability Command',
            actionPath: '/domains',
          });
        }
      } catch {}

      setSystemAlerts(alerts);
    } catch {}
  };

  const fetchBlocklist = async () => {
    try {
      const res = await leadAPI.getBlocklist();
      setBlocklist(res.data || []);
    } catch {
      toast.error('Failed to load suppression blocklist', 'Error');
    }
  };

  const fetchOverviewStats = async () => {
    try {
      const [cRes, lRes, dRes] = await Promise.all([
        campaignAPI.getAll(),
        leadAPI.getAll(1, 1),
        domainAPI.getAll(),
      ]);
      setStats({
        campaignsCount: (cRes.data || []).length,
        leadsCount: lRes.data?.pagination?.total || 0,
        domainsCount: (dRes.data || []).length,
      });
    } catch {}
  };

  useEffect(() => {
    fetchBlocklist();
    fetchOverviewStats();
    runSystemHealthChecks();
  }, []);

  const handleAddBlock = async (e: React.FormEvent) => {
    e.preventDefault();
    const cleanPattern = newBlock.trim().toLowerCase().replace(/^\*@?/, '').replace(/^@/, '');
    if (!cleanPattern) return;

    try {
      await leadAPI.addBlocklist(cleanPattern);
      toast.success(`Suppression rule added for "${cleanPattern}"`, 'Rule Created');
      setNewBlock('');
      await fetchBlocklist();
    } catch {
      toast.error('Failed to add suppression pattern', 'Error');
    }
  };

  const handleDeleteBlock = async (id: string) => {
    try {
      await leadAPI.deleteBlocklist(id);
      toast.info('Suppression rule deleted', 'Removed');
      await fetchBlocklist();
    } catch {
      toast.error('Could not delete pattern', 'Error');
    }
  };

  return (
    <div className="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
      {/* System Health Push-Notification Banner */}
      {systemAlerts.length > 0 && (
        <div className="space-y-2">
          {systemAlerts.map((alert, idx) => {
            const isError = alert.severity === 'error';
            return (
              <div
                key={idx}
                className={`p-4 rounded-2xl border shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 animate-in slide-in-from-top-2 duration-150 ${
                  isError
                    ? 'bg-rose-50 border-rose-300 text-rose-950'
                    : 'bg-amber-50 border-gold-500/50 text-amber-950'
                }`}
              >
                <div className="flex items-center gap-3">
                  <div className={`w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 ${
                    isError ? 'bg-rose-200 text-rose-800' : 'bg-gold-200 text-amber-900'
                  }`}>
                    <Icons.Warning />
                  </div>
                  <div>
                    <div className="flex items-center gap-2">
                      <span className="text-[10px] font-black uppercase tracking-wider bg-white/80 px-1.5 py-0.5 rounded border border-gold-500/30">
                        {alert.component}
                      </span>
                      <p className="text-xs font-bold">{alert.title}</p>
                    </div>
                    <p className="text-[11px] opacity-80 mt-0.5">{alert.message}</p>
                  </div>
                </div>

                <button
                  onClick={() => navigate(alert.actionPath)}
                  className={`px-4 py-1.5 rounded-xl text-xs font-bold shadow-xs transition-colors whitespace-nowrap self-end sm:self-center flex items-center gap-1.5 ${
                    isError
                      ? 'bg-rose-600 hover:bg-rose-700 text-white'
                      : 'btn-royal'
                  }`}
                >
                  <span>{alert.actionLabel}</span>
                  <Icons.ChevronLeft className="rotate-180" />
                </button>
              </div>
            );
          })}
        </div>
      )}

      {/* Top Banner with Golden Separator */}
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-5 border-b border-gold-500/40">
        <div>
          <h1 className="text-2xl sm:text-3xl font-black text-royal-950 tracking-tight">Workspace Overview</h1>
          <p className="text-xs text-thistle-500 mt-1">Autonomous outbound control center and global lead suppression rules.</p>
        </div>

        <button
          onClick={() => navigate('/campaigns')}
          className="px-5 py-2.5 btn-royal text-xs font-bold rounded-xl flex items-center gap-2"
        >
          <Icons.Campaigns className="text-gold-300" />
          <span>Launch Outreach Sequences</span>
          <Icons.ChevronLeft className="rotate-180" />
        </button>
      </div>

      {/* Metric Tiles */}
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div className="p-5 rounded-2xl card-midas">
          <p className="text-[10px] font-bold uppercase tracking-wider text-thistle-500">Total Leads In Database</p>
          <p className="text-2xl font-black text-royal-950 mt-1">{stats.leadsCount}</p>
          <p className="text-[11px] text-thistle-500 mt-0.5">Verified &amp; staged across campaigns</p>
        </div>
        <div className="p-5 rounded-2xl card-midas">
          <p className="text-[10px] font-bold uppercase tracking-wider text-thistle-500">Active Sequences</p>
          <p className="text-2xl font-black text-royal-950 mt-1">{stats.campaignsCount}</p>
          <p className="text-[11px] text-thistle-500 mt-0.5">Automated SDR follow-up loops</p>
        </div>
        <div className="p-5 rounded-2xl card-midas">
          <p className="text-[10px] font-bold uppercase tracking-wider text-thistle-500">Authenticated Domains</p>
          <p className="text-2xl font-black text-royal-950 mt-1">{stats.domainsCount}</p>
          <p className="text-[11px] text-thistle-500 mt-0.5">Mailbox warmup circuit breakers armed</p>
        </div>
      </div>

      {/* Lead Ingestion Studio */}
      <UploadArea onJobComplete={fetchOverviewStats} allowCampaignSelection={true} />

      {/* Global Suppression Blocklist */}
      <div className="rounded-2xl card-midas p-6 space-y-4">
        <div className="pb-3 border-b border-gold-500/35">
          <h2 className="text-lg font-black text-royal-950 tracking-tight">Global Suppression Rules (Blocklist)</h2>
          <p className="text-xs text-thistle-500 mt-0.5">
            Emails or domains matching these patterns are discarded immediately during CSV/Excel ingestion.
          </p>
        </div>

        <form onSubmit={handleAddBlock} className="flex flex-col sm:flex-row gap-3">
          <input
            type="text"
            value={newBlock}
            onChange={(e) => setNewBlock(e.target.value)}
            placeholder="e.g. competitor.com, agency.io, or ceo@target.com"
            className="flex-1 px-4 py-2 bg-thistle-50 border border-gold-500/35 rounded-xl text-xs font-mono text-royal-950 focus:outline-none focus:border-gold-500"
            required
          />
          <button
            type="submit"
            className="px-5 py-2 btn-royal rounded-xl text-xs font-bold flex items-center justify-center gap-1.5"
          >
            <Icons.Plus className="text-gold-300" />
            <span>Add Suppression Rule</span>
          </button>
        </form>

        <div className="pt-2">
          {blocklist.length === 0 ? (
            <p className="py-8 text-center text-xs text-thistle-500 italic bg-thistle-50 rounded-xl border border-gold-500/30">
              No active suppression patterns configured.
            </p>
          ) : (
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
              {blocklist.map((b) => (
                <div
                  key={b.id}
                  className="p-3 bg-thistle-50/70 border border-gold-500/35 rounded-xl flex items-center justify-between text-xs glow-gold-hover"
                >
                  <span className="font-mono font-bold text-royal-950">{b.pattern}</span>
                  <button
                    onClick={() => handleDeleteBlock(b.id)}
                    className="text-thistle-500 hover:text-rose-600 font-bold p-1 text-[11px] flex items-center gap-1"
                    title="Delete rule"
                  >
                    <Icons.Trash />
                  </button>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  );
};
</file>

