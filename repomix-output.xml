import React, { useEffect, useState } from 'react';
import { SignIn } from '@clerk/clerk-react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';
import { useToast } from '../context/ToastContext';

export const Login: React.FC = () => {
  const { user, loading, providerMode, signIn, signInWithGoogle } = useAuth();
  const { toast } = useToast();
  const navigate = useNavigate();

  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [submitting, setSubmitting] = useState(false);

  useEffect(() => {
    if (!loading && user) {
      navigate('/', { replace: true });
    }
  }, [user, loading, navigate]);

  const handleSupabaseLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    try {
      await signIn(email, password);
      toast.success('Welcome back to MIDAS', 'Signed In');
      navigate('/', { replace: true });
    } catch (err: any) {
      toast.error(err?.message || 'Sign in failed', 'Authentication Error');
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="min-h-screen flex items-center justify-center bg-thistle-canvas py-12 px-4 sm:px-6 lg:px-8">
      <div className="max-w-md w-full flex flex-col items-center space-y-6">
        <div className="text-center">
          <span className="text-3xl font-black bg-gradient-to-r from-royal-700 via-royal-600 to-gold-500 bg-clip-text text-transparent tracking-wider">
            MIDAS
          </span>
          <p className="text-xs text-thistle-500 font-semibold mt-1">Golden Email Infrastructure</p>
        </div>

        {providerMode === 'clerk' ? (
          <SignIn
            signUpUrl="/signup"
            afterSignInUrl="/"
            appearance={{
              elements: {
                formButtonPrimary: 'bg-[#4A2559] hover:bg-[#33183E] text-white border border-[#D4AF37]/50',
                card: 'shadow-xl rounded-2xl border border-[#D4AF37]/40 bg-white',
                footerActionLink: 'text-[#4A2559] hover:text-[#6D3B82]',
              },
            }}
          />
        ) : (
          <div className="w-full card-midas rounded-3xl p-8 space-y-5 shadow-xl">
            <div className="text-center pb-3 border-b border-gold-500/35">
              <h1 className="text-lg font-black text-royal-950">Sign in to Workspace</h1>
              <p className="text-xs text-thistle-500 mt-0.5">Access sequences, Town Crier &amp; deliverability controls.</p>
            </div>

            <button
              type="button"
              onClick={() => signInWithGoogle()}
              className="w-full py-2.5 px-4 bg-white hover:bg-thistle-50 border border-gold-500/40 rounded-xl text-xs font-bold text-royal-950 glow-gold-hover transition-all"
            >
              Continue with Google
            </button>

            <div className="flex items-center gap-3">
              <div className="flex-1 h-px bg-gold-500/35" />
              <span className="text-[10px] font-bold uppercase text-thistle-500">or email</span>
              <div className="flex-1 h-px bg-gold-500/35" />
            </div>

            <form onSubmit={handleSupabaseLogin} className="space-y-4 text-xs">
              <div>
                <label className="block text-[10px] font-bold uppercase text-thistle-500 mb-1">Email Address</label>
                <input
                  type="email"
                  required
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  placeholder="founder@company.com"
                  className="w-full px-3.5 py-2.5 bg-thistle-50 border border-gold-500/40 rounded-xl font-medium focus:outline-none focus:border-gold-500"
                />
              </div>
              <div>
                <label className="block text-[10px] font-bold uppercase text-thistle-500 mb-1">Password</label>
                <input
                  type="password"
                  required
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  placeholder="••••••••••••"
                  className="w-full px-3.5 py-2.5 bg-thistle-50 border border-gold-500/40 rounded-xl focus:outline-none focus:border-gold-500"
                />
              </div>
              <button
                type="submit"
                disabled={submitting}
                className="w-full py-2.5 btn-royal rounded-xl font-bold text-xs"
              >
                {submitting ? 'Signing in...' : 'Sign In'}
              </button>
            </form>

            <p className="text-center text-xs text-thistle-500 pt-2 border-t border-gold-500/30">
              New to MIDAS?{' '}
              <Link to="/signup" className="font-bold text-royal-700 hover:underline">
                Create free Scout account
              </Link>
            </p>
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/pages/TownCrier.tsx">
import React, { useEffect, useState } from 'react';
import { townCrierAPI, getErrorMessage } from '../services/api';
import { useToast } from '../context/ToastContext';
import { TownCrierHeader } from '../components/townCrier/TownCrierHeader';
import { TownCrierAnalytics } from '../components/townCrier/TownCrierAnalytics';
import { TownCrierBroadcastsTab } from '../components/townCrier/tabs/TownCrierBroadcastsTab';
import { TownCrierGongsTab } from '../components/townCrier/tabs/TownCrierGongsTab';
import { TownCrierAudienceTab } from '../components/townCrier/tabs/TownCrierAudienceTab';
import { TownCrierComposerDrawer } from '../components/townCrier/drawers/TownCrierComposerDrawer';
import { TownCrierGongDrawer } from '../components/townCrier/drawers/TownCrierGongDrawer';
import { TownCrierAddRecipientDrawer } from '../components/townCrier/drawers/TownCrierAddRecipientDrawer';
import { TownCrierEmbedDrawer } from '../components/townCrier/drawers/TownCrierEmbedDrawer';
import { GongQuickstartModal } from '../components/townCrier/GongQuickstartModal';

type Tab = 'broadcasts' | 'gongs' | 'audience';

export const TownCrier: React.FC = () => {
  const { toast } = useToast();
  const [activeTab, setActiveTab] = useState<Tab>('broadcasts');

  const [analytics, setAnalytics] = useState<any>({
    totalSubscribers: 0,
    netGrowth30d: 0,
    churnRate: 0,
    broadcastsCount: 0,
    totalSent: 0,
  });

  const [broadcasts, setBroadcasts] = useState<any[]>([]);
  const [loadingBroadcasts, setLoadingBroadcasts] = useState(true);

  const [gongs, setGongs] = useState<any[]>([]);
  const [loadingGongs, setLoadingGongs] = useState(false);
  const [editingGong, setEditingGong] = useState<any | null>(null);

  const [quickstartGong, setQuickstartGong] = useState<any | null>(null);

  const [recipients, setRecipients] = useState<any[]>([]);
  const [pagination, setPagination] = useState({ page: 1, pageSize: 20, total: 0, totalPages: 0 });
  const [loadingAudience, setLoadingAudience] = useState(false);

  const [isComposerOpen, setIsComposerOpen] = useState(false);
  const [isGongDrawerOpen, setIsGongDrawerOpen] = useState(false);
  const [isAddRecipientOpen, setIsAddRecipientOpen] = useState(false);
  const [isEmbedDrawerOpen, setIsEmbedDrawerOpen] = useState(false);

  const fetchAnalytics = async () => {
    try {
      const res = await townCrierAPI.getAnalytics();
      setAnalytics(res.data);
    } catch {}
  };

  const fetchBroadcasts = async () => {
    try {
      const res = await townCrierAPI.getBroadcasts();
      setBroadcasts(res.data || []);
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to load broadcasts'), 'Network Error');
    } finally {
      setLoadingBroadcasts(false);
    }
  };

  const fetchGongs = async () => {
    setLoadingGongs(true);
    try {
      const res = await townCrierAPI.getGongs();
      setGongs(res.data?.gongs || []);
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to load Gong channels'), 'Error');
    } finally {
      setLoadingGongs(false);
    }
  };

  const fetchRecipients = async (page = pagination.page) => {
    setLoadingAudience(true);
    try {
      const res = await townCrierAPI.getRecipients(page, pagination.pageSize);
      setRecipients(res.data.data || []);
      setPagination(res.data.pagination);
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to load audience'), 'Network Error');
    } finally {
      setLoadingAudience(false);
    }
  };

  // Load gongs on initial mount so Composer Drawer always has channels populated
  useEffect(() => {
    fetchAnalytics();
    fetchGongs();
  }, []);

  useEffect(() => {
    if (activeTab === 'broadcasts') fetchBroadcasts();
    if (activeTab === 'gongs') fetchGongs();
    if (activeTab === 'audience') fetchRecipients(1);
  }, [activeTab]);

  return (
    <div className="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-6">
      <TownCrierHeader
        activeTab={activeTab}
        onOpenComposer={() => setIsComposerOpen(true)}
        onOpenAddRecipient={() => setIsAddRecipientOpen(true)}
        onOpenCreateGong={() => {
          setEditingGong(null);
          setIsGongDrawerOpen(true);
        }}
        onOpenEmbedDrawer={() => setIsEmbedDrawerOpen(true)}
        onRefreshAudience={() => {
          fetchRecipients(1);
          fetchAnalytics();
        }}
      />

      <TownCrierAnalytics analytics={analytics} />

      <div className="border-b border-gold-500/40">
        <nav className="flex space-x-8">
          {[
            ['broadcasts', 'Broadcasts'],
            ['gongs', `Gongs / Channels (${gongs.length})`],
            ['audience', `Audience (${pagination.total || analytics.totalSubscribers || 0})`],
          ].map(([key, label]) => (
            <button
              key={key}
              onClick={() => setActiveTab(key as Tab)}
              className={`py-3 px-1 border-b-2 text-xs font-bold transition-colors ${
                activeTab === key
                  ? 'border-royal-700 text-royal-800'
                  : 'border-transparent text-thistle-500 hover:text-royal-800'
              }`}
            >
              {label}
            </button>
          ))}
        </nav>
      </div>

      {activeTab === 'broadcasts' && (
        <TownCrierBroadcastsTab
          broadcasts={broadcasts}
          loading={loadingBroadcasts}
          onOpenComposer={() => setIsComposerOpen(true)}
          onRefresh={() => {
            fetchBroadcasts();
            fetchAnalytics();
          }}
        />
      )}

      {activeTab === 'gongs' && (
        <TownCrierGongsTab
          gongs={gongs}
          loading={loadingGongs}
          onOpenCreateGong={() => {
            setEditingGong(null);
            setIsGongDrawerOpen(true);
          }}
          onEditGong={(gong) => {
            setEditingGong(gong);
            setIsGongDrawerOpen(true);
          }}
          onOpenQuickstart={(gong) => setQuickstartGong(gong)}
        />
      )}

      {activeTab === 'audience' && (
        <TownCrierAudienceTab
          recipients={recipients}
          pagination={pagination}
          loading={loadingAudience}
          onPageChange={(p) => fetchRecipients(p)}
          onOpenAddRecipient={() => setIsAddRecipientOpen(true)}
          onRefresh={() => {
            fetchRecipients(pagination.page);
            fetchAnalytics();
          }}
        />
      )}

      <TownCrierGongDrawer
        isOpen={isGongDrawerOpen}
        onClose={() => setIsGongDrawerOpen(false)}
        editingGong={editingGong}
        onSuccess={(savedGong) => {
          fetchGongs();
          fetchAnalytics();
          setQuickstartGong(savedGong);
        }}
      />

      <GongQuickstartModal
        isOpen={Boolean(quickstartGong)}
        onClose={() => setQuickstartGong(null)}
        gong={quickstartGong}
      />

      <TownCrierComposerDrawer
        isOpen={isComposerOpen}
        onClose={() => setIsComposerOpen(false)}
        gongs={gongs}
        onSuccess={() => {
          fetchBroadcasts();
          fetchAnalytics();
        }}
      />

      <TownCrierAddRecipientDrawer
        isOpen={isAddRecipientOpen}
        onClose={() => setIsAddRecipientOpen(false)}
        onSuccess={() => {
          fetchRecipients(1);
          fetchAnalytics();
        }}
      />

      <TownCrierEmbedDrawer
        isOpen={isEmbedDrawerOpen}
        onClose={() => setIsEmbedDrawerOpen(false)}
      />
    </div>
  );
};
</file>

