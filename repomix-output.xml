<file path="server/services/newsletterQueue.service.ts">
import prisma from '../lib/prisma';
import { logger } from '../config/logger';
import { emailService } from './email.service';
import { personalisationService } from './personalisation.service';
import { env } from '../config/env';

export class NewsletterQueueService {
  /**
   * Drains up to 5 pending newsletter items per tick.
   * Strictly adheres to the non-bulk bounded queue invariant.
   */
  async processNewsletterQueue(): Promise<{ claimed: number; sent: number; deferred: number; failed: number }> {
    const summary = { claimed: 0, sent: 0, deferred: 0, failed: 0 };
    const batchSize = env.SEND_SWEEP_BATCH_SIZE || 5;
    const cooldownSeconds = env.SENDER_COOLDOWN_SECONDS || 20;

    try {
      // 1. Recover stale processing rows
      await prisma.$executeRaw`
        UPDATE "NewsletterQueueItem"
        SET status = 'PENDING'
        WHERE status = 'PROCESSING'
        AND created_at < NOW() - INTERVAL '10 minutes'
      `;

      // 2. Atomic claim bounded to 5 items
      let itemIds: string[] = [];
      try {
        itemIds = await prisma.$transaction(async (tx) => {
          const locked = await tx.$queryRaw<{ id: string }[]>`
            SELECT q.id FROM "NewsletterQueueItem" q
            JOIN "NewsletterBroadcast" b ON q.broadcast_id = b.id
            WHERE q.status = 'PENDING'
            AND b.status IN ('QUEUED', 'SENDING')
            ORDER BY q.created_at ASC
            LIMIT ${batchSize}
            FOR UPDATE OF q SKIP LOCKED
          `;

          if (locked.length === 0) return [];
          const ids = locked.map(i => i.id);

          await tx.newsletterQueueItem.updateMany({
            where: { id: { in: ids } },
            data: { status: 'PROCESSING' },
          });

          return ids;
        }, { maxWait: 5000, timeout: 8000 });
      } catch (txErr: any) {
        logger.warn({ err: txErr?.message }, 'Newsletter queue claim transaction rolled back');
        return summary;
      }

      if (itemIds.length === 0) return summary;
      summary.claimed = itemIds.length;

      const itemsToProcess = await prisma.newsletterQueueItem.findMany({
        where: { id: { in: itemIds } },
        include: {
          broadcast: true,
        },
      });

      for (const item of itemsToProcess) {
        try {
          const recipient = await prisma.newsletterRecipient.findUnique({
            where: { id: item.recipientId },
          });

          if (!recipient || recipient.status !== 'SUBSCRIBED') {
            await prisma.newsletterQueueItem.update({
              where: { id: item.id },
              data: { status: 'FAILED', error: 'Recipient is unsubscribed or removed' },
            });
            summary.failed++;
            continue;
          }

          // Fetch active senders for user
          const activeSenders = await prisma.sender.findMany({
            where: {
              userId: item.userId,
              status: 'active',
              domain: { status: 'active' },
            },
            include: { domain: true },
          });

          if (activeSenders.length === 0) {
            await prisma.newsletterQueueItem.update({
              where: { id: item.id },
              data: { status: 'PENDING' },
            });
            summary.deferred++;
            continue;
          }

          // FAIR-SHARE SENDER ALLOCATION:
          // Reserve 50% of each sender's daily capacity for cold campaign outreach
          const eligibleSender = activeSenders.find(s => {
            const fairShareCap = Math.max(5, Math.floor(s.dailyLimit * 0.5));
            const isUnderCap = s.sentCountToday < fairShareCap;
            const isCooledDown = !s.lastDispatchedAt || (Date.now() - new Date(s.lastDispatchedAt).getTime()) >= cooldownSeconds * 1000;
            return isUnderCap && isCooledDown;
          }) || activeSenders.find(s => s.sentCountToday < s.dailyLimit);

          if (!eligibleSender) {
            await prisma.newsletterQueueItem.update({
              where: { id: item.id },
              data: { status: 'PENDING' },
            });
            summary.deferred++;
            continue;
          }

          // Atomic quota reservation on sender
          const claimResult = await prisma.$queryRaw<{ id: string }[]>`
            UPDATE "Sender"
            SET "sent_count_today" = "sent_count_today" + 1,
                "last_dispatched_at" = NOW()
            WHERE id = ${eligibleSender.id} AND "sent_count_today" < "daily_limit"
            RETURNING id
          `;

          if (claimResult.length === 0) {
            await prisma.newsletterQueueItem.update({
              where: { id: item.id },
              data: { status: 'PENDING' },
            });
            summary.deferred++;
            continue;
          }

          const userSettings = await prisma.userSettings.findUnique({ where: { userId: item.userId } });

          // Personalize newsletter copy
          const appBaseUrl = process.env.APP_URL || 'https://midas-aem.vercel.app';
          const unsubUrl = `${appBaseUrl.replace(/\/$/, '')}/api/public/town-crier/recipients/${recipient.id}/unsubscribe`;

          const { subject, body } = personalisationService.personalise(
            recipient,
            item.broadcast.subject,
            item.broadcast.body,
            null,
            eligibleSender.displayName || userSettings?.companyName || 'The Team',
            unsubUrl,
            {
              companyName: userSettings?.companyName,
              physicalAddress: userSettings?.physicalAddress,
              customOptOutText: userSettings?.customOptOutText,
            }
          );

          const result = await emailService.sendEmailNow(
            { ...eligibleSender.domain, senderLocalPart: eligibleSender.localPart },
            recipient.email,
            subject,
            body.replace(/\n/g, '<br>'),
            body,
            `tc_${item.id}`,
            eligibleSender.displayName || userSettings?.companyName || null,
            undefined,
            unsubUrl,
            undefined,
            {
              brandName: userSettings?.companyName,
              brandInitials: userSettings?.brandInitials,
              brandColorHex: userSettings?.brandColorHex,
              logoUrl: userSettings?.logoUrl,
              brandingEnabled: userSettings?.brandingEnabled ?? true,
            }
          );

          if (result.success) {
            await prisma.newsletterQueueItem.update({
              where: { id: item.id },
              data: { status: 'SENT' },
            });
            summary.sent++;

            // Check if broadcast is complete
            const remaining = await prisma.newsletterQueueItem.count({
              where: { broadcastId: item.broadcastId, status: { in: ['PENDING', 'PROCESSING'] } },
            });
            if (remaining === 0) {
              await prisma.newsletterBroadcast.update({
                where: { id: item.broadcastId },
                data: { status: 'COMPLETED' },
              });
            } else {
              await prisma.newsletterBroadcast.update({
                where: { id: item.broadcastId },
                data: { status: 'SENDING' },
              });
            }
          } else {
            await prisma.sender.update({
              where: { id: eligibleSender.id },
              data: { sentCountToday: { decrement: 1 } },
            });
            await prisma.newsletterQueueItem.update({
              where: { id: item.id },
              data: { status: 'FAILED', error: result.error },
            });
            summary.failed++;
          }
        } catch (itemErr: any) {
          summary.failed++;
          await prisma.newsletterQueueItem.update({
            where: { id: item.id },
            data: { status: 'FAILED', error: itemErr.message },
          });
        }
      }
    } catch (error) {
      logger.error({ error }, 'Fatal error during newsletter queue drain');
    }

    return summary;
  }

  /**
   * Queues a broadcast for send by fanning out rows into NewsletterQueueItem.
   * NEVER sends emails directly.
   */
  async queueBroadcast(broadcastId: string, userId: string): Promise<{ queuedCount: number }> {
    const broadcast = await prisma.newsletterBroadcast.findFirst({
      where: { id: broadcastId, userId },
    });
    if (!broadcast) throw new Error('Broadcast not found');

    const recipients = await prisma.newsletterRecipient.findMany({
      where: { userId, status: 'SUBSCRIBED' },
      select: { id: true },
    });

    if (recipients.length === 0) {
      throw new Error('No active subscribed recipients found for this broadcast');
    }

    // Chunked insertion of 500 rows/batch
    const CHUNK_SIZE = 500;
    let inserted = 0;

    for (let i = 0; i < recipients.length; i += CHUNK_SIZE) {
      const batch = recipients.slice(i, i + CHUNK_SIZE).map(r => ({
        broadcastId: broadcast.id,
        recipientId: r.id,
        userId,
        status: 'PENDING',
      }));

      await prisma.newsletterQueueItem.createMany({
        data: batch,
      });
      inserted += batch.length;
    }

    await prisma.newsletterBroadcast.update({
      where: { id: broadcast.id },
      data: { status: 'QUEUED', queuedAt: new Date() },
    });

    // Opportunistically run 1 bounded tick
    this.processNewsletterQueue().catch(err => {
      logger.error({ err }, 'Opportunistic newsletter queue sweep failed');
    });

    return { queuedCount: inserted };
  }
}

export const newsletterQueueService = new NewsletterQueueService();
</file>

<file path="server/services/promptManager.service.ts">
import { logger } from '../config/logger';

export type UseCase = 'initial' | 'followup' | 'reply';

export interface PromptParams {
  useCase: UseCase;
  tone: string;
  campaignContext?: string | null;
  reference?: string | null;
  companyContext?: string | null;
  variationSeed?: string | number;
  originalEmail?: string;
  originalSubject?: string;
  recipientName?: string;
  recipientCompany?: string;
  sentiment?: string;
  conversationHistory?: string;
  stepNumber?: number;
}

export class PromptManager {
  buildPrompt(params: PromptParams): string {
    const { useCase, campaignContext, reference, stepNumber } = params;
    const hasReference = !!reference;

    let prompt = `You are an elite, top-tier B2B SDR with a 45%+ reply rate. Your objective is to write hyper-concise, industrial-grade cold emails. \n\n`;

    prompt += `## ABSOLUTE B2B MANDATES (DO NOT VIOLATE)\n`;
    prompt += `1. NO FLUFF. Never use phrases like "I hope this finds you well", "Game-changer", "Revolutionary", or "Synergy".\n`;
    prompt += `2. EXTREMELY SHORT. Keep the total body under 80 words. Time is money. \n`;
    prompt += `3. DIRECT VALUE. Get straight to the pain point and the mechanism to solve it.\n`;
    prompt += `4. SOFT CTA. End with a low-friction question based on interest, not time (e.g., "Open to seeing how?", "Worth exploring?"). Do NOT ask for "15 minutes on Tuesday".\n`;
    
    prompt += `\n## SPINTAX FORMATTING REQUIRED\n`;
    prompt += `To prevent spam fingerprinting, you MUST use Spintax formatting for greetings, transitions, and closings.\n`;
    prompt += `Format: {Option A|Option B|Option C}. \n`;
    prompt += `Example: {Hi|Hey|Hello} {{name}}, {I noticed|Looks like} you handle operations at {{company}}.\n\n`;

    prompt += `## PLACEHOLDERS\n`;
    prompt += `- {{name}} → Prospect's name.\n`;
    prompt += `- {{company}} → Prospect's company.\n`;
    prompt += `- {{senderName}} → Your name.\n`;
    if (hasReference) prompt += `- {{reference_company}} → MUST use this to refer to the past client story provided below.\n`;

    switch (useCase) {
      case 'initial':
        prompt += this.buildInitialPrompt(campaignContext, hasReference, reference);
        break;
      case 'followup':
        prompt += this.buildFollowupPrompt(params.originalEmail, stepNumber);
        break;
      case 'reply':
        prompt += this.buildReplyPrompt(params);
        break;
    }

    prompt += `\n## OUTPUT FORMAT\n`;
    prompt += `Return ONLY a valid JSON object: {"subject": "...", "body": "..."}\n`;

    return prompt;
  }

  private buildInitialPrompt(campaignContext?: string | null, hasReference?: boolean, reference?: string | null): string {
    let section = `\n## INITIAL OUTREACH TASK\n`;
    if (campaignContext) section += `Campaign Goal: ${campaignContext}\n`;
    if (hasReference && reference) section += `Reference Story: ${reference}\n`;

    section += `Structure:\n`;
    section += `1. Observation/Pain Point (Spintaxed).\n`;
    section += `2. The Mechanism (How we solve it concisely).\n`;
    section += `3. ${hasReference ? 'Name drop {{reference_company}} and their result.' : 'Brief credibility statement.'}\n`;
    section += `4. Soft CTA.\n`;
    return section;
  }

  private buildFollowupPrompt(originalEmail?: string, stepNumber?: number): string {
    let section = `\n## FOLLOW-UP TASK (Step ${stepNumber || 1})\n`;
    section += `The prospect did not reply. Provide a fresh angle, ONE sentence of value, and a new soft CTA. Maximum 3 sentences total.\n`;
    if (originalEmail) section += `Original Email sent to them:\n${originalEmail}\n`;
    return section;
  }

  private buildReplyPrompt(params: PromptParams): string {
    let section = `\n## REPLY TASK\n`;
    section += `Prospect replied with sentiment: ${params.sentiment}. \n`;
    section += `Their Message: ${params.originalEmail}\n`;
    section += `Address their specific question or objection. If positive, offer a specific next step or resource. Match their tone.\n`;
    return section;
  }
}

export const promptManager = new PromptManager();
