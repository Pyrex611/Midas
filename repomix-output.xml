    } finally {
      setSavingBimi(false);
    }
  };

  const pyrexxSvgSnippet = `<?xml version="1.0" encoding="utf-8"?>
<svg version="1.2" baseProfile="tiny-ps" xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 512 512" width="512" height="512" overflow="visible">
