import { Icons } from '../../../lib/icons';

type DrilldownCategory = 'ALL' | 'CONTACTED' | 'OPENED' | 'CLICKED' | 'REPLIED' | 'BOUNCED' | 'UNSUBSCRIBED';

interface CampaignOverviewTabProps {
  analytics: {
    totalLeads: number;
    contactedCount: number;
    queuedCount: number;
    sentCount: number;
    openRate: number;
    openedCount: number;
    clickRate: number;
    clickedCount: number;
    replyRate: number;
    replyCount: number;
    bounceRate: number;
    bounceCount: number;
    unsubscribedCount: number;
  };
  unsubscribeRate: number;
  campaign: any;
  onSelectCategory: (category: DrilldownCategory) => void;
  onReconcileQueue: () => void;
  onDispatchNow: () => void;
  isReconciling: boolean;
  isDispatchingNow: boolean;
}

