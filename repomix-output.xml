<file path="server/lib/apiKeys.ts">
import crypto from 'crypto';

export interface GeneratedApiKey {
  plaintextKey: string;
  keyPrefix: string;
  keyHash: string;
}

export function generateApiKey(): GeneratedApiKey {
  // Prefix tc_live_ + 32 random hex bytes (64 chars)
  const randomEntropy = crypto.randomBytes(32).toString('hex');
  const plaintextKey = `tc_live_${randomEntropy}`;
  const keyPrefix = plaintextKey.slice(0, 16); // e.g. tc_live_a1b2c3d4
  const keyHash = hashApiKey(plaintextKey);

  return {
    plaintextKey,
    keyPrefix,
    keyHash,
  };
}

export function hashApiKey(key: string): string {
  return crypto.createHash('sha256').update(key.trim()).digest('hex');
}

export function verifyApiKey(candidateKey: string, storedHash: string): boolean {
  if (!candidateKey || !storedHash) return false;
  const candidateHash = hashApiKey(candidateKey);
  const bufA = Buffer.from(candidateHash, 'hex');
  const bufB = Buffer.from(storedHash, 'hex');

  if (bufA.length !== bufB.length) return false;
  return crypto.timingSafeEqual(bufA, bufB);
}
</file>

<file path="server/lib/operatorAuth.ts">
import crypto from 'crypto';

const SIGNING_SECRET = process.env.ENCRYPTION_KEY || process.env.CRON_SECRET || 'midas_operator_secret_32_chars_min';
const MASTER_PASSPHRASE = process.env.OPERATOR_PASSPHRASE || process.env.ADMIN_PASSPHRASE || 'midas_operator_2026';

export interface OperatorTokenPayload {
  role: 'operator_admin';
  issuedAt: number;
  nonce: string;
}

function safeCompare(a: string, b: string): boolean {
  const hashA = crypto.createHash('sha256').update(a).digest();
  const hashB = crypto.createHash('sha256').update(b).digest();
  return crypto.timingSafeEqual(hashA, hashB);
}

export function verifyMasterPassphrase(candidate: string): boolean {
  if (!candidate || typeof candidate !== 'string') return false;
  return safeCompare(candidate.trim(), MASTER_PASSPHRASE.trim());
}

export function generateOperatorToken(): { token: string; expiresAt: number } {
  const issuedAt = Date.now();
  const expiresAt = issuedAt + 60 * 60 * 1000; // 60 minutes
  const payload: OperatorTokenPayload = {
    role: 'operator_admin',
    issuedAt,
    nonce: crypto.randomBytes(8).toString('hex'),
  };

  const serialized = Buffer.from(JSON.stringify(payload)).toString('base64url');
  const signature = crypto
    .createHmac('sha256', SIGNING_SECRET)
    .update(serialized)
    .digest('base64url');

  return {
    token: `${serialized}.${signature}`,
    expiresAt,
  };
}

export function verifyOperatorToken(token?: string): boolean {
  if (!token || typeof token !== 'string') return false;

  try {
    const [serialized, signature] = token.split('.');
    if (!serialized || !signature) return false;

    const expectedSignature = crypto
      .createHmac('sha256', SIGNING_SECRET)
      .update(serialized)
      .digest('base64url');

    if (!safeCompare(signature, expectedSignature)) return false;

    const payload: OperatorTokenPayload = JSON.parse(
      Buffer.from(serialized, 'base64url').toString('utf8')
    );

    // Hard ceiling: token cannot be older than 60 minutes
    const age = Date.now() - payload.issuedAt;
    if (age > 60 * 60 * 1000 || age < 0) {
      return false;
    }

    return payload.role === 'operator_admin';
  } catch {
    return false;
  }
}
</file>

<file path="server/lib/tracking.ts">
import crypto from 'crypto';

const SIGNING_SECRET = process.env.ENCRYPTION_KEY || process.env.CRON_SECRET || 'midas_default_telemetry_secret_32';

export interface OpenTrackingPayload {
  outboundEmailId: string;
  leadId: string;
  campaignId?: string | null;
}

export interface ClickTrackingPayload {
  outboundEmailId: string;
  leadId: string;
  campaignId?: string | null;
  targetUrl: string;
}

// RFC compliant 43-byte 1x1 transparent GIF
export const TRANSPARENT_GIF_BUFFER = Buffer.from(
  'R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7',
  'base64'
);

function sign(data: string): string {
  return crypto.createHmac('sha256', SIGNING_SECRET).update(data).digest('hex').substring(0, 16);
}

export function encodeOpenToken(payload: OpenTrackingPayload): string {
  const jsonStr = JSON.stringify(payload);
  const base64 = Buffer.from(jsonStr).toString('base64url');
  const signature = sign(base64);
  return `${base64}.${signature}`;
}

export function decodeOpenToken(token: string): OpenTrackingPayload | null {
  try {
    const [base64, signature] = token.split('.');
    if (!base64 || !signature || sign(base64) !== signature) return null;
    const jsonStr = Buffer.from(base64, 'base64url').toString('utf8');
    return JSON.parse(jsonStr) as OpenTrackingPayload;
  } catch {
    return null;
  }
}

export function encodeClickToken(payload: ClickTrackingPayload): string {
  const jsonStr = JSON.stringify(payload);
  const base64 = Buffer.from(jsonStr).toString('base64url');
  const signature = sign(base64);
  return `${base64}.${signature}`;
}

export function decodeClickToken(token: string): ClickTrackingPayload | null {
  try {
    const [base64, signature] = token.split('.');
    if (!base64 || !signature || sign(base64) !== signature) return null;
    const jsonStr = Buffer.from(base64, 'base64url').toString('utf8');
    return JSON.parse(jsonStr) as ClickTrackingPayload;
  } catch {
    return null;
  }
}

export function isBotScanner(userAgent?: string): boolean {
  if (!userAgent) return false;
  const ua = userAgent.toLowerCase();
  return (
    ua.includes('googleimageproxy') ||
    ua.includes('barracuda') ||
    ua.includes('proofpoint') ||
    ua.includes('mimecast') ||
    ua.includes('virustotal') ||
    ua.includes('mailprefetch') ||
    ua.includes('crawler')
  );
}
</file>

