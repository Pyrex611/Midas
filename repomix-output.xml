  success: boolean;
  summary: {
    totalRows: number;
    valid: number;
    created: number;
    duplicates: number;
    failed: number;
    parseErrors: { row: number; message: string }[];
    dbErrors: any[];
  };
  needsEmailSelection: boolean;
  emailCandidates?: {
    rowIndex: number;
    candidates: EmailCandidate[];
    leadPreview: {
      name: string;
      company: string | null;
      position: string | null;
    };
