    if (res.ok) alert('Subscribed successfully!');
    else alert('Subscription failed');
  });
</script>`}
            </pre>
          </div>

          <div>
            <span className="block text-[10px] font-bold text-zinc-400 uppercase mb-1">cURL / Webhook Payload Example</span>
