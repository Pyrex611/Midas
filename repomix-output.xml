              className="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition-colors shadow-xs disabled:opacity-50"
            >
              {isDispatchingNow ? 'Sending Batch...' : 'Send next batch (≤5)'}
            </button>
          </div>
