<file path="server/controllers/userSettings.controller.ts">
import { Response, NextFunction } from 'express';
import { AuthRequest } from '../middleware/auth.middleware';
import prisma from '../lib/prisma';
import { encrypt, tryDecrypt } from '../lib/encryption';

export const getSettings = async (req: AuthRequest, res: Response, next: NextFunction) => {
  try {
    const userId = req.user!.id;
    const settings = await prisma.userSettings.findUnique({
      where: { userId },
    });

    if (!settings) {
      return res.json({ hasAiApiKey: false, aiKeyDecryptionFailed: false, brandingEnabled: false });
    }

    const { aiApiKeyEncrypted, ...safeSettings } = settings;
    const aiKeyDecryptionFailed = Boolean(aiApiKeyEncrypted) && !tryDecrypt(aiApiKeyEncrypted);

    res.json({
      ...safeSettings,
      hasAiApiKey: Boolean(aiApiKeyEncrypted),
      aiKeyDecryptionFailed,
    });
  } catch (error) {
    next(error);
  }
};

const VALID_PERIODS = ['hour', 'day'] as const;
const VALID_PROVIDERS = ['gemini', 'openrouter', 'aigateway', 'openai', 'deepseek', 'ollama', 'mock'] as const;

export const updateSettings = async (req: AuthRequest, res: Response, next: NextFunction) => {
  try {
    const userId = req.user!.id;
    const {
      sendLimit,
      sendPeriod,
      companyName,
      physicalAddress,
      customOptOutText,
      aiProvider,
      aiModel,
      aiApiKey,
      clearAiApiKey,
      aiGatewayUrl,
      brandColorHex,
      brandInitials,
      logoUrl,
      brandingEnabled,
      dedicatedNewsletterSenderId,
    } = req.body;

    const data: Record<string, any> = {};

    if (sendLimit !== undefined) {
      const n = Number(sendLimit);
      if (sendLimit !== null && (!Number.isInteger(n) || n <= 0)) {
        return res.status(400).json({ error: 'sendLimit must be a positive integer' });
      }
      data.sendLimit = sendLimit === null ? null : n;
    }

    if (sendPeriod !== undefined) {
      if (sendPeriod !== null && !VALID_PERIODS.includes(sendPeriod)) {
        return res.status(400).json({ error: `sendPeriod must be one of: ${VALID_PERIODS.join(', ')}` });
      }
      data.sendPeriod = sendPeriod;
    }

    if (companyName !== undefined) {
      data.companyName = typeof companyName === 'string' ? companyName.trim() : null;
    }

    if (physicalAddress !== undefined) {
      data.physicalAddress = typeof physicalAddress === 'string' ? physicalAddress.trim() : null;
    }

    if (customOptOutText !== undefined) {
      data.customOptOutText = typeof customOptOutText === 'string' ? customOptOutText.trim() : null;
    }

    if (brandColorHex !== undefined) {
      data.brandColorHex = typeof brandColorHex === 'string' ? brandColorHex.trim() : null;
    }
    if (brandInitials !== undefined) {
      data.brandInitials = typeof brandInitials === 'string' ? brandInitials.trim().slice(0, 4) : null;
    }
    if (logoUrl !== undefined) {
      data.logoUrl = typeof logoUrl === 'string' ? logoUrl.trim() : null;
    }
    if (brandingEnabled !== undefined) {
      data.brandingEnabled = Boolean(brandingEnabled);
    }

    if (dedicatedNewsletterSenderId !== undefined) {
      if (!dedicatedNewsletterSenderId) {
        data.dedicatedNewsletterSenderId = null;
      } else {
        const sender = await prisma.sender.findFirst({
          where: { id: String(dedicatedNewsletterSenderId).trim(), userId },
          select: { id: true },
        });
        if (!sender) {
          return res.status(404).json({ error: 'Selected dedicated newsletter sender not found on your account' });
        }
        data.dedicatedNewsletterSenderId = sender.id;
      }
    }

    if (aiProvider !== undefined) {
      if (aiProvider !== null && !VALID_PROVIDERS.includes(aiProvider)) {
        return res.status(400).json({ error: `aiProvider must be one of: ${VALID_PROVIDERS.join(', ')}` });
      }
      data.aiProvider = aiProvider;
    }

    if (aiModel !== undefined) {
      data.aiModel = typeof aiModel === 'string' && aiModel.trim() ? aiModel.trim() : null;
    }

    if (aiGatewayUrl !== undefined) {
      data.aiGatewayUrl = typeof aiGatewayUrl === 'string' && aiGatewayUrl.trim() ? aiGatewayUrl.trim() : null;
    }

    if (aiApiKey && typeof aiApiKey === 'string' && aiApiKey.trim()) {
      data.aiApiKeyEncrypted = encrypt(aiApiKey.trim());
    } else if (clearAiApiKey === true) {
      data.aiApiKeyEncrypted = null;
    }

    const settings = await prisma.userSettings.upsert({
      where: { userId },
      update: data,
      create: { userId, ...data },
    });

    const { aiApiKeyEncrypted, ...safeSettings } = settings;
    res.json({
      ...safeSettings,
      hasAiApiKey: Boolean(aiApiKeyEncrypted),
      aiKeyDecryptionFailed: false,
    });
  } catch (error) {
    next(error);
  }
};
</file>

<file path="server/services/followUp.service.ts">
import prisma from '../lib/prisma';
import { logger } from '../config/logger';
import { personalisationService } from './personalisation.service';

export class FollowUpService {

  /**
   * Batched O(1)-roundtrip-per-campaign follow-up sequencer:
   * - Excludes UNSUBSCRIBED and BOUNCED leads.
   * - Eliminates N+1 per-lead queries by loading campaign OutboundEmails, PendingEmails,
   *   and follow-up Drafts once per campaign.
   * - Resolves `preferredSenderId` from the initial outbound email's domain senders so
   *   follow-ups continue from the exact same mailbox address.
   * - Queues at most ONE due follow-up step per lead per tick.
   */
  async checkFollowUps(): Promise<{ queued: number; campaignsScanned: number }> {
    let queued = 0;
    let campaignsScanned = 0;

    try {
      const campaigns = await prisma.campaign.findMany({
        where: {
          status: 'ACTIVE',
          followUpSteps: { some: { enabled: true } },
        },
        include: {
          followUpSteps: {
            where: { enabled: true },
            orderBy: { stepNumber: 'asc' },
          },
          senderLinks: {
            include: { sender: true },
          },
          drafts: {
            where: { useCase: 'followup', isActive: true },
            orderBy: { createdAt: 'desc' },
          },
        },
      });
      campaignsScanned = campaigns.length;

      for (const campaign of campaigns) {
        const leads = await prisma.lead.findMany({
          where: {
            campaignId: campaign.id,
            outreachStatus: 'SENT',
            status: { notIn: ['UNSUBSCRIBED', 'BOUNCED'] },
          },
        });

        if (leads.length === 0) continue;

        const leadIds = leads.map(l => l.id);

        // Batch-load all outbound/inbound emails and pending queue items for this campaign's leads
        const [allEmails, allPending] = await Promise.all([
          prisma.outboundEmail.findMany({
            where: {
              campaignId: campaign.id,
              leadId: { in: leadIds },
            },
            include: { draft: { select: { stepNumber: true } } },
            orderBy: { sentAt: 'asc' },
          }),
          prisma.pendingEmail.findMany({
            where: {
              campaignId: campaign.id,
              leadId: { in: leadIds },
            },
            include: { draft: { select: { stepNumber: true } } },
          }),
        ]);

        const emailsByLead = new Map<string, typeof allEmails>();
        for (const email of allEmails) {
          const list = emailsByLead.get(email.leadId) || [];
          list.push(email);
          emailsByLead.set(email.leadId, list);
        }

        const pendingByLead = new Map<string, typeof allPending>();
        for (const p of allPending) {
          const list = pendingByLead.get(p.leadId) || [];
          list.push(p);
          pendingByLead.set(p.leadId, list);
        }

        // Index follow-up drafts by stepNumber
        const draftByStep = new Map<number, (typeof campaign.drafts)[number]>();
        for (const d of campaign.drafts) {
          if (d.stepNumber && !draftByStep.has(d.stepNumber)) {
            draftByStep.set(d.stepNumber, d);
          }
        }

        // Index active campaign senders by domainId for consistent thread sender matching
        const senderByDomain = new Map<string, string>();
        for (const link of campaign.senderLinks) {
          if (link.sender.status === 'active' && !senderByDomain.has(link.sender.domainId)) {
            senderByDomain.set(link.sender.domainId, link.sender.id);
          }
        }

        const now = new Date();

        for (const lead of leads) {
          const leadEmails = emailsByLead.get(lead.id) || [];
          const leadPending = pendingByLead.get(lead.id) || [];

          // Stop follow-ups immediately if prospect has replied
          if (leadEmails.some(e => e.isIncoming)) continue;

          // If a pending email is already in-flight for this lead, wait for it
          if (leadPending.some(p => p.status === 'PENDING' || p.status === 'PROCESSING')) continue;

          const initialEmail = leadEmails.find(e => !e.isIncoming);
          if (!initialEmail) continue;

          const completedStepNumbers = new Set<number>();
          for (const e of leadEmails) {
            if (e.id !== initialEmail.id && e.draft?.stepNumber) {
              completedStepNumbers.add(e.draft.stepNumber);
            }
          }
          for (const p of leadPending) {
            if (p.draft?.stepNumber) {
              completedStepNumbers.add(p.draft.stepNumber);
            }
          }

          for (const step of campaign.followUpSteps) {
            if (completedStepNumbers.has(step.stepNumber)) continue;

            const targetDate = new Date(initialEmail.sentAt);
            targetDate.setDate(targetDate.getDate() + step.delayDays);

            if (now >= targetDate) {
              const draft = draftByStep.get(step.stepNumber);
              if (!draft) {
                logger.warn({ leadId: lead.id, campaignId: campaign.id, stepNumber: step.stepNumber }, 'No follow-up draft available');
                break;
              }

              const preferredSenderId = initialEmail.domainId
                ? senderByDomain.get(initialEmail.domainId) || null
                : null;

              const { subject, body } = personalisationService.personalise(
                lead,
                draft.subject,
                draft.body,
                campaign.reference,
                campaign.senderName
              );

              try {
                await prisma.pendingEmail.create({
                  data: {
                    userId: campaign.userId,
                    campaignId: campaign.id,
                    leadId: lead.id,
                    draftId: draft.id,
                    subject,
                    body,
                    inReplyTo: initialEmail.messageId,
                    domainId: initialEmail.domainId,
                    preferredSenderId,
                    status: 'PENDING',
                    priority: 2,
                    scheduledAt: now,
                  },
                });
                queued++;
                logger.info({ leadId: lead.id, campaignId: campaign.id, step: step.stepNumber }, 'Follow-up queued in PendingEmail');
              } catch (queueErr: any) {
                logger.error({ error: queueErr?.message, leadId: lead.id, campaignId: campaign.id }, 'Failed to queue follow-up');
              }

              // Queue strictly one step per lead per tick to preserve sequential cadence
              break;
            }
          }
        }
      }
    } catch (error) {
      logger.error({ error }, 'Follow-up sequencer execution failed');
    }

    return { queued, campaignsScanned };
  }
}

export const followUpService = new FollowUpService();
</file>

