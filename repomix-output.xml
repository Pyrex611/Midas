import prisma from '../lib/prisma';
import { env } from '../config/env';
import { logger } from '../config/logger';

export interface SandboxSendResult {
  success: boolean;
  sandboxDomain: string;
  messageId?: string;
  remainingToday: number;
  dailyLimit: number;
}

export class SandboxService {
  private getCredentials(): { domain: string; apiKey: string; region: 'us' | 'eu' } | null {
    if (env.SANDBOX_DOMAIN && env.SANDBOX_MAILGUN_KEY) {
      return {
        domain: env.SANDBOX_DOMAIN.trim(),
        apiKey: env.SANDBOX_MAILGUN_KEY.trim(),
        region: env.SANDBOX_REGION || 'us',
      };
    }

    if (env.MAILGUN_API_KEY && env.EMAIL_FROM && env.EMAIL_FROM.includes('.') && !env.EMAIL_FROM.includes('vercel.app')) {
      return {
        domain: env.EMAIL_FROM.trim(),
        apiKey: env.MAILGUN_API_KEY.trim(),
        region: env.MAILGUN_REGION || 'us',
      };
    }

    return null;
  }

  public isConfigured(): boolean {
    return Boolean(this.getCredentials());
  }

  public async getSandboxStatus(userId: string): Promise<{
    available: boolean;
    domain: string | null;
    sentToday: number;
    dailyLimit: number;
    remainingToday: number;
  }> {
    const creds = this.getCredentials();
    const startOfDay = new Date();
    startOfDay.setUTCHours(0, 0, 0, 0);

    const sentToday = await prisma.outboundEmail.count({
      where: {
        userId,
        isIncoming: false,
        sentAt: { gte: startOfDay },
        subject: { startsWith: '[MIDAS SANDBOX]' },
      },
    });

    const dailyLimit = env.SANDBOX_DAILY_LIMIT || 15;
    return {
      available: Boolean(creds),
      domain: creds?.domain || null,
      sentToday,
      dailyLimit,
      remainingToday: Math.max(0, dailyLimit - sentToday),
    };
  }

  /**
   * Dispatches a real live test email without requiring the developer to buy a
   * domain or configure Mailgun DNS first.
   *
   * SECURITY GUARDRAIL:
   * Sandbox recipients MUST match the authenticated user's own account email
   * (`userEmail`) to prevent spammers from abusing shared sandbox reputation.
   */
  public async sendSandboxTest(options: {
    userId: string;
    userEmail: string;
    toEmail?: string;
    subject?: string;
    body?: string;
  }): Promise<SandboxSendResult> {
    const creds = this.getCredentials();
    if (!creds) {
      throw new Error(
        'Zero-Setup Sandbox is not configured on this server (missing SANDBOX_DOMAIN / SANDBOX_MAILGUN_KEY). ' +
        'Connect your own domain under Sending Domains to dispatch live emails.'
      );
    }

    const accountEmail = options.userEmail.trim().toLowerCase();
    const requestedTo = (options.toEmail || accountEmail).trim().toLowerCase();

    if (requestedTo !== accountEmail) {
      throw new Error(
        `Sandbox sends are strictly restricted to your own verified account email (${accountEmail}). ` +
        `Connect a custom Sending Domain to email external prospects.`
      );
    }

    const status = await this.getSandboxStatus(options.userId);
    if (status.remainingToday <= 0) {
      throw new Error(
        `Daily sandbox limit reached (${status.dailyLimit}/${status.dailyLimit}). ` +
        `Connect your own Sending Domain to unlock higher limits.`
      );
    }

    const rawSubject = (options.subject || 'Hello from MIDAS Golden Infrastructure').trim();
    const finalSubject = rawSubject.startsWith('[MIDAS SANDBOX]')
      ? rawSubject
      : `[MIDAS SANDBOX] ${rawSubject}`;

    const finalBody = (
      options.body ||
      `Hi there,\n\nThis is a live test email dispatched via MIDAS Zero-Setup Sandbox (${creds.domain}).\n\nYour outbound pipeline, HTML envelope rendering, and API key authentication are working end-to-end.\n\nNext step: connect your custom domain under Sending Domains when ready to reach external prospects.`
    ).trim();

    const baseUrl = creds.region === 'eu' ? 'https://api.eu.mailgun.net/v3' : 'https://api.mailgun.net/v3';
    const authHeader = `Basic ${Buffer.from(`api:${creds.apiKey}`).toString('base64')}`;

    const form = new URLSearchParams();
    form.append('from', `MIDAS Sandbox <sandbox@${creds.domain}>`);
    form.append('to', accountEmail);
    form.append('subject', finalSubject);
    form.append('text', finalBody);
    form.append(
      'html',
      `<div style="font-family:-apple-system,sans-serif;max-width:560px;margin:24px auto;padding:24px;border-radius:16px;border:1px solid #D4AF37;background:#FFFFFF;color:#1F1124;">
        <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;color:#4A2559;margin-bottom:12px;">MIDAS Zero-Setup Sandbox</div>
        <div style="font-size:14px;line-height:1.65;">${finalBody.replace(/\n/g, '<br/>')}</div>
      </div>`
    );

    const res = await fetch(`${baseUrl}/${creds.domain}/messages`, {
      method: 'POST',
      headers: {
        Authorization: authHeader,
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: form.toString(),
      signal: AbortSignal.timeout(10_000),
    });

    const rawText = await res.text();
    let parsed: any = {};
    try { parsed = JSON.parse(rawText); } catch { parsed = { message: rawText }; }

    if (!res.ok) {
      throw new Error(`Sandbox delivery rejected (${res.status}): ${parsed.message || rawText}`);
    }

    // Record inside Lead + OutboundEmail cleanly so user sees it immediately in telemetry
    const selfLead = await prisma.lead.upsert({
      where: { userId_email: { userId: options.userId, email: accountEmail } },
      update: {},
      create: {
        userId: options.userId,
        email: accountEmail,
        name: accountEmail.split('@')[0],
        status: 'CONTACTED',
        outreachStatus: 'SENT',
      },
    });

    const cleanMessageId = (parsed.id || '').replace(/^<|>$/g, '').trim();
    await prisma.outboundEmail.create({
      data: {
        userId: options.userId,
        leadId: selfLead.id,
        subject: finalSubject,
        body: finalBody,
        status: 'SENT',
        messageId: cleanMessageId || null,
        fromAddress: `sandbox@${creds.domain}`,
        toAddress: accountEmail,
      },
    });

    logger.info({ userId: options.userId, domain: creds.domain }, 'Guarded sandbox test email sent');

    return {
      success: true,
      sandboxDomain: creds.domain,
      messageId: cleanMessageId || undefined,
      remainingToday: Math.max(0, status.remainingToday - 1),
      dailyLimit: status.dailyLimit,
    };
  }
}

export const sandboxService = new SandboxService();
</file>

<file path="server/services/sequenceAgent.service.ts">
import prisma from '../lib/prisma';
import { logger } from '../config/logger';
import { aiService, InboundClassification } from './ai.service';
import { emailService } from './email.service';
import { personalisationService } from './personalisation.service';
import { ensureUnsubscribeToken, buildUnsubscribeUrl } from '../lib/unsubscribe';

export class SequenceAgentService {
  /**
   * Evaluates prospect behavioral telemetry and transitions lead through the state graph.
   */
  async processInboundTransition(
    leadId: string,
    campaignId: string,
    inboundEmailId: string,
    inboundBody: string
  ): Promise<void> {
    try {
      const [lead, campaign, inboundEmail] = await Promise.all([
        prisma.lead.findUnique({ where: { id: leadId } }),
        prisma.campaign.findUnique({ where: { id: campaignId } }),
        prisma.outboundEmail.findUnique({ where: { id: inboundEmailId } }),
      ]);

      if (!lead || !campaign || !inboundEmail) return;

      // 1. AI Intent Classification
      const classification: InboundClassification = await aiService.classifyIntent(inboundBody);
      logger.info(
        { leadId, intent: classification.intent, confidence: classification.confidence },
        '[STATE-GRAPH] Inbound reply classified'
      );

      // Record classification in OutboundEmail analysis
      await prisma.outboundEmail.update({
        where: { id: inboundEmailId },
        data: {
          sentiment: classification.sentiment,
          intent: classification.intent,
          analysis: JSON.stringify(classification),
        },
      });

      // 2. State-Graph Branching Logic
      switch (classification.intent) {
        // BRANCH A: UNSUBSCRIBE REQUEST
        case 'UNSUBSCRIBE_REQUEST': {
          await prisma.lead.update({
            where: { id: lead.id },
            data: { status: 'UNSUBSCRIBED', outreachStatus: 'UNSUBSCRIBED' },
          });
          await prisma.pendingEmail.deleteMany({ where: { leadId: lead.id } });
          logger.info({ leadId: lead.id }, '[STATE-GRAPH] Lead auto-unsubscribed via intent classification');
          break;
        }

        // BRANCH B: OUT OF OFFICE (Auto-Freeze Sequence)
        case 'OUT_OF_OFFICE': {
          let resumeDate = new Date();
          if (classification.extractedReturnDate) {
            const parsed = new Date(classification.extractedReturnDate);
            if (!isNaN(parsed.getTime()) && parsed > resumeDate) {
              resumeDate = new Date(parsed.getTime() + 24 * 60 * 60 * 1000); // Resume 24h after return
            } else {
              resumeDate.setDate(resumeDate.getDate() + 7); // Default 7 days
            }
          } else {
            resumeDate.setDate(resumeDate.getDate() + 7);
          }

          // Reschedule any pending follow-up emails to the resume date
          await prisma.pendingEmail.updateMany({
            where: { leadId: lead.id, campaignId: campaign.id },
            data: { scheduledAt: resumeDate },
          });

          await prisma.leadActivityEvent.create({
            data: {
              leadId: lead.id,
              campaignId: campaign.id,
              eventType: 'EMAIL_REPLIED',
              metadata: {
                intent: 'OUT_OF_OFFICE',
                frozenUntil: resumeDate.toISOString(),
              },
            },
          });

          logger.info({ leadId: lead.id, resumeDate }, '[STATE-GRAPH] Sequence cadence frozen for OOO lead');
          break;
        }

        // BRANCH C: OBJECTION HANDLING (Pricing, Timing, Competitor)
        case 'OBJECTION_PRICING':
        case 'OBJECTION_TIMING':
        case 'OBJECTION_COMPETITOR':
        case 'NOT_DECISION_MAKER': {
          // Cancel scheduled generic follow-up steps
          await prisma.pendingEmail.deleteMany({ where: { leadId: lead.id, campaignId: campaign.id } });

          // Synthesize tailored objection-handling copy
          const objectionDraft = await aiService.generateObjectionResponse(
            campaign,
            lead,
            inboundBody,
            classification.intent
          );

          if (campaign.autoReplyEnabled) {
            // Auto-dispatch response immediately if enabled
            await this.dispatchAutonomousReply(lead, campaign, inboundEmail, objectionDraft);
          } else {
            // Stage as reply draft in Unified Inbox for 1-click human approval
            await prisma.draft.deleteMany({ where: { leadId: lead.id, campaignId: campaign.id, isReplyDraft: true } });
            await prisma.draft.create({
              data: {
                userId: campaign.userId,
                leadId: lead.id,
                campaignId: campaign.id,
                subject: objectionDraft.subject,
                body: objectionDraft.body,
                tone: 'professional',
                useCase: 'reply',
                isReplyDraft: true,
              },
            });
            logger.info({ leadId: lead.id }, '[STATE-GRAPH] Objection response staged for human copilot review');
          }
          break;
        }

        // BRANCH D: CONVERSION (Demo / Info Interest)
        case 'INTERESTED_DEMO':
        case 'INTERESTED_INFO':
        default: {
          await prisma.pendingEmail.deleteMany({ where: { leadId: lead.id, campaignId: campaign.id } });

          if (campaign.autoReplyEnabled) {
            const replyDraft = await aiService.generateDraft(
              'professional',
              'reply',
              campaign.context,
              campaign.reference,
              undefined,
              inboundBody,
              classification.sentiment
            );
            await this.dispatchAutonomousReply(lead, campaign, inboundEmail, replyDraft);
          }
          break;
        }
      }
    } catch (err: any) {
      logger.error({ err: err?.message, leadId }, '[STATE-GRAPH] Inbound transition processing failed');
    }
  }

  private async dispatchAutonomousReply(
    lead: any,
    campaign: any,
    inboundEmail: any,
    draftData: { subject: string; body: string }
  ) {
    const domain = await prisma.domain.findFirst({
      where: { id: inboundEmail.domainId!, status: 'active' },
      include: { senders: { where: { status: 'active' }, take: 1 } },
    });

    if (!domain) return;
    const sender = domain.senders[0];
    const localPart = sender?.localPart || 'hello';

    const unsubscribeToken = await ensureUnsubscribeToken(lead.id, lead.unsubscribeToken);
    const unsubscribeUrl = buildUnsubscribeUrl(unsubscribeToken);

    const { subject, body } = personalisationService.personalise(
      lead,
      draftData.subject,
      draftData.body,
      campaign.reference,
      campaign.senderName || sender?.displayName || null,
      unsubscribeUrl
    );

    const outboundRecord = await prisma.outboundEmail.create({
      data: {
        userId: campaign.userId,
        domainId: domain.id,
        leadId: lead.id,
        campaignId: campaign.id,
        subject,
        body,
        isIncoming: false,
        status: 'PROCESSING',
        replyToId: inboundEmail.id,
      },
    });

    const result = await emailService.sendEmailNow(
      { ...domain, senderLocalPart: localPart },
      lead.email,
      subject,
      body.replace(/\n/g, '<br>'),
      body,
      outboundRecord.id,
      campaign.senderName || sender?.displayName || null,
      inboundEmail.messageId,
      unsubscribeUrl,
      { leadId: lead.id, campaignId: campaign.id }
    );

    if (result.success) {
      await prisma.outboundEmail.update({
        where: { id: outboundRecord.id },
        data: { status: 'SENT', messageId: result.messageId, sentAt: new Date() },
      });
      logger.info({ leadId: lead.id }, '[STATE-GRAPH] Autonomous reply dispatched');
    }
  }
}

export const sequenceAgentService = new SequenceAgentService();
</file>

