  ];

  const getBreadcrumbs = () => {
    const p = location.pathname;
    if (p === '/') return 'Overview';
    if (p.startsWith('/campaigns/')) return 'Campaigns / Sequence Studio';
    if (p === '/campaigns') return 'Campaigns';
    if (p === '/town-crier') return 'Town Crier Newsletter';
