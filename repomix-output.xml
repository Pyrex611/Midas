                  </div>
                  <div className="pt-2 border-t border-gold-500/25 text-[9px] text-thistle-500">
                    Unsubscribe · {physicalAddress || '100 Market St, San Francisco'}
                  </div>
                </div>
              </div>
            </div>
          </div>
