<file path="src/components/townCrier/TownCrierHeader.tsx">
import React, { useRef, useState, useEffect } from 'react';
import { townCrierAPI, getErrorMessage } from '../../services/api';
import { useToast } from '../../context/ToastContext';
import { Icons } from '../../lib/icons';

interface TownCrierHeaderProps {
  activeTab: 'broadcasts' | 'gongs' | 'audience';
  onOpenComposer: () => void;
  onOpenAddRecipient: () => void;
  onOpenCreateGong: () => void;
  onOpenEmbedDrawer: () => void;
  onRefreshAudience: () => void;
}

export const TownCrierHeader: React.FC<TownCrierHeaderProps> = ({
  activeTab,
  onOpenComposer,
  onOpenAddRecipient,
  onOpenCreateGong,
  onOpenEmbedDrawer,
  onRefreshAudience,
}) => {
  const { toast } = useToast();
  const fileInputRef = useRef<HTMLInputElement | null>(null);
  const exportMenuRef = useRef<HTMLDivElement | null>(null);
  const [exportMenuOpen, setExportMenuOpen] = useState(false);

  useEffect(() => {
    const handleOutsideClick = (e: MouseEvent) => {
      if (exportMenuRef.current && !exportMenuRef.current.contains(e.target as Node)) {
        setExportMenuOpen(false);
      }
    };
    if (exportMenuOpen) {
      document.addEventListener('mousedown', handleOutsideClick);
    }
    return () => document.removeEventListener('mousedown', handleOutsideClick);
  }, [exportMenuOpen]);

  const handleExportContacts = async (format: 'json' | 'csv') => {
    setExportMenuOpen(false);
    try {
      toast.info(`Preparing ${format.toUpperCase()} export...`, 'Exporting');
      const res = await townCrierAPI.exportRecipients(format, 'all');

      if (format === 'csv') {
        const url = window.URL.createObjectURL(new Blob([res.data]));
        const link = document.createElement('a');
        link.href = url;
        link.setAttribute('download', `subscribers-export-${new Date().toISOString().slice(0, 10)}.csv`);
        document.body.appendChild(link);
        link.click();
        link.remove();
      } else {
        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(res.data, null, 2));
        const link = document.createElement('a');
        link.href = dataStr;
        link.setAttribute('download', `subscribers-dump-${new Date().toISOString().slice(0, 10)}.json`);
        document.body.appendChild(link);
        link.click();
        link.remove();
      }
      toast.success('Contacts exported successfully', 'Export Complete');
    } catch {
      toast.error('Failed to export contacts', 'Export Error');
    }
  };

  const handleCsvImport = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    try {
      const res = await townCrierAPI.importRecipients(file);
      toast.success(`Imported ${res.data.importedCount} subscriber(s)`, 'CSV Import Complete');
      onRefreshAudience();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to import CSV'), 'Import Error');
    } finally {
      if (fileInputRef.current) fileInputRef.current.value = '';
    }
  };

  return (
    <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-5 border-b border-gold-500/40">
      <div>
        <div className="flex items-center gap-2 flex-wrap">
          <h1 className="text-2xl sm:text-3xl font-black text-royal-950 tracking-tight">Town Crier</h1>
          <span className="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-thistle-100 text-royal-800 border border-gold-500/40">
            Newsletter Engine
          </span>
        </div>
        <p className="text-xs text-thistle-500 mt-1">
          Universal list marketing &amp; newsletter channels. Gongs, welcome autoresponders, and isolated mailboxes.
        </p>
      </div>

      <div className="flex items-center gap-2 flex-wrap">
        <button
          onClick={onOpenEmbedDrawer}
          className="px-3.5 py-2 bg-white hover:bg-thistle-100 text-royal-800 border border-gold-500/40 rounded-xl text-xs font-bold glow-gold-hover flex items-center gap-1.5"
        >
          <Icons.Code className="text-gold-600" />
          <span>Integrate SDK &amp; Forms</span>
        </button>

        <div className="relative" ref={exportMenuRef}>
          <button
            type="button"
            onClick={() => setExportMenuOpen((prev) => !prev)}
            className="px-3 py-2 bg-white hover:bg-thistle-100 text-royal-800 border border-gold-500/40 rounded-xl text-xs font-bold glow-gold-hover flex items-center gap-1.5"
          >
            <Icons.Download className="text-gold-600" />
            <span>Export Contacts ▾</span>
          </button>
          {exportMenuOpen && (
            <div className="absolute right-0 mt-1.5 w-40 bg-white border border-gold-500/45 rounded-xl shadow-xl p-1 z-30 animate-in fade-in zoom-in-95 duration-100">
              <button
                type="button"
                onClick={() => handleExportContacts('csv')}
                className="w-full text-left px-3 py-1.5 text-xs font-semibold text-royal-950 hover:bg-thistle-100 rounded-lg"
              >
                Export as CSV
              </button>
              <button
                type="button"
                onClick={() => handleExportContacts('json')}
                className="w-full text-left px-3 py-1.5 text-xs font-semibold text-royal-950 hover:bg-thistle-100 rounded-lg"
              >
                Export as JSON
              </button>
            </div>
          )}
        </div>

        {activeTab === 'broadcasts' && (
          <button
            onClick={onOpenComposer}
            className="px-4 py-2 btn-royal rounded-xl text-xs font-bold flex items-center gap-1.5"
          >
            <Icons.Plus className="text-gold-300" />
            <span>New Broadcast</span>
          </button>
        )}

        {activeTab === 'gongs' && (
          <button
            onClick={onOpenCreateGong}
            className="px-4 py-2 btn-royal rounded-xl text-xs font-bold flex items-center gap-1.5"
          >
            <Icons.TownCrier className="text-gold-300" />
            <span>New Gong Channel</span>
          </button>
        )}

        {activeTab === 'audience' && (
          <>
            <input
              type="file"
              ref={fileInputRef}
              accept=".csv"
              onChange={handleCsvImport}
              className="hidden"
            />
            <button
              onClick={() => fileInputRef.current?.click()}
              className="px-3.5 py-2 bg-white hover:bg-thistle-100 border border-gold-500/40 text-royal-800 rounded-xl text-xs font-bold glow-gold-hover flex items-center gap-1.5"
            >
              <Icons.Upload className="text-gold-600" />
              <span>Import CSV</span>
            </button>
            <button
              onClick={onOpenAddRecipient}
              className="px-4 py-2 btn-royal rounded-xl text-xs font-bold flex items-center gap-1.5"
            >
              <Icons.Plus className="text-gold-300" />
              <span>Add Subscriber</span>
            </button>
          </>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/context/ToastContext.tsx">
import React, { createContext, useContext, useState, useCallback, useMemo } from 'react';

export interface Toast {
  id: string;
  type: 'success' | 'error' | 'info' | 'warning';
  title?: string;
  message: string;
  duration?: number;
  action?: {
    label: string;
    onClick: () => void;
  };
}

interface ToastContextType {
  toast: {
    success: (message: string, title?: string, action?: Toast['action']) => void;
    error: (message: string, title?: string) => void;
    info: (message: string, title?: string) => void;
    warning: (message: string, title?: string) => void;
  };
}

const ToastContext = createContext<ToastContextType | undefined>(undefined);

export const ToastProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [toasts, setToasts] = useState<Toast[]>([]);

  const addToast = useCallback((type: Toast['type'], message: string, title?: string, action?: Toast['action']) => {
    const id = `toast-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`;
    const newToast: Toast = { id, type, message, title, action, duration: 5000 };

    setToasts((prev) => [...prev, newToast]);

    setTimeout(() => {
      setToasts((prev) => prev.filter((t) => t.id !== id));
    }, newToast.duration);
  }, []);

  const removeToast = useCallback((id: string) => {
    setToasts((prev) => prev.filter((t) => t.id !== id));
  }, []);

  // Stabilize toast reference so it NEVER triggers re-renders in consumers
  const toast = useMemo(
    () => ({
      success: (message: string, title?: string, action?: Toast['action']) => addToast('success', message, title, action),
      error: (message: string, title?: string) => addToast('error', message, title),
      info: (message: string, title?: string) => addToast('info', message, title),
      warning: (message: string, title?: string) => addToast('warning', message, title),
    }),
    [addToast]
  );

  const getToastStyles = (type: Toast['type']) => {
    switch (type) {
      case 'success':
        return 'bg-emerald-950/90 border-emerald-500/40 text-emerald-200';
      case 'error':
        return 'bg-rose-950/90 border-rose-500/40 text-rose-200';
      case 'warning':
        return 'bg-amber-950/90 border-amber-500/40 text-amber-200';
      case 'info':
      default:
        return 'bg-zinc-900/90 border-zinc-700/60 text-zinc-200';
    }
  };

  return (
    <ToastContext.Provider value={{ toast }}>
      {children}
      <div className="fixed bottom-5 right-5 z-[100] flex flex-col gap-2.5 max-w-md w-full pointer-events-none px-4 sm:px-0">
        {toasts.map((t) => (
          <div
            key={t.id}
            className={`pointer-events-auto flex items-start justify-between gap-3 p-4 rounded-xl border shadow-2xl backdrop-blur-md transition-all animate-in slide-in-from-bottom-3 duration-200 ${getToastStyles(
              t.type
            )}`}
          >
            <div className="flex-1 min-w-0">
              {t.title && <p className="text-xs font-bold uppercase tracking-wider mb-0.5 opacity-90">{t.title}</p>}
              <p className="text-sm font-medium leading-relaxed break-words">{t.message}</p>
              {t.action && (
                <button
                  onClick={() => {
                    t.action?.onClick();
                    removeToast(t.id);
                  }}
                  className="mt-2 text-xs font-bold underline hover:opacity-80 transition-opacity"
                >
                  {t.action.label}
                </button>
              )}
            </div>
            <button
              onClick={() => removeToast(t.id)}
              className="text-xs opacity-60 hover:opacity-100 transition-opacity p-1 -mr-1"
            >
              ✕
            </button>
          </div>
        ))}
      </div>
    </ToastContext.Provider>
  );
};

export const useToast = () => {
  const context = useContext(ToastContext);
  if (!context) throw new Error('useToast must be used within a ToastProvider');
  return context;
};
</file>

<file path="src/lib/townCrierClient.ts">
import { useCallback, useState } from 'react';

export interface TownCrierFieldSchema {
  name: string;
  type: 'email' | 'text' | 'url' | 'number' | 'tel' | 'select' | 'boolean' | 'cadence';
  label: string;
  placeholder?: string;
  required?: boolean;
  options?: string[];
  followUp?: Omit<TownCrierFieldSchema, 'followUp'>;
}

export interface MidasSubscribeOptions {
  email: string;
  name?: string;
  cadence?: 'daily' | 'weekly' | 'biweekly' | 'monthly' | string;
  tags?: string[];
  gongId?: string;
  campaignId?: string;
  metadata?: Record<string, any>;
}

export interface MidasClientConfig {
  apiKey?: string;
  baseUrl?: string;
}

export class MidasClient {
  private apiKey: string;
  private baseUrl: string;

  constructor(config?: MidasClientConfig) {
    let key = config?.apiKey?.trim();

    if (!key && typeof process !== 'undefined' && process.env) {
      key = (
        process.env.MIDAS_API_KEY ||
        process.env.TOWN_CRIER_API_KEY ||
        process.env.NEXT_PUBLIC_MIDAS_API_KEY
      )?.trim();
    }

    if (!key && typeof import.meta !== 'undefined' && (import.meta as any).env) {
      key = ((import.meta as any).env.VITE_MIDAS_API_KEY)?.trim();
    }

    if (!key || (!key.startsWith('midas_live_') && !key.startsWith('tc_live_'))) {
      throw new Error(
        'MidasClient: A valid API key starting with "midas_live_" or "tc_live_" is required. ' +
        'Pass apiKey to the constructor or set MIDAS_API_KEY in your environment variables.'
      );
    }

    this.apiKey = key;
    this.baseUrl = (
      config?.baseUrl ||
      (typeof process !== 'undefined' && process.env?.MIDAS_BASE_URL) ||
      (typeof window !== 'undefined' ? window.location.origin : 'https://midas-aem.vercel.app')
    ).replace(/\/$/, '');
  }

  async subscribe(options: MidasSubscribeOptions) {
    if (!options.email || !options.email.includes('@')) {
      throw new Error('MidasClient: A valid email address is required.');
    }

    const endpoint = `${this.baseUrl}/api/public/town-crier/subscribe`;
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${this.apiKey}`,
      },
      body: JSON.stringify({
        email: options.email.trim().toLowerCase(),
        name: options.name?.trim() || undefined,
        cadence: options.cadence || 'weekly',
        tags: options.tags || ['sdk_signup'],
        gongId: options.gongId?.trim() || undefined,
        campaignId: options.campaignId?.trim() || undefined,
        metadata: options.metadata || undefined,
      }),
    });

    const data = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(data.error || `Subscription failed (HTTP ${response.status})`);
    }

    return data;
  }

  async listGongs() {
    const endpoint = `${this.baseUrl}/api/public/town-crier/gongs`;
    const response = await fetch(endpoint, {
      headers: { Authorization: `Bearer ${this.apiKey}` },
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Failed to list Gongs');
    return data.gongs || [];
  }

  async publishBroadcast(gongId: string, issue: { subject: string; body: string; templateStyle?: string }) {
    const endpoint = `${this.baseUrl}/api/public/town-crier/gongs/${gongId}/broadcast`;
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${this.apiKey}`,
      },
      body: JSON.stringify(issue),
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Failed to publish broadcast');
    return data;
  }

  async getStats() {
    const endpoint = `${this.baseUrl}/api/public/town-crier/stats`;
    const response = await fetch(endpoint, {
      headers: { Authorization: `Bearer ${this.apiKey}` },
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'Failed to fetch telemetry');
    return data;
  }
}

export const TownCrierClient = MidasClient;

/**
 * React Hook for Zero-Boilerplate Modal Subscriptions with Progressive Profiling
 */
export function useMidasModal(defaultConfig?: {
  apiKey?: string;
  gongId?: string;
  headline?: string;
  accent?: string;
  fields?: string[];
  schema?: TownCrierFieldSchema[];
}) {
  const [isOpen, setIsOpen] = useState(false);

  const open = useCallback(
    (overrideConfig?: {
      apiKey?: string;
      gongId?: string;
      headline?: string;
      accent?: string;
      fields?: string[];
      schema?: TownCrierFieldSchema[];
    }) => {
      const cfg = { ...defaultConfig, ...overrideConfig };
      if (typeof window !== 'undefined' && (window as any).TownCrier?.openModal) {
        (window as any).TownCrier.openModal({
          apiKey: cfg.apiKey,
          gongId: cfg.gongId,
          headline: cfg.headline,
          accent: cfg.accent,
          fields: cfg.fields,
          schema: cfg.schema,
        });
        setIsOpen(true);
      } else {
        console.warn('TownCrier widget.js script is not loaded in the window.');
      }
    },
    [defaultConfig]
  );

  return { open, isOpen };
}

export const useTownCrierModal = useMidasModal;
