<file path="src/components/RenameCampaignModal.tsx">
import React, { useState, useEffect } from 'react';
import { campaignAPI, getErrorMessage } from '../services/api';
import { useToast } from '../context/ToastContext';
import { Icons } from '../lib/icons';

interface Props {
  isOpen: boolean;
  onClose: () => void;
  campaign: any;
  onSuccess: () => void;
}

export const RenameCampaignModal: React.FC<Props> = ({
  isOpen,
  onClose,
  campaign,
  onSuccess,
}) => {
  const { toast } = useToast();
  const [name, setName] = useState(campaign.name || '');
  const [submitting, setSubmitting] = useState(false);

  useEffect(() => {
    if (isOpen && campaign?.name) {
      setName(campaign.name);
    }
  }, [isOpen, campaign?.name]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!name.trim()) return;
    setSubmitting(true);
    try {
      await campaignAPI.update(campaign.id, { name: name.trim() });
      toast.success('Campaign renamed', 'Saved');
      onSuccess();
      onClose();
    } catch (error: any) {
      toast.error(getErrorMessage(error, 'Could not rename campaign'), 'Error');
    } finally {
      setSubmitting(false);
    }
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
      <div className="fixed inset-0 bg-royal-950/65 backdrop-blur-sm" onClick={onClose} />

      <div className="relative w-full max-w-md bg-white border border-gold-500/45 rounded-3xl shadow-2xl p-6 z-10 animate-in zoom-in-95 duration-150">
        <div className="flex items-center justify-between pb-3 mb-4 border-b border-gold-500/35">
          <h3 className="text-base font-black text-royal-950">Rename Campaign</h3>
          <button onClick={onClose} className="text-thistle-500 hover:text-royal-950 p-1">
            <Icons.Close />
          </button>
        </div>

        <form onSubmit={handleSubmit} className="space-y-4 text-xs">
          <div>
            <label className="block text-[10px] font-bold uppercase text-thistle-500 mb-1">Campaign Name</label>
            <input
              type="text"
              value={name}
              onChange={(e) => setName(e.target.value)}
              className="w-full px-3.5 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl font-semibold text-royal-950 focus:outline-none focus:border-gold-500"
              required
            />
          </div>

          <div className="flex justify-end gap-3 pt-3 border-t border-gold-500/35">
            <button
              type="button"
              onClick={onClose}
              className="px-4 py-2 text-thistle-500 hover:text-royal-950 font-bold"
            >
              Cancel
            </button>
            <button
              type="submit"
              disabled={submitting || !name.trim()}
              className="px-5 py-2 btn-royal rounded-xl font-bold"
            >
              {submitting ? 'Saving...' : 'Save Name'}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};
</file>

<file path="src/components/settings/ApiKeySettings.tsx">
import React, { useEffect, useState } from 'react';
import { apiKeyAPI, getErrorMessage } from '../../services/api';
import { useToast } from '../../context/ToastContext';
import { Sheet } from '../common/Sheet';
import { ConfirmDialog } from '../common/ConfirmDialog';
import { Icons } from '../../lib/icons';

interface ApiKeyItem {
  id: string;
  label: string;
  keyPrefix: string;
  scopes: string[];
  lastUsedAt: string | null;
  createdAt: string;
}

export const ApiKeySettings: React.FC = () => {
  const { toast } = useToast();
  const [apiKeys, setApiKeys] = useState<ApiKeyItem[]>([]);
  const [loading, setLoading] = useState(true);

  const [isCreateOpen, setIsCreateOpen] = useState(false);
  const [keyLabel, setKeyLabel] = useState('');
  const [selectedScopes, setSelectedScopes] = useState<string[]>(['*']);
  const [creating, setCreating] = useState(false);
  const [revealedKey, setRevealedKey] = useState<string | null>(null);

  const [revokeTarget, setRevokeTarget] = useState<{ id: string; label: string } | null>(null);
  const [revoking, setRevoking] = useState(false);

  const fetchKeys = async () => {
    try {
      const res = await apiKeyAPI.list();
      setApiKeys(res.data || []);
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to load API keys'), 'Error');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchKeys();
  }, []);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!keyLabel.trim()) return;

    setCreating(true);
    try {
      const res = await apiKeyAPI.create(keyLabel.trim(), selectedScopes);
      setRevealedKey(res.data.plaintextKey);
      setKeyLabel('');
      setSelectedScopes(['*']);
      setIsCreateOpen(false);
      toast.success('Workspace API Key provisioned', 'Key Created');
      await fetchKeys();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not provision API key'), 'Error');
    } finally {
      setCreating(false);
    }
  };

  const handleConfirmRevoke = async () => {
    if (!revokeTarget) return;
    setRevoking(true);
    try {
      await apiKeyAPI.revoke(revokeTarget.id);
      toast.warning(`API key "${revokeTarget.label}" revoked`, 'Key Revoked');
      setRevokeTarget(null);
      await fetchKeys();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to revoke API key'), 'Error');
    } finally {
      setRevoking(false);
    }
  };

  return (
    <div className="space-y-6">
      <div className="p-6 card-midas rounded-2xl space-y-4">
        <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-3 border-b border-gold-500/35">
          <div>
            <div className="flex items-center gap-2">
              <h3 className="text-base font-black text-royal-950 tracking-tight">Workspace Developer API Keys</h3>
              <span className="text-[10px] uppercase font-bold bg-thistle-100 text-royal-800 px-2 py-0.5 rounded-md border border-gold-500/35">
                {apiKeys.length} / 15 Active Keys
              </span>
            </div>
            <p className="text-xs text-thistle-500 mt-0.5">
              Programmatic keys for CLI automation, external website forms, and CRM integrations. Supports granular wildcard scopes.
            </p>
          </div>

          <button
            onClick={() => setIsCreateOpen(true)}
            disabled={apiKeys.length >= 15}
            className="px-4 py-2 btn-royal rounded-xl text-xs font-bold flex items-center gap-1.5"
          >
            <Icons.Key className="text-gold-300" />
            <span>Generate API Key</span>
          </button>
        </div>

        {revealedKey && (
          <div className="p-4 bg-amber-50 border border-gold-500/60 rounded-xl space-y-2 animate-in fade-in duration-150 text-xs">
            <div className="flex items-center justify-between">
              <span className="font-bold text-amber-950 uppercase tracking-wider text-[10px]">Save Your Secret API Key</span>
              <button onClick={() => setRevealedKey(null)} className="text-amber-800 hover:text-amber-950 font-bold text-xs flex items-center gap-1">
                <Icons.Close />
                <span>Dismiss</span>
              </button>
            </div>
            <p className="text-amber-900 text-[11px]">
              Copy this key immediately. For security, it will <strong>never be displayed again</strong>.
            </p>
            <div className="flex items-center gap-2">
              <input
                type="text"
                readOnly
                value={revealedKey}
                className="flex-1 px-3 py-1.5 bg-white border border-gold-500/50 rounded-lg text-xs font-mono font-bold text-royal-950 select-all"
              />
              <button
                onClick={() => {
                  navigator.clipboard.writeText(revealedKey);
                  toast.success('API Key copied to clipboard', 'Copied');
                }}
                className="px-3.5 py-1.5 btn-royal rounded-lg text-xs font-bold flex items-center gap-1"
              >
                <Icons.Copy className="text-gold-300" />
                <span>Copy Key</span>
              </button>
            </div>
          </div>
        )}

        <div className="border border-gold-500/40 rounded-xl overflow-hidden">
          {loading ? (
            <div className="py-12 text-center text-xs text-thistle-500">Loading API keys...</div>
          ) : apiKeys.length === 0 ? (
            <div className="py-12 text-center text-xs text-thistle-500 space-y-2">
              <p>No active API keys found for this workspace.</p>
              <button onClick={() => setIsCreateOpen(true)} className="text-royal-700 font-bold hover:underline">
                Generate your first key for programmatic access
              </button>
            </div>
          ) : (
            <table className="min-w-full divide-y divide-gold-500/25 text-left text-xs">
              <thead className="bg-thistle-100/75 text-royal-800 font-bold uppercase tracking-wider text-[10px] border-b border-gold-500/35">
                <tr>
                  <th className="py-3 px-4">Label</th>
                  <th className="py-3 px-4">Prefix</th>
                  <th className="py-3 px-4">Authorized Scopes</th>
                  <th className="py-3 px-4">Last Used</th>
                  <th className="py-3 px-4 text-right">Action</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gold-500/20 font-medium text-royal-950">
                {apiKeys.map((k) => (
                  <tr key={k.id} className="hover:bg-thistle-50/80">
                    <td className="py-3 px-4 font-bold text-royal-950">{k.label}</td>
                    <td className="py-3 px-4 font-mono text-thistle-500">{k.keyPrefix}••••••••</td>
                    <td className="py-3 px-4">
                      <div className="flex flex-wrap gap-1">
                        {k.scopes.map((scope) => (
                          <span key={scope} className="px-1.5 py-0.5 rounded text-[10px] font-mono bg-thistle-100 text-royal-800 border border-gold-500/30">
                            {scope}
                          </span>
                        ))}
                      </div>
                    </td>
                    <td className="py-3 px-4 text-thistle-500">
                      {k.lastUsedAt ? new Date(k.lastUsedAt).toLocaleString() : 'Never'}
                    </td>
                    <td className="py-3 px-4 text-right">
                      <button
                        onClick={() => setRevokeTarget({ id: k.id, label: k.label })}
                        className="text-rose-600 hover:text-rose-800 text-xs font-bold"
                      >
                        Revoke
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </div>

      <Sheet
        isOpen={isCreateOpen}
        onClose={() => setIsCreateOpen(false)}
        title="Provision Developer API Key"
        description="Create a secret key for CLI access, external webhooks, or website newsletter forms."
        width="md"
      >
        <form onSubmit={handleCreate} className="space-y-4 text-xs">
          <div>
            <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Key Label *</label>
            <input
              type="text"
              value={keyLabel}
              onChange={(e) => setKeyLabel(e.target.value)}
              placeholder="e.g. Production Next.js App / Terminal CLI"
              required
              className="w-full px-3 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl focus:outline-none focus:border-gold-500 font-medium"
            />
          </div>

          <div>
            <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Assign Permission Scopes</label>
            <div className="space-y-2 p-3 bg-thistle-50 border border-gold-500/35 rounded-xl">
              {[
                ['*', 'Super Admin (* - Full Access)'],
                ['campaigns:*', 'Outreach Campaigns (Read/Write/Dispatch)'],
                ['leads:*', 'Leads Management (Read/Upload/Delete)'],
                ['town_crier:*', 'Town Crier Newsletters & Gongs'],
                ['analytics:*', 'Analytics & Reporting Telemetry'],
              ].map(([scope, label]) => {
                const checked = selectedScopes.includes(scope);
                return (
                  <label key={scope} className="flex items-center gap-2 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={checked}
                      onChange={(e) => {
                        if (scope === '*') {
                          setSelectedScopes(['*']);
                        } else {
                          const next = selectedScopes.filter((x) => x !== '*');
                          if (e.target.checked) next.push(scope);
                          else next.splice(next.indexOf(scope), 1);
                          setSelectedScopes(next.length === 0 ? ['*'] : next);
                        }
                      }}
                      className="rounded border-thistle-400 text-royal-700 focus:ring-0"
                    />
                    <span className="font-semibold text-royal-950 text-[11px]">{label}</span>
                  </label>
                );
              })}
            </div>
          </div>

          <div className="pt-3 border-t border-gold-500/35 flex justify-end gap-2">
            <button
              type="button"
              onClick={() => setIsCreateOpen(false)}
              className="px-4 py-2 text-thistle-500 font-bold hover:text-royal-950"
            >
              Cancel
            </button>
            <button
              type="submit"
              disabled={creating || !keyLabel.trim()}
              className="px-5 py-2 btn-royal font-bold rounded-xl"
            >
              {creating ? 'Generating Key...' : 'Generate Secret Key'}
            </button>
          </div>
        </form>
      </Sheet>

      <ConfirmDialog
        isOpen={Boolean(revokeTarget)}
        onClose={() => setRevokeTarget(null)}
        onConfirm={handleConfirmRevoke}
        title={`Revoke API Key "${revokeTarget?.label}"`}
        description="Any external apps, embeds, or CLI scripts authenticating with this key will fail immediately."
        confirmLabel="Revoke Key"
        loading={revoking}
      />
    </div>
  );
};
</file>

<file path="src/components/settings/WebhookSettings.tsx">
import React, { useEffect, useState } from 'react';
import { webhookAPI, getErrorMessage } from '../../services/api';
import { useToast } from '../../context/ToastContext';
import { ConfirmDialog } from '../common/ConfirmDialog';
import { Icons } from '../../lib/icons';

interface WebhookSub {
  id: string;
  targetUrl: string;
  secret: string;
  events: string[];
  isActive: boolean;
  createdAt: string;
  _count?: { deliveries: number };
}

export const WebhookSettings: React.FC = () => {
  const { toast } = useToast();
  const [subscriptions, setSubscriptions] = useState<WebhookSub[]>([]);
  const [loading, setLoading] = useState(true);

  const [targetUrl, setTargetUrl] = useState('');
  const [selectedEvents, setSelectedEvents] = useState<string[]>(['*']);
  const [creating, setCreating] = useState(false);

  const [inspectingSubId, setInspectingSubId] = useState<string | null>(null);
  const [deliveries, setDeliveries] = useState<any[]>([]);
  const [loadingDeliveries, setLoadingDeliveries] = useState(false);
  const [pingingId, setPingingId] = useState<string | null>(null);

  const [deleteTargetId, setDeleteTargetId] = useState<string | null>(null);
  const [deleting, setDeleting] = useState(false);

  const fetchSubscriptions = async () => {
    try {
      const res = await webhookAPI.list();
      setSubscriptions(res.data || []);
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to load webhooks'), 'Error');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchSubscriptions();
  }, []);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!targetUrl.trim()) return;

    setCreating(true);
    try {
      await webhookAPI.create({
        targetUrl: targetUrl.trim(),
        events: selectedEvents,
      });
      toast.success('Webhook endpoint subscribed', 'Created');
      setTargetUrl('');
      setSelectedEvents(['*']);
      await fetchSubscriptions();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to create webhook endpoint'), 'Error');
    } finally {
      setCreating(false);
    }
  };

  const handleConfirmDelete = async () => {
    if (!deleteTargetId) return;
    setDeleting(true);
    try {
      await webhookAPI.delete(deleteTargetId);
      toast.info('Webhook endpoint removed', 'Deleted');
      setDeleteTargetId(null);
      await fetchSubscriptions();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not delete endpoint'), 'Error');
    } finally {
      setDeleting(false);
    }
  };

  const handleTestPing = async (id: string) => {
    setPingingId(id);
    try {
      const res = await webhookAPI.test(id);
      const status = res.data?.delivery?.status;
      if (status === 'DELIVERED') {
        toast.success(`Ping returned HTTP ${res.data?.delivery?.statusCode} (${res.data?.delivery?.durationMs}ms)`, 'Ping Succeeded');
      } else {
        toast.warning(`Ping failed: ${res.data?.delivery?.error}`, 'Delivery Rejected');
      }
      if (inspectingSubId === id) {
        handleInspect(id);
      }
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Test ping request failed'), 'Error');
    } finally {
      setPingingId(null);
    }
  };

  const handleInspect = async (id: string) => {
    setInspectingSubId(id);
    setLoadingDeliveries(true);
    try {
      const res = await webhookAPI.getDeliveries(id);
      setDeliveries(res.data || []);
    } catch {
      toast.error('Failed to load delivery logs', 'Error');
    } finally {
      setLoadingDeliveries(false);
    }
  };

  return (
    <div className="space-y-6">
      <div className="p-6 card-midas rounded-2xl space-y-4">
        <div className="pb-3 border-b border-gold-500/35">
          <div className="flex items-center gap-2">
            <h3 className="text-base font-black text-royal-950 tracking-tight">Bi-Directional CRM &amp; Outbound Webhooks</h3>
            <span className="text-[10px] uppercase font-bold bg-thistle-100 text-royal-800 px-2 py-0.5 rounded-md border border-gold-500/35">
              HMAC-SHA256 Signed
            </span>
          </div>
          <p className="text-xs text-thistle-500 mt-0.5">
            Receive real-time signed HTTPS events whenever prospects reply, subscribe to Gongs, click CTAs, or trip deliverability alerts.
          </p>
        </div>

        <form onSubmit={handleCreate} className="space-y-3 p-4 bg-thistle-50/70 border border-gold-500/35 rounded-xl text-xs">
          <div>
            <label className="block text-[10px] font-bold uppercase text-thistle-500 mb-1">Target Endpoint URL (HTTPS)</label>
            <input
              type="url"
              value={targetUrl}
              onChange={(e) => setTargetUrl(e.target.value)}
              placeholder="https://your-crm.com/api/webhooks/midas or https://hooks.zapier.com/..."
              required
              className="w-full px-3 py-2 bg-white border border-gold-500/40 rounded-xl font-mono text-xs focus:outline-none focus:border-gold-500"
            />
          </div>

          <div>
            <label className="block text-[10px] font-bold uppercase text-thistle-500 mb-1">Subscribed Events</label>
            <div className="flex flex-wrap gap-2 pt-1">
              {[
                ['*', 'All Events (*)'],
                ['lead.replied', 'Prospect Replied'],
                ['gong.subscribed', 'Gong Subscribed'],
                ['deliverability.circuit_tripped', 'Circuit Breaker Alert'],
                ['deal.booked', 'Deal Booked / CTA Clicked'],
              ].map(([ev, label]) => {
                const checked = selectedEvents.includes(ev);
                return (
                  <label key={ev} className="flex items-center gap-1.5 px-2.5 py-1 bg-white border border-gold-500/35 rounded-lg cursor-pointer">
                    <input
                      type="checkbox"
                      checked={checked}
                      onChange={(e) => {
                        if (ev === '*') {
                          setSelectedEvents(['*']);
                        } else {
                          const next = selectedEvents.filter((x) => x !== '*');
                          if (e.target.checked) next.push(ev);
                          else next.splice(next.indexOf(ev), 1);
                          setSelectedEvents(next.length === 0 ? ['*'] : next);
                        }
                      }}
                      className="rounded border-thistle-400 text-royal-700 focus:ring-0"
                    />
                    <span className="font-medium text-royal-950 text-[11px]">{label}</span>
                  </label>
                );
              })}
            </div>
          </div>

          <div className="pt-2 flex justify-end">
            <button
              type="submit"
              disabled={creating || !targetUrl.trim()}
              className="px-4 py-2 btn-royal font-bold rounded-xl text-xs flex items-center gap-1.5"
            >
              <Icons.Plus className="text-gold-300" />
              <span>{creating ? 'Registering Endpoint...' : 'Add Webhook Endpoint'}</span>
            </button>
          </div>
        </form>

        <div className="space-y-3 pt-2">
          {loading ? (
            <div className="py-8 text-center text-xs text-thistle-500">Loading subscriptions...</div>
          ) : subscriptions.length === 0 ? (
            <div className="py-8 text-center text-xs text-thistle-500">No outbound webhook endpoints configured yet.</div>
          ) : (
            subscriptions.map((sub) => (
              <div key={sub.id} className="p-4 bg-thistle-50/70 border border-gold-500/35 rounded-xl space-y-3 text-xs">
                <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                  <div>
                    <p className="font-mono font-bold text-royal-950 truncate max-w-lg">{sub.targetUrl}</p>
                    <div className="flex items-center gap-2 mt-1">
                      <span className="text-[10px] font-mono text-thistle-500">Signing Secret:</span>
                      <code className="text-[10px] font-mono font-bold bg-white px-1.5 py-0.5 rounded border border-gold-500/35 text-royal-800 select-all">
                        {sub.secret}
                      </code>
                    </div>
                  </div>

                  <div className="flex items-center gap-2 self-end sm:self-center">
                    <button
                      onClick={() => handleTestPing(sub.id)}
                      disabled={pingingId === sub.id}
                      className="px-3 py-1 bg-white border border-gold-500/35 hover:bg-thistle-100 text-royal-800 font-bold rounded-lg text-[11px] flex items-center gap-1"
                    >
                      <Icons.Bolt className="text-gold-600" />
                      <span>{pingingId === sub.id ? 'Pinging...' : 'Test Ping'}</span>
                    </button>
                    <button
                      onClick={() => handleInspect(sub.id)}
                      className="px-3 py-1 bg-white border border-gold-500/35 hover:bg-thistle-100 text-royal-700 font-bold rounded-lg text-[11px]"
                    >
                      Logs
                    </button>
                    <button
                      onClick={() => setDeleteTargetId(sub.id)}
                      className="text-thistle-500 hover:text-rose-600 font-bold text-xs p-1"
                    >
                      Delete
                    </button>
                  </div>
                </div>

                <div className="flex flex-wrap gap-1 pt-2 border-t border-gold-500/25">
                  {sub.events.map((ev) => (
                    <span key={ev} className="px-1.5 py-0.5 rounded text-[10px] font-mono bg-thistle-100 text-royal-800 border border-gold-500/25">
                      {ev}
                    </span>
                  ))}
                </div>

                {inspectingSubId === sub.id && (
                  <div className="mt-3 p-3 bg-white border border-gold-500/35 rounded-xl space-y-2 text-[11px] animate-in fade-in duration-100">
                    <div className="flex items-center justify-between pb-1 border-b border-gold-500/25">
                      <span className="font-bold uppercase text-thistle-500 text-[10px]">Recent Delivery Attempts</span>
                      <button onClick={() => setInspectingSubId(null)} className="text-thistle-500 hover:text-royal-950 text-[10px] flex items-center gap-1">
                        <Icons.Close />
                        <span>Close</span>
                      </button>
                    </div>

                    {loadingDeliveries ? (
                      <p className="py-2 text-center text-thistle-500">Loading deliveries...</p>
                    ) : deliveries.length === 0 ? (
                      <p className="py-2 text-center text-thistle-500">No delivery attempts recorded yet.</p>
                    ) : (
                      deliveries.map((d) => (
                        <div key={d.id} className="p-2 rounded-lg bg-thistle-50 border border-gold-500/25 flex items-center justify-between font-mono text-[10px]">
                          <div>
                            <span className="font-bold text-royal-950">{d.event}</span>
                            <span className="text-thistle-500 ml-2">{new Date(d.createdAt).toLocaleTimeString()}</span>
                            {d.error && <p className="text-rose-600 mt-0.5">{d.error}</p>}
                          </div>
                          <div className="flex items-center gap-2">
                            <span className={`font-bold px-1.5 py-0.2 rounded ${
                              d.status === 'DELIVERED' ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700'
                            }`}>
                              HTTP {d.statusCode || 'ERR'}
                            </span>
                            <span className="text-thistle-500">{d.durationMs}ms</span>
                          </div>
                        </div>
                      ))
                    )}
                  </div>
                )}
              </div>
            ))
          )}
        </div>
      </div>

      <ConfirmDialog
        isOpen={Boolean(deleteTargetId)}
        onClose={() => setDeleteTargetId(null)}
        onConfirm={handleConfirmDelete}
        title="Remove Webhook Endpoint"
        description="Outbound CRM event deliveries to this target URL will stop immediately."
        confirmLabel="Remove Endpoint"
        loading={deleting}
      />
    </div>
  );
};
</file>

<file path="src/components/townCrier/drawers/TownCrierAddRecipientDrawer.tsx">
import React, { useState } from 'react';
import { Sheet } from '../../common/Sheet';
import { townCrierAPI, getErrorMessage } from '../../../services/api';
import { useToast } from '../../../context/ToastContext';

interface TownCrierAddRecipientDrawerProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess: () => void;
}

export const TownCrierAddRecipientDrawer: React.FC<TownCrierAddRecipientDrawerProps> = ({
  isOpen,
  onClose,
  onSuccess,
}) => {
  const { toast } = useToast();
  const [newEmail, setNewEmail] = useState('');
  const [newName, setNewName] = useState('');
  const [newTags, setNewTags] = useState('newsletter');
  const [submittingRecipient, setSubmittingRecipient] = useState(false);

  const handleAddRecipient = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newEmail.trim()) return;

    setSubmittingRecipient(true);
    try {
      const tagsArray = newTags.split(/[,;]/).map((t) => t.trim()).filter(Boolean);
      await townCrierAPI.addRecipient(newEmail.trim(), newName.trim() || undefined, tagsArray);
      toast.success(`Subscribed ${newEmail.trim()}`, 'Subscriber Added');
      setNewEmail('');
      setNewName('');
      setNewTags('newsletter');
      onClose();
      onSuccess();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to add subscriber'), 'Error');
    } finally {
      setSubmittingRecipient(false);
    }
  };

  return (
    <Sheet
      isOpen={isOpen}
      onClose={onClose}
      title="Add Newsletter Subscriber"
      description="Add a single verified subscriber to your Town Crier audience."
      width="md"
    >
      <form onSubmit={handleAddRecipient} className="space-y-4">
        <div>
          <label className="block text-xs font-bold text-royal-800 uppercase mb-1">Subscriber Email *</label>
          <input
            type="email"
            value={newEmail}
            onChange={(e) => setNewEmail(e.target.value)}
            placeholder="subscriber@domain.com"
            required
            className="w-full px-3.5 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl text-xs font-mono focus:outline-none focus:border-gold-500"
          />
        </div>

        <div>
          <label className="block text-xs font-bold text-royal-800 uppercase mb-1">Subscriber Name (Optional)</label>
          <input
            type="text"
            value={newName}
            onChange={(e) => setNewName(e.target.value)}
            placeholder="John Doe"
            className="w-full px-3.5 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl text-xs focus:outline-none focus:border-gold-500"
          />
        </div>

        <div>
          <label className="block text-xs font-bold text-royal-800 uppercase mb-1">Tags (Comma-separated)</label>
          <input
            type="text"
            value={newTags}
            onChange={(e) => setNewTags(e.target.value)}
            placeholder="newsletter, web-signup"
            className="w-full px-3.5 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl text-xs font-mono focus:outline-none focus:border-gold-500"
          />
        </div>

        <div className="pt-3 border-t border-gold-500/35 flex justify-end gap-2">
          <button
            type="button"
            onClick={onClose}
            className="px-4 py-2 text-xs font-bold text-thistle-500 hover:text-royal-950"
          >
            Cancel
          </button>
          <button
            type="submit"
            disabled={submittingRecipient}
            className="px-5 py-2 btn-royal rounded-xl text-xs font-bold"
          >
            {submittingRecipient ? 'Adding...' : 'Subscribe'}
          </button>
        </div>
      </form>
    </Sheet>
  );
};
</file>

<file path="src/components/townCrier/drawers/TownCrierEmbedDrawer.tsx">
import React, { useState } from 'react';
import { Sheet } from '../../common/Sheet';
import { useToast } from '../../../context/ToastContext';
import { Icons } from '../../../lib/icons';

interface TownCrierEmbedDrawerProps {
  isOpen: boolean;
  onClose: () => void;
}

export const TownCrierEmbedDrawer: React.FC<TownCrierEmbedDrawerProps> = ({
  isOpen,
  onClose,
}) => {
  const { toast } = useToast();
  const [embedFrameworkTab, setEmbedFrameworkTab] = useState<'modal' | 'progressive' | 'universal' | 'nextjs' | 'node'>('modal');
  const [copiedSnippet, setCopiedSnippet] = useState<string | null>(null);

  const copyToClipboard = async (code: string, label: string) => {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(code);
      } else {
        const textarea = document.createElement('textarea');
        textarea.value = code;
        textarea.style.position = 'fixed';
        textarea.style.left = '-999999px';
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
      }
      setCopiedSnippet(label);
      toast.success(`${label} copied to clipboard!`, 'Copied');
      setTimeout(() => setCopiedSnippet(null), 2500);
    } catch {
      toast.error('Could not copy code to clipboard', 'Error');
    }
  };

  const origin = typeof window !== 'undefined' ? window.location.origin : 'https://midas-aem.vercel.app';

  const modalSnippet = `<!-- 1. Include Universal Script in <head> or <body> -->
<script src="${origin}/api/public/town-crier/widget.js" async></script>

<!-- 2. Modal Trigger with Gong Slug, Custom Accent & Dynamic Fields -->
<button 
  data-town-crier-modal 
  data-key="midas_live_YOUR_API_KEY"
  data-gong="weekly-alpha"
  data-fields="name,email,company,cadence"
  data-headline="Join 15,000+ Founders"
  data-subheadline="Choose your digest frequency and get our weekly growth playbook."
  data-accent="#4A2559"
  data-button="Get Instant Access"
  style="padding: 12px 24px; border-radius: 12px; background: #4A2559; color: #fff; font-weight: bold; border: none; cursor: pointer;">
  Subscribe (Opens Modal)
</button>`;

  const progressiveSnippet = `<!-- 1. Include Universal Script -->
<script src="${origin}/api/public/town-crier/widget.js" async></script>

<!-- 2. Progressive Profiling Trigger -->
<button 
  data-town-crier-modal 
  data-key="midas_live_YOUR_API_KEY"
  data-gong="weekly-alpha"
  data-fields="name,email,company,developer"
  data-headline="Join the Engineering Alpha"
  data-subheadline="Tell us if you are a developer to unlock technical repositories."
  data-accent="#4A2559">
  Progressive Profiling Modal
</button>`;

  const universalSnippet = `<!-- 1. Include Universal Widget Script -->
<script src="${origin}/api/public/town-crier/widget.js" async></script>

<!-- 2. Drop-in Inline Card (Shadow DOM isolated) -->
<div 
  data-town-crier-widget 
  data-key="midas_live_YOUR_API_KEY"
  data-gong="weekly-alpha"
  data-fields="name,email"
  data-theme="card" 
  data-accent="#4A2559"
  data-headline="Subscribe to Weekly Dispatch"
  data-subheadline="Deep dives on distributed systems and cold outreach architecture.">
</div>`;

  const nextJsSnippet = `// app/api/newsletter/route.ts (Next.js App Router)
import { NextResponse } from 'next/server';

export async function POST(req: Request) {
  const { email, name, company, cadence, metadata } = await req.json();

  const res = await fetch('${origin}/api/public/town-crier/subscribe', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer ' + process.env.MIDAS_API_KEY
    },
    body: JSON.stringify({
      email,
      name,
      gongId: 'weekly-alpha',
      cadence: cadence || 'weekly',
      metadata: { company, ...metadata },
      tags: ['nextjs_app_router']
    })
  });

  const data = await res.json();
  if (!res.ok) return NextResponse.json({ error: data.error }, { status: 400 });
  return NextResponse.json({ success: true, subscriber: data.subscriber });
}`;

  const nodeJsSnippet = `import { MidasClient } from '@midas-aem/client';

// Auto-detects process.env.MIDAS_API_KEY from environment
const client = new MidasClient();

await client.subscribe({
  email: 'prospect@acme.com',
  name: 'Alex Mercer',
  gongId: 'weekly-alpha',
  cadence: 'weekly',
  tags: ['enterprise', 'lead_magnet'],
  metadata: { company: 'Acme Corp', isDeveloper: true }
});`;

  const CodePanel = ({ filename, code, copyId }: { filename: string; code: string; copyId: string }) => (
    <div className="rounded-2xl border border-gold-500/45 bg-royal-950 overflow-hidden shadow-lg">
      <div className="flex items-center justify-between px-4 py-2.5 bg-royal-800/70 border-b border-gold-500/35">
        <span className="text-[11px] font-mono font-bold text-thistle-300">{filename}</span>
        <button
          type="button"
          onClick={() => copyToClipboard(code, copyId)}
          className="px-3 py-1 bg-royal-950 hover:bg-royal-700 text-thistle-100 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 border border-gold-500/35"
        >
          {copiedSnippet === copyId ? <Icons.CheckCircle className="text-emerald-400" /> : <Icons.Copy className="text-gold-400" />}
          <span>{copiedSnippet === copyId ? 'Copied!' : 'Copy'}</span>
        </button>
      </div>
      <pre className="p-4 text-thistle-100 font-mono text-[11px] overflow-x-auto whitespace-pre leading-relaxed select-all">
        {code}
      </pre>
    </div>
  );

  return (
    <Sheet
      isOpen={isOpen}
      onClose={onClose}
      title="Universal Town Crier Integration Suite"
      description="1-Click code snippets to integrate custom newsletter forms into any Next.js, Node.js, Vite, or web platform."
      width="2xl"
    >
      <div className="space-y-5 text-xs">
        <div className="flex border-b border-gold-500/35 gap-2 pb-2 overflow-x-auto">
          {[
            ['modal', '1. Click-to-Open Modal'],
            ['progressive', '2. Progressive Profiling'],
            ['universal', '3. Inline Card'],
            ['nextjs', '4. Next.js App Router'],
            ['node', '5. @midas-aem/client SDK'],
          ].map(([tabKey, label]) => (
            <button
              key={tabKey}
              onClick={() => setEmbedFrameworkTab(tabKey as any)}
              className={`text-xs font-bold px-3 py-1.5 rounded-lg transition-all whitespace-nowrap ${
                embedFrameworkTab === tabKey
                  ? 'bg-royal-700 text-white border border-gold-400/50 shadow-2xs'
                  : 'text-royal-800 hover:bg-thistle-100'
              }`}
            >
              {label}
            </button>
          ))}
        </div>

        {embedFrameworkTab === 'modal' && (
          <div className="space-y-3">
            <p className="text-royal-950/75">
              Renders an accessible modal overlay with hardware-accelerated animations and background blur:
            </p>
            <CodePanel filename="modal-custom-fields.html" code={modalSnippet} copyId="Modal Custom Fields Snippet" />
          </div>
        )}

        {embedFrameworkTab === 'progressive' && (
          <div className="space-y-3">
            <div className="p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-950 leading-relaxed">
              <span className="font-bold">Progressive Profiling:</span> Start with a minimal form and reveal conditional inputs (like GitHub URLs) when users toggle boolean switches.
            </div>
            <CodePanel filename="progressive-profiling.html" code={progressiveSnippet} copyId="Progressive Profiling Snippet" />
          </div>
        )}

        {embedFrameworkTab === 'universal' && (
          <div className="space-y-3">
            <p className="text-royal-950/75">
              Embeds a responsive newsletter signup card directly into your page layout (Shadow DOM isolated):
            </p>
            <CodePanel filename="index.html (Inline Widget)" code={universalSnippet} copyId="Universal HTML Embed" />
          </div>
        )}

