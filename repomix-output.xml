import React, { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { Icons } from '../lib/icons';

interface CommandAction {
  label: string;
  path: string;
  category: string;
  icon: React.ReactNode;
  keywords?: string;
}

interface CommandPaletteProps {
  isOpen: boolean;
  onClose: () => void;
  isAdmin?: boolean;
}

export const CommandPalette: React.FC<CommandPaletteProps> = ({ isOpen, onClose, isAdmin = false }) => {
  const navigate = useNavigate();
  const [query, setQuery] = useState('');

  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (isOpen) onClose();
      }
      if (e.key === 'Escape' && isOpen) {
        onClose();
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [isOpen, onClose]);

  if (!isOpen) return null;

  const actions: CommandAction[] = [
    { label: 'Overview & Lead Ingestion', path: '/', category: 'Navigation', icon: <Icons.Home />, keywords: 'home dashboard upload blocklist' },
    { label: 'Campaigns & Sequences', path: '/campaigns', category: 'Navigation', icon: <Icons.Campaigns />, keywords: 'sequences outreach emails cold sales' },
    { label: 'Unified Inbox', path: '/inbox', category: 'Navigation', icon: <Icons.Inbox />, keywords: 'replies unread triage messages conversations' },
    { label: 'Leads Command Hub', path: '/leads', category: 'Navigation', icon: <Icons.Leads />, keywords: 'contacts prospects list data imports' },
    { label: 'Sending Domains & Mailboxes', path: '/domains', category: 'Infrastructure', icon: <Icons.Domains />, keywords: 'domains mailboxes mailgun senders dmarc bimi' },
    { label: 'Sender Avatars & BIMI Setup', path: '/domains', category: 'Infrastructure', icon: <Icons.Image />, keywords: 'avatar logo bimi icon photo picture brand image' },
    { label: 'Town Crier Newsletter Hub', path: '/town-crier', category: 'Marketing', icon: <Icons.TownCrier />, keywords: 'broadcasts newsletter subscribers gongs embed widget' },
    { label: 'Developer Docs & API Reference', path: '/docs', category: 'Documentation', icon: <Icons.Book />, keywords: 'docs api guide sdk developer documentation manual integration help cli' },
    { label: 'Workspace API Keys', path: '/profile?tab=apiKeys', category: 'Developer', icon: <Icons.Key />, keywords: 'api keys secret token midas_live developer credentials' },
    { label: 'Outbound CRM Webhooks', path: '/profile?tab=webhooks', category: 'Developer', icon: <Icons.Link />, keywords: 'webhooks crm hubspot salesforce events integration' },
    { label: 'Account, AI Studio & Throttling', path: '/profile?tab=settings', category: 'Account', icon: <Icons.Settings />, keywords: 'settings limits quotas profile user password ai models' },
    ...(isAdmin ? [{ label: 'Platform Operator Command', path: '/admin', category: 'Administration', icon: <Icons.Admin />, keywords: 'admin operator circuit breaker clearance' }] : []),
  ];

  const q = query.toLowerCase().trim();
  const filtered = actions.filter((a) => {
    if (!q) return true;
    return a.label.toLowerCase().includes(q) || (a.keywords || '').toLowerCase().includes(q);
  });

  const handleSelect = (path: string) => {
    navigate(path);
    setQuery('');
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 overflow-y-auto p-4 sm:p-6 md:p-20">
      <div className="fixed inset-0 bg-royal-950/65 backdrop-blur-sm transition-opacity" onClick={onClose} />

      <div className="relative mx-auto max-w-xl bg-white rounded-2xl shadow-2xl border border-thistle-300 overflow-hidden transform transition-all animate-in zoom-in-95 duration-150">
        <div className="flex items-center px-4 border-b border-thistle-200 bg-thistle-50/70">
          <span className="text-thistle-500 mr-3">
            <Icons.Search />
          </span>
          <input
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Jump to workspace view, Developer Docs, or settings..."
            className="w-full py-4 text-sm text-royal-950 placeholder-thistle-500 bg-transparent focus:outline-none"
            autoFocus
          />
          <kbd className="hidden sm:inline-block px-2 py-0.5 text-[10px] font-bold text-royal-700 bg-white rounded border border-thistle-300">
            ESC
          </kbd>
        </div>

        <div className="max-h-80 overflow-y-auto p-2 space-y-1">
          {filtered.length === 0 ? (
            <p className="p-6 text-xs text-center text-thistle-500">No matching commands or routes found.</p>
          ) : (
            filtered.map((item, idx) => (
              <button
                key={idx}
                onClick={() => handleSelect(item.path)}
                className="w-full flex items-center justify-between p-3 rounded-xl hover:bg-thistle-100/80 border border-transparent hover:border-gold-400/50 text-left text-sm font-medium text-royal-950 hover:text-royal-700 transition-all group"
              >
                <span className="flex items-center gap-3">
                  <span className="text-thistle-500 group-hover:text-gold-600 transition-colors">{item.icon}</span>
                  <span>{item.label}</span>
                </span>
                <span className="text-[10px] uppercase font-bold text-royal-700 bg-thistle-100 group-hover:bg-gold-200/70 px-2 py-0.5 rounded border border-thistle-200">
                  {item.category}
                </span>
              </button>
            ))
          )}
        </div>
      </div>
    </div>
  );
};
</file>

<file path="src/components/domains/DomainCard.tsx">
import React, { useState } from 'react';
import { domainAPI, getErrorMessage } from '../../services/api';
import { useToast } from '../../context/ToastContext';
import { DomainSenderList } from './DomainSenderList';
import { ConfirmDialog } from '../common/ConfirmDialog';
import { Icons } from '../../lib/icons';

export interface DomainCardData {
  id: string;
  domainName: string;
  status: string;
  espProvider?: string;
  bounceRate: number;
  complaintRate: number;
  sendTestPassedAt: string | null;
  receivingConfirmedAt: string | null;
  receivingTestAddress: string | null;
  spfStatus?: boolean;
  dkimStatus?: boolean;
  mxStatus?: boolean;
  trackingStatus?: boolean;
  trackingDomain?: string | null;
  trackingHostnameStatus?: string | null;
  bimiEnabled: boolean;
  bimiSvgUrl: string | null;
  bimiVmcUrl: string | null;
  dmarcPolicy: string | null;
  keyDecryptionFailed?: boolean;
  senders: any[];
}

interface DomainCardProps {
  domain: DomainCardData;
  onOpenBimiDrawer: (domain: DomainCardData) => void;
  onRefresh: () => void;
  testRecipientEmail?: string;
}

export const DomainCard: React.FC<DomainCardProps> = ({
  domain,
  onOpenBimiDrawer,
  onRefresh,
  testRecipientEmail,
}) => {
  const { toast } = useToast();
  const [checkingReceiving, setCheckingReceiving] = useState(false);
  const [receivingState, setReceivingState] = useState<{ confirmed?: boolean; testAddress?: string; testCode?: string } | null>(null);
  const [confirmDeleteOpen, setConfirmDeleteOpen] = useState(false);
  const [deleting, setDeleting] = useState(false);

  const [inspectingDns, setInspectingDns] = useState(false);
  const [dnsReport, setDnsReport] = useState<any | null>(null);
  const [trackingFormOpen, setTrackingFormOpen] = useState(false);
  const [trackingInput, setTrackingInput] = useState(domain.trackingDomain || `track.${domain.domainName}`);
  const [savingTracking, setSavingTracking] = useState(false);

  const [snapshotsOpen, setSnapshotsOpen] = useState(false);
  const [snapshots, setSnapshots] = useState<any[]>([]);
  const [loadingSnapshots, setLoadingSnapshots] = useState(false);

  const isReceivingConfirmed = domain.receivingConfirmedAt || receivingState?.confirmed;

  const handleToggleSnapshots = async () => {
    const next = !snapshotsOpen;
    setSnapshotsOpen(next);
    if (next && snapshots.length === 0) {
      setLoadingSnapshots(true);
      try {
        const res = await domainAPI.getSnapshots(domain.id, 14);
        setSnapshots(res.data || []);
      } catch {
        toast.error('Failed to load daily health snapshots', 'Error');
      } finally {
        setLoadingSnapshots(false);
      }
    }
  };

  const handleInspectDns = async () => {
    setInspectingDns(true);
    try {
      const res = await domainAPI.inspectDns(domain.id);
      setDnsReport(res.data);
      toast.success('Authoritative DNS inspection complete', 'DNS Updated');
      onRefresh();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'DNS lookup failed'), 'DNS Error');
    } finally {
      setInspectingDns(false);
    }
  };

  const handleSaveTrackingDomain = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!trackingInput.trim()) return;
    setSavingTracking(true);
    try {
      const res = await domainAPI.setTrackingDomain(domain.id, trackingInput.trim());
      toast.success(
        `Tracking domain ${res.data.trackingDomain} saved. Point CNAME to ${res.data.expectedCnameTarget}`,
        'Tracking CNAME'
      );
      setTrackingFormOpen(false);
      onRefresh();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not configure tracking hostname'), 'Error');
    } finally {
      setSavingTracking(false);
    }
  };

  const handleRetrySendTest = async () => {
    try {
      await domainAPI.retrySendTest(domain.id, testRecipientEmail || undefined);
      toast.success('Live test send passed!', 'Verified');
      onRefresh();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Send test failed again'), 'Send Test Failed');
    }
  };

  const handleResetReceivingTest = async () => {
    try {
      await domainAPI.resetReceivingTest(domain.id);
      toast.info('New one-time verification code generated', 'Code Reset');
      onRefresh();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not reset the receiving test'), 'Error');
    }
  };

  const handleCheckReceiving = async () => {
    setCheckingReceiving(true);
    try {
      const res = await domainAPI.checkReceivingTest(domain.id);
      setReceivingState(res.data);
      if (res.data.confirmed) {
        toast.success('Inbound reply routing confirmed!', 'Domain Ready');
        onRefresh();
      } else {
        toast.info('Inbound test not yet detected. Ensure code was sent.', 'Pending');
      }
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not check receiving status'), 'Error');
    } finally {
      setCheckingReceiving(false);
    }
  };

  const handleConfirmDelete = async () => {
    setDeleting(true);
    try {
      await domainAPI.delete(domain.id);
      toast.info('Domain and mailboxes deleted', 'Deleted');
      setConfirmDeleteOpen(false);
      onRefresh();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not delete domain'), 'Error');
    } finally {
      setDeleting(false);
    }
  };

  return (
    <div className="card-midas rounded-2xl p-6 space-y-4">
      <div className="flex items-start justify-between gap-4 flex-wrap">
        <div className="space-y-1">
          <div className="flex items-center gap-3 flex-wrap">
            {domain.bimiEnabled && domain.bimiSvgUrl ? (
              <img
                src={domain.bimiSvgUrl}
                alt={`${domain.domainName} Avatar`}
                className="w-7 h-7 rounded-full border border-gold-500/60 object-cover bg-white shadow-2xs"
                onError={(e) => { e.currentTarget.style.display = 'none'; }}
              />
            ) : (
              <div className="w-7 h-7 rounded-full bg-royal-700 text-gold-300 font-bold text-xs flex items-center justify-center border border-gold-400/50">
                {domain.domainName.charAt(0).toUpperCase()}
              </div>
            )}

            <h3 className="text-xl font-bold text-royal-950 tracking-tight font-mono">{domain.domainName}</h3>
            <span className="px-2 py-0.5 rounded bg-thistle-100 text-royal-800 border border-gold-500/35 text-[10px] font-mono font-bold uppercase">
              {domain.espProvider || 'mailgun'}
            </span>
          </div>

          <div className="flex items-center gap-2 mt-2 text-xs flex-wrap pt-1">
            <span className={`px-2.5 py-0.5 rounded-full font-bold text-[10px] border ${
              domain.sendTestPassedAt
                ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                : 'bg-rose-50 text-rose-700 border-rose-200'
            }`}>
              Outbound: {domain.sendTestPassedAt ? 'VERIFIED' : 'FAILED'}
            </span>
            <span className={`px-2.5 py-0.5 rounded-full font-bold text-[10px] border ${
              isReceivingConfirmed
                ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                : 'bg-amber-50 text-amber-800 border-gold-400/50'
            }`}>
              Replies: {isReceivingConfirmed ? 'VERIFIED' : 'PENDING CODE'}
            </span>
            <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${
              domain.bimiEnabled
                ? 'bg-thistle-100 text-royal-800 border-gold-500/45'
                : 'bg-thistle-50 text-thistle-500 border-gold-500/25'
            }`}>
              Avatar: {domain.bimiEnabled ? 'ACTIVE (BIMI)' : 'NOT CONFIGURED'}
            </span>
            <span className="text-thistle-500 ml-2">Bounce rate: {(domain.bounceRate * 100).toFixed(1)}%</span>
          </div>
        </div>

        <div className="flex items-center gap-2 flex-wrap">
          <button
            onClick={handleToggleSnapshots}
            className="px-3 py-1.5 bg-white hover:bg-thistle-100 border border-gold-500/40 text-royal-800 rounded-xl text-xs font-bold"
          >
            {snapshotsOpen ? 'Hide Trends' : 'Health Trends (14d)'}
          </button>

          <button
            onClick={handleInspectDns}
            disabled={inspectingDns}
            className="px-3 py-1.5 bg-white hover:bg-thistle-100 border border-gold-500/40 text-royal-800 rounded-xl text-xs font-bold flex items-center gap-1.5"
          >
            <Icons.Refresh className={inspectingDns ? 'animate-spin text-gold-600' : 'text-gold-600'} />
            <span>{inspectingDns ? 'Scanning DNS...' : 'Verify DNS'}</span>
          </button>

          <button
            onClick={() => onOpenBimiDrawer(domain)}
            className="px-3.5 py-1.5 btn-royal rounded-xl text-xs font-bold flex items-center gap-1.5"
          >
            <Icons.Image className="text-gold-300" />
            <span>{domain.bimiEnabled ? 'Manage Avatar' : 'Setup Avatar'}</span>
          </button>

          <button
            onClick={() => setConfirmDeleteOpen(true)}
            className="px-3 py-1.5 text-rose-600 hover:bg-rose-50 rounded-xl text-xs font-bold transition-colors flex items-center gap-1"
          >
            <Icons.Trash />
            <span>Delete</span>
          </button>
        </div>
      </div>

      {/* Authoritative DNS & Custom Tracking Bar */}
      <div className="p-3 bg-thistle-50/70 border border-gold-500/35 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-[11px]">
        <div className="flex items-center gap-2 flex-wrap">
          <span className="text-[10px] font-bold uppercase text-thistle-500">DNS Records:</span>
          {[
            ['SPF', domain.spfStatus],
            ['DKIM', domain.dkimStatus],
            ['MX', domain.mxStatus],
            ['DMARC', domain.dmarcPolicy && domain.dmarcPolicy !== 'missing'],
            ['Tracking CNAME', domain.trackingStatus],
          ].map(([label, ok]) => (
            <span
              key={label as string}
              className={`px-2 py-0.5 rounded font-mono font-bold border ${
                ok
                  ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                  : 'bg-white text-thistle-500 border-gold-500/30'
              }`}
            >
              {label as string}: {ok ? 'OK' : 'UNSET'}
            </span>
          ))}
        </div>

        <button
          type="button"
          onClick={() => setTrackingFormOpen((prev) => !prev)}
          className="text-xs font-bold text-royal-700 hover:underline whitespace-nowrap"
        >
          {domain.trackingDomain ? `Tracking: ${domain.trackingDomain}` : '+ Custom Tracking CNAME'}
        </button>
      </div>

      {snapshotsOpen && (
        <div className="p-4 bg-thistle-50/70 border border-gold-500/35 rounded-xl space-y-2 text-xs">
          <p className="font-bold text-royal-950">Daily Deliverability Snapshots (Human Opens vs Bounces)</p>
          {loadingSnapshots ? (
            <p className="text-thistle-500">Loading snapshots...</p>
          ) : snapshots.length === 0 ? (
            <p className="text-thistle-500 italic">No daily snapshots recorded yet (runs via /api/cron/snapshots).</p>
          ) : (
            <div className="overflow-x-auto bg-white border border-gold-500/35 rounded-lg">
              <table className="min-w-full divide-y divide-gold-500/20 text-[11px] font-mono">
                <thead className="bg-thistle-100/75 text-royal-800">
                  <tr>
                    <th className="py-1.5 px-3 text-left">Date</th>
                    <th className="py-1.5 px-3 text-right">Sent</th>
                    <th className="py-1.5 px-3 text-right">Human Opens</th>
                    <th className="py-1.5 px-3 text-right">Clicks</th>
                    <th className="py-1.5 px-3 text-right">Replies</th>
                    <th className="py-1.5 px-3 text-right">Bounces</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gold-500/15">
                  {snapshots.map((snap) => (
                    <tr key={snap.id}>
                      <td className="py-1.5 px-3">{snap.snapshotDate}</td>
                      <td className="py-1.5 px-3 text-right font-bold">{snap.sentCount}</td>
                      <td className="py-1.5 px-3 text-right text-royal-700">{snap.humanOpenCount}</td>
                      <td className="py-1.5 px-3 text-right">{snap.clickCount}</td>
                      <td className="py-1.5 px-3 text-right text-emerald-700">{snap.replyCount}</td>
                      <td className="py-1.5 px-3 text-right text-rose-600">{snap.bounceCount}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      )}

      {dnsReport && (
        <div className="p-3.5 bg-white border border-gold-500/40 rounded-xl text-[11px] space-y-1.5">
          <p className="font-bold text-royal-950">Live Authoritative DNS Lookup Results</p>
          <p className="font-mono text-thistle-500 truncate">SPF: {dnsReport.spf.record || 'Not published'}</p>
          <p className="font-mono text-thistle-500 truncate">
            DKIM: {dnsReport.dkim.verified ? `Selector "${dnsReport.dkim.matchedSelector}" verified` : 'No standard selector found'}
          </p>
          <p className="font-mono text-thistle-500 truncate">
            DMARC: {dnsReport.dmarc.record || 'Missing _dmarc TXT record'}
          </p>
        </div>
      )}

      {trackingFormOpen && (
        <form onSubmit={handleSaveTrackingDomain} className="p-3.5 bg-thistle-50 border border-gold-500/40 rounded-xl flex flex-wrap items-end gap-3 text-xs">
          <div className="flex-1 min-w-[200px]">
            <label className="block text-[10px] font-bold uppercase text-thistle-500 mb-1">
              Custom Tracking Hostname (CNAME Target)
            </label>
            <input
              type="text"
              value={trackingInput}
              onChange={(e) => setTrackingInput(e.target.value)}
              placeholder={`track.${domain.domainName}`}
              className="w-full px-3 py-1.5 bg-white border border-gold-500/40 rounded-lg font-mono text-xs focus:outline-none focus:border-gold-500"
            />
          </div>
          <button type="submit" disabled={savingTracking} className="px-4 py-1.5 btn-royal rounded-lg text-xs font-bold">
            {savingTracking ? 'Saving...' : 'Save Tracking CNAME'}
          </button>
        </form>
      )}

      {domain.keyDecryptionFailed && (
        <div className="p-3.5 bg-rose-50 border border-rose-300 rounded-xl text-xs text-rose-900 flex items-center gap-2.5">
          <Icons.Warning className="text-rose-600" />
          <span>
            <strong>Credential Unreadable:</strong> Stored API key failed decryption (<code className="font-mono">ENCRYPTION_KEY</code> may have rotated). Delete and reconnect this domain to resume sends.
          </span>
        </div>
      )}

      {!domain.sendTestPassedAt && (
        <div className="p-4 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <p className="font-bold">The test send failed for this domain.</p>
            <p className="opacity-90 mt-0.5">Ensure the domain matches Mailgun and the API key matches the configured region.</p>
          </div>
          <button
            onClick={handleRetrySendTest}
            className="px-4 py-1.5 bg-rose-600 text-white rounded-lg text-xs font-bold hover:bg-rose-700 transition-colors whitespace-nowrap"
          >
            Retry Test Send
          </button>
        </div>
      )}

      {domain.sendTestPassedAt && !isReceivingConfirmed && (domain.espProvider || 'mailgun') === 'mailgun' && (
        <div className="p-4 bg-thistle-50 border border-gold-500/40 rounded-xl text-xs text-royal-950 space-y-2">
          <p className="font-bold text-royal-800">Step 2: Confirm Inbound Reply Routing</p>
          <p className="text-royal-950/75">
            Send an email from an external inbox to{' '}
            <code className="bg-white px-1.5 py-0.5 rounded border border-gold-500/35 font-mono font-bold">
              {receivingState?.testAddress || domain.receivingTestAddress}
            </code>{' '}
            with this code in the message:{' '}
            <code className="bg-white px-1.5 py-0.5 rounded border border-gold-500/35 font-mono font-bold text-royal-700">
              {receivingState?.testCode || '(click Check Status to load)'}
            </code>
          </p>
          <div className="flex gap-2 pt-1">
            <button
              onClick={handleCheckReceiving}
              disabled={checkingReceiving}
              className="px-3.5 py-1.5 btn-royal rounded-lg text-xs font-bold"
            >
              {checkingReceiving ? 'Verifying...' : 'Check Status'}
            </button>
            <button
              onClick={handleResetReceivingTest}
              className="px-3.5 py-1.5 bg-white border border-gold-500/35 text-royal-800 rounded-lg text-xs font-bold hover:bg-thistle-100"
            >
              Regenerate Code
            </button>
          </div>
        </div>
      )}

      <DomainSenderList
        domainId={domain.id}
        domainName={domain.domainName}
        sendTestPassedAt={domain.sendTestPassedAt}
        senders={domain.senders || []}
        onRefresh={onRefresh}
      />

      <ConfirmDialog
        isOpen={confirmDeleteOpen}
        onClose={() => setConfirmDeleteOpen(false)}
        onConfirm={handleConfirmDelete}
        title={`Delete Domain "${domain.domainName}"`}
        description="All associated mailbox senders and campaign linkages will be permanently removed."
        confirmLabel="Delete Domain"
        loading={deleting}
      />
    </div>
  );
};
</file>

<file path="src/components/leads/LeadDrawer.tsx">
import React, { useEffect, useState } from 'react';
import { Sheet } from '../common/Sheet';
import { campaignAPI, leadAPI, getErrorMessage } from '../../services/api';
import { useToast } from '../../context/ToastContext';
import { Lead } from '../../types/lead';
import { Icons } from '../../lib/icons';

interface LeadDrawerProps {
  isOpen: boolean;
  onClose: () => void;
  lead: Lead | null;
  campaignId?: string;
  onUpdate?: () => void;
}

export const LeadDrawer: React.FC<LeadDrawerProps> = ({
  isOpen,
  onClose,
  lead,
  campaignId,
  onUpdate,
}) => {
  const { toast } = useToast();
  const [thread, setThread] = useState<any[]>([]);
  const [scheduledEmails, setScheduledEmails] = useState<any[]>([]);
  const [replyDraft, setReplyDraft] = useState<any | null>(null);
  const [loading, setLoading] = useState(false);
  const [generating, setGenerating] = useState(false);
  const [sending, setSending] = useState(false);

  const [enriched, setEnriched] = useState<Lead['enrichedData'] | null>(null);
  const [enriching, setEnriching] = useState(false);

  const [editingScheduledId, setEditingScheduledId] = useState<string | null>(null);
  const [editSubject, setEditSubject] = useState('');
  const [editBody, setEditBody] = useState('');
  const [savingScheduled, setSavingScheduled] = useState(false);
  const [sendingNowId, setSendingNowId] = useState<string | null>(null);

  const activeCampaignId = campaignId || lead?.campaignId || undefined;

  const loadData = () => {
    if (!isOpen || !lead) return;
    setEnriched(lead.enrichedData || null);

    if (!activeCampaignId) return;
    setLoading(true);
    Promise.all([
      campaignAPI.getLeadThread(activeCampaignId, lead.id),
      campaignAPI.getReplyDraft(activeCampaignId, lead.id).catch(() => null),
    ])
      .then(([threadRes, draftRes]) => {
        setThread(threadRes.data?.emails || []);
        setScheduledEmails(threadRes.data?.scheduled || []);
        setReplyDraft(draftRes?.data || null);
      })
      .catch(() => {
        toast.error('Failed to load conversation history', 'Network Error');
      })
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    loadData();
  }, [isOpen, lead, activeCampaignId]);

  const handleEnrichLead = async () => {
    if (!lead) return;
    setEnriching(true);
    try {
      const res = await leadAPI.enrich(lead.id);
      setEnriched(res.data?.enrichedData || null);
      toast.success('Lead enriched with corporate insights (2 AI credits)', 'Enriched');
      if (onUpdate) onUpdate();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Lead enrichment failed'), 'AI Credit / Enrichment Error');
    } finally {
      setEnriching(false);
    }
  };

  const handleStartEditScheduled = (item: any) => {
    setEditingScheduledId(item.id);
    setEditSubject(item.rawSubject);
    setEditBody(item.rawBody);
  };

  const handleSaveScheduled = async (pendingId: string) => {
    if (!editSubject.trim() || !editBody.trim() || !activeCampaignId) return;
    setSavingScheduled(true);
    try {
      await campaignAPI.updateScheduledEmail(activeCampaignId, pendingId, {
        subject: editSubject.trim(),
        body: editBody.trim(),
      });
      toast.success('Scheduled email updated', 'Saved');
      setEditingScheduledId(null);
      loadData();
    } catch {
      toast.error('Could not save scheduled email', 'Error');
    } finally {
      setSavingScheduled(false);
    }
  };

  const handleSendNow = async (pendingId: string) => {
    if (!activeCampaignId) return;
    setSendingNowId(pendingId);
    try {
      await campaignAPI.sendScheduledEmailNow(activeCampaignId, pendingId);
      toast.success('Email dispatched immediately', 'Sent');
      loadData();
      if (onUpdate) onUpdate();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to dispatch email'), 'Send Error');
    } finally {
      setSendingNowId(null);
    }
  };

  const handleGenerateReply = async () => {
    if (!lead || !activeCampaignId) return;
    setGenerating(true);
    try {
      const res = await campaignAPI.generateReplyDraft(activeCampaignId, lead.id);
      setReplyDraft(res.data);
      toast.success('AI reply drafted successfully', 'Copilot');
    } catch {
      toast.error('Could not generate AI reply draft', 'Error');
    } finally {
      setGenerating(false);
    }
  };

  const handleSendReply = async () => {
    if (!lead || !activeCampaignId || !replyDraft) return;
    setSending(true);
    try {
      await campaignAPI.sendReplyDraft(activeCampaignId, lead.id, {
        subject: replyDraft.subject,
        body: replyDraft.body,
      });
      toast.success(`Reply sent to ${lead.email}`, 'Dispatched');
      setReplyDraft(null);
      loadData();
      if (onUpdate) onUpdate();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to dispatch reply'), 'Send Error');
    } finally {
      setSending(false);
    }
  };

  if (!lead) return null;

  return (
    <Sheet
      isOpen={isOpen}
      onClose={onClose}
      title={lead.name}
      description={`${lead.email} · ${lead.company || 'No Company'} · ${lead.position || 'No Title'}`}
      width="xl"
    >
      <div className="space-y-6">
        <div className="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-gold-500/35">
          <div className="flex flex-wrap gap-2">
            <span className="px-2.5 py-1 text-xs font-semibold rounded-lg bg-thistle-100 text-royal-950 border border-gold-500/30">
              Status: {lead.status}
            </span>
            <span className="px-2.5 py-1 text-xs font-semibold rounded-lg bg-royal-700 text-white">
              Outreach: {lead.outreachStatus || 'UNCONTACTED'}
            </span>
          </div>

          <button
            type="button"
            onClick={handleEnrichLead}
            disabled={enriching}
            className="px-3.5 py-1.5 btn-royal rounded-xl text-xs font-bold flex items-center gap-1.5"
          >
            <Icons.Sparkles className="text-gold-300" />
            <span>{enriching ? 'Enriching...' : enriched ? 'Re-Enrich (2 Credits)' : 'Enrich Lead (2 Credits)'}</span>
          </button>
        </div>

        {/* Enriched Corporate Intelligence */}
        {enriched && (
          <div className="p-4 bg-thistle-50/80 border border-gold-500/45 rounded-2xl space-y-2 text-xs">
            <div className="flex items-center justify-between">
              <span className="text-[10px] font-black uppercase tracking-wider text-royal-700">AI Lead Intelligence</span>
              {enriched.industry && (
                <span className="px-2 py-0.5 rounded bg-white border border-gold-500/30 text-[10px] font-bold text-royal-800">
                  {enriched.industry}
                </span>
              )}
            </div>
            {enriched.companySummary && <p className="text-royal-950/85 leading-relaxed">{enriched.companySummary}</p>}
            {enriched.personalizationHook && (
              <div className="p-2.5 bg-white border border-gold-500/35 rounded-xl">
                <span className="text-[10px] font-bold uppercase text-thistle-500 block">Outreach Opener Hook</span>
                <p className="font-medium text-royal-950 mt-0.5">{enriched.personalizationHook}</p>
              </div>
            )}
            {enriched.likelyPainPoints && enriched.likelyPainPoints.length > 0 && (
              <div className="flex flex-wrap gap-1.5 pt-1">
                {enriched.likelyPainPoints.map((p, idx) => (
                  <span key={idx} className="px-2 py-0.5 rounded bg-thistle-100 text-royal-800 border border-gold-500/30 text-[10px]">
                    {p}
                  </span>
                ))}
              </div>
            )}
          </div>
        )}

        {scheduledEmails.length > 0 && (
          <div className="space-y-3">
            <span className="text-xs font-bold uppercase tracking-wider text-amber-800 flex items-center gap-1.5">
              <span className="w-2 h-2 rounded-full bg-gold-500 animate-pulse" />
              Scheduled Dispatch ({scheduledEmails.length})
            </span>

            {scheduledEmails.map((item) => {
              const isEditing = editingScheduledId === item.id;
              const isSending = sendingNowId === item.id;

              return (
                <div key={item.id} className="p-4 rounded-2xl bg-amber-50/60 border border-gold-500/45 space-y-3 text-xs">
                  <div className="flex items-center justify-between pb-2 border-b border-gold-500/35">
                    <span className="font-bold text-amber-950 text-[11px]">
                      {isEditing ? 'Editing Template' : 'Resolved Live Preview'}
                    </span>

                    <div className="flex items-center gap-2">
                      {!isEditing ? (
                        <>
                          <button
                            onClick={() => handleStartEditScheduled(item)}
                            className="px-2.5 py-1 bg-white hover:bg-thistle-100 text-royal-800 font-bold rounded-lg border border-gold-500/35 text-[10px]"
                          >
                            Edit
                          </button>
                          <button
                            onClick={() => handleSendNow(item.id)}
                            disabled={isSending}
                            className="px-3 py-1 btn-royal font-bold rounded-lg text-[10px] flex items-center gap-1"
                          >
                            <Icons.Send className="text-gold-300 text-[11px]" />
                            <span>{isSending ? 'Sending...' : 'Send Now'}</span>
                          </button>
                        </>
                      ) : (
                        <div className="flex gap-1.5">
                          <button onClick={() => setEditingScheduledId(null)} className="px-2.5 py-1 text-thistle-500 text-[10px]">
                            Cancel
                          </button>
                          <button onClick={() => handleSaveScheduled(item.id)} disabled={savingScheduled} className="px-3 py-1 btn-royal font-bold rounded-lg text-[10px]">
                            {savingScheduled ? 'Saving...' : 'Save'}
                          </button>
                        </div>
                      )}
                    </div>
                  </div>

                  {isEditing ? (
                    <div className="space-y-2">
                      <input
                        type="text"
                        value={editSubject}
                        onChange={(e) => setEditSubject(e.target.value)}
                        className="w-full px-3 py-1.5 bg-white border border-gold-500/40 rounded-lg text-xs font-mono"
                      />
                      <textarea
                        rows={6}
                        value={editBody}
                        onChange={(e) => setEditBody(e.target.value)}
                        className="w-full p-3 bg-white border border-gold-500/40 rounded-lg text-xs font-mono"
                      />
                    </div>
                  ) : (
                    <div className="space-y-1">
                      <p className="font-bold text-royal-950">{item.resolvedSubject}</p>
                      <p className="whitespace-pre-wrap leading-relaxed text-royal-950/80">{item.resolvedBody}</p>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}

        <div>
          <h3 className="text-xs font-bold uppercase tracking-wider text-thistle-500 mb-3">Conversation Stream</h3>
          {loading ? (
            <div className="py-12 text-center text-xs text-thistle-500">Loading conversation history...</div>
          ) : thread.length === 0 && scheduledEmails.length === 0 ? (
            <div className="p-6 text-center rounded-xl bg-thistle-50 border border-gold-500/30 text-xs text-thistle-500">
              No emails sent or queued yet for this lead.
            </div>
          ) : (
            <div className="space-y-3">
              {thread.map((msg) => (
                <div
                  key={msg.id}
                  className={`p-4 rounded-2xl text-xs space-y-1.5 ${
                    msg.isIncoming
                      ? 'bg-thistle-50 border border-gold-500/40 text-royal-950 mr-6'
                      : 'bg-royal-700 text-white border border-gold-400/50 ml-6 shadow-sm'
                  }`}
                >
                  <div className="flex items-center justify-between opacity-80 text-[10px] pb-1 border-b border-gold-500/30">
                    <span className="font-bold">{msg.isIncoming ? 'Prospect Reply' : 'Outbound Dispatch'}</span>
                    <span>{new Date(msg.sentAt).toLocaleString()}</span>
                  </div>
                  <p className="font-bold pt-0.5">{msg.subject}</p>
                  <p className="whitespace-pre-wrap leading-relaxed opacity-95">{msg.body}</p>
                </div>
              ))}
            </div>
          )}
        </div>

        {activeCampaignId && (
          <div className="pt-4 border-t border-gold-500/35">
            <div className="flex items-center justify-between mb-3">
              <span className="text-xs font-bold uppercase tracking-wider text-royal-800">AI Response Copilot</span>
              {!replyDraft && (
                <button
                  onClick={handleGenerateReply}
                  disabled={generating}
                  className="px-3 py-1.5 btn-royal text-xs font-bold rounded-lg flex items-center gap-1.5"
                >
                  <Icons.Sparkles className="text-gold-300" />
                  <span>{generating ? 'Drafting...' : 'Generate Smart Reply'}</span>
                </button>
              )}
            </div>

            {replyDraft && (
              <div className="p-4 bg-thistle-100/70 border border-gold-500/45 rounded-2xl space-y-3">
                <div>
                  <p className="text-[10px] font-bold uppercase text-royal-700">Subject</p>
                  <p className="text-xs font-semibold text-royal-950">{replyDraft.subject}</p>
                </div>
                <div>
                  <p className="text-[10px] font-bold uppercase text-royal-700">Body</p>
                  <p className="text-xs text-royal-950/85 whitespace-pre-wrap">{replyDraft.body}</p>
                </div>
                <div className="flex justify-end gap-2 pt-2 border-t border-gold-500/35">
                  <button onClick={() => setReplyDraft(null)} className="px-3 py-1 text-xs text-thistle-500 font-bold">
                    Discard
                  </button>
                  <button onClick={handleSendReply} disabled={sending} className="px-4 py-1.5 btn-royal text-xs font-bold rounded-lg">
                    {sending ? 'Sending...' : 'Approve & Send Reply'}
                  </button>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </Sheet>
  );
};
</file>

<file path="src/components/townCrier/drawers/TownCrierComposerDrawer.tsx">
import React, { useState, useEffect } from 'react';
import { Sheet } from '../../common/Sheet';
import { townCrierAPI, knowledgeAPI, getErrorMessage } from '../../../services/api';
import { useToast } from '../../../context/ToastContext';
import { ArtifactsPanel } from '../../artifacts/ArtifactsPanel';

interface TownCrierComposerDrawerProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess: () => void;
  gongs?: any[];
}

export const TownCrierComposerDrawer: React.FC<TownCrierComposerDrawerProps> = ({
  isOpen,
  onClose,
  onSuccess,
  gongs = [],
}) => {
  const { toast } = useToast();
  const [broadcastSubject, setBroadcastSubject] = useState('');
  const [broadcastBody, setBroadcastBody] = useState('');
  const [selectedGongId, setSelectedGongId] = useState('');
  const [selectedKbId, setSelectedKbId] = useState('');
  const [knowledgeBases, setKnowledgeBases] = useState<any[]>([]);
  const [templateStyle, setTemplateStyle] = useState<'card' | 'editorial' | 'minimal' | 'plain'>('card');
  const [broadcastTagFilter, setBroadcastTagFilter] = useState('');
  const [savingBroadcast, setSavingBroadcast] = useState(false);

  useEffect(() => {
    if (isOpen) {
      knowledgeAPI
        .listBases()
        .then((res) => setKnowledgeBases(res.data || []))
        .catch(() => {});
    }
  }, [isOpen]);

  const handleCreateBroadcast = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!broadcastSubject.trim() || !broadcastBody.trim()) return;

    setSavingBroadcast(true);
    try {
      await townCrierAPI.createBroadcast({
        subject: broadcastSubject.trim(),
        body: broadcastBody.trim(),
        gongId: selectedGongId || undefined,
        knowledgeBaseId: selectedKbId || undefined,
        tagFilter: broadcastTagFilter.trim() || undefined,
        templateStyle,
      });
      toast.success('Broadcast created as Draft', 'Saved');
      setBroadcastSubject('');
      setBroadcastBody('');
      setSelectedGongId('');
      setSelectedKbId('');
      setBroadcastTagFilter('');
      setTemplateStyle('card');
      onClose();
      onSuccess();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not create broadcast'), 'Error');
    } finally {
      setSavingBroadcast(false);
    }
  };

  return (
    <Sheet
      isOpen={isOpen}
      onClose={onClose}
      title="Compose Newsletter Broadcast"
      description="Stage a newsletter edition. Dispatched via paced 5-send batches to protect domain reputation."
      width="xl"
    >
      <form onSubmit={handleCreateBroadcast} className="space-y-4 text-xs">
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Target Newsletter Channel</label>
            <select
              value={selectedGongId}
              onChange={(e) => setSelectedGongId(e.target.value)}
              className="w-full px-3.5 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl font-bold text-royal-950 focus:outline-none focus:border-gold-500"
            >
              <option value="">-- All Active Subscribers --</option>
              {gongs.map((g) => (
                <option key={g.id} value={g.id}>
                  {g.name} (/{g.slug} · {g.cadence?.toUpperCase() || 'WEEKLY'})
                </option>
              ))}
            </select>
          </div>

          <div>
            <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Knowledge Base Override</label>
            <select
              value={selectedKbId}
              onChange={(e) => setSelectedKbId(e.target.value)}
              className="w-full px-3.5 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl font-semibold text-royal-950 focus:outline-none focus:border-gold-500"
            >
              <option value="">-- Channel / Workspace Default --</option>
              {knowledgeBases.map((kb) => (
                <option key={kb.id} value={kb.id}>
                  {kb.name} ({kb.resources?.length || 0} resources)
                </option>
              ))}
            </select>
          </div>
        </div>

        <ArtifactsPanel gongId={selectedGongId || undefined} compact />

        <div>
          <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">
            Email Layout Design (Card Enabled by Default)
          </label>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
            {[
              ['card', 'Card Envelope', 'Centered 580px rounded box'],
              ['editorial', 'Editorial', 'Substack/Beehiiv publication'],
              ['minimal', 'Clean Minimal', 'Accent line & header'],
              ['plain', 'Conversational', 'Raw HTML format'],
            ].map(([id, label, desc]) => (
              <button
                key={id}
                type="button"
                onClick={() => setTemplateStyle(id as any)}
                className={`p-2.5 rounded-xl border text-left transition-all ${
                  templateStyle === id
                    ? 'border-gold-500 bg-thistle-100 text-royal-950 shadow-2xs font-bold'
                    : 'border-gold-500/35 bg-white hover:bg-thistle-50 text-royal-800'
                }`}
              >
                <p className="text-xs">{label}</p>
                <p className="text-[10px] text-thistle-500 font-normal mt-0.5">{desc}</p>
              </button>
            ))}
          </div>
        </div>

        <div>
          <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Broadcast Subject Line *</label>
          <input
            type="text"
            value={broadcastSubject}
            onChange={(e) => setBroadcastSubject(e.target.value)}
            placeholder="e.g. Issue #42: Scaling Outbound Infrastructure"
            required
            className="w-full px-3.5 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl font-medium focus:outline-none focus:border-gold-500"
          />
        </div>

        <div>
          <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Subscriber Tag Filter (Optional)</label>
          <input
            type="text"
            value={broadcastTagFilter}
            onChange={(e) => setBroadcastTagFilter(e.target.value)}
            placeholder="e.g. vip, webflow (leave blank for all channel subscribers)"
            className="w-full px-3.5 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl font-mono text-[11px] focus:outline-none focus:border-gold-500"
          />
        </div>

        <div>
          <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Newsletter Body (Mustache, Spintax &amp; {'{{artifact:slug}}'} Enabled)</label>
          <textarea
            rows={10}
            value={broadcastBody}
            onChange={(e) => setBroadcastBody(e.target.value)}
            placeholder="Write your newsletter edition here..."
            required
            className="w-full p-3.5 bg-thistle-50 border border-gold-500/40 rounded-xl font-sans focus:outline-none focus:border-gold-500 text-xs leading-relaxed"
          />
        </div>

        <div className="pt-3 border-t border-gold-500/35 flex justify-end gap-2">
          <button type="button" onClick={onClose} className="px-4 py-2 font-bold text-thistle-500 hover:text-royal-950">
            Cancel
          </button>
          <button type="submit" disabled={savingBroadcast} className="px-5 py-2 btn-royal font-bold rounded-xl">
            {savingBroadcast ? 'Saving Draft...' : 'Save Broadcast Draft'}
          </button>
        </div>
      </form>
    </Sheet>
  );
};
</file>

