router.post('/gongs', requireApiKeyScope('town_crier:write'), async (req: Request, res: Response) => {
  const apiReq = req as ApiKeyRequest;
  const userId = apiReq.apiUser!.id;
  const {
    name,
    slug,
    description,
    cadence = 'weekly',
    templateStyle = 'card',
    welcomeEmailEnabled = false,
    welcomeSubject,
    welcomeBody,
    embedTheme = 'minimal',
    accentColor = '#4A2559',
    headline = 'Join our newsletter',
    buttonText = 'Subscribe',
  } = req.body;

  if (!name?.trim()) {
    return res.status(400).json({ error: 'Gong channel name is required' });
  }

  const generatedSlug = (slug || name)
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9_-]/g, '-');

  try {
    const gong = await prisma.gong.create({
      data: {
        userId,
        name: name.trim(),
        slug: generatedSlug,
        description: description?.trim() || null,
        cadence: ['daily', 'weekly', 'biweekly', 'monthly'].includes(cadence) ? cadence : 'weekly',
        templateStyle: ['card', 'editorial', 'minimal', 'plain'].includes(templateStyle) ? templateStyle : 'card',
        welcomeEmailEnabled: Boolean(welcomeEmailEnabled),
        welcomeSubject: welcomeSubject?.trim() || null,
        welcomeBody: welcomeBody?.trim() || null,
        embedTheme,
        accentColor,
        headline,
        buttonText,
      },
    });

    res.status(201).json({ success: true, gong });
  } catch (error: any) {
    res.status(400).json({ error: error.message || 'Failed to create Gong channel' });
  }
});

router.post('/gongs/:id/broadcast', requireApiKeyScope('town_crier:send'), async (req: Request, res: Response) => {
  const apiReq = req as ApiKeyRequest;
  const userId = apiReq.apiUser!.id;
  const { id } = req.params;
  const { subject, body, templateStyle, tagFilter } = req.body;

  if (!subject?.trim() || !body?.trim()) {
    return res.status(400).json({ error: 'Subject and body are required' });
  }

  try {
    const gong = await prisma.gong.findFirst({
      where: {
        userId,
        OR: [{ id }, { slug: id.toLowerCase().trim() }],
      },
    });
    if (!gong) return res.status(404).json({ error: 'Gong channel not found' });

    const cleanTag = tagFilter?.trim() || null;

    const broadcast = await prisma.newsletterBroadcast.create({
      data: {
        userId,
        gongId: gong.id,
        subject: subject.trim(),
        body: body.trim(),
        templateStyle: templateStyle || gong.templateStyle || 'card',
        tagFilter: cleanTag,
        status: 'QUEUED',
        queuedAt: new Date(),
      },
    });

    const recipients = await prisma.newsletterRecipient.findMany({
      where: {
        userId,
        gongId: gong.id,
        status: 'SUBSCRIBED',
        ...(cleanTag ? { tags: { has: cleanTag } } : {}),
      },
      select: { id: true },
    });

    const queueItems = recipients.map((r) => ({
      broadcastId: broadcast.id,
      recipientId: r.id,
      userId,
      status: 'PENDING',
    }));

    if (queueItems.length > 0) {
      await prisma.newsletterQueueItem.createMany({ data: queueItems });
      safeWaitUntil(newsletterQueueService.processNewsletterQueue());
    }

    res.status(201).json({
      success: true,
      broadcastId: broadcast.id,
      queuedSubscribers: queueItems.length,
      message: `Broadcast staged into bounded queue drainer for ${queueItems.length} subscriber(s).`,
    });
  } catch (error: any) {
    res.status(500).json({ error: error.message || 'Failed to publish headless broadcast' });
  }
});

router.post('/subscribe', requireApiKeyScope('town_crier:write'), async (req: Request, res: Response) => {
  const apiReq = req as ApiKeyRequest;
  const userId = apiReq.apiUser!.id;
  const payload = req.body;

  try {
    const blocklist = await prisma.blocklist.findMany({ where: { userId } });

    if (Array.isArray(payload.subscribers)) {
      const userGongs = await prisma.gong.findMany({
        where: { userId },
        select: { id: true, slug: true },
      });
      const gongLookup = new Map<string, { id: string; slug: string }>();
      for (const g of userGongs) {
        gongLookup.set(g.id, g);
        gongLookup.set(g.slug.toLowerCase(), g);
      }

      const defaultIdentifier = (payload.gongId || payload.gong || '').trim();
      const defaultGong = defaultIdentifier
        ? gongLookup.get(defaultIdentifier) || gongLookup.get(defaultIdentifier.toLowerCase()) || null
        : null;

      const validSubscribers = payload.subscribers
        .map((s: any) => {
          const itemIdentifier = (s.gongId || s.gong || '').trim();
          const resolvedGong = itemIdentifier
            ? gongLookup.get(itemIdentifier) || gongLookup.get(itemIdentifier.toLowerCase()) || defaultGong
            : defaultGong;

          const baseTags = Array.isArray(s.tags) ? s.tags.map((t: any) => String(t).trim()) : ['api_bulk'];
          if (resolvedGong && !baseTags.includes(`gong:${resolvedGong.slug}`)) {
            baseTags.push(`gong:${resolvedGong.slug}`);
          }

          return {
            email: String(s.email || '').trim().toLowerCase(),
            name: s.name ? String(s.name).trim() : null,
            cadence: s.cadence || 'weekly',
            tags: baseTags,
            userId,
            gongId: resolvedGong?.id || null,
            source: 'api_bulk',
            status: 'SUBSCRIBED',
            unsubscribeToken: crypto.randomBytes(16).toString('hex'),
          };
        })
        .filter((s: any) => s.email && s.email.includes('@') && !isEmailBlocked(s.email, blocklist));

      let insertedCount = 0;
      const CHUNK = 500;
      for (let i = 0; i < validSubscribers.length; i += CHUNK) {
        const batch = validSubscribers.slice(i, i + CHUNK);
        const r = await prisma.newsletterRecipient.createMany({
          data: batch,
          skipDuplicates: true,
        });
        insertedCount += r.count;
      }

      safeWaitUntil(
        webhookDispatchService.dispatch({
          userId,
          event: 'gong.subscribed',
          payload: {
            bulk: true,
            processed: payload.subscribers.length,
            inserted: insertedCount,
            gongSlug: defaultGong?.slug || null,
          },
        })
      );

      return res.status(201).json({ success: true, processed: payload.subscribers.length, inserted: insertedCount });
    }

    const cleanEmail = (payload.email || '').trim().toLowerCase();
    if (!cleanEmail || !cleanEmail.includes('@')) {
      return res.status(400).json({ error: 'A valid email address is required' });
    }

    if (isEmailBlocked(cleanEmail, blocklist)) {
      return res.status(400).json({ error: 'This email is suppressed by workspace blocklist rules.' });
    }

    let targetGong: any = null;
    const gongIdentifier = (payload.gongId || payload.gong || '').trim();
    if (gongIdentifier) {
      targetGong = await prisma.gong.findFirst({
        where: {
          userId,
          OR: [{ id: gongIdentifier }, { slug: gongIdentifier.toLowerCase() }],
        },
        include: {
          dedicatedSender: { include: { domain: true } },
        },
      });
    }

    const unsubToken = crypto.randomBytes(16).toString('hex');
    const cleanTags = Array.isArray(payload.tags)
      ? payload.tags.map((t: any) => String(t).trim())
      : targetGong?.tags?.length
      ? [...targetGong.tags]
      : ['website_form'];

    if (targetGong && !cleanTags.includes(`gong:${targetGong.slug}`)) {
      cleanTags.push(`gong:${targetGong.slug}`);
    }

    const requestedCadence = payload.cadence || targetGong?.cadence || 'weekly';

    const recipient = await prisma.newsletterRecipient.upsert({
      where: {
        userId_email: { userId, email: cleanEmail },
      },
      update: {
        name: payload.name ? String(payload.name).trim() : undefined,
        cadence: requestedCadence,
        status: 'SUBSCRIBED',
        gongId: targetGong?.id || undefined,
        tags: cleanTags,
        metadata: payload.metadata || undefined,
      },
      create: {
        userId,
        email: cleanEmail,
        name: payload.name ? String(payload.name).trim() : null,
        cadence: requestedCadence,
        gongId: targetGong?.id || null,
        source: 'website_form',
        status: 'SUBSCRIBED',
        tags: cleanTags,
        metadata: payload.metadata || null,
        unsubscribeToken: unsubToken,
      },
    });

    if (targetGong && targetGong.welcomeEmailEnabled && targetGong.welcomeSubject && targetGong.welcomeBody) {
      safeWaitUntil(
        (async () => {
          try {
            if (await planGuardService.isOverMonthlyEmailLimit(userId)) {
              logger.warn({ userId, gongId: targetGong.id }, '[GONG] Skipped welcome email: monthly plan limit reached');
              return;
            }

            const userSettings = await prisma.userSettings.findUnique({
              where: { userId },
              include: { dedicatedNewsletterSender: { include: { domain: true } } },
            });

            let eligibleSender: any = null;
            if (
              targetGong.dedicatedSender &&
              targetGong.dedicatedSender.status === 'active' &&
              targetGong.dedicatedSender.domain?.status === 'active'
            ) {
              eligibleSender = targetGong.dedicatedSender;
            } else if (
              userSettings?.dedicatedNewsletterSender &&
              userSettings.dedicatedNewsletterSender.status === 'active' &&
              userSettings.dedicatedNewsletterSender.domain?.status === 'active'
            ) {
              eligibleSender = userSettings.dedicatedNewsletterSender;
            } else {
              const senders = await prisma.sender.findMany({
                where: { userId, status: 'active', domain: { status: 'active' } },
                include: { domain: true },
              });
              eligibleSender = senders[0] || null;
            }

            if (eligibleSender) {
              eligibleSender = await senderService.ensureSenderDailyReset(eligibleSender.id);
              const [artifacts, mimeAttachments] = await Promise.all([
                artifactService.getArtifactMapForUser(userId),
                artifactService.resolveMimeAttachmentsForScope(userId, { gongId: targetGong.id }),
              ]);

              const appBaseUrl = process.env.APP_URL || 'https://midas-aem.vercel.app';
              const unsubUrl = `${appBaseUrl.replace(/\/$/, '')}/api/public/town-crier/recipients/unsubscribe/${recipient.unsubscribeToken}`;

              const { subject, body } = personalisationService.personalise(
                recipient,
                targetGong.welcomeSubject,
                targetGong.welcomeBody,
                null,
                eligibleSender.displayName || userSettings?.companyName || 'The Team',
                unsubUrl,
                {
                  companyName: userSettings?.companyName,
                  physicalAddress: userSettings?.physicalAddress,
                  customOptOutText: userSettings?.customOptOutText,
                  artifacts,
                }
              );

              const sendRes = await emailService.sendEmailNow(
                { ...eligibleSender.domain, senderLocalPart: eligibleSender.localPart },
                recipient.email,
                subject,
                body.replace(/\n/g, '<br>'),
                body,
                `tc_welcome_${recipient.id}`,
                eligibleSender.displayName || userSettings?.companyName || null,
                undefined,
                unsubUrl,
                undefined,
                {
                  brandName: userSettings?.companyName,
                  brandInitials: userSettings?.brandInitials,
                  brandColorHex: userSettings?.brandColorHex,
                  logoUrl: userSettings?.logoUrl,
                  brandingEnabled: userSettings?.brandingEnabled ?? true,
                  templateStyle: targetGong.templateStyle || 'card',
                },
                mimeAttachments
              );

              if (sendRes.success) {
                await planGuardService.recordEmailSent(userId, 1);
                logger.info({ recipientId: recipient.id, gongId: targetGong.id }, '[GONG] Preset welcome email dispatched');
              }
            }
          } catch (err: any) {
            logger.error({ err: err?.message, recipientId: recipient.id }, '[GONG] Failed to dispatch welcome email');
          }
        })()
      );
    }

    safeWaitUntil(
      webhookDispatchService.dispatch({
        userId,
        event: 'gong.subscribed',
        payload: {
          recipientId: recipient.id,
          email: recipient.email,
          name: recipient.name,
          cadence: recipient.cadence,
          gongId: targetGong?.id || null,
          gongSlug: targetGong?.slug || null,
          tags: recipient.tags,
          metadata: recipient.metadata,
        },
      })
    );

    if (payload.campaignId && typeof payload.campaignId === 'string') {
      const campaign = await prisma.campaign.findFirst({
        where: { id: payload.campaignId.trim(), userId },
      });
      if (campaign) {
        await prisma.lead.upsert({
          where: { userId_email: { userId, email: cleanEmail } },
          update: { campaignId: campaign.id, outreachStatus: 'PENDING' },
          create: {
            userId,
            email: cleanEmail,
            name: payload.name ? String(payload.name).trim() : cleanEmail.split('@')[0],
            campaignId: campaign.id,
            outreachStatus: 'PENDING',
          },
        });
        safeWaitUntil(reconcileCampaignQueue(campaign.id, userId));
      }
    }

    res.status(201).json({ success: true, subscriber: recipient, gong: targetGong });
  } catch (error: any) {
    logger.error({ error: error.message }, 'Failed to ingest newsletter subscriber');
    res.status(500).json({ error: 'Failed to process subscription' });
  }
});

router.post('/recipients/import', requireApiKeyScope('town_crier:write'), upload.single('file'), async (req: Request, res: Response) => {
  const apiReq = req as ApiKeyRequest;
  const userId = apiReq.apiUser!.id;

  if (!req.file) {
    return res.status(400).json({ error: 'A CSV file is required' });
  }

  try {
    const csvText = req.file.buffer.toString('utf8');
    const parsed = Papa.parse(csvText, { header: true, skipEmptyLines: true });
    const rows = parsed.data as any[];

    const blocklist = await prisma.blocklist.findMany({ where: { userId } });
    const validRecipients: any[] = [];

    for (const row of rows) {
      const keys = Object.keys(row);
      const emailKey = keys.find((k) => /email/i.test(k));
      const nameKey = keys.find((k) => /^(full ?name|name)$/i.test(k));

      const email = emailKey ? String(row[emailKey] || '').trim().toLowerCase() : '';
      const name = nameKey ? String(row[nameKey] || '').trim() : null;

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) continue;
      if (isEmailBlocked(email, blocklist)) continue;

      validRecipients.push({
        email,
        name: name || null,
        userId,
        source: 'api_import',
        status: 'SUBSCRIBED',
        tags: ['csv_import'],
        unsubscribeToken: crypto.randomBytes(16).toString('hex'),
      });
    }

    let insertedCount = 0;
    const CHUNK = 500;
    for (let i = 0; i < validRecipients.length; i += CHUNK) {
      const batch = validRecipients.slice(i, i + CHUNK);
      const r = await prisma.newsletterRecipient.createMany({
        data: batch,
        skipDuplicates: true,
      });
      insertedCount += r.count;
    }

    res.status(201).json({ success: true, processedRows: rows.length, insertedCount });
  } catch (error: any) {
    res.status(500).json({ error: error.message || 'Import failed' });
  }
});

router.get('/recipients', requireApiKeyScope('town_crier:read'), async (req: Request, res: Response) => {
  const apiReq = req as ApiKeyRequest;
  const userId = apiReq.apiUser!.id;
  const page = parseInt((req.query.page as string) || '1', 10);
  const pageSize = parseInt((req.query.pageSize as string) || '50', 10);

  try {
    const [recipients, total] = await Promise.all([
      prisma.newsletterRecipient.findMany({
        where: { userId },
        skip: (page - 1) * pageSize,
        take: pageSize,
        orderBy: { createdAt: 'desc' },
      }),
      prisma.newsletterRecipient.count({ where: { userId } }),
    ]);

    res.json({
      data: recipients,
      pagination: { page, pageSize, total, totalPages: Math.ceil(total / pageSize) },
    });
  } catch (error) {
    res.status(500).json({ error: 'Failed to fetch recipients' });
  }
});

export default router;
</file>

<file path="server/routes/webhooks.routes.ts">
import { Router, Request, Response } from 'express';
import multer from 'multer';
import { Webhook } from 'svix';
import prisma from '../lib/prisma';
import { env } from '../config/env';
import { webhooksService } from '../services/webhooks.service';
import { dodoService } from '../services/billing/dodo.service';
import { logger } from '../config/logger';

const router = Router();
const upload = multer();

function safeWaitUntil(promise: Promise<any>): void {
  try {
    // eslint-disable-next-line @typescript-eslint/no-var-requires
    const vercel = require('@vercel/functions');
    if (typeof vercel.waitUntil === 'function') {
      vercel.waitUntil(promise);
      return;
    }
  } catch {}

  promise.catch((err) => {
    logger.error({ err: err?.message || err }, '[BACKGROUND TASK ERROR]');
  });
}

// 1. Mailgun Deliverability Events Webhook
router.post('/mailgun', async (req: Request, res: Response) => {
  try {
    const { signature } = req.body;
    if (!signature) return res.status(401).send('Missing signature');

    const isValid = webhooksService.verifyMailgunSignature(
      signature.timestamp,
      signature.token,
      signature.signature
    );

    if (!isValid) return res.status(403).send('Invalid Signature');

    safeWaitUntil(
      webhooksService.processDeliverabilityEvent(req.body).catch((err) => {
        logger.error({ err }, 'Deliverability event background processing error');
      })
    );

    res.status(200).send('OK');
  } catch (error) {
    logger.error({ error }, 'Mailgun event webhook error');
    res.status(500).send('Internal Server Error');
  }
});

// 2. Mailgun Inbound Parse Webhook
router.post('/mailgun/inbound', upload.none(), async (req: Request, res: Response) => {
  try {
    const { timestamp, token, signature } = req.body;
    if (!signature) return res.status(401).send('Missing signature');

    const isValid = webhooksService.verifyMailgunSignature(timestamp, token, signature);
    if (!isValid) return res.status(403).send('Invalid Signature');

    safeWaitUntil(
      webhooksService.processInboundEmail(req.body).catch((err) => {
        logger.error({ err }, 'Inbound reply processing error');
      })
    );

    res.status(200).send('OK');
  } catch (error) {
    logger.error({ error }, 'Mailgun inbound webhook error');
    res.status(500).send('Internal Server Error');
  }
});

// 3. Resend Svix Webhook (Deliverability + email.received Inbound Replies)
router.post('/resend', async (req: Request, res: Response) => {
  const secret = env.RESEND_WEBHOOK_SECRET;
  if (!secret) {
    logger.error('RESEND_WEBHOOK_SECRET is not configured');
    return res.status(500).json({ error: 'Resend webhook secret not configured' });
  }

  const svixId = req.headers['svix-id'] as string;
  const svixTimestamp = req.headers['svix-timestamp'] as string;
  const svixSignature = req.headers['svix-signature'] as string;

  if (!svixId || !svixTimestamp || !svixSignature) {
    return res.status(400).json({ error: 'Missing svix headers' });
  }

  const rawPayload = (req as any).rawBody ? (req as any).rawBody.toString('utf8') : JSON.stringify(req.body);
  try {
    const wh = new Webhook(secret);
    wh.verify(rawPayload, {
      'svix-id': svixId,
      'svix-timestamp': svixTimestamp,
      'svix-signature': svixSignature,
    });
  } catch (err: any) {
    logger.warn({ err: err?.message }, 'Resend Svix signature verification failed');
    return res.status(401).json({ error: 'Invalid Resend webhook signature' });
  }

  safeWaitUntil(
    webhooksService.processResendWebhook(req.body).catch((err) => {
      logger.error({ err: err?.message }, '[RESEND] Background webhook error');
    })
  );

  res.status(200).json({ received: true });
});

// 4. Generic Custom Inbound Webhook (Cloudflare Email Workers / Make / Zapier Gmail)
router.post('/inbound/custom/:domainId', async (req: Request, res: Response) => {
  try {
    const { domainId } = req.params;
    const providedToken = (req.headers['x-midas-inbound-token'] as string) || (req.query.token as string);

    if (!webhooksService.verifyCustomInboundToken(domainId, providedToken)) {
      return res.status(401).json({ error: 'Invalid inbound token' });
    }

    safeWaitUntil(
      webhooksService.processInboundEmail({
        'Message-Id': req.body.messageId || req.body['Message-Id'],
        'In-Reply-To': req.body.inReplyTo || req.body['In-Reply-To'],
        References: req.body.references || req.body.References,
        from: req.body.from,
        to: req.body.to,
        subject: req.body.subject,
        'stripped-text': req.body.text || req.body.body || '',
        'stripped-html': req.body.html || '',
        timestamp: req.body.timestamp,
      })
    );

    res.status(200).json({ received: true });
  } catch (err: any) {
    res.status(500).json({ error: err.message || 'Custom inbound error' });
  }
});

// 5. Dodo Payments Standard Webhooks Receiver
router.post('/dodo', async (req: Request, res: Response) => {
  try {
    const rawBody = (req as any).rawBody || JSON.stringify(req.body);
    const isValid = dodoService.verifyWebhookSignature(rawBody, {
      webhookId: req.headers['webhook-id'] as string | undefined,
      webhookTimestamp: req.headers['webhook-timestamp'] as string | undefined,
      webhookSignature: req.headers['webhook-signature'] as string | undefined,
    });

    if (!isValid) {
      logger.warn('[DODO] Rejected webhook due to invalid Standard Webhooks signature');
      return res.status(401).json({ error: 'Invalid Dodo webhook signature' });
    }

    safeWaitUntil(
      dodoService.processWebhook(req.body).catch((err) => {
        logger.error({ err: err?.message }, '[DODO] Background webhook processing error');
      })
    );

    res.status(200).json({ received: true });
  } catch (error) {
    logger.error({ error }, 'Dodo Payments webhook error');
    res.status(500).send('Internal Server Error');
  }
});

// 6. Clerk User Synchronization Webhook
router.post('/clerk', async (req: Request, res: Response) => {
  const webhookSecret = process.env.CLERK_WEBHOOK_SECRET;
  if (!webhookSecret) {
    logger.error('CLERK_WEBHOOK_SECRET is not configured');
    return res.status(500).json({ error: 'Webhook configuration error' });
  }

  const headers = req.headers;
  const svix_id = headers['svix-id'] as string;
  const svix_timestamp = headers['svix-timestamp'] as string;
  const svix_signature = headers['svix-signature'] as string;

  if (!svix_id || !svix_timestamp || !svix_signature) {
    return res.status(400).json({ error: 'Missing svix headers' });
  }

  const payload = (req as any).rawBody ? (req as any).rawBody.toString('utf8') : JSON.stringify(req.body);
  const wh = new Webhook(webhookSecret);
  let evt: any;

  try {
    evt = wh.verify(payload, {
      'svix-id': svix_id,
      'svix-timestamp': svix_timestamp,
      'svix-signature': svix_signature,
    }) as any;
  } catch (err: any) {
    logger.error({ err }, 'Clerk webhook signature verification failed');
    return res.status(400).json({ error: 'Invalid webhook signature' });
  }

  const eventType = evt.type;

  try {
    if (eventType === 'user.created' || eventType === 'user.updated') {
      const { id: clerkId, email_addresses, first_name, last_name } = evt.data;
      const email = email_addresses?.[0]?.email_address;
      const name = `${first_name || ''} ${last_name || ''}`.trim() || email?.split('@')[0];

      if (email) {
        await prisma.user.upsert({
          where: { email },
          update: { clerkId, name },
          create: { clerkId, email, name },
        });
      }
    } else if (eventType === 'user.deleted') {
      const { id: clerkId } = evt.data;
      await prisma.user.deleteMany({ where: { clerkId } });
    }

    res.json({ success: true });
  } catch (dbErr: any) {
    logger.error({ dbErr }, 'Clerk webhook database sync failed');
    res.status(500).json({ error: 'Database syncing failed' });
  }
});

export default router;
</file>

<file path="src/components/UploadArea.tsx">
import React, { useCallback, useState, useEffect, useRef } from 'react';
import { useDropzone } from 'react-dropzone';
import Papa from 'papaparse';
import * as XLSX from 'xlsx';
import { leadAPI, configAPI, campaignAPI } from '../services/api';
import { useToast } from '../context/ToastContext';
import { Icons } from '../lib/icons';

interface Job {
  id: string;
  filename: string;
  status: string;
  totalRows: number;
  validLeads: number;
  catchAllLeads: number;
  blockedLeads: number;
  invalidLeads: number;
  duplicates: number;
}

interface ColumnMapping {
  email: string;
  nameMode: 'single' | 'split';
  nameCol: string;
  firstNameCol: string;
  lastNameCol: string;
  companyCol: string;
  positionCol: string;
}

interface UploadAreaProps {
  onJobComplete: () => void;
  campaignId?: string;
  allowCampaignSelection?: boolean;
}

export const UploadArea: React.FC<UploadAreaProps> = ({
  onJobComplete,
  campaignId,
  allowCampaignSelection = false,
}) => {
  const { toast } = useToast();
  const [jobs, setJobs] = useState<Job[]>([]);
  const [uploading, setUploading] = useState(false);
  const [verifyEmails, setVerifyEmails] = useState(false);
  const [verificationAvailable, setVerificationAvailable] = useState(false);
  const [verificationProvider, setVerificationProvider] = useState<string>('mock');
  const pollTimerRef = useRef<NodeJS.Timeout | null>(null);

  const [availableCampaigns, setAvailableCampaigns] = useState<any[]>([]);
  const [selectedCampaignId, setSelectedCampaignId] = useState<string>(campaignId || '');

  const [stagedFile, setStagedFile] = useState<File | null>(null);
  const [detectedHeaders, setDetectedHeaders] = useState<string[]>([]);
  const [sampleRows, setSampleRows] = useState<Record<string, string>[]>([]);
  const [mapping, setMapping] = useState<ColumnMapping>({
    email: '',
    nameMode: 'single',
    nameCol: '',
    firstNameCol: '',
    lastNameCol: '',
    companyCol: '',
    positionCol: '',
  });

  const fetchJobs = async () => {
    try {
      const res = await leadAPI.getJobs();
      const currentJobs: Job[] = res.data || [];
      setJobs(currentJobs);

      const hasActive = currentJobs.some((j: Job) => ['PENDING', 'PROCESSING', 'VERIFYING'].includes(j.status));
      if (hasActive) {
        pollTimerRef.current = setTimeout(fetchJobs, 3500);
      } else {
        onJobComplete();
      }
    } catch (e) {
      console.error('Failed to poll upload jobs', e);
    }
  };

  useEffect(() => {
    fetchJobs();
    configAPI.get()
      .then(res => {
        setVerificationAvailable(!!res.data?.verification?.available);
        setVerificationProvider(res.data?.verification?.provider || 'mock');
      })
      .catch(() => setVerificationAvailable(false));

    if (allowCampaignSelection && !campaignId) {
      campaignAPI.getAll()
        .then(res => setAvailableCampaigns(res.data || []))
        .catch(() => {});
    }

    return () => {
      if (pollTimerRef.current) clearTimeout(pollTimerRef.current);
    };
  }, [campaignId, allowCampaignSelection]);

  const analyzeFileHeaders = async (file: File) => {
    const isExcel = file.name.endsWith('.xlsx') || file.name.endsWith('.xls');

    if (isExcel) {
      const arrayBuffer = await file.arrayBuffer();
      const workbook = XLSX.read(arrayBuffer, { type: 'array' });
      const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
      const rawData = XLSX.utils.sheet_to_json(firstSheet, { header: 1 }) as any[][];
      if (rawData.length < 1) return toast.error('File appears to be empty', 'Parsing Error');

      const headers = (rawData[0] || []).map((h: any) => String(h || '').trim().replace(/^\uFEFF/, '')).filter(Boolean);
      const samples: Record<string, string>[] = [];
      for (let i = 1; i <= Math.min(3, rawData.length - 1); i++) {
        const row = rawData[i];
        const obj: Record<string, string> = {};
        headers.forEach((h, idx) => { obj[h] = row[idx] ? String(row[idx]).trim() : ''; });
        samples.push(obj);
      }
      setupMappingStage(file, headers, samples);
    } else {
      Papa.parse(file, {
        header: true,
        preview: 4,
        skipEmptyLines: true,
        complete: (results) => {
          if (!results.meta.fields || results.meta.fields.length === 0) {
            return toast.error('No headers found in CSV file', 'Parsing Error');
          }
          const headers = results.meta.fields.map(h => h.trim().replace(/^\uFEFF/, '')).filter(Boolean);
          const samples = (results.data as any[]).slice(0, 3);
          setupMappingStage(file, headers, samples);
        },
        error: () => toast.error('Failed to parse CSV preview', 'Error'),
      });
    }
  };

  const setupMappingStage = (file: File, headers: string[], samples: Record<string, string>[]) => {
    setStagedFile(file);
    setDetectedHeaders(headers);
    setSampleRows(samples);

    const emailMatch = headers.find(h => /^(work_?email|corporate_?email|email_?address|email|primary_?email)$/i.test(h)) ||
                       headers.find(h => /email/i.test(h)) || '';

    const firstMatch = headers.find(h => /^(first_?name|first|fname)$/i.test(h)) || '';
    const lastMatch = headers.find(h => /^(last_?name|last|lname|surname)$/i.test(h)) || '';
    const fullMatch = headers.find(h => /^(full_?name|contact_?name|lead_?name|name)$/i.test(h) && !/company/i.test(h)) || '';

    const companyMatch = headers.find(h => /^(company_?name|company|organization|account_?name|account)$/i.test(h)) ||
                          headers.find(h => /company|org/i.test(h)) || '';

    const positionMatch = headers.find(h => /^(job_?title|title|position|role|designation)$/i.test(h)) ||
                          headers.find(h => /title|position/i.test(h)) || '';

    setMapping({
      email: emailMatch,
      nameMode: firstMatch && lastMatch ? 'split' : 'single',
      nameCol: fullMatch || headers.find(h => /name/i.test(h)) || '',
      firstNameCol: firstMatch,
      lastNameCol: lastMatch,
      companyCol: companyMatch,
      positionCol: positionMatch,
    });
  };

  const onDrop = useCallback(async (acceptedFiles: File[]) => {
    if (acceptedFiles.length === 0) return;
    const file = acceptedFiles[0];
    await analyzeFileHeaders(file);
  }, []);

  const { getRootProps, getInputProps, isDragActive } = useDropzone({
    onDrop,
    maxFiles: 1,
    accept: {
      'text/csv': ['.csv'],
      'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': ['.xlsx'],
      'application/vnd.ms-excel': ['.xls'],
    },
  });

  const handleConfirmAndUpload = async () => {
    if (!stagedFile) return;
    if (!mapping.email) {
      return toast.warning('Please select a column for the Email field', 'Validation Error');
    }

    setUploading(true);
    const targetCampaign = campaignId || selectedCampaignId || undefined;

    try {
      await leadAPI.upload(
        stagedFile,
        verificationAvailable && verifyEmails,
        JSON.stringify(mapping),
        targetCampaign
      );
      toast.success(`Staged ${stagedFile.name} for ingestion${targetCampaign ? ' into campaign' : ''}`, 'Ingestion Queued');
      setStagedFile(null);
      setDetectedHeaders([]);
      setSampleRows([]);
      await fetchJobs();
    } catch {
      toast.error('File upload failed. Check CSV formatting.', 'Upload Error');
    } finally {
      setUploading(false);
    }
  };

  const getStatusBadge = (status: string) => {
    switch (status) {
      case 'COMPLETED':
        return <span className="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">COMPLETED</span>;
      case 'FAILED':
        return <span className="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">FAILED</span>;
      case 'VERIFYING':
        return <span className="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-royal-700 text-gold-300 animate-pulse">VERIFYING</span>;
      case 'PROCESSING':
      case 'PENDING':
      default:
        return <span className="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-800 border border-gold-400/50 animate-pulse">PROCESSING</span>;
    }
  };

  return (
    <div className="card-midas rounded-2xl p-6 space-y-6">
      <div className="pb-3 border-b border-gold-500/35">
        <h2 className="text-lg font-black text-royal-950 tracking-tight">
          {campaignId ? 'Import Leads Directly to Sequence' : 'Lead Ingestion Studio'}
        </h2>
        <p className="text-xs text-thistle-500 mt-0.5">
          {campaignId
            ? 'Import prospect lists directly into this campaign. Uploaded leads are automatically queued for outreach.'
            : 'Upload prospect lists with visual field matching. Deduplication and suppression rules apply automatically.'}
        </p>
      </div>

      {!stagedFile && (
        <div
          {...getRootProps()}
          className={`border-2 border-dashed rounded-2xl p-8 text-center cursor-pointer transition-all ${
            isDragActive
              ? 'border-gold-500 bg-thistle-100/80 scale-[0.99]'
              : 'border-gold-500/40 hover:border-gold-500 bg-thistle-50/60 hover:bg-thistle-100/40'
          }`}
        >
          <input {...getInputProps()} disabled={uploading} />
          <div className="w-10 h-10 rounded-2xl bg-white border border-gold-500/40 shadow-xs text-royal-700 mx-auto flex items-center justify-center mb-3">
            <Icons.Upload className="text-gold-600" />
          </div>
          <p className="text-xs font-bold text-royal-950">
            {uploading ? 'Processing file...' : isDragActive ? 'Drop file to analyze headers' : 'Drag & drop prospect CSV/XLSX, or click to browse'}
          </p>
          <p className="text-[11px] text-thistle-500 mt-1">
            Headers will be auto-detected for interactive mapping before final insertion.
          </p>
        </div>
      )}

      {stagedFile && (
        <div className="p-5 bg-thistle-50/70 border border-gold-500/45 rounded-2xl space-y-5 animate-in fade-in duration-150">
          <div className="flex items-center justify-between pb-3 border-b border-gold-500/35">
            <div>
              <span className="text-[10px] font-bold uppercase tracking-wider text-royal-700">Step 2: Field Matching</span>
              <h3 className="text-sm font-bold text-royal-950 mt-0.5">Map File Columns to Prospect Fields</h3>
              <p className="text-xs text-thistle-500 font-mono">{stagedFile.name} ({(stagedFile.size / 1024).toFixed(1)} KB)</p>
            </div>
            <button
              onClick={() => { setStagedFile(null); setDetectedHeaders([]); setSampleRows([]); }}
              className="text-xs font-bold text-thistle-500 hover:text-rose-600 transition-colors flex items-center gap-1"
            >
              <Icons.Close />
              <span>Change File</span>
            </button>
          </div>

          {allowCampaignSelection && !campaignId && (
            <div className="p-3 bg-white border border-gold-500/35 rounded-xl space-y-1">
              <label className="block text-[10px] font-bold text-thistle-500 uppercase">
                Assign Upload Directly to a Campaign (Optional)
              </label>
              <select
                value={selectedCampaignId}
                onChange={(e) => setSelectedCampaignId(e.target.value)}
                className="w-full px-3 py-1.5 border border-gold-500/35 rounded-lg text-xs font-medium text-royal-950 focus:outline-none focus:border-gold-500"
              >
                <option value="">-- None (Stage as Global Leads) --</option>
                {availableCampaigns.map(c => (
                  <option key={c.id} value={c.id}>{c.name} ({c.status})</option>
                ))}
              </select>
            </div>
          )}

          <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-xs">
            <div>
              <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">
                Email Address <span className="text-rose-500">*</span>
              </label>
              <select
                value={mapping.email}
                onChange={(e) => setMapping({ ...mapping, email: e.target.value })}
                className="w-full px-3 py-2 bg-white border border-gold-500/40 rounded-xl font-bold text-royal-950 focus:outline-none focus:border-gold-500"
              >
                <option value="">-- Select Email Column --</option>
                {detectedHeaders.map(h => <option key={h} value={h}>{h}</option>)}
              </select>
            </div>

            <div>
              <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Name Resolution</label>
              <div className="flex bg-thistle-200/70 p-1 rounded-xl mb-1.5">
                <button
                  type="button"
                  onClick={() => setMapping({ ...mapping, nameMode: 'single' })}
                  className={`flex-1 py-1 rounded-lg text-[10px] font-bold transition-all ${
                    mapping.nameMode === 'single' ? 'bg-royal-700 text-white shadow-xs' : 'text-royal-800'
                  }`}
                >
                  Full Name
                </button>
                <button
                  type="button"
                  onClick={() => setMapping({ ...mapping, nameMode: 'split' })}
                  className={`flex-1 py-1 rounded-lg text-[10px] font-bold transition-all ${
                    mapping.nameMode === 'split' ? 'bg-royal-700 text-white shadow-xs' : 'text-royal-800'
                  }`}
                >
                  First + Last
                </button>
              </div>

              {mapping.nameMode === 'single' ? (
                <select
                  value={mapping.nameCol}
                  onChange={(e) => setMapping({ ...mapping, nameCol: e.target.value })}
                  className="w-full px-3 py-2 bg-white border border-gold-500/35 rounded-xl text-royal-950 font-medium focus:outline-none"
                >
                  <option value="">-- Full Name Column --</option>
                  {detectedHeaders.map(h => <option key={h} value={h}>{h}</option>)}
                </select>
              ) : (
                <div className="grid grid-cols-2 gap-1.5">
                  <select
                    value={mapping.firstNameCol}
                    onChange={(e) => setMapping({ ...mapping, firstNameCol: e.target.value })}
                    className="w-full px-2 py-2 bg-white border border-gold-500/35 rounded-xl text-[11px] font-medium focus:outline-none"
                  >
                    <option value="">First</option>
                    {detectedHeaders.map(h => <option key={h} value={h}>{h}</option>)}
                  </select>
                  <select
                    value={mapping.lastNameCol}
                    onChange={(e) => setMapping({ ...mapping, lastNameCol: e.target.value })}
                    className="w-full px-2 py-2 bg-white border border-gold-500/35 rounded-xl text-[11px] font-medium focus:outline-none"
                  >
                    <option value="">Last</option>
                    {detectedHeaders.map(h => <option key={h} value={h}>{h}</option>)}
                  </select>
                </div>
              )}
            </div>

            <div>
              <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Company / Account</label>
              <select
                value={mapping.companyCol}
                onChange={(e) => setMapping({ ...mapping, companyCol: e.target.value })}
                className="w-full px-3 py-2 bg-white border border-gold-500/35 rounded-xl text-royal-950 font-medium focus:outline-none"
              >
                <option value="">-- Optional Company --</option>
                {detectedHeaders.map(h => <option key={h} value={h}>{h}</option>)}
              </select>
            </div>

            <div>
              <label className="block text-[10px] font-bold text-thistle-500 uppercase mb-1">Job Title / Role</label>
              <select
                value={mapping.positionCol}
                onChange={(e) => setMapping({ ...mapping, positionCol: e.target.value })}
                className="w-full px-3 py-2 bg-white border border-gold-500/35 rounded-xl text-royal-950 font-medium focus:outline-none"
              >
                <option value="">-- Optional Position --</option>
                {detectedHeaders.map(h => <option key={h} value={h}>{h}</option>)}
              </select>
            </div>
          </div>

          {sampleRows.length > 0 && (
            <div className="space-y-2 pt-2 border-t border-gold-500/35">
              <span className="text-[10px] font-bold uppercase text-thistle-500">Live Sample Data Preview</span>
              <div className="overflow-x-auto bg-white border border-gold-500/40 rounded-xl">
                <table className="min-w-full divide-y divide-gold-500/25 text-left text-[11px]">
                  <thead className="bg-thistle-100/75 font-bold text-royal-800 border-b border-gold-500/35">
                    <tr>
                      <th className="py-2 px-3">Resolved Email</th>
                      <th className="py-2 px-3">Resolved Name</th>
                      <th className="py-2 px-3">Company</th>
                      <th className="py-2 px-3">Position</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gold-500/20 font-medium text-royal-950">
                    {sampleRows.map((sample, idx) => {
                      const emailVal = mapping.email ? sample[mapping.email] : '—';
                      let nameVal = '—';
                      if (mapping.nameMode === 'split') {
                        const f = mapping.firstNameCol ? sample[mapping.firstNameCol] : '';
                        const l = mapping.lastNameCol ? sample[mapping.lastNameCol] : '';
                        nameVal = `${f} ${l}`.trim() || '—';
                      } else {
                        nameVal = mapping.nameCol ? sample[mapping.nameCol] || '—' : '—';
                      }
                      const compVal = mapping.companyCol ? sample[mapping.companyCol] || '—' : '—';
                      const posVal = mapping.positionCol ? sample[mapping.positionCol] || '—' : '—';

                      return (
                        <tr key={idx}>
                          <td className="py-2 px-3 font-mono font-bold text-royal-950">{emailVal}</td>
                          <td className="py-2 px-3">{nameVal}</td>
                          <td className="py-2 px-3 text-thistle-500">{compVal}</td>
                          <td className="py-2 px-3 text-thistle-500">{posVal}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          <div className="pt-3 border-t border-gold-500/35 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div className="flex items-center gap-2">
              <input
                id="verify-leads-checkbox"
                type="checkbox"
                checked={verifyEmails}
                disabled={!verificationAvailable || uploading}
                onChange={(e) => setVerifyEmails(e.target.checked)}
                className="h-4 w-4 rounded border-thistle-400 text-royal-700 focus:ring-0 disabled:opacity-40"
              />
              <label htmlFor="verify-leads-checkbox" className="text-xs font-bold text-royal-950 cursor-pointer">
                Verify Deliverability via {verificationProvider.toUpperCase()}
              </label>
            </div>

            <div className="flex items-center gap-2 w-full sm:w-auto justify-end">
              <button
                type="button"
                onClick={() => { setStagedFile(null); setDetectedHeaders([]); setSampleRows([]); }}
                className="px-4 py-2 text-xs font-bold text-thistle-500 hover:text-royal-950"
              >
                Cancel
              </button>
              <button
                type="button"
                onClick={handleConfirmAndUpload}
                disabled={uploading || !mapping.email}
                className="px-5 py-2 btn-royal rounded-xl text-xs font-bold"
              >
                {uploading ? 'Staging & Ingesting...' : 'Confirm Mapping & Ingest'}
              </button>
            </div>
          </div>
        </div>
      )}

      {jobs.length > 0 && (
        <div className="space-y-3 pt-4 border-t border-gold-500/35">
          <h3 className="text-xs font-bold text-thistle-500 uppercase tracking-wider">Recent Ingestion Batches</h3>
          <div className="space-y-2">
            {jobs.map((job) => (
              <div key={job.id} className="p-4 bg-thistle-50/70 border border-gold-500/35 rounded-xl flex items-center justify-between text-xs">
                <div>
                  <p className="font-bold text-royal-950 font-mono">{job.filename}</p>
                  <p className="text-[11px] text-thistle-500 mt-0.5">
                    Valid: <span className="font-bold text-royal-950">{job.validLeads}</span> ·
                    Catch-All: <span className="font-bold text-royal-950">{job.catchAllLeads}</span> ·
                    Invalid: <span className="font-bold text-royal-950">{job.invalidLeads}</span> ·
                    Suppressed: <span className="font-bold text-royal-950">{job.blockedLeads}</span> ·
                    Duplicates: <span className="font-bold text-royal-950">{job.duplicates}</span>
                  </p>
                </div>
                <div>{getStatusBadge(job.status)}</div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
};
</file>

