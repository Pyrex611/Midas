                        <button
                          type="button"
                          onClick={() => handleAddModel(integration.id)}
                          disabled={verifyingNewModel || !customModelInput.trim()}
                          className="px-3 py-1.5 btn-royal rounded-lg text-xs font-bold whitespace-nowrap"
