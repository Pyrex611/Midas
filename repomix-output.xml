    { cat: 'ALL', label: 'Total Leads', value: analytics.totalLeads, sub: 'In sequence', valueColor: 'text-royal-950' },
    { cat: 'CONTACTED', label: 'Contacted', value: analytics.contactedCount, sub: 'Sent outreach', valueColor: 'text-royal-800' },
