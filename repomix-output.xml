import React, { useEffect, useState, useRef, useCallback } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { campaignAPI, senderAPI, getErrorMessage } from '../services/api';
import { Sheet } from '../components/common/Sheet';
import { ConfirmDialog } from '../components/common/ConfirmDialog';
import { SequenceCanvas } from '../components/campaigns/SequenceCanvas';
import { LeadDrawer } from '../components/leads/LeadDrawer';
import { UploadArea } from '../components/UploadArea';
import { RenameCampaignModal } from '../components/RenameCampaignModal';
import { DeleteCampaignModal } from '../components/DeleteCampaignModal';
import { EditStrategyModal } from '../components/EditStrategyModal';
import { InviteCollaboratorModal } from '../components/InviteCollaboratorModal';
import { CampaignHeader } from '../components/campaigns/CampaignHeader';
import { CampaignHealthBanner, HealthAlert } from '../components/campaigns/CampaignHealthBanner';
import { CampaignOverviewTab } from '../components/campaigns/tabs/CampaignOverviewTab';
import { CampaignDraftsTab } from '../components/campaigns/tabs/CampaignDraftsTab';
import { CampaignAutomationTab } from '../components/campaigns/tabs/CampaignAutomationTab';
import { CampaignSettingsTab } from '../components/campaigns/tabs/CampaignSettingsTab';
import { DrilldownDrawer } from '../components/campaigns/DrilldownDrawer';
import { useToast } from '../context/ToastContext';
import { Icons } from '../lib/icons';

type TabType = 'dashboard' | 'flow' | 'leads' | 'drafts' | 'automation' | 'settings';
type DrilldownCategory = 'ALL' | 'CONTACTED' | 'OPENED' | 'CLICKED' | 'REPLIED' | 'BOUNCED' | 'UNSUBSCRIBED';

export const CampaignDetail: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();
  const { toast } = useToast();

  const [campaign, setCampaign] = useState<any>(null);
  const [initialLoading, setInitialLoading] = useState(true);
  const isFirstLoadRef = useRef(true);

  const [activeTab, setActiveTab] = useState<TabType>('dashboard');

  const [drilldownCategory, setDrilldownCategory] = useState<DrilldownCategory | null>(null);
  const [drilldownSearch, setDrilldownSearch] = useState('');

  const [healthAlerts, setHealthAlerts] = useState<HealthAlert[]>([]);
  const [isDispatchingNow, setIsDispatchingNow] = useState(false);
  const [isReconciling, setIsReconciling] = useState(false);
  const [isRepersonalizing, setIsRepersonalizing] = useState(false);

  const [isUploadDrawerOpen, setIsUploadDrawerOpen] = useState(false);

  const [showRenameModal, setShowRenameModal] = useState(false);
  const [showDeleteModal, setShowDeleteModal] = useState(false);
  const [showStrategyModal, setShowStrategyModal] = useState(false);
  const [showInviteModal, setShowInviteModal] = useState(false);

  const [previewLead, setPreviewLead] = useState<any | null>(null);
  const [isLeadDrawerOpen, setIsLeadDrawerOpen] = useState(false);

  const [isDraftDrawerOpen, setIsDraftDrawerOpen] = useState(false);
  const [editingDraft, setEditingDraft] = useState<any | null>(null);
  const [draftSubject, setDraftSubject] = useState('');
  const [draftBody, setDraftBody] = useState('');
  const [savingDraft, setSavingDraft] = useState(false);
  const [generatingDraft, setGeneratingDraft] = useState(false);

  const [pendingDeleteDraftId, setPendingDeleteDraftId] = useState<string | null>(null);
  const [deletingDraft, setDeletingDraft] = useState(false);

  const [userSenders, setUserSenders] = useState<any[]>([]);
  const [campaignSenderIds, setCampaignSenderIds] = useState<Set<string>>(new Set());
  const [updatingSender, setUpdatingSender] = useState(false);

  const [autoReplyEnabled, setAutoReplyEnabled] = useState(false);
  const [savingAutoReply, setSavingAutoReply] = useState(false);
  const [sendHourUTC, setSendHourUTC] = useState(9);
  const [savingSendHour, setSavingSendHour] = useState(false);
  const [activeStartHour, setActiveStartHour] = useState<number | ''>('');
  const [activeEndHour, setActiveEndHour] = useState<number | ''>('');
  const [timezone, setTimezone] = useState('UTC');
  const [savingActiveHours, setSavingActiveHours] = useState(false);
  const [followUpSteps, setFollowUpSteps] = useState<any[]>([]);
  const [savingSteps, setSavingSteps] = useState(false);
  const [generatingDraftFor, setGeneratingDraftFor] = useState<number | null>(null);

  const role: 'OWNER' | 'EDITOR' | 'VIEWER' = campaign?.role || 'VIEWER';
  const canEdit = role === 'OWNER' || role === 'EDITOR';
  const canDelete = role === 'OWNER';

  const fetchCampaign = useCallback(async () => {
    if (!id) return;
    if (isFirstLoadRef.current) {
      setInitialLoading(true);
    }

    try {
      const [res, healthRes] = await Promise.all([
        campaignAPI.get(id),
        campaignAPI.getHealth(id).catch(() => ({ data: { alerts: [] } })),
      ]);

      setCampaign(res.data);
      setAutoReplyEnabled(res.data.autoReplyEnabled || false);
      setSendHourUTC(res.data.sendHourUTC ?? 9);
      setActiveStartHour(res.data.activeStartHour ?? '');
      setActiveEndHour(res.data.activeEndHour ?? '');
      setTimezone(res.data.timezone || 'UTC');
      setFollowUpSteps((res.data.followUpSteps || []).sort((a: any, b: any) => a.stepNumber - b.stepNumber));
      setHealthAlerts(healthRes.data?.alerts || []);
    } catch {
      toast.error('Failed to load campaign data', 'Network Error');
    } finally {
      isFirstLoadRef.current = false;
      setInitialLoading(false);
    }
  }, [id, toast]);

  const fetchSenders = useCallback(async () => {
    if (!id) return;
    try {
      const [allRes, assignedRes] = await Promise.all([
        senderAPI.listAll(),
        campaignAPI.getCampaignSenders(id),
      ]);
      setUserSenders(allRes.data || []);
      setCampaignSenderIds(new Set((assignedRes.data || []).map((s: any) => s.id)));
    } catch {}
  }, [id]);

  useEffect(() => {
    fetchCampaign();
    fetchSenders();
  }, [id]);

  const handleReconcileQueue = async () => {
    if (!id) return;
    setIsReconciling(true);
    try {
      const res = await campaignAPI.reconcileQueue(id);
      toast.success(res.data?.message || 'Queue synced', 'Queue Staged');
      await fetchCampaign();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not sync queue'), 'Queue Error');
    } finally {
      setIsReconciling(false);
    }
  };

  const handleRepersonalizeQueue = async () => {
    if (!id) return;
    setIsRepersonalizing(true);
    try {
      const res = await campaignAPI.repersonalizeQueue(id);
      toast.success(res.data?.message || 'Queue refreshed from active reserves', 'Re-Personalized');
      await fetchCampaign();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not refresh queue from reserves'), 'Error');
    } finally {
      setIsRepersonalizing(false);
    }
  };

  const handleTogglePauseResume = async () => {
    if (!id || !campaign) return;
    try {
      if (campaign.status === 'PAUSED') {
        await campaignAPI.resume(id);
        toast.success('Campaign outreach resumed and queue synced', 'Active');
      } else {
        await campaignAPI.pause(id);
        toast.warning('Campaign outreach paused', 'Halted');
      }
      await fetchCampaign();
    } catch {
      toast.error('Could not update campaign status', 'Error');
    }
  };

  const handleDispatchNow = async () => {
    if (!id) return;
    setIsDispatchingNow(true);
    try {
      const res = await campaignAPI.dispatchNow(id);
      const sent = res.data?.summary?.sent || 0;
      toast.success(`Dispatched send batch: ${sent} email(s) sent`, 'Batch Sent (≤5)');
      await fetchCampaign();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Could not trigger queue sweep'), 'Dispatch Error');
    } finally {
      setIsDispatchingNow(false);
    }
  };

  const handleAlertAction = (actionType?: string) => {
    switch (actionType) {
      case 'RESUME':
      case 'ACTIVATE':
        handleTogglePauseResume();
        break;
      case 'RECONCILE_QUEUE':
        handleReconcileQueue();
        break;
      case 'REPERSONALIZE':
        handleRepersonalizeQueue();
        break;
      case 'ASSIGN_SENDERS':
        setActiveTab('settings');
        break;
      case 'NAVIGATE_DOMAINS':
        navigate('/domains');
        break;
      case 'DISPATCH_NOW':
        handleDispatchNow();
        break;
      case 'ADJUST_HOURS':
        setActiveTab('automation');
        break;
      default:
        break;
    }
  };

  const handleDeleteCampaign = async () => {
    if (!id) return;
    try {
      await campaignAPI.delete(id);
      toast.info('Campaign purged permanently', 'Deleted');
      navigate('/campaigns');
    } catch {
      toast.error('Could not delete campaign', 'Error');
    }
  };

  const handleToggleSender = async (senderId: string, checked: boolean) => {
    if (!id) return;
    setUpdatingSender(true);
    try {
      if (checked) {
        await campaignAPI.addSenderToCampaign(id, senderId);
        setCampaignSenderIds((prev) => new Set(prev).add(senderId));
        toast.success('Mailbox attached to campaign rotation', 'Sender Active');
      } else {
        await campaignAPI.removeSenderFromCampaign(id, senderId);
        setCampaignSenderIds((prev) => {
          const next = new Set(prev);
          next.delete(senderId);
          return next;
        });
        toast.info('Mailbox unlinked from rotation', 'Sender Removed');
      }
      await fetchCampaign();
    } catch {
      toast.error('Could not update sender link', 'Error');
    } finally {
      setUpdatingSender(false);
    }
  };

  const handleOpenDraftDrawer = (draft?: any) => {
    if (draft) {
      setEditingDraft(draft);
      setDraftSubject(draft.subject || '');
      setDraftBody(draft.body || '');
    } else {
      setEditingDraft(null);
      setDraftSubject('');
      setDraftBody('');
    }
    setIsDraftDrawerOpen(true);
  };

  const handleSaveDraft = async () => {
    if (!id || !draftSubject.trim() || !draftBody.trim()) return;
    setSavingDraft(true);
    try {
      if (editingDraft) {
        await campaignAPI.updateDraft(id, editingDraft.id, { subject: draftSubject, body: draftBody });
        toast.success('Draft variation updated', 'Saved');
      } else {
        await campaignAPI.createCustomDraft(id, { subject: draftSubject, body: draftBody });
        toast.success('New draft variation created', 'Saved');
      }
      setIsDraftDrawerOpen(false);
      await fetchCampaign();
    } catch {
      toast.error('Could not save draft', 'Error');
    } finally {
      setSavingDraft(false);
    }
  };

  const handleConfirmDeleteDraft = async () => {
    if (!id || !pendingDeleteDraftId) return;
    setDeletingDraft(true);
    try {
      await campaignAPI.deleteDraft(id, pendingDeleteDraftId);
      toast.info('Draft variation deleted', 'Deleted');
      setPendingDeleteDraftId(null);
      await fetchCampaign();
    } catch {
      toast.error('Could not delete draft', 'Error');
    } finally {
      setDeletingDraft(false);
    }
  };

  const handleGenerateAiDraft = async () => {
    if (!id) return;
    setGeneratingDraft(true);
    try {
      await campaignAPI.generateDraft(id);
      toast.success('AI synthesized a fresh tonal draft variation', 'Synthesized');
      await fetchCampaign();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to synthesize draft with active AI provider'), 'AI Error');
    } finally {
      setGeneratingDraft(false);
    }
  };

  const handleGenerateStepDraft = async (stepNumber: number) => {
    if (!id) return;
    setGeneratingDraftFor(stepNumber);
    try {
      await campaignAPI.generateStepDraft(id, stepNumber);
      toast.success(`Synthesized AI draft for step #${stepNumber}`, 'Complete');
      await fetchCampaign();
    } catch (err: any) {
      toast.error(getErrorMessage(err, `Failed to generate draft for step #${stepNumber}`), 'AI Step Draft Error');
    } finally {
      setGeneratingDraftFor(null);
    }
  };

  const handleToggleAutoReply = async (checked: boolean) => {
    if (!id) return;
    setAutoReplyEnabled(checked);
    setSavingAutoReply(true);
    try {
      await campaignAPI.updateAutoReply(id, { autoReplyEnabled: checked });
      toast.success(`Autonomous AI auto-reply is now ${checked ? 'ACTIVE' : 'PAUSED'}`, 'Auto-Reply');
    } catch {
      setAutoReplyEnabled(!checked);
      toast.error('Could not update auto-reply setting', 'Error');
    } finally {
      setSavingAutoReply(false);
    }
  };

  const handleSaveSendHour = async () => {
    if (!id) return;
    setSavingSendHour(true);
    try {
      await campaignAPI.updateSendHour(id, sendHourUTC);
      toast.success(`Preferred send window anchored to ${sendHourUTC}:00 UTC`, 'Saved');
    } catch {
      toast.error('Could not update preferred send hour', 'Error');
    } finally {
      setSavingSendHour(false);
    }
  };

  const handleSaveActiveHours = async () => {
    if (!id) return;
    setSavingActiveHours(true);
    try {
      await campaignAPI.updateActiveHours(id, {
        activeStartHour: activeStartHour === '' ? null : Number(activeStartHour),
        activeEndHour: activeEndHour === '' ? null : Number(activeEndHour),
        timezone,
      });
      toast.success('Active sending hours and timezone updated', 'Saved');
    } catch {
      toast.error('Could not update active hours window', 'Error');
    } finally {
      setSavingActiveHours(false);
    }
  };

  const handleSaveFollowUpSteps = async () => {
    if (!id) return;
    setSavingSteps(true);
    try {
      await campaignAPI.setFollowUpSteps(
        id,
        followUpSteps.map((s) => ({ stepNumber: s.stepNumber, delayDays: s.delayDays }))
      );
      toast.success('Follow-up sequence timeline persisted', 'Flow Updated');
      await fetchCampaign();
    } catch {
      toast.error('Could not save follow-up sequence', 'Error');
    } finally {
      setSavingSteps(false);
    }
  };

  if (initialLoading && !campaign) {
    return <div className="py-24 text-center text-xs text-thistle-500">Loading campaign workflow...</div>;
  }
  if (!campaign) {
    return <div className="py-24 text-center text-rose-500">Campaign not found.</div>;
  }

  const analytics = campaign.analytics || {
    totalLeads: campaign.leads?.length || 0,
    contactedCount: 0,
    queuedCount: campaign.queuedCount || 0,
    sentCount: 0,
    openRate: 0,
    clickRate: 0,
    replyRate: 0,
    bounceRate: 0,
    unsubscribedCount: 0,
  };

  const unsubscribeRate =
    analytics.sentCount > 0 ? Number(((analytics.unsubscribedCount / analytics.sentCount) * 100).toFixed(1)) : 0;

  const getFilteredLeadsForCategory = () => {
    const list = campaign.leads || [];
    const emails = campaign.emails || [];

    switch (drilldownCategory) {
      case 'CONTACTED':
        return list.filter((l: any) => l.outreachStatus === 'SENT' || l.status === 'CONTACTED' || l.status === 'REPLIED');
      case 'OPENED': {
        const openedLeadIds = new Set(emails.filter((e: any) => e.openedAt && !e.isIncoming).map((e: any) => e.leadId));
        return list.filter((l: any) => openedLeadIds.has(l.id));
      }
      case 'CLICKED': {
        const clickedLeadIds = new Set(emails.filter((e: any) => e.clickedAt && !e.isIncoming).map((e: any) => e.leadId));
        return list.filter((l: any) => clickedLeadIds.has(l.id));
      }
      case 'REPLIED': {
        const repliedLeadIds = new Set(emails.filter((e: any) => e.isIncoming).map((e: any) => e.leadId));
        return list.filter((l: any) => l.status === 'REPLIED' || repliedLeadIds.has(l.id));
      }
      case 'BOUNCED':
        return list.filter((l: any) => l.status === 'BOUNCED' || l.outreachStatus === 'BOUNCED');
      case 'UNSUBSCRIBED':
        return list.filter((l: any) => l.status === 'UNSUBSCRIBED');
      case 'ALL':
      default:
        return list;
    }
  };

  const filteredDrilldownLeads = getFilteredLeadsForCategory().filter((l: any) => {
    if (!drilldownSearch.trim()) return true;
    const q = drilldownSearch.toLowerCase();
    return (
      (l.name || '').toLowerCase().includes(q) ||
      (l.email || '').toLowerCase().includes(q) ||
      (l.company || '').toLowerCase().includes(q)
    );
  });

  const openLeadDrawer = (lead: any) => {
    setPreviewLead(lead);
    setIsLeadDrawerOpen(true);
  };

  return (
    <div className="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-6">
      <CampaignHeader
        campaign={campaign}
        role={role}
        canEdit={canEdit}
        canDelete={canDelete}
        onUploadLeadsClick={() => setIsUploadDrawerOpen(true)}
        onInviteClick={() => setShowInviteModal(true)}
        onTogglePauseResume={handleTogglePauseResume}
        onReconcileQueue={handleReconcileQueue}
        onRepersonalizeQueue={handleRepersonalizeQueue}
        onRenameClick={() => setShowRenameModal(true)}
        onStrategyClick={() => setShowStrategyModal(true)}
        onDeleteClick={() => setShowDeleteModal(true)}
        isReconciling={isReconciling}
        isRepersonalizing={isRepersonalizing}
      />

      <CampaignHealthBanner
        alerts={healthAlerts}
        onAction={handleAlertAction}
        isDispatchingNow={isDispatchingNow}
        isReconciling={isReconciling}
        isRepersonalizing={isRepersonalizing}
      />

      <div className="border-b border-gold-500/40">
        <nav className="flex space-x-8 overflow-x-auto" aria-label="Campaign views">
          {[
            ['dashboard', 'Overview & Analytics'],
            ['flow', 'Sequence Flow'],
            ['leads', `Leads (${campaign.leads?.length || 0})`],
            ['drafts', `Copywriting (${campaign.drafts?.length || 0})`],
            ['automation', 'Automation Rules'],
            ['settings', 'Senders & Strategy'],
          ].map(([key, label]) => (
            <button
              key={key}
              type="button"
              onClick={() => setActiveTab(key as TabType)}
              className={`py-3 px-1 border-b-2 text-xs font-bold transition-colors whitespace-nowrap ${
                activeTab === key
                  ? 'border-royal-700 text-royal-800'
                  : 'border-transparent text-thistle-500 hover:text-royal-800'
              }`}
            >
              {label}
            </button>
          ))}
        </nav>
      </div>

      {activeTab === 'dashboard' && (
        <CampaignOverviewTab
          analytics={analytics}
          unsubscribeRate={unsubscribeRate}
          campaign={campaign}
          onSelectCategory={(cat) => setDrilldownCategory(cat)}
          onReconcileQueue={handleReconcileQueue}
          onDispatchNow={handleDispatchNow}
          isReconciling={isReconciling}
          isDispatchingNow={isDispatchingNow}
        />
      )}

      {activeTab === 'flow' && (
        <div className="space-y-8">
          <SequenceCanvas
            steps={followUpSteps}
            drafts={campaign.drafts || []}
            canEdit={canEdit}
            onAddStep={() => {
              const nextNum = (followUpSteps[followUpSteps.length - 1]?.stepNumber || 0) + 1;
              setFollowUpSteps([...followUpSteps, { stepNumber: nextNum, delayDays: 3 }]);
            }}
            onUpdateDelay={(idx, days) => {
              const next = [...followUpSteps];
              next[idx] = { ...next[idx], delayDays: days };
              setFollowUpSteps(next);
            }}
            onRemoveStep={(idx) => setFollowUpSteps(followUpSteps.filter((_, i) => i !== idx))}
            onGenerateDraft={handleGenerateStepDraft}
            generatingDraftFor={generatingDraftFor}
          />

          {canEdit && (
            <div className="flex justify-end">
              <button
                type="button"
                onClick={handleSaveFollowUpSteps}
                disabled={savingSteps}
                className="px-5 py-2.5 btn-royal text-xs font-bold rounded-xl"
              >
                {savingSteps ? 'Saving...' : 'Save Sequence Timeline'}
              </button>
            </div>
          )}
        </div>
      )}

      {activeTab === 'leads' && (
        <div className="space-y-4">
          <div className="flex justify-between items-center">
            <span className="text-xs font-bold text-thistle-500 uppercase tracking-wider">Prospects in this Sequence</span>
            {canEdit && (
              <button
                type="button"
                onClick={() => setIsUploadDrawerOpen(true)}
                className="px-3.5 py-1.5 btn-royal text-xs font-bold rounded-xl flex items-center gap-1.5"
              >
                <Icons.Plus className="text-gold-300" />
                <span>Upload Leads to Campaign</span>
              </button>
            )}
          </div>

          <div className="bg-white rounded-2xl border border-gold-500/40 overflow-hidden shadow-xs">
            {(!campaign.leads || campaign.leads.length === 0) ? (
              <div className="py-20 text-center text-xs text-thistle-500 space-y-2">
                <p>No leads attached to this sequence yet.</p>
                {canEdit && (
                  <button type="button" onClick={() => setIsUploadDrawerOpen(true)} className="text-royal-700 font-bold hover:underline">
                    Upload and map your first lead list
                  </button>
                )}
              </div>
            ) : (
              <table className="min-w-full divide-y divide-gold-500/25 text-left text-xs">
                <thead className="bg-thistle-100/75 text-royal-800 font-bold uppercase tracking-wider border-b border-gold-500/35">
                  <tr>
                    <th className="py-3 px-4">Name</th>
                    <th className="py-3 px-4">Email</th>
                    <th className="py-3 px-4">Company</th>
                    <th className="py-3 px-4">Outreach Status</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gold-500/20 font-medium text-royal-950">
                  {campaign.leads.map((l: any) => (
                    <tr
                      key={l.id}
                      tabIndex={0}
                      role="button"
                      aria-label={`Inspect conversation and enrichment for ${l.name}`}
                      onClick={() => openLeadDrawer(l)}
                      onKeyDown={(e) => {
                        if (e.key === 'Enter' || e.key === ' ') {
                          e.preventDefault();
                          openLeadDrawer(l);
                        }
                      }}
                      className="hover:bg-thistle-50/80 cursor-pointer transition-colors"
                    >
                      <td className="py-3 px-4 font-bold text-royal-950">{l.name}</td>
                      <td className="py-3 px-4 font-mono text-thistle-500">{l.email}</td>
                      <td className="py-3 px-4 text-royal-950/75">{l.company || '—'}</td>
                      <td className="py-3 px-4">
                        <span className="px-2 py-0.5 rounded font-semibold text-[10px] bg-thistle-100 text-royal-800 border border-gold-500/30">
                          {l.outreachStatus || l.status}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </div>
      )}

      {activeTab === 'drafts' && (
        <CampaignDraftsTab
          campaignId={campaign.id}
          drafts={campaign.drafts || []}
          canEdit={canEdit}
          onGenerateAiDraft={handleGenerateAiDraft}
          onOpenCustomDraftModal={() => handleOpenDraftDrawer()}
          onEditDraft={handleOpenDraftDrawer}
          onDeleteDraft={(draftId) => setPendingDeleteDraftId(draftId)}
          generatingDraft={generatingDraft}
        />
      )}

      {activeTab === 'automation' && (
        <CampaignAutomationTab
          canEdit={canEdit}
          autoReplyEnabled={autoReplyEnabled}
          savingAutoReply={savingAutoReply}
          onToggleAutoReply={handleToggleAutoReply}
          sendHourUTC={sendHourUTC}
          savingSendHour={savingSendHour}
          onSendHourChange={setSendHourUTC}
          onSaveSendHour={handleSaveSendHour}
          activeStartHour={activeStartHour}
          activeEndHour={activeEndHour}
          timezone={timezone}
          savingActiveHours={savingActiveHours}
          onStartHourChange={setActiveStartHour}
          onEndHourChange={setActiveEndHour}
          onTimezoneChange={setTimezone}
          onSaveActiveHours={handleSaveActiveHours}
        />
      )}

      {activeTab === 'settings' && (
        <CampaignSettingsTab
          campaign={campaign}
          userSenders={userSenders}
          campaignSenderIds={campaignSenderIds}
          canEdit={canEdit}
          updatingSender={updatingSender}
          onToggleSender={handleToggleSender}
          onEditStrategyClick={() => setShowStrategyModal(true)}
        />
      )}

      <DrilldownDrawer
        isOpen={Boolean(drilldownCategory)}
        onClose={() => {
          setDrilldownCategory(null);
          setDrilldownSearch('');
        }}
        category={drilldownCategory}
        leads={filteredDrilldownLeads}
        searchQuery={drilldownSearch}
        onSearchChange={setDrilldownSearch}
        onLeadClick={(lead) => openLeadDrawer(lead)}
      />

      <Sheet
        isOpen={isUploadDrawerOpen}
        onClose={() => setIsUploadDrawerOpen(false)}
        title={`Import Leads into "${campaign.name}"`}
        description="Ingest, verify, and match fields directly. Ingested leads are queued for outreach immediately."
        width="2xl"
      >
        <UploadArea
          campaignId={campaign.id}
          onJobComplete={() => {
            fetchCampaign();
            setIsUploadDrawerOpen(false);
          }}
        />
      </Sheet>

      <LeadDrawer
        isOpen={isLeadDrawerOpen}
        onClose={() => setIsLeadDrawerOpen(false)}
        lead={previewLead}
        campaignId={campaign.id}
        onUpdate={() => fetchCampaign()}
      />

      <Sheet
        isOpen={isDraftDrawerOpen}
        onClose={() => setIsDraftDrawerOpen(false)}
        title={editingDraft ? 'Edit Copywriting Draft' : 'Create Custom Draft'}
        description="Include Spintax {Option A|Option B}, {{name}}, {{company}}, or {{artifact:slug}} tokens."
      >
        <div className="space-y-4">
          <div>
            <label className="block text-xs font-bold text-royal-800 uppercase mb-1">Subject Line</label>
            <input
              type="text"
              value={draftSubject}
              onChange={(e) => setDraftSubject(e.target.value)}
              className="w-full px-3 py-2 border border-gold-500/35 rounded-xl text-xs font-medium focus:outline-none focus:border-gold-500"
            />
          </div>
          <div>
            <label className="block text-xs font-bold text-royal-800 uppercase mb-1">Body Text</label>
            <textarea
              rows={10}
              value={draftBody}
              onChange={(e) => setDraftBody(e.target.value)}
              className="w-full p-3 border border-gold-500/35 rounded-xl text-xs font-mono focus:outline-none focus:border-gold-500"
            />
          </div>
          <div className="flex justify-end gap-2 pt-3 border-t border-gold-500/35">
            <button type="button" onClick={() => setIsDraftDrawerOpen(false)} className="px-3 py-1.5 text-xs text-thistle-500 hover:text-royal-950 font-bold">
              Cancel
            </button>
            <button
              type="button"
              onClick={handleSaveDraft}
              disabled={savingDraft}
              className="px-4 py-2 btn-royal text-xs font-bold rounded-xl"
            >
              {savingDraft ? 'Saving...' : 'Save Draft'}
            </button>
          </div>
        </div>
      </Sheet>

      <ConfirmDialog
        isOpen={Boolean(pendingDeleteDraftId)}
        onClose={() => setPendingDeleteDraftId(null)}
        onConfirm={handleConfirmDeleteDraft}
        title="Delete Draft Variation"
        description="Are you sure you want to permanently delete this email draft variation?"
        confirmLabel="Delete Draft"
        loading={deletingDraft}
      />

      <RenameCampaignModal isOpen={showRenameModal} onClose={() => setShowRenameModal(false)} campaign={campaign} onSuccess={() => fetchCampaign()} />
      <DeleteCampaignModal isOpen={showDeleteModal} onClose={() => setShowDeleteModal(false)} onConfirm={handleDeleteCampaign} campaignName={campaign.name} />
      <EditStrategyModal isOpen={showStrategyModal} onClose={() => setShowStrategyModal(false)} campaign={campaign} onSuccess={() => fetchCampaign()} />
      <InviteCollaboratorModal isOpen={showInviteModal} onClose={() => setShowInviteModal(false)} campaignId={campaign.id} onSuccess={() => fetchCampaign()} />
    </div>
  );
};
</file>

<file path="server/config/env.ts">
import { z } from 'zod';
import dotenv from 'dotenv';
import crypto from 'crypto';

dotenv.config();

if (process.env.NODE_ENV !== 'production' && !process.env.CRON_SECRET) {
  process.env.CRON_SECRET = crypto.randomBytes(32).toString('hex');
  console.warn(
    '[env] CRON_SECRET is not set — generated a temporary development-only value ' +
    '(changes every restart). Set it explicitly before deploying: openssl rand -hex 32'
  );
}

const envSchema = z.object({
  NODE_ENV: z.enum(['development', 'production', 'test']).default('development'),
  PORT: z.string().default('3000'),
  DATABASE_URL: z.string().url(),
  CORS_ORIGIN: z.string().default('http://localhost:5173,https://midas-aem.vercel.app'),
  CORS_VERCEL_PROJECT_PREFIX: z.string().default('midas-aem'),
  MAX_FILE_SIZE_MB: z.string().default('10'),
  ENCRYPTION_KEY: z.string().optional(),
  EMAIL_SERVICE: z.enum(['ethereal', 'smtp', 'mailgun']).default('mailgun'),
  EMAIL_FROM: z.string().default('midas-aem.vercel.app'),
  APP_URL: z.string().url().optional(),

  // Authentication Mode ('clerk' | 'supabase' | 'dual')
  AUTH_PROVIDER: z.enum(['clerk', 'supabase', 'dual']).default('dual'),
  CLERK_SECRET_KEY: z.string().optional(),
  CLERK_PUBLISHABLE_KEY: z.string().optional(),
  VITE_CLERK_PUBLISHABLE_KEY: z.string().optional(),
  CLERK_WEBHOOK_SECRET: z.string().optional(),

  // Supabase Infrastructure
  SUPABASE_URL: z.string().url().optional(),
  SUPABASE_ANON_KEY: z.string().optional(),
  SUPABASE_SERVICE_ROLE_KEY: z.string().optional(),
  SUPABASE_STORAGE_BUCKET: z.string().default('midas-uploads'),
  STORAGE_PROVIDER: z.enum(['auto', 'supabase', 'vercel_blob']).default('auto'),

  // Dodo Payments
  DODO_PAYMENTS_API_KEY: z.string().optional(),
  DODO_PAYMENTS_WEBHOOK_SECRET: z.string().optional(),
  DODO_PAYMENTS_MODE: z.enum(['test_mode', 'live_mode']).default('test_mode'),
  DODO_PRODUCT_CHIEF_MONTHLY: z.string().optional(),
  DODO_PRODUCT_CHIEF_ANNUAL: z.string().optional(),
  DODO_PRODUCT_SYNDICATE_MONTHLY: z.string().optional(),
  DODO_PRODUCT_SYNDICATE_ANNUAL: z.string().optional(),

  // ESP Webhooks & Credentials
  MAILGUN_API_KEY: z.string().optional(),
  MAILGUN_WEBHOOK_KEY: z.string().optional(),
  MAILGUN_REGION: z.enum(['us', 'eu']).default('us'),
  RESEND_WEBHOOK_SECRET: z.string().optional(),

  // Upstash Redis REST
  UPSTASH_REDIS_REST_URL: z.string().url().optional(),
  UPSTASH_REDIS_REST_TOKEN: z.string().optional(),

  // Zero-Setup Sandbox Mode
  SANDBOX_DOMAIN: z.string().optional(),
  SANDBOX_MAILGUN_KEY: z.string().optional(),
  SANDBOX_REGION: z.enum(['us', 'eu']).default('us'),
  SANDBOX_DAILY_LIMIT: z.string().default('15').transform((v) => Math.max(1, Number(v) || 15)),

  // Cloudflare for SaaS Tracking Custom Hostnames
  CLOUDFLARE_API_TOKEN: z.string().optional(),
  CLOUDFLARE_ZONE_ID: z.string().optional(),
  CLOUDFLARE_SAAS_FALLBACK_ORIGIN: z.string().optional(),

  // Automation & Cron Infrastructure
  CRON_SECRET: z.string().optional(),
  BLOB_READ_WRITE_TOKEN: z.string().optional(),

  // Send Rate Safety Guards
  SEND_SWEEP_BATCH_SIZE: z.string().default('5').transform((v) => Math.min(Math.max(1, Number(v) || 5), 10)),
  SENDER_COOLDOWN_SECONDS: z.string().default('20').transform((v) => Math.max(5, Number(v) || 20)),

  // Optional Upstash QStash signature verification
  QSTASH_CURRENT_SIGNING_KEY: z.string().optional(),
  QSTASH_NEXT_SIGNING_KEY: z.string().optional(),

  // Modular email verification
  VERIFICATION_PROVIDER: z.enum(['mock', 'bounceban', 'neverbounce', 'zerobounce']).default('mock'),
  BOUNCEBAN_API_KEY: z.string().optional(),
  NEVERBOUNCE_API_KEY: z.string().optional(),
  ZEROBOUNCE_API_KEY: z.string().optional(),

  // AI Provider Credentials
  AI_PROVIDER: z.enum(['mock', 'openai', 'gemini', 'ollama', 'deepseek', 'openrouter', 'aigateway']).default('aigateway'),
  PRIMARY_FALLBACK_PROVIDER: z.enum(['mock', 'openai', 'gemini', 'ollama', 'deepseek', 'openrouter', 'aigateway']).optional(),
  OPENAI_API_KEY: z.string().optional(),
  OPENAI_MODEL: z.string().default('gpt-4o-mini'),
  GEMINI_API_KEY: z.string().optional(),
  GEMINI_MODEL: z.string().default('gemini-1.5-flash'),
  DEEPSEEK_API_KEY: z.string().optional(),
  DEEPSEEK_MODEL: z.string().default('deepseek-chat'),
  OPENROUTER_API_KEY: z.string().optional(),
  OPENROUTER_MODEL: z.string().default('deepseek/deepseek-chat'),
  AI_GATEWAY_API_KEY: z.string().optional(),
  AI_GATEWAY_KEY: z.string().optional(),
  AI_GATEWAY_URL: z.string().default('https://ai-gateway.vercel.sh/v1'),
  AI_GATEWAY_MODEL: z.string().default('openai/gpt-4o-mini'),
  OLLAMA_URL: z.string().default('http://localhost:11434'),
  OLLAMA_FAST_MODEL: z.string().default('llama3.2:1b'),
  OLLAMA_POWERFUL_MODEL: z.string().default('llama3.1:8b'),

  AI_REQUEST_DELAY_MS: z.string().default('500').transform(Number),
});

const parsed = envSchema.safeParse(process.env);
if (!parsed.success) {
  console.error('Invalid environment variables:', parsed.error.format());
  process.exit(1);
}

export const env = parsed.data;
</file>

<file path="server/app.ts">
import express from 'express';
import cors from 'cors';
import { env } from './config/env';
import { logger } from './config/logger';
import { requireAuth } from './middleware/auth.middleware';
import { requireAdmin } from './middleware/requireAdmin.middleware';
import { requireAuthOrApiKey } from './middleware/dualAuth.middleware';
import { requestTimeoutGuard } from './middleware/requestTimeoutGuard.middleware';
import { createRateLimiter, limitMetadataSize } from './middleware/rateLimit.middleware';
import cronRoutes from './routes/cron.routes';
import leadRoutes from './routes/lead.routes';
import campaignRoutes from './routes/campaign.routes';
import domainRoutes from './routes/domain.routes';
import webhookRoutes from './routes/webhooks.routes';
import webhookSubscriptionRoutes from './routes/webhookSubscription.routes';
import inboxRoutes from './routes/inbox.routes';
import aiRoutes from './routes/ai.routes';
import diagnosticRoutes from './routes/diagnostic.routes';
import userRoutes from './routes/user.routes';
import userSettingsRoutes from './routes/userSettings.routes';
import configRoutes from './routes/config.routes';
import unsubscribeRoutes from './routes/unsubscribe.routes';
import adminRoutes from './routes/admin.routes';
import migrationRoutes from './routes/migration.routes';
import trackRoutes from './routes/track.routes';
import townCrierRoutes from './routes/townCrier.routes';
import townCrierPublicRoutes from './routes/public/townCrier.public.routes';
import notificationRoutes from './routes/notification.routes';
import apiKeyRoutes from './routes/apiKey.routes';
import sandboxRoutes from './routes/sandbox.routes';
import knowledgeRoutes from './routes/knowledge.routes';
import artifactRoutes from './routes/artifact.routes';
import billingRoutes from './routes/billing.routes';

const app = express();

const allowedOrigins = (env.CORS_ORIGIN || '')
  .split(',')
  .map(o => o.trim().replace(/\/$/, ''))
  .filter(Boolean);

app.use(cors({
  origin: (origin, callback) => {
    if (!origin) return callback(null, true);

    const cleanOrigin = origin.trim().replace(/\/$/, '');

    const isOwnVercelPreview =
      /^https:\/\/[a-z0-9-]+\.vercel\.app$/.test(cleanOrigin) &&
      cleanOrigin.includes(`${env.CORS_VERCEL_PROJECT_PREFIX}-`);

    const isAllowed =
      allowedOrigins.includes(cleanOrigin) ||
      isOwnVercelPreview ||
      /^https?:\/\/localhost(:\d+)?$/.test(cleanOrigin) ||
      /^https?:\/\/127\.0\.0\.1(:\d+)?$/.test(cleanOrigin);

    callback(null, isAllowed);
  },
  credentials: true,
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS', 'PATCH'],
  allowedHeaders: ['Content-Type', 'Authorization', 'X-Requested-With', 'Accept', 'x-operator-token', 'x-action-passphrase'],
}));

app.use((req, res, next) => {
  const start = Date.now();
  res.on('finish', () => {
    const duration = Date.now() - start;
    logger.info(`[HTTP] ${req.method} ${req.originalUrl} ${res.statusCode} - ${duration}ms`);
  });
  next();
});

app.get('/api/health', (_req, res) => {
  res.status(200).json({ status: 'ok', timestamp: new Date().toISOString() });
});

app.use(express.json({
  limit: '10mb',
  verify: (req: any, _res, buf) => {
    req.rawBody = buf;
  },
}));
app.use(express.urlencoded({ extended: true, limit: '10mb' }));

app.use(requestTimeoutGuard(15000));

const publicSubscribeLimiter = createRateLimiter({
  windowMs: 60 * 1000,
  max: 60,
  keyPrefix: 'tc_sub',
  message: 'Subscription rate limit exceeded. Please wait a minute before retrying.',
});

const publicTelemetryLimiter = createRateLimiter({
  windowMs: 60 * 1000,
  max: 300,
  keyPrefix: 'pub_tel',
});

app.use('/api/webhooks', webhookRoutes);
app.use('/api/cron', cronRoutes);
app.use('/api/config', configRoutes);
app.use('/api/unsubscribe', publicTelemetryLimiter, unsubscribeRoutes);
app.use('/api/track', publicTelemetryLimiter, trackRoutes);

app.post('/api/public/town-crier/subscribe', publicSubscribeLimiter, limitMetadataSize(16384));
app.post('/api/public/town-crier/recipients/import', publicSubscribeLimiter);
app.use('/api/public/town-crier', townCrierPublicRoutes);

app.use('/api/campaigns', requireAuthOrApiKey, campaignRoutes);
app.use('/api/leads', requireAuthOrApiKey, leadRoutes);
app.use('/api/sandbox', requireAuthOrApiKey, sandboxRoutes);
app.use('/api/artifacts', requireAuthOrApiKey, artifactRoutes);

app.use('/api/domains', requireAuth, domainRoutes);
app.use('/api/inbox', requireAuth, inboxRoutes);
app.use('/api/ai', requireAuth, aiRoutes);
app.use('/api/knowledge', requireAuth, knowledgeRoutes);
app.use('/api/billing', requireAuth, billingRoutes);
app.use('/api/user', requireAuth, userRoutes);
app.use('/api/user/settings', requireAuth, userSettingsRoutes);
app.use('/api/user/webhooks', requireAuth, webhookSubscriptionRoutes);
app.use('/api/diagnostics', requireAuth, diagnosticRoutes);
app.use('/api/town-crier', requireAuth, townCrierRoutes);
app.use('/api/notifications', requireAuth, notificationRoutes);
app.use('/api/api-keys', requireAuth, apiKeyRoutes);
app.use('/api/admin/migration', requireAuth, requireAdmin, migrationRoutes);
app.use('/api/admin', requireAuth, adminRoutes);

export default app;
</file>

<file path="prisma/schema.prisma">
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- Midas Core Models ---
model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  email          String    @unique
  password       String?   
  clerkId        String?   @unique @map("clerk_id")
  supabaseAuthId String?   @unique @map("supabase_auth_id")
  isAdmin        Boolean   @default(false) @map("is_admin")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  leads          Lead[]
  campaigns      Campaign[]
  drafts         Draft[]
  settings       UserSettings?
  subscription   Subscription?
  domains        Domain[]
  outboundEmails OutboundEmail[]
  pendingEmails  PendingEmail[]
  uploadJobs     UploadJob[]
  blocklist      Blocklist[]
  memberships    CampaignMember[]
  invitesSent    CampaignInvite[]

  apiKeys              ApiKey[]
  gongs                Gong[]
  newsletterRecipients NewsletterRecipient[]
  newsletterBroadcasts NewsletterBroadcast[]
  newsletterQueueItems NewsletterQueueItem[]
  notifications        Notification[]
  webhookSubscriptions WebhookSubscription[]
  knowledgeBases       KnowledgeBase[]
  knowledgeResources   KnowledgeResource[]
  artifacts            Artifact[]

  @@map("users")
}

// --- SAAS SUBSCRIPTION & QUOTA LEDGER (DODO PAYMENTS) ---

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id") @db.Uuid
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("SCOUT") // 'SCOUT' | 'CHIEF' | 'SYNDICATE'
  status               String    @default("ACTIVE") // 'ACTIVE' | 'PAST_DUE' | 'CANCELLED'
  billingCycle         String    @default("monthly") @map("billing_cycle")
  dodoCustomerId       String?   @map("dodo_customer_id")
  dodoSubscriptionId   String?   @unique @map("dodo_subscription_id")
  currentPeriodStart   DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  aiCreditsUsed        Int       @default(0) @map("ai_credits_used")
  emailsSentThisMonth  Int       @default(0) @map("emails_sent_this_month")
  periodResetAt        DateTime  @default(now()) @map("period_reset_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
}

// --- Domain & Deliverability Engine ---
model Domain {
  id               String   @id @default(cuid())
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  domainName       String   @unique @map("domain_name")
  status           String   @default("pending_setup")
  espProvider      String   @default("mailgun") @map("esp_provider")
  
  dkimStatus       Boolean  @default(false)
  spfStatus        Boolean  @default(false)
  mxStatus         Boolean  @default(false)
  trackingStatus   Boolean  @default(false)
  dnsRecords       String?  @db.Text 
  mailgunApiKeyEncrypted String? @db.Text @map("mailgun_api_key_encrypted")
  smtpConfigEncrypted    String? @db.Text @map("smtp_config_encrypted")
  mailgunRegion    String?  @map("mailgun_region")

  trackingDomain         String? @map("tracking_domain")
  trackingHostnameStatus String? @map("tracking_hostname_status")

  sendTestPassedAt     DateTime? @map("send_test_passed_at")
  receivingTestCode    String?   @map("receiving_test_code")
  receivingTestAddress String?   @map("receiving_test_address")
  receivingConfirmedAt DateTime? @map("receiving_confirmed_at")

  bounceCount      Int      @default(0) @map("bounce_count")
  replyCount       Int      @default(0) @map("reply_count")
  bounceRate       Float    @default(0.0)
  complaintRate    Float    @default(0.0)

  routeId          String?  @map("route_id")

  bimiEnabled      Boolean  @default(false) @map("bimi_enabled")
  bimiSvgUrl       String?  @map("bimi_svg_url")
  bimiVmcUrl       String?  @map("bimi_vmc_url")
  dmarcPolicy      String?  @map("dmarc_policy")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  senders                Sender[]
  outboundEmails         OutboundEmail[]  @relation("OutboundEmailDomain")
  pendingEmails          PendingEmail[]   @relation("PendingEmailDomain")
  healthSnapshots        DomainHealthSnapshot[]

  @@index([userId])
}

model DomainHealthSnapshot {
  id             String   @id @default(cuid())
  domainId       String   @map("domain_id")
  domain         Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  snapshotDate   String   @map("snapshot_date")
  sentCount      Int      @default(0) @map("sent_count")
  rawOpenCount   Int      @default(0) @map("raw_open_count")
  humanOpenCount Int      @default(0) @map("human_open_count")
  clickCount     Int      @default(0) @map("click_count")
  replyCount     Int      @default(0) @map("reply_count")
  bounceCount    Int      @default(0) @map("bounce_count")
  complaintCount Int      @default(0) @map("complaint_count")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([domainId, snapshotDate])
  @@index([domainId])
}

model Sender {
  id               String    @id @default(cuid())
  domainId         String    @map("domain_id")
  domain           Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  userId           String    @map("user_id") @db.Uuid
  localPart        String    @map("local_part")
  displayName      String?   @map("display_name")
  status           String    @default("active")
  warmupDay        Int       @default(1) @map("warmup_day")
  dailyLimit       Int       @default(20) @map("daily_limit")
  sentCountToday   Int       @default(0) @map("sent_count_today")
  lastSentReset    DateTime  @default(now()) @map("last_sent_reset")
  lastDispatchedAt DateTime? @map("last_dispatched_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  campaignLinks          CampaignSender[]
  preferredPendingEmails PendingEmail[]   @relation("PendingEmailPreferredSender")
  dedicatedSettings      UserSettings[]   @relation("DedicatedNewsletterSender")
  gongDedicatedChannels  Gong[]           @relation("GongDedicatedSender")
  outboundEmails         OutboundEmail[]  @relation("OutboundEmailSender")

  @@unique([domainId, localPart])
  @@index([userId])
}

model CampaignSender {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId   String   @map("sender_id")
  sender     Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now()) @map("added_at")
  @@unique([campaignId, senderId])
}

enum CampaignRole {
  OWNER
  EDITOR
  VIEWER
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String       @map("campaign_id")
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       CampaignRole @default(EDITOR)
  joinedAt   DateTime     @default(now()) @map("joined_at")

  @@unique([campaignId, userId])
  @@index([userId])
}

model CampaignInvite {
  id         String       @id @default(cuid())
  campaignId String       @map("campaign_id")
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId   String       @map("sender_id") @db.Uuid
  sender     User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  email      String
  role       CampaignRole @default(EDITOR)
  token      String       @unique
  accepted   Boolean      @default(false)
  expiresAt  DateTime     @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([email])
}

model Campaign {
  id                String   @id @default(cuid())
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  context           String?
  reference         String?
  senderName        String?  @map("sender_name")
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now()) @map("created_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  lastDomainIndex   Int      @default(0) @map("last_domain_index")
  autoReplyEnabled  Boolean  @default(false) @map("auto_reply_enabled")
  sendHourUTC       Int      @default(9) @map("send_hour_utc")
  activeStartHour   Int?     @map("active_start_hour")
  activeEndHour     Int?     @map("active_end_hour")
  timezone          String?
  objective         String?
  targetTool        String?  @map("target_tool")
  extendedObjective String?  @map("extended_objective")

  knowledgeBaseId   String?        @map("knowledge_base_id")
  knowledgeBase     KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  followUpSteps  FollowUpStep[]
  leads          Lead[]
  emails         OutboundEmail[]
  drafts         Draft[]
  pendingEmails  PendingEmail[]
  senderLinks    CampaignSender[] 
  members        CampaignMember[]
  invites        CampaignInvite[]
  artifacts      Artifact[]

  @@index([userId])
  @@index([knowledgeBaseId])
}

model Blocklist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern   String   
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId, pattern])
}

model UploadJob {
  id             String   @id @default(cuid())
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename       String
  blobUrl        String   @db.Text
  status         String   @default("PENDING") 
  error          String?  @db.Text
  totalRows      Int      @default(0)
  validLeads     Int      @default(0)
  catchAllLeads  Int      @default(0)
  invalidLeads   Int      @default(0)
  blockedLeads   Int      @default(0)
  duplicates     Int      @default(0)
  verificationId String?  
  verifyEmails   Boolean  @default(false) @map("verify_emails")
  pendingRows    String?  @db.Text
  columnMapping  String?  @db.Text @map("column_mapping")
  campaignId     String?  @map("campaign_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([userId])
  @@index([status])
}

model Lead {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id") @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  email              String
  company            String?
  position           String?
  status             String    @default("NEW")
  outreachStatus     String?   @map("outreach_status")
  verificationStatus String    @default("UNVERIFIED") @map("verification_status")
  unsubscribeToken   String?   @unique @map("unsubscribe_token")
  enrichedData       Json?     @map("enriched_data")
  enrichedAt         DateTime? @map("enriched_at")
  campaignId         String?   @map("campaign_id")
  campaign           Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  
  sentEmails     OutboundEmail[]
  replyDrafts    Draft[]         @relation("LeadDrafts")
  pendingEmails  PendingEmail[]
  activityEvents LeadActivityEvent[]

  @@unique([userId, email])
  @@index([userId])
  @@index([campaignId])
  @@index([status])
}

model LeadActivityEvent {
  id         String   @id @default(cuid())
  leadId     String   @map("lead_id")
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId String?  @map("campaign_id")
  eventType  String   @map("event_type")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([leadId, eventType])
  @@index([campaignId, createdAt])
}

model Draft {
  id           String   @id @default(cuid())
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  body         String
  tone         String
  useCase      String   @map("use_case")
  version      Int      @default(1)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  campaignId   String?  @map("campaign_id")
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  leadId       String?  @map("lead_id")
  lead         Lead?    @relation("LeadDrafts", fields: [leadId], references: [id], onDelete: SetNull)
  isReplyDraft Boolean  @default(false) @map("is_reply_draft")
  stepNumber   Int?     @map("step_number") 
  sentCount    Int      @default(0) @map("sent_count")
  replyCount   Int      @default(0) @map("reply_count")

  emails        OutboundEmail[]
  followUpSteps FollowUpStep[]
  pendingEmails PendingEmail[]
}

model FollowUpStep {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepNumber Int
  delayDays  Int
  draftId    String?  @map("draft_id")
  draft      Draft?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@unique([campaignId, stepNumber])
}

model OutboundEmail {
  id          String   @id @default(cuid())
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId    String?  @map("domain_id")
  domain      Domain?  @relation("OutboundEmailDomain", fields: [domainId], references: [id], onDelete: SetNull)
  senderId    String?  @map("sender_id")
  sender      Sender?  @relation("OutboundEmailSender", fields: [senderId], references: [id], onDelete: SetNull)
  leadId      String   @map("lead_id")
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId  String?  @map("campaign_id")
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  draftId     String?  @map("draft_id")
  draft       Draft?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  
  subject     String
  body        String
  sentAt      DateTime @default(now()) @map("sent_at")
  status      String   @default("SENT")
  error       String?

  openedAt      DateTime? @map("opened_at")
  clickedAt     DateTime? @map("clicked_at") 
  bouncedAt     DateTime? @map("bounced_at") 
  spamComplaint Boolean   @default(false) @map("spam_complaint") 
  repliedAt     DateTime? @map("replied_at")
  replyText     String?   @map("reply_text")

  replyToId     String?         @map("reply_to_id")
  replyTo       OutboundEmail?  @relation("Replies", fields: [replyToId], references: [id])
  replies       OutboundEmail[] @relation("Replies")
  isIncoming    Boolean         @default(false) @map("is_incoming")
  messageId     String?         @map("message_id")
  references    String?
  inReplyTo     String?         @map("in_reply_to")
  fromAddress   String?         @map("from_address")
  toAddress     String?         @map("to_address")
  sentiment     String?
  intent        String?
  analysis      String?

  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
  @@index([messageId])
  @@index([senderId])
}

model PendingEmail {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id") @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId           String?  @map("domain_id")
  domain             Domain?  @relation("PendingEmailDomain", fields: [domainId], references: [id], onDelete: SetNull)
  campaignId         String   @map("campaign_id")
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId             String   @map("lead_id")
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  draftId            String?  @map("draft_id")
  draft              Draft?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  subject            String
  body               String
  inReplyTo          String?  @map("in_reply_to")
  scheduledAt        DateTime? @map("scheduled_at")
  status             String   @default("PENDING") 
  error              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  priority           Int      @default(2)
  preferredSenderId  String?  @map("preferred_sender_id")
  preferredSender    Sender?  @relation("PendingEmailPreferredSender", fields: [preferredSenderId], references: [id], onDelete: SetNull)
  @@index([status, scheduledAt])
  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
}

model UserSettings {
  userId            String   @id @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendLimit         Int?     @map("send_limit")
  sendPeriod        String?  @map("send_period")
  companyName       String?  @map("company_name")
  physicalAddress   String?  @map("physical_address")
  customOptOutText  String?  @map("custom_opt_out_text")
  
  aiProvider        String?  @map("ai_provider")
  aiModel           String?  @map("ai_model")
  aiApiKeyEncrypted String?  @db.Text @map("ai_api_key_encrypted")
  aiGatewayUrl      String?  @map("ai_gateway_url")
  aiIntegrations    Json?    @map("ai_integrations")

  brandColorHex     String?  @map("brand_color_hex")
  brandInitials     String?  @map("brand_initials")
  logoUrl           String?  @map("logo_url")
  brandingEnabled   Boolean  @default(false) @map("branding_enabled")

  dedicatedNewsletterSenderId String? @map("dedicated_newsletter_sender_id")
  dedicatedNewsletterSender   Sender? @relation("DedicatedNewsletterSender", fields: [dedicatedNewsletterSenderId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
}

// --- MULTI-RESOURCE KNOWLEDGE BASES ---

model KnowledgeBase {
  id          String              @id @default(cuid())
  userId      String              @map("user_id") @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean             @default(false) @map("is_default")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  resources   KnowledgeResource[]
  campaigns   Campaign[]
  gongs       Gong[]
  broadcasts  NewsletterBroadcast[]

  @@index([userId])
}

model KnowledgeResource {
  id              String        @id @default(cuid())
  knowledgeBaseId String        @map("knowledge_base_id")
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  sourceType      String        @default("TEXT") @map("source_type") // 'TEXT' | 'URL' | 'FILE'
  sourceUrl       String?       @map("source_url")
  fileUrl         String?       @map("file_url")
  mimeType        String?       @map("mime_type")
  content         String        @db.Text
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([knowledgeBaseId])
  @@index([userId])
}

// --- ARTIFACTS (LINKS, ONE-TIME ATTACHMENTS & AI USAGE PROMPTS) ---

model Artifact {
  id             String               @id @default(cuid())
  userId         String               @map("user_id") @db.Uuid
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId     String?              @map("campaign_id")
  campaign       Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  gongId         String?              @map("gong_id")
  gong           Gong?                @relation(fields: [gongId], references: [id], onDelete: SetNull)
  broadcastId    String?              @map("broadcast_id")
  broadcast      NewsletterBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  title          String
  slug           String
  description    String?              @db.Text
  usagePrompt    String?              @db.Text @map("usage_prompt")
  type           String               @default("LINK") // 'LINK' | 'DOCUMENT' | 'IMAGE'
  attachmentMode String               @default("LINK") @map("attachment_mode") // 'LINK' | 'MIME_ATTACHMENT'
  isOneTime      Boolean              @default(false) @map("is_one_time")
  url            String               @db.Text
  mimeType       String?              @map("mime_type")
  sizeBytes      Int?                 @map("size_bytes")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@unique([userId, slug])
  @@index([userId])
  @@index([campaignId])
  @@index([gongId])
  @@index([broadcastId])
}

// --- DEVELOPER API KEYS ---

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @map("key_hash")
  scopes     String[]  @default(["*"])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([keyPrefix])
}

// --- TOWN CRIER "GONG" CHANNELS & NEWSLETTER MODELS ---

model Gong {
  id                   String                 @id @default(cuid())
  userId               String                 @map("user_id") @db.Uuid
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  description          String?
  cadence              String                 @default("weekly")
  templateStyle        String                 @default("card") @map("template_style")
  dedicatedSenderId    String?                @map("dedicated_sender_id")
  dedicatedSender      Sender?                @relation("GongDedicatedSender", fields: [dedicatedSenderId], references: [id], onDelete: SetNull)
  knowledgeBaseId      String?                @map("knowledge_base_id")
  knowledgeBase        KnowledgeBase?         @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  
  welcomeEmailEnabled  Boolean                @default(false) @map("welcome_email_enabled")
  welcomeSubject       String?                @map("welcome_subject")
  welcomeBody          String?                @db.Text @map("welcome_body")
  
  embedTheme           String                 @default("minimal") @map("embed_theme")
  accentColor          String                 @default("#4A2559") @map("accent_color")
  headline             String                 @default("Join our newsletter")
  subheadline          String                 @default("Get the latest updates delivered to your inbox.")
  buttonText           String                 @default("Subscribe") @map("button_text")
  successMessage       String                 @default("Thank you for subscribing!") @map("success_message")
  tags                 String[]               @default([])

  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  recipients           NewsletterRecipient[]
  broadcasts           NewsletterBroadcast[]
  artifacts            Artifact[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([dedicatedSenderId])
  @@index([knowledgeBaseId])
}

model NewsletterRecipient {
  id               String   @id @default(cuid())
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gongId           String?  @map("gong_id")
  gong             Gong?    @relation(fields: [gongId], references: [id], onDelete: SetNull)
  email            String
  name             String?
  cadence          String   @default("weekly")
  status           String   @default("SUBSCRIBED")
  source           String   @default("ui")
  tags             String[] @default([])
  metadata         Json?
  unsubscribeToken String?  @unique @map("unsubscribe_token")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, email])
  @@index([userId])
  @@index([gongId])
}

model NewsletterBroadcast {
  id              String                @id @default(cuid())
  userId          String                @map("user_id") @db.Uuid
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gongId          String?               @map("gong_id")
  gong            Gong?                 @relation(fields: [gongId], references: [id], onDelete: SetNull)
  knowledgeBaseId String?               @map("knowledge_base_id")
  knowledgeBase   KnowledgeBase?        @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  subject         String
  body            String
  status          String                @default("DRAFT")
  templateStyle   String                @default("card") @map("template_style")
  tagFilter       String?               @map("tag_filter")
  queuedAt        DateTime?             @map("queued_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  queueItems      NewsletterQueueItem[]
  artifacts       Artifact[]

  @@index([userId])
  @@index([gongId])
  @@index([knowledgeBaseId])
}

model NewsletterQueueItem {
  id          String              @id @default(cuid())
  broadcastId String              @map("broadcast_id")
  broadcast   NewsletterBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  recipientId String              @map("recipient_id")
  userId      String              @map("user_id") @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String              @default("PENDING")
  error       String?
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([broadcastId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model WebhookSubscription {
  id         String            @id @default(cuid())
  userId     String            @map("user_id") @db.Uuid
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetUrl  String            @map("target_url")
  secret     String
  events     String[]          @default(["*"])
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String              @map("subscription_id")
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  statusCode     Int?                @map("status_code")
  responseBody   String?             @db.Text @map("response_body")
  error          String?             @db.Text
  attempts       Int                 @default(1)
  status         String              @default("DELIVERED")
  durationMs     Int?                @map("duration_ms")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([subscriptionId, createdAt])
}

model CronLock {
  name      String    @id
  lockedAt  DateTime? @map("locked_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
}
