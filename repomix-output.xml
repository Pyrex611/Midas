│   ├── index.ts                 # Server entry point (port 3000)
│   ├── config/                  # Configuration modules
│   │   ├── env.ts              # Environment validation (Zod)
│   │   └── logger.ts           # Winston logging
│   ├── middleware/              # Auth & request handlers
