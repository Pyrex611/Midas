<file path="server/services/emailQueue.service.ts">
import prisma from '../lib/prisma';
import { logger } from '../config/logger';
import { emailService } from './email.service';
import { personalisationService } from './personalisation.service';
import { senderService } from './sender.service';
import { artifactService } from './artifact.service';
import { ensureUnsubscribeToken, buildUnsubscribeUrl } from '../lib/unsubscribe';
import { env } from '../config/env';

export class EmailQueueService {
  private checkTimezone(timezone: string | null, startHour: number | null, endHour: number | null): boolean {
    if (startHour === null || startHour === undefined || endHour === null || endHour === undefined) return true;
    const tz = timezone || 'UTC';
    try {
      const formatter = new Intl.DateTimeFormat('en-US', { hour: 'numeric', hour12: false, timeZone: tz });
      let currentHour = parseInt(formatter.format(new Date()), 10);
      if (currentHour === 24) currentHour = 0;

      return startHour <= endHour
        ? currentHour >= startHour && currentHour < endHour
        : currentHour >= startHour || currentHour < endHour;
    } catch {
      return true;
    }
  }

  private async isOverUserSendLimit(userId: string): Promise<boolean> {
    const settings = await prisma.userSettings.findUnique({ where: { userId } });
    if (!settings?.sendLimit || !settings?.sendPeriod) return false;

    const periodStart = new Date();
    if (settings.sendPeriod === 'hour') {
      periodStart.setMinutes(0, 0, 0);
    } else {
      periodStart.setHours(0, 0, 0, 0);
    }

    const sentInPeriod = await prisma.outboundEmail.count({
      where: { userId, isIncoming: false, sentAt: { gte: periodStart } },
    });

    return sentInPeriod >= settings.sendLimit;
  }

  async processQueue(): Promise<{ claimed: number; sent: number; deferred: number; failed: number; skippedUnsubscribed: number }> {
    const summary = { claimed: 0, sent: 0, deferred: 0, failed: 0, skippedUnsubscribed: 0 };
    const userLimitCache = new Map<string, boolean>();
    const userSettingsCache = new Map<string, any>();
    const artifactMapCache = new Map<string, Record<string, { url: string; type: string; title: string }>>();

    const batchSize = env.SEND_SWEEP_BATCH_SIZE || 5;
    const cooldownSeconds = env.SENDER_COOLDOWN_SECONDS || 20;

    try {
      await prisma.$executeRaw`
        UPDATE "PendingEmail"
        SET status = 'PENDING'
        WHERE status = 'PROCESSING'
        AND updated_at < NOW() - INTERVAL '10 minutes'
      `;

      let emailIds: string[] = [];
      try {
        emailIds = await prisma.$transaction(async (tx) => {
          const lockedEmails = await tx.$queryRaw<{ id: string }[]>`
            SELECT p.id FROM "PendingEmail" p
            JOIN "Campaign" c ON p.campaign_id = c.id
            WHERE p.status = 'PENDING'
            AND c.status = 'ACTIVE'
            AND (p.scheduled_at IS NULL OR p.scheduled_at <= NOW())
            ORDER BY p.priority ASC, p.created_at ASC
            LIMIT ${batchSize}
            FOR UPDATE OF p SKIP LOCKED
          `;

          if (lockedEmails.length === 0) return [];
          const ids = lockedEmails.map(e => e.id);

          await tx.pendingEmail.updateMany({
            where: { id: { in: ids } },
            data: { status: 'PROCESSING' },
          });

          return ids;
        }, { maxWait: 5000, timeout: 8000 });
      } catch (txErr: any) {
        logger.warn({ err: txErr?.message }, 'Queue claim transaction rolled back or timed out');
        return summary;
      }

      if (emailIds.length === 0) return summary;
      summary.claimed = emailIds.length;

      const emailsToProcess = await prisma.pendingEmail.findMany({
        where: { id: { in: emailIds } },
        include: {
          campaign: {
            include: {
              senderLinks: { include: { sender: { include: { domain: true } } } },
            },
          },
          lead: true,
          draft: true,
          preferredSender: { include: { domain: true } },
        },
      });

      for (const pending of emailsToProcess) {
        try {
          const campaign = pending.campaign;
          const lead = pending.lead;

          if (campaign.status !== 'ACTIVE') {
            await prisma.pendingEmail.update({
              where: { id: pending.id },
              data: { status: 'PENDING' },
            });
            summary.deferred++;
            continue;
          }

          if (lead.status === 'UNSUBSCRIBED') {
            await prisma.pendingEmail.delete({ where: { id: pending.id } });
            summary.skippedUnsubscribed++;
            continue;
          }

          if (!this.checkTimezone(campaign.timezone, campaign.activeStartHour, campaign.activeEndHour)) {
            await prisma.pendingEmail.update({
              where: { id: pending.id },
              data: { status: 'PENDING', scheduledAt: new Date(Date.now() + 60 * 60 * 1000) },
            });
            summary.deferred++;
            continue;
          }

          if (!userLimitCache.has(pending.userId)) {
            userLimitCache.set(pending.userId, await this.isOverUserSendLimit(pending.userId));
          }
          if (userLimitCache.get(pending.userId)) {
            await prisma.pendingEmail.update({
              where: { id: pending.id },
              data: { status: 'PENDING', scheduledAt: new Date(Date.now() + 60 * 60 * 1000) },
            });
            summary.deferred++;
            continue;
          }

          const activeSenders = campaign.senderLinks
            .map(l => l.sender)
            .filter(s => s.status === 'active' && s.domain.status === 'active');

          if (activeSenders.length === 0) throw new Error('No active senders linked to this campaign');

          let selectedSender =
            pending.preferredSender &&
            pending.preferredSender.status === 'active' &&
            pending.preferredSender.domain.status === 'active'
              ? pending.preferredSender
              : activeSenders[campaign.lastDomainIndex % activeSenders.length];

          selectedSender = await senderService.ensureSenderDailyReset(selectedSender.id);

          if (selectedSender.lastDispatchedAt) {
            const msSinceLast = Date.now() - new Date(selectedSender.lastDispatchedAt).getTime();
            if (msSinceLast < cooldownSeconds * 1000) {
              await prisma.pendingEmail.update({
                where: { id: pending.id },
                data: { status: 'PENDING', scheduledAt: new Date(Date.now() + 25_000) },
              });
              summary.deferred++;
              continue;
            }
          }

          const claimResult = await prisma.$queryRaw<{ id: string }[]>`
            UPDATE "Sender"
            SET "sent_count_today" = "sent_count_today" + 1,
                "last_dispatched_at" = NOW()
            WHERE id = ${selectedSender.id} AND "sent_count_today" < "daily_limit"
            RETURNING id
          `;

          if (claimResult.length === 0) {
            const tomorrow = new Date();
            tomorrow.setUTCDate(tomorrow.getUTCDate() + 1);
            tomorrow.setUTCHours(campaign.sendHourUTC || 9, 0, 0, 0);

            await prisma.pendingEmail.update({
              where: { id: pending.id },
              data: { status: 'PENDING', scheduledAt: tomorrow },
            });
            summary.deferred++;
            continue;
          }

          if (!userSettingsCache.has(pending.userId)) {
            userSettingsCache.set(
              pending.userId,
              await prisma.userSettings.findUnique({ where: { userId: pending.userId } })
            );
          }
          if (!artifactMapCache.has(pending.userId)) {
            artifactMapCache.set(
              pending.userId,
              await artifactService.getArtifactMapForUser(pending.userId)
            );
          }

          const userSettings = userSettingsCache.get(pending.userId);
          const artifacts = artifactMapCache.get(pending.userId);

          const unsubscribeToken = await ensureUnsubscribeToken(lead.id, lead.unsubscribeToken);
          const unsubscribeUrl = buildUnsubscribeUrl(unsubscribeToken);

          const { subject, body } = personalisationService.personalise(
            lead,
            pending.subject,
            pending.body,
            campaign.reference,
            selectedSender.displayName || campaign.senderName,
            unsubscribeUrl,
            {
              companyName: userSettings?.companyName,
              physicalAddress: userSettings?.physicalAddress,
              customOptOutText: userSettings?.customOptOutText,
              artifacts,
            }
          );

          const fromEmail = `${selectedSender.localPart}@${selectedSender.domain.domainName}`;

          const outboundRecord = await prisma.outboundEmail.create({
            data: {
              userId: pending.userId,
              domainId: selectedSender.domainId,
              senderId: selectedSender.id,
              fromAddress: fromEmail,
              toAddress: lead.email,
              leadId: pending.leadId,
              campaignId: pending.campaignId,
              draftId: pending.draftId,
              subject,
              body,
              status: 'PROCESSING',
            },
          });

          const result = await emailService.sendEmailNow(
            { ...selectedSender.domain, senderLocalPart: selectedSender.localPart },
            lead.email,
            subject,
            body.replace(/\n/g, '<br>'),
            body,
            outboundRecord.id,
            selectedSender.displayName || campaign.senderName,
            pending.inReplyTo,
            unsubscribeUrl,
            { leadId: pending.leadId, campaignId: pending.campaignId },
            {
              brandName: userSettings?.companyName,
              brandInitials: userSettings?.brandInitials,
              brandColorHex: userSettings?.brandColorHex,
              logoUrl: userSettings?.logoUrl,
              brandingEnabled: userSettings?.brandingEnabled,
            }
          );

          if (result.success) {
            await prisma.outboundEmail.update({
              where: { id: outboundRecord.id },
              data: { status: 'SENT', messageId: result.messageId, sentAt: new Date() },
            });

            await prisma.campaign.update({
              where: { id: campaign.id },
              data: { lastDomainIndex: { increment: 1 } },
            });

            await prisma.lead.update({
              where: { id: pending.leadId },
              data: { outreachStatus: 'SENT', status: 'CONTACTED' },
            });

            await prisma.leadActivityEvent.create({
              data: {
                leadId: pending.leadId,
                campaignId: pending.campaignId,
                eventType: 'EMAIL_SENT',
                metadata: {
                  outboundEmailId: outboundRecord.id,
                  senderId: selectedSender.id,
                  sender: fromEmail,
                },
              },
            });

            if (pending.draftId) {
              await prisma.draft.update({ where: { id: pending.draftId }, data: { sentCount: { increment: 1 } } });
            }

            await prisma.pendingEmail.delete({ where: { id: pending.id } });
            summary.sent++;
            logger.info({ leadId: pending.leadId, sender: fromEmail }, 'Email Sent Successfully');
          } else {
            await prisma.sender.update({
              where: { id: selectedSender.id },
              data: { sentCountToday: { decrement: 1 } },
            });
            throw new Error(result.error);
          }
        } catch (error: any) {
          summary.failed++;
          logger.error({ error: error.message, pendingId: pending.id }, 'Queue processing failed for email');
          await prisma.pendingEmail.update({
            where: { id: pending.id },
            data: { status: 'FAILED', error: error.message },
          });
        }
      }
    } catch (error) {
      logger.error({ error }, 'Fatal Queue Processing Error');
    }
    return summary;
  }
}

export const emailQueueService = new EmailQueueService();
</file>

<file path="server/lib/prisma.ts">
import { PrismaClient } from '@prisma/client';
import { PrismaPg } from '@prisma/adapter-pg';
import { Pool } from 'pg';
import { logger } from '../config/logger';

function buildConnectionString(): { connectionString: string; provider: 'supabase' | 'neon' | 'postgres' } {
  const raw =
    process.env.DATABASE_URL_POOLED ||
    process.env.DATABASE_URL ||
    process.env.POSTGRES_URL ||
    '';

  if (!raw) {
    throw new Error('DATABASE_URL is not set in environment variables');
  }

  let url: URL;
  try {
    url = new URL(raw);
  } catch {
    return { connectionString: raw, provider: 'postgres' };
  }

  const host = url.hostname.toLowerCase();
  const isSupabase = host.includes('supabase.co') || host.includes('supabase.com');
  const isNeon = host.includes('.neon.tech');

  // Inject '-pooler' strictly for Neon endpoints if not already pooled
  if (isNeon && !host.includes('-pooler')) {
    const parts = url.hostname.split('.');
    parts[0] = `${parts[0]}-pooler`;
    url.hostname = parts.join('.');
  }

  // Strip query parameters unrecognized by node-postgres pg.Pool
  url.searchParams.delete('connect_timeout');
  url.searchParams.delete('pool_timeout');
  url.searchParams.delete('pgbouncer');

  if (isNeon && !url.searchParams.has('sslmode')) {
    url.searchParams.set('sslmode', 'verify-full');
  }

  return {
    connectionString: url.toString(),
    provider: isSupabase ? 'supabase' : isNeon ? 'neon' : 'postgres',
  };
}

const prismaClientSingleton = () => {
  const { connectionString, provider } = buildConnectionString();
  logger.info(`[PRISMA] Initializing pooled Postgres connection (${provider}) via pg.Pool + @prisma/adapter-pg`);

  const pool = new Pool({
    connectionString,
    ssl: {
      rejectUnauthorized: false,
    },
    connectionTimeoutMillis: 6_000,
    idleTimeoutMillis: 10_000,
    max: 2,
  });

  try {
    // eslint-disable-next-line @typescript-eslint/no-var-requires
    const vercelFunctions = require('@vercel/functions');
    if (typeof vercelFunctions.attachDatabasePool === 'function') {
      vercelFunctions.attachDatabasePool(pool);
    }
  } catch {}

  const adapter = new PrismaPg(pool);

  return new PrismaClient({
    adapter,
    log: process.env.NODE_ENV === 'production' ? ['error', 'warn'] : ['error', 'warn', 'query'],
  });
};

declare global {
  // eslint-disable-next-line no-var
  var prismaGlobal: undefined | ReturnType<typeof prismaClientSingleton>;
}

const prisma = globalThis.prismaGlobal ?? prismaClientSingleton();

export default prisma;

if (process.env.NODE_ENV !== 'production') {
  globalThis.prismaGlobal = prisma;
}
</file>

<file path="server/middleware/auth.middleware.ts">
import 'dotenv/config';
import crypto from 'crypto';
import { Request, Response, NextFunction } from 'express';
import { ClerkExpressRequireAuth, clerkClient } from '@clerk/clerk-sdk-node';
import prisma from '../lib/prisma';
import { env } from '../config/env';
import { logger } from '../config/logger';

export interface AuthRequest extends Request {
  user?: {
    id: string;
    email: string;
    isAdmin: boolean;
  };
  auth?: any;
}

type CachedUser = { id: string; email: string; isAdmin: boolean };

const CACHE_TTL_MS = 3 * 60 * 1000;
const userCache = new Map<string, { value: CachedUser; expiresAt: number }>();

const cleanKey = (key?: string) => (key ? key.trim().replace(/^["']|["']$/g, '') : '');

const resolvedPublishableKey = cleanKey(
  process.env.CLERK_PUBLISHABLE_KEY ||
  process.env.VITE_CLERK_PUBLISHABLE_KEY ||
  process.env.NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
);
if (resolvedPublishableKey && !process.env.CLERK_PUBLISHABLE_KEY) {
  process.env.CLERK_PUBLISHABLE_KEY = resolvedPublishableKey;
}

const resolvedSecretKey = cleanKey(process.env.CLERK_SECRET_KEY);
if (resolvedSecretKey && !process.env.CLERK_SECRET_KEY) {
  process.env.CLERK_SECRET_KEY = resolvedSecretKey;
}

let clerkHandlerInstance: any = null;
function getClerkHandler() {
  if (!clerkHandlerInstance) {
    clerkHandlerInstance = ClerkExpressRequireAuth();
  }
  return clerkHandlerInstance;
}

function decodeJwtIssuer(token: string): string {
  try {
    const parts = token.split('.');
    if (parts.length !== 3) return '';
    const payload = JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8'));
    return String(payload.iss || '').toLowerCase();
  } catch {
    return '';
  }
}

async function authenticateSupabaseToken(token: string, req: Request, res: Response, next: NextFunction) {
  if (!env.SUPABASE_URL || !env.SUPABASE_ANON_KEY) {
    return res.status(500).json({ error: 'Supabase Auth is not configured on this server' });
  }

  const tokenKey = `sb:${crypto.createHash('sha256').update(token).digest('hex').slice(0, 24)}`;
  const cached = userCache.get(tokenKey);
  if (cached && cached.expiresAt > Date.now()) {
    (req as AuthRequest).user = cached.value;
    return next();
  }

  try {
    const supaRes = await fetch(`${env.SUPABASE_URL.replace(/\/$/, '')}/auth/v1/user`, {
      headers: {
        Authorization: `Bearer ${token}`,
        apikey: env.SUPABASE_ANON_KEY,
      },
      signal: AbortSignal.timeout(5_000),
    });

    if (!supaRes.ok) {
      return res.status(401).json({ error: 'Unauthorized: Invalid or expired Supabase session' });
    }

    const supaUser: any = await supaRes.json();
    const sbId = supaUser?.id;
    const email = supaUser?.email ? String(supaUser.email).toLowerCase().trim() : null;
    if (!sbId || !email) {
      return res.status(401).json({ error: 'Unauthorized: Supabase identity missing email' });
    }

    const displayName =
      supaUser?.user_metadata?.full_name ||
      supaUser?.user_metadata?.name ||
      email.split('@')[0];

    let user = await prisma.user.findUnique({
      where: { supabaseAuthId: sbId },
      select: { id: true, email: true, isAdmin: true },
    });

    if (!user) {
      user = await prisma.user.upsert({
        where: { email },
        update: { supabaseAuthId: sbId },
        create: {
          supabaseAuthId: sbId,
          email,
          name: displayName,
        },
        select: { id: true, email: true, isAdmin: true },
      });
    }

    const resolved: CachedUser = { id: user.id, email: user.email, isAdmin: user.isAdmin };
    userCache.set(tokenKey, { value: resolved, expiresAt: Date.now() + CACHE_TTL_MS });

    (req as AuthRequest).user = resolved;
    next();
  } catch (err: any) {
    logger.error({ err: err?.message }, '[AUTH] Supabase session validation failed');
    return res.status(500).json({ error: 'Authentication verification failed' });
  }
}

export const requireAuth = (req: Request, res: Response, next: NextFunction) => {
  const authHeader = req.headers.authorization || '';
  const bearerToken = authHeader.startsWith('Bearer ') ? authHeader.slice(7).trim() : '';

  const mode = env.AUTH_PROVIDER || 'dual';
  const issuer = bearerToken ? decodeJwtIssuer(bearerToken) : '';
  const looksLikeSupabase =
    mode === 'supabase' ||
    (mode === 'dual' && issuer.includes('supabase'));

  if (looksLikeSupabase && bearerToken) {
    return authenticateSupabaseToken(bearerToken, req, res, next);
  }

  if (mode === 'supabase') {
    return res.status(401).json({ error: 'Unauthorized: Missing Supabase Bearer token' });
  }

  if (!process.env.CLERK_SECRET_KEY || !process.env.CLERK_PUBLISHABLE_KEY) {
    logger.error('[AUTH] Clerk keys missing while handling Clerk auth request');
    return res.status(500).json({ error: 'Authentication service not configured' });
  }

  getClerkHandler()(req, res, async (err: any) => {
    if (err) {
      logger.error({ err: err?.message || err }, '[AUTH] Clerk token verification failed');
      return res.status(401).json({ error: 'Unauthorized: Invalid or expired session' });
    }

    try {
      const authReq = req as AuthRequest;
      const clerkId = authReq.auth?.userId;
      if (!clerkId) {
        return res.status(401).json({ error: 'Unauthorized: Missing User Identity' });
      }

      const cacheKey = `clerk:${clerkId}`;
      const cached = userCache.get(cacheKey);
      if (cached && cached.expiresAt > Date.now()) {
        authReq.user = cached.value;
        return next();
      }

      let user = await prisma.user.findUnique({
        where: { clerkId },
        select: { id: true, email: true, isAdmin: true },
      });

      if (!user) {
        let email = authReq.auth.sessionClaims?.email;
        let name = authReq.auth.sessionClaims?.fullName;

        if (!email) {
          try {
            const clerkUser = await clerkClient.users.getUser(clerkId);
            email =
              clerkUser.emailAddresses?.find((e: any) => e.id === clerkUser.primaryEmailAddressId)?.emailAddress ||
              clerkUser.emailAddresses?.[0]?.emailAddress;
            name = `${clerkUser.firstName || ''} ${clerkUser.lastName || ''}`.trim() || clerkUser.username;
          } catch {}
        }

        if (!email) email = `user-${clerkId.substring(0, 8)}@clerk.local`;
        if (!name) name = email.split('@')[0];

        user = await prisma.user.upsert({
          where: { email: email.toLowerCase().trim() },
          update: { clerkId },
          create: { clerkId, email: email.toLowerCase().trim(), name },
          select: { id: true, email: true, isAdmin: true },
        });
      }

      const resolvedUser: CachedUser = { id: user.id, email: user.email, isAdmin: user.isAdmin };
      userCache.set(cacheKey, { value: resolvedUser, expiresAt: Date.now() + CACHE_TTL_MS });

      authReq.user = resolvedUser;
      next();
    } catch (dbErr: any) {
      logger.error({ dbErr: dbErr?.message || dbErr }, '[AUTH] Database session validation failed');
      res.status(500).json({ error: 'Database session validation failed' });
    }
  });
};
</file>

<file path="server/services/domain.service.ts">
import crypto from 'crypto';
import dns from 'dns';
import prisma from '../lib/prisma';
import { logger } from '../config/logger';
import { encrypt, tryDecrypt } from '../lib/encryption';

function generateCode(): string {
  return String(crypto.randomInt(100000, 999999));
}

export class DomainService {
  private baseUrlFor(region?: string | null): string {
    return region === 'eu' ? 'https://api.eu.mailgun.net/v3' : 'https://api.mailgun.net/v3';
  }

  private authHeaderFor(mailgunApiKey: string): string {
    const cleanKey = mailgunApiKey.trim();
    return `Basic ${Buffer.from(`api:${cleanKey}`).toString('base64')}`;
  }

  private sanitize(domain: any) {
    if (!domain) return domain;
    const { mailgunApiKeyEncrypted, smtpConfigEncrypted, ...rest } = domain;
    const keyDecryptionFailed =
      (Boolean(mailgunApiKeyEncrypted) && !tryDecrypt(mailgunApiKeyEncrypted)) ||
      (Boolean(smtpConfigEncrypted) && !tryDecrypt(smtpConfigEncrypted));
    return {
      ...rest,
      hasMailgunKey: !!mailgunApiKeyEncrypted,
      hasSmtpConfig: !!smtpConfigEncrypted,
      keyDecryptionFailed,
    };
  }

  async checkDmarcPolicy(domainName: string): Promise<{
    policy: 'none' | 'quarantine' | 'reject' | 'missing';
    record?: string;
    bimiReady: boolean;
  }> {
    const cleanDomain = domainName.trim().toLowerCase();
    try {
      const records = await dns.promises.resolveTxt(`_dmarc.${cleanDomain}`);
      const flat = records.map((chunk) => chunk.join('')).join(' ');
      const match = flat.match(/p=(none|quarantine|reject)/i);
      const policy = match ? (match[1].toLowerCase() as any) : 'none';
      const bimiReady = policy === 'quarantine' || policy === 'reject';
      return { policy, record: flat, bimiReady };
    } catch {
      const parts = cleanDomain.split('.');
      if (parts.length > 2) {
        const rootDomain = parts.slice(-2).join('.');
        try {
          const rootRecords = await dns.promises.resolveTxt(`_dmarc.${rootDomain}`);
          const flat = rootRecords.map((chunk) => chunk.join('')).join(' ');
          const match = flat.match(/p=(none|quarantine|reject)/i);
          const policy = match ? (match[1].toLowerCase() as any) : 'none';
          const bimiReady = policy === 'quarantine' || policy === 'reject';
          return { policy, record: flat, bimiReady };
        } catch {}
      }
      return { policy: 'missing', bimiReady: false };
    }
  }

  async updateBimiSettings(
    userId: string,
    domainId: string,
    data: { bimiEnabled: boolean; bimiSvgUrl?: string; bimiVmcUrl?: string }
  ) {
    const domain = await prisma.domain.findFirst({ where: { id: domainId, userId } });
    if (!domain) throw new Error('Domain not found');

    const dmarcResult = await this.checkDmarcPolicy(domain.domainName);

    if (data.bimiEnabled && !dmarcResult.bimiReady) {
      throw new Error(
        `Cannot enable BIMI: DMARC policy for ${domain.domainName} is "${dmarcResult.policy}". ` +
        `BIMI requires DMARC to be enforced at p=quarantine or p=reject.`
      );
    }

    const updated = await prisma.domain.update({
      where: { id: domainId },
      data: {
        bimiEnabled: data.bimiEnabled,
        bimiSvgUrl: data.bimiSvgUrl?.trim() || null,
        bimiVmcUrl: data.bimiVmcUrl?.trim() || null,
        dmarcPolicy: dmarcResult.policy,
      },
    });

    return this.sanitize(updated);
  }

  private async sendTestEmail(domainName: string, mailgunApiKey: string, region: string | null, toEmail: string) {
    const cleanTo = (toEmail || '').trim().toLowerCase();
    if (!cleanTo || !cleanTo.includes('@')) {
      throw new Error(`Invalid test recipient email address: "${toEmail}". Please provide a valid email.`);
    }

    const cleanDomain = domainName.trim().toLowerCase();
    const cleanKey = mailgunApiKey.trim();
    const url = `${this.baseUrlFor(region)}/${cleanDomain}/messages`;

    const res = await fetch(url, {
      method: 'POST',
      headers: {
        Authorization: this.authHeaderFor(cleanKey),
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: new URLSearchParams({
        from: `Midas Connectivity Test <postmaster@${cleanDomain}>`,
        to: cleanTo,
        subject: 'Midas: your domain is connected',
        text: `This confirms ${cleanDomain} can send email through your Mailgun account via Midas.`,
      }).toString(),
      signal: AbortSignal.timeout(10_000),
    });

    const rawText = await res.text();
    let data: any = {};
    try { data = JSON.parse(rawText); } catch { data = { message: rawText }; }

    if (!res.ok) {
      const errorMsg = data.message || rawText || `HTTP ${res.status}`;
      throw new Error(`Mailgun rejected the test send (${res.status}): ${errorMsg}`);
    }

    return data;
  }

  private appUrl(): string {
    const configured = process.env.APP_URL;
    if (configured) return configured.replace(/\/$/, '');
    return 'https://midas-aem.vercel.app';
  }

  private routeExpressionFor(domainName: string): string {
    return `match_recipient('.*@${domainName.replace(/\./g, '\\.')}')`;
  }

  private async listRoutes(mailgunApiKey: string, region: string | null): Promise<{ items: any[] }> {
    const res = await fetch(`${this.baseUrlFor(region)}/routes?limit=100`, {
      headers: { Authorization: this.authHeaderFor(mailgunApiKey) },
      signal: AbortSignal.timeout(10_000),
    });
    if (!res.ok) {
      const text = await res.text();
      throw new Error(`Failed to list Mailgun routes (${res.status}): ${text}`);
    }
    return res.json();
  }

  private async ensureInboundRoute(
    domainId: string,
    domainName: string,
    mailgunApiKey: string,
    region: string | null
  ): Promise<string> {
    const webhookUrl = `${this.appUrl()}/api/webhooks/mailgun/inbound`;
    const expression = this.routeExpressionFor(domainName);

    const current = await prisma.domain.findUnique({ where: { id: domainId }, select: { routeId: true } });
    if (current?.routeId) {
      try {
        const check = await fetch(`${this.baseUrlFor(region)}/routes/${current.routeId}`, {
          headers: { Authorization: this.authHeaderFor(mailgunApiKey) },
          signal: AbortSignal.timeout(10_000),
        });
        if (check.ok) return current.routeId;
      } catch {}
    }

    const list = await this.listRoutes(mailgunApiKey, region);
    const existing = (list.items || []).find((r: any) => r.expression === expression);
    if (existing) return existing.id;

    const form = new URLSearchParams();
    form.set('priority', '0');
    form.set('description', `Midas inbound — ${domainName}`);
    form.set('expression', expression);
    form.append('action', `forward("${webhookUrl}")`);
    form.append('action', 'stop()');

    const res = await fetch(`${this.baseUrlFor(region)}/routes`, {
      method: 'POST',
      headers: {
        Authorization: this.authHeaderFor(mailgunApiKey),
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: form.toString(),
      signal: AbortSignal.timeout(10_000),
    });

    const raw = await res.text();
    let data: any = {};
    try { data = JSON.parse(raw); } catch { data = { message: raw }; }

    if (!res.ok) {
      throw new Error(data.message || `Failed to create Mailgun inbound route (${res.status})`);
    }
    return data.route?.id || '';
  }

  async connectWithKey(userId: string, domainName: string, mailgunApiKey: string, region: string | null, testRecipientEmail: string) {
    const cleanDomain = domainName.toLowerCase().trim();
    const cleanKey = mailgunApiKey.trim();

    const existing = await prisma.domain.findFirst({ where: { userId, domainName: cleanDomain } });
    if (existing) throw new Error('This domain is already connected to your account');

    const dmarcCheck = await this.checkDmarcPolicy(cleanDomain);

    const domain = await prisma.domain.create({
      data: {
        userId,
        domainName: cleanDomain,
        espProvider: 'mailgun',
        status: 'pending_setup',
        mailgunApiKeyEncrypted: encrypt(cleanKey),
        mailgunRegion: region || null,
        dmarcPolicy: dmarcCheck.policy,
      },
    });

    const updated = await this.runSendTest(userId, domain.id, testRecipientEmail);
    return this.sanitize(updated);
  }

  /** Connects a Resend (for Town Crier) or Custom SMTP domain cleanly. */
  async connectEspDomain(
    userId: string,
    input: {
      domainName: string;
      espProvider: 'resend' | 'smtp';
      apiKey?: string;
      smtpConfig?: { host: string; port: number; secure: boolean; user: string; pass: string };
    }
  ) {
    const cleanDomain = input.domainName.toLowerCase().trim();
    const existing = await prisma.domain.findFirst({ where: { userId, domainName: cleanDomain } });
    if (existing) throw new Error('This domain is already connected to your account');

    if (input.espProvider === 'resend' && !input.apiKey?.trim()) {
      throw new Error('Resend API Key is required');
    }
    if (input.espProvider === 'smtp' && (!input.smtpConfig?.host || !input.smtpConfig?.user || !input.smtpConfig?.pass)) {
      throw new Error('SMTP host, user, and password are required');
    }

    const dmarcCheck = await this.checkDmarcPolicy(cleanDomain);

    const domain = await prisma.domain.create({
      data: {
        userId,
        domainName: cleanDomain,
        espProvider: input.espProvider,
        status: 'active',
        sendTestPassedAt: new Date(),
        dmarcPolicy: dmarcCheck.policy,
        mailgunApiKeyEncrypted: input.apiKey?.trim() ? encrypt(input.apiKey.trim()) : null,
        smtpConfigEncrypted: input.smtpConfig ? encrypt(JSON.stringify(input.smtpConfig)) : null,
      },
    });

    return this.sanitize(domain);
  }

  async runSendTest(userId: string, domainId: string, testRecipientEmail: string) {
    const domain = await prisma.domain.findFirst({ where: { id: domainId, userId } });
    if (!domain) throw new Error('Domain not found');
    if (!domain.mailgunApiKeyEncrypted) throw new Error('No Mailgun API key is set for this domain');

    const key = tryDecrypt(domain.mailgunApiKeyEncrypted);
    if (!key) throw new Error('Could not decrypt the stored Mailgun key (ENCRYPTION_KEY may have changed) — please reconnect this domain.');

    await this.sendTestEmail(domain.domainName, key, domain.mailgunRegion, testRecipientEmail);

    const receivingTestCode = generateCode();
    const receivingTestAddress = `connectivity@${domain.domainName}`;

    let routeId = domain.routeId ?? undefined;
    try {
      routeId = await this.ensureInboundRoute(domain.id, domain.domainName, key, domain.mailgunRegion);
    } catch (err: any) {
      logger.warn({ err: err.message, domainId: domain.id }, 'Automatic Mailgun inbound route setup failed');
    }

    return prisma.domain.update({
      where: { id: domainId },
      data: {
        status: 'active',
        sendTestPassedAt: new Date(),
        receivingTestCode,
        receivingTestAddress,
        routeId,
      },
    });
  }

  async resetReceivingTest(userId: string, domainId: string) {
    const domain = await prisma.domain.findFirst({ where: { id: domainId, userId } });
    if (!domain) throw new Error('Domain not found');

    return this.sanitize(await prisma.domain.update({
      where: { id: domainId },
      data: {
        receivingTestCode: generateCode(),
        receivingTestAddress: `connectivity@${domain.domainName}`,
        receivingConfirmedAt: null,
      },
    }));
  }

  async checkReceivingTest(userId: string, domainId: string) {
    const domain = await prisma.domain.findFirst({ where: { id: domainId, userId } });
    if (!domain) throw new Error('Domain not found');
    return {
      confirmed: !!domain.receivingConfirmedAt,
      testAddress: domain.receivingTestAddress,
      testCode: domain.receivingTestCode,
    };
  }

  async getDomains(userId: string) {
    const domains = await prisma.domain.findMany({
      where: { userId },
      include: { senders: { orderBy: { createdAt: 'asc' } } },
      orderBy: { createdAt: 'desc' },
    });
    return domains.map((d) => this.sanitize(d));
  }

  async getDomainRaw(domainId: string) {
    return prisma.domain.findUnique({ where: { id: domainId } });
  }

  getMailgunContextForDomain(domain: { mailgunApiKeyEncrypted?: string | null; mailgunRegion?: string | null }): { authHeader: string; baseUrl: string } {
    if (domain.mailgunApiKeyEncrypted) {
      const decrypted = tryDecrypt(domain.mailgunApiKeyEncrypted);
      if (!decrypted) {
        throw new Error('Stored Mailgun key could not be decrypted (ENCRYPTION_KEY mismatch) — reconnect the domain.');
      }
      return { authHeader: this.authHeaderFor(decrypted), baseUrl: this.baseUrlFor(domain.mailgunRegion) };
    }
    const key = process.env.MAILGUN_API_KEY;
    if (!key) throw new Error('No Mailgun API key available for this domain');
    return { authHeader: this.authHeaderFor(key), baseUrl: this.baseUrlFor(domain.mailgunRegion) };
  }

  async deleteDomain(userId: string, domainId: string) {
    const domain = await prisma.domain.findFirst({ where: { id: domainId, userId } });
    if (!domain) throw new Error('Domain not found');
    await prisma.domain.delete({ where: { id: domainId } });
  }
}

export const domainService = new DomainService();
