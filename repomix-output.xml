<file path="server/services/ai/providers/ollama.provider.ts">
import { AIProvider } from '../types';

export class OllamaProvider implements AIProvider {
  readonly name = 'ollama';

  constructor(
    private baseUrl: string = process.env.OLLAMA_URL || 'http://localhost:11434',
    private model: string = process.env.OLLAMA_POWERFUL_MODEL || 'llama3.1:8b'
  ) {}

  async isAvailable(): Promise<boolean> {
    try {
      const cleanBase = this.baseUrl.replace(/\/+$/, '');
      const res = await fetch(`${cleanBase}/api/tags`, {
        signal: AbortSignal.timeout(3_000),
      });
      return res.ok;
    } catch {
      return false;
    }
  }

  async complete(prompt: string, system?: string): Promise<string> {
    const cleanBase = this.baseUrl.replace(/\/+$/, '');
    const fullPrompt = system ? `${system}\n\n${prompt}` : prompt;

    const response = await fetch(`${cleanBase}/api/generate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: this.model,
        prompt: fullPrompt,
        stream: false,
        options: { temperature: 0.7 },
      }),
      signal: AbortSignal.timeout(25_000),
    });

    const rawText = await response.text();
    if (!response.ok) {
      throw new Error(`Ollama generation failed (${response.status}): ${rawText}`);
    }

    const data = JSON.parse(rawText);
    if (!data.response) {
      throw new Error(`Ollama returned an empty response for model "${this.model}"`);
    }
    return data.response;
  }
}
</file>

<file path="server/services/ai/utils/modelClassifier.ts">
/**
 * Detects whether an LLM model belongs to a reasoning/thinking family
 * (e.g. Gemini 2.0/2.5 Thinking, OpenAI o1/o3/o4, DeepSeek-R1, QwQ, Nemotron).
 */
export function isReasoningModel(provider: string, model: string): boolean {
  if (!model || typeof model !== 'string') return false;
  const m = model.toLowerCase();

  return (
    m.includes('thinking') ||
    m.includes('nemotron') ||
    m.includes('deepseek-r1') ||
    m.includes('deepseek-reasoner') ||
    m.includes('qwq') ||
    m.includes(':thinking') ||
    m.startsWith('o1') ||
    m.startsWith('o3') ||
    m.startsWith('o4') ||
    m.includes('/o1') ||
    m.includes('/o3') ||
    m.includes('/o4')
  );
}
</file>

<file path="server/services/billing/dodo.service.ts">
import crypto from 'crypto';
import prisma from '../../lib/prisma';
import { env } from '../../config/env';
import { logger } from '../../config/logger';
import { PlanTier } from './plans';

export class DodoService {
  private baseUrl(): string {
    return env.DODO_PAYMENTS_MODE === 'live_mode'
      ? 'https://live.dodopayments.com'
      : 'https://test.dodopayments.com';
  }

  public isConfigured(): boolean {
    return Boolean(env.DODO_PAYMENTS_API_KEY);
  }

  private resolveProductId(plan: 'CHIEF' | 'SYNDICATE', cycle: 'monthly' | 'annual'): string {
    if (plan === 'CHIEF') {
      const id = cycle === 'annual' ? env.DODO_PRODUCT_CHIEF_ANNUAL : env.DODO_PRODUCT_CHIEF_MONTHLY;
      if (!id) throw new Error(`Dodo product ID not configured for CHIEF (${cycle})`);
      return id.trim();
    }
    const id = cycle === 'annual' ? env.DODO_PRODUCT_SYNDICATE_ANNUAL : env.DODO_PRODUCT_SYNDICATE_MONTHLY;
    if (!id) throw new Error(`Dodo product ID not configured for SYNDICATE (${cycle})`);
    return id.trim();
  }

  private inferPlanFromProduct(productId?: string | null): PlanTier | null {
    if (!productId) return null;
    const clean = productId.trim();
    if (clean === env.DODO_PRODUCT_CHIEF_MONTHLY || clean === env.DODO_PRODUCT_CHIEF_ANNUAL) return 'CHIEF';
    if (clean === env.DODO_PRODUCT_SYNDICATE_MONTHLY || clean === env.DODO_PRODUCT_SYNDICATE_ANNUAL) return 'SYNDICATE';
    return null;
  }

  async createCheckoutSession(options: {
    userId: string;
    email: string;
    name?: string | null;
    plan: 'CHIEF' | 'SYNDICATE';
    billingCycle: 'monthly' | 'annual';
  }): Promise<{ checkoutUrl: string; sessionId: string }> {
    if (!env.DODO_PAYMENTS_API_KEY) {
      throw new Error('DODO_PAYMENTS_API_KEY is not configured on this server');
    }

    const productId = this.resolveProductId(options.plan, options.billingCycle);
    const appUrl = (env.APP_URL || 'https://midas-aem.vercel.app').replace(/\/$/, '');

    const res = await fetch(`${this.baseUrl()}/checkouts`, {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${env.DODO_PAYMENTS_API_KEY.trim()}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        product_cart: [{ product_id: productId, quantity: 1 }],
        customer: {
          email: options.email,
          name: options.name || options.email.split('@')[0],
        },
        metadata: {
          userId: options.userId,
          plan: options.plan,
          billingCycle: options.billingCycle,
        },
        return_url: `${appUrl}/profile?tab=billing&checkout=success`,
      }),
      signal: AbortSignal.timeout(10_000),
    });

    const rawText = await res.text();
    let data: any = {};
    try { data = JSON.parse(rawText); } catch { data = { message: rawText }; }

    if (!res.ok || !data.checkout_url) {
      throw new Error(data.message || `Dodo checkout session failed (HTTP ${res.status})`);
    }

    return {
      checkoutUrl: data.checkout_url,
      sessionId: data.session_id,
    };
  }

  async cancelSubscription(userId: string) {
    const sub = await prisma.subscription.findUnique({ where: { userId } });
    if (!sub || sub.plan === 'SCOUT') {
      throw new Error('No active paid subscription to cancel');
    }

    if (sub.dodoSubscriptionId && env.DODO_PAYMENTS_API_KEY) {
      const res = await fetch(`${this.baseUrl()}/subscriptions/${sub.dodoSubscriptionId}`, {
        method: 'PATCH',
        headers: {
          Authorization: `Bearer ${env.DODO_PAYMENTS_API_KEY.trim()}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ cancel_at_next_billing_date: true }),
        signal: AbortSignal.timeout(10_000),
      });

      if (!res.ok) {
        const text = await res.text();
        throw new Error(`Failed to schedule cancellation in Dodo Payments: ${text}`);
      }
    }

    return prisma.subscription.update({
      where: { userId },
      data: { cancelAtPeriodEnd: true },
    });
  }

  verifyWebhookSignature(
    rawBody: Buffer | string,
    headers: { webhookId?: string; webhookTimestamp?: string; webhookSignature?: string }
  ): boolean {
    const secret = env.DODO_PAYMENTS_WEBHOOK_SECRET;
    if (!secret) return false;

    const { webhookId, webhookTimestamp, webhookSignature } = headers;
    if (!webhookId || !webhookTimestamp || !webhookSignature) return false;

    const tsNum = Number(webhookTimestamp);
    if (!Number.isFinite(tsNum) || Math.abs(Math.floor(Date.now() / 1000) - tsNum) > 300) {
      return false;
    }

    const cleanSecret = secret.startsWith('whsec_') ? secret.slice(6) : secret;
    const keyBytes = Buffer.from(cleanSecret, 'base64');
    const bodyStr = Buffer.isBuffer(rawBody) ? rawBody.toString('utf8') : rawBody;
    const signedPayload = `${webhookId}.${webhookTimestamp}.${bodyStr}`;

    const expectedB64 = crypto
      .createHmac('sha256', keyBytes)
      .update(signedPayload)
      .digest('base64');

    const signatures = webhookSignature.split(' ');
    for (const entry of signatures) {
      const [version, sigB64] = entry.split(',');
      if (version !== 'v1' || !sigB64) continue;
      const a = Buffer.from(sigB64, 'utf8');
      const b = Buffer.from(expectedB64, 'utf8');
      if (a.length === b.length && crypto.timingSafeEqual(a, b)) {
        return true;
      }
    }

    return false;
  }

  async processWebhook(payload: any) {
    const eventType: string = payload?.type || '';
    const data = payload?.data || {};
    const metadata = data?.metadata || {};

    let userId: string | null = metadata.userId || null;

    if (!userId && data.customer?.email) {
      const user = await prisma.user.findUnique({
        where: { email: String(data.customer.email).toLowerCase().trim() },
        select: { id: true },
      });
      userId = user?.id || null;
    }

    if (!userId && data.subscription_id) {
      const existingSub = await prisma.subscription.findUnique({
        where: { dodoSubscriptionId: data.subscription_id },
        select: { userId: true },
      });
      userId = existingSub?.userId || null;
    }

    if (!userId) {
      logger.warn({ eventType, subId: data.subscription_id }, '[DODO] Webhook received without resolvable userId');
      return;
    }

    const resolvedPlan: PlanTier =
      (metadata.plan as PlanTier) ||
      this.inferPlanFromProduct(data.product_id) ||
      'CHIEF';

    const billingCycle = metadata.billingCycle === 'annual' ? 'annual' : 'monthly';
    const dodoCustomerId = data.customer?.customer_id || data.customer_id || undefined;
    const dodoSubscriptionId = data.subscription_id || undefined;
    const nextBillingDate = data.next_billing_date ? new Date(data.next_billing_date) : undefined;

    if (
      eventType === 'subscription.active' ||
      eventType === 'subscription.renewed' ||
      eventType === 'payment.succeeded'
    ) {
      await prisma.subscription.upsert({
        where: { userId },
        update: {
          plan: resolvedPlan,
          status: 'ACTIVE',
          billingCycle,
          cancelAtPeriodEnd: Boolean(data.cancel_at_next_billing_date),
          ...(dodoCustomerId ? { dodoCustomerId } : {}),
          ...(dodoSubscriptionId ? { dodoSubscriptionId } : {}),
          ...(nextBillingDate ? { currentPeriodEnd: nextBillingDate } : {}),
          ...(eventType === 'subscription.renewed' ? { aiCreditsUsed: 0, emailsSentThisMonth: 0, periodResetAt: new Date() } : {}),
        },
        create: {
          userId,
          plan: resolvedPlan,
          status: 'ACTIVE',
          billingCycle,
          dodoCustomerId,
          dodoSubscriptionId,
          currentPeriodEnd: nextBillingDate,
        },
      });
      logger.info({ userId, plan: resolvedPlan, eventType }, '[DODO] Subscription activated/renewed');
    } else if (eventType === 'subscription.on_hold' || eventType === 'payment.failed') {
      await prisma.subscription.updateMany({
        where: { userId },
        data: { status: 'PAST_DUE' },
      });
    } else if (eventType === 'subscription.cancelled' || eventType === 'subscription.expired') {
      await prisma.subscription.updateMany({
        where: { userId },
        data: {
          plan: 'SCOUT',
          status: 'CANCELLED',
          cancelAtPeriodEnd: false,
        },
      });
    }
  }
}

export const dodoService = new DodoService();
</file>

<file path="server/services/billing/planGuard.service.ts">
import prisma from '../../lib/prisma';
import { getPlanConfig, PlanQuotaConfig, PlanTier } from './plans';

export class PlanGuardService {
  /**
   * Resolves the user's subscription row, lazily provisioning SCOUT (Free)
   * if none exists and automatically rolling over monthly usage counters
   * when crossing into a new calendar month.
   */
  async getOrInitSubscription(userId: string) {
    let sub = await prisma.subscription.findUnique({ where: { userId } });

    if (!sub) {
      sub = await prisma.subscription.create({
        data: {
          userId,
          plan: 'SCOUT',
          status: 'ACTIVE',
          periodResetAt: new Date(),
        },
      });
    }

    const now = new Date();
    const lastReset = new Date(sub.periodResetAt);
    const sameMonth =
      now.getUTCFullYear() === lastReset.getUTCFullYear() &&
      now.getUTCMonth() === lastReset.getUTCMonth();

    if (!sameMonth) {
      sub = await prisma.subscription.update({
        where: { userId },
        data: {
          aiCreditsUsed: 0,
          emailsSentThisMonth: 0,
          periodResetAt: now,
        },
      });
    }

    const effectivePlan: PlanTier = sub.status === 'ACTIVE' ? (sub.plan as PlanTier) : 'SCOUT';
    const config = getPlanConfig(effectivePlan);

    return { subscription: sub, config };
  }

  async getQuotaSummary(userId: string) {
    const { subscription, config } = await this.getOrInitSubscription(userId);
    const [leadCount, subscriberCount, domainCount, senderCount, gongCount, kbCount] = await Promise.all([
      prisma.lead.count({ where: { userId } }),
      prisma.newsletterRecipient.count({ where: { userId } }),
      prisma.domain.count({ where: { userId } }),
      prisma.sender.count({ where: { userId } }),
      prisma.gong.count({ where: { userId } }),
      prisma.knowledgeBase.count({ where: { userId } }),
    ]);

    return {
      plan: config.tier,
      displayName: config.displayName,
      status: subscription.status,
      billingCycle: subscription.billingCycle,
      cancelAtPeriodEnd: subscription.cancelAtPeriodEnd,
      currentPeriodEnd: subscription.currentPeriodEnd,
      limits: config,
      usage: {
        emailsSentThisMonth: subscription.emailsSentThisMonth,
        aiCreditsUsed: subscription.aiCreditsUsed,
        leads: leadCount,
        subscribers: subscriberCount,
        domains: domainCount,
        senders: senderCount,
        gongs: gongCount,
        knowledgeBases: kbCount,
      },
    };
  }

  async assertKnowledgeBaseCapacity(userId: string): Promise<PlanQuotaConfig> {
    const { config } = await this.getOrInitSubscription(userId);
    const count = await prisma.knowledgeBase.count({ where: { userId } });
    if (count >= config.maxKnowledgeBases) {
      throw new Error(
        `Your ${config.displayName} plan allows up to ${config.maxKnowledgeBases} Knowledge Base(s). Upgrade to Chief ($35/mo) to create up to 5 Knowledge Bases.`
      );
    }
    return config;
  }

  async assertKnowledgeResourceCapacity(userId: string, knowledgeBaseId: string): Promise<PlanQuotaConfig> {
    const { config } = await this.getOrInitSubscription(userId);
    const count = await prisma.knowledgeResource.count({ where: { knowledgeBaseId, userId } });
    if (count >= config.maxResourcesPerKnowledgeBase) {
      throw new Error(
        `Your ${config.displayName} plan allows up to ${config.maxResourcesPerKnowledgeBase} resources per Knowledge Base. Upgrade to add more files and URLs.`
      );
    }
    return config;
  }

  async assertArtifactCapacity(
    userId: string,
    scope: { campaignId?: string | null; gongId?: string | null; broadcastId?: string | null },
    fileSizeBytes?: number
  ): Promise<PlanQuotaConfig> {
    const { config } = await this.getOrInitSubscription(userId);

    if (fileSizeBytes && fileSizeBytes > config.maxArtifactSizeMb * 1024 * 1024) {
      throw new Error(
        `Artifact file exceeds your ${config.displayName} maximum size of ${config.maxArtifactSizeMb}MB.`
      );
    }

    const where: any = { userId };
    if (scope.campaignId) where.campaignId = scope.campaignId;
    else if (scope.gongId) where.gongId = scope.gongId;
    else if (scope.broadcastId) where.broadcastId = scope.broadcastId;

    const count = await prisma.artifact.count({ where });
    if (count >= config.maxArtifactsPerEntity) {
      throw new Error(
        `Your ${config.displayName} plan allows ${config.maxArtifactsPerEntity} artifact(s) per Campaign/Gong/Broadcast. Upgrade to Chief ($35/mo) for 5 per entity.`
      );
    }

    return config;
  }

  async consumeAiCredits(userId: string, cost: number = 1, bypassWithByoKey: boolean = false): Promise<void> {
    if (bypassWithByoKey) {
      const settings = await prisma.userSettings.findUnique({
        where: { userId },
        select: { aiApiKeyEncrypted: true },
      });
      if (settings?.aiApiKeyEncrypted) return;
    }

    const { subscription, config } = await this.getOrInitSubscription(userId);
    if (subscription.aiCreditsUsed + cost > config.monthlyAiCredits) {
      throw new Error(
        `Monthly AI credit allowance (${config.monthlyAiCredits}) reached on ${config.displayName}. Upgrade to Chief ($35/mo) for 500 credits/mo or attach your own AI key in Settings.`
      );
    }

    await prisma.subscription.update({
      where: { userId },
      data: { aiCreditsUsed: { increment: cost } },
    });
  }

  async recordEmailSent(userId: string, count: number = 1): Promise<void> {
    await this.getOrInitSubscription(userId);
    await prisma.subscription.update({
      where: { userId },
      data: { emailsSentThisMonth: { increment: count } },
    }).catch(() => {});
  }

  async isOverMonthlyEmailLimit(userId: string): Promise<boolean> {
    const { subscription, config } = await this.getOrInitSubscription(userId);
    return subscription.emailsSentThisMonth >= config.monthlyEmails;
  }
}

