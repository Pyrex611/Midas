<file path="src/components/CommandPalette.tsx">
import React, { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';

interface CommandPaletteProps {
  isOpen: boolean;
  onClose: () => void;
  isAdmin?: boolean;
}

export const CommandPalette: React.FC<CommandPaletteProps> = ({ isOpen, onClose, isAdmin = false }) => {
  const navigate = useNavigate();
  const [query, setQuery] = useState('');

  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        isOpen ? onClose() : null;
      }
      if (e.key === 'Escape' && isOpen) {
        onClose();
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [isOpen, onClose]);

  if (!isOpen) return null;

  const actions = [
    { label: '📊 View Campaigns', path: '/campaigns', category: 'Navigation' },
    { label: '📥 Open Unified Inbox', path: '/inbox', category: 'Navigation' },
    { label: '📋 View All Leads', path: '/leads', category: 'Navigation' },
    { label: '🌐 Manage Sending Domains', path: '/domains', category: 'Infrastructure' },
    { label: '👤 User Profile & Settings', path: '/profile', category: 'Account' },
    ...(isAdmin ? [{ label: '🛡️ Platform Admin Dashboard', path: '/admin', category: 'Administration' }] : []),
  ];

  const filtered = actions.filter((a) => a.label.toLowerCase().includes(query.toLowerCase()));

  const handleSelect = (path: string) => {
    navigate(path);
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 overflow-y-auto p-4 sm:p-6 md:p-20">
      <div className="fixed inset-0 bg-zinc-950/60 backdrop-blur-sm transition-opacity" onClick={onClose} />

      <div className="relative mx-auto max-w-xl bg-white rounded-2xl shadow-2xl border border-zinc-200 overflow-hidden transform transition-all animate-in zoom-in-95 duration-150">
        <div className="flex items-center px-4 border-b border-zinc-100">
          <svg className="w-5 h-5 text-zinc-400 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Search commands, campaigns, or routes..."
            className="w-full py-4 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none"
            autoFocus
          />
          <kbd className="hidden sm:inline-block px-2 py-0.5 text-[10px] font-bold text-zinc-400 bg-zinc-100 rounded border border-zinc-200">
            ESC
          </kbd>
        </div>

        <div className="max-h-80 overflow-y-auto p-2 space-y-1">
          {filtered.length === 0 ? (
            <p className="p-4 text-xs text-center text-zinc-400">No matching commands found.</p>
          ) : (
            filtered.map((item, idx) => (
              <button
                key={idx}
                onClick={() => handleSelect(item.path)}
                className="w-full flex items-center justify-between p-3 rounded-xl hover:bg-zinc-50 text-left text-sm font-medium text-zinc-700 hover:text-blue-600 transition-colors group"
              >
                <span>{item.label}</span>
                <span className="text-[10px] uppercase font-bold text-zinc-400 bg-zinc-100 group-hover:bg-blue-50 group-hover:text-blue-600 px-2 py-0.5 rounded">
                  {item.category}
                </span>
              </button>
            ))
          )}
        </div>
      </div>
    </div>
  );
};
</file>

<file path="src/components/LeadEmailPreviewModal.tsx">
import React, { useEffect, useState } from 'react';
import { campaignAPI } from '../services/api';

interface Props {
  isOpen: boolean;
  onClose: () => void;
  campaignId: string;
  lead: {
    id: string;
    name: string;
    email: string;
    outreachStatus?: string;
  } | null;
  onSendSuccess?: () => void;
}

export const LeadEmailPreviewModal: React.FC<Props> = ({
  isOpen,
  onClose,
  campaignId,
  lead,
  onSendSuccess,
}) => {
  const [drafts, setDrafts] = useState<any[]>([]);
  const [currentDraftIndex, setCurrentDraftIndex] = useState(0);
  const [preview, setPreview] = useState<{ subject: string; body: string } | null>(null);
  const [thread, setThread] = useState<any[]>([]);
  const [replyDraft, setReplyDraft] = useState<any | null>(null);
  const [loadingThread, setLoadingThread] = useState(false);
  const [generatingReply, setGeneratingReply] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [sending, setSending] = useState(false);

  const loadThread = async () => {
    if (!isOpen || !lead) return;
    setLoadingThread(true);
    try {
      const [threadRes, draftRes] = await Promise.all([
        campaignAPI.getLeadThread(campaignId, lead.id),
        campaignAPI.getReplyDraft(campaignId, lead.id).catch(() => null)
      ]);
      setThread(threadRes.data);
      if (draftRes && draftRes.data) {
        setReplyDraft(draftRes.data);
      } else {
        setReplyDraft(null);
      }
    } catch (err) {
      setError('Failed to load conversation thread');
    } finally {
      setLoadingThread(false);
    }
  };

  useEffect(() => {
    if (isOpen && lead) {
      campaignAPI.getDrafts(campaignId)
        .then(res => setDrafts(res.data))
        .catch(() => setError('Failed to load drafts'));
      loadThread();
    }
  }, [isOpen, campaignId, lead]);

  const handleRefresh = async () => {
    await loadThread();
  };

  const handleGenerateReply = async () => {
    if (!lead) return;
    setGeneratingReply(true);
    try {
      const res = await campaignAPI.generateReplyDraft(campaignId, lead.id);
      setReplyDraft(res.data);
    } catch (err: any) {
      setError('Failed to generate reply draft');
    } finally {
      setGeneratingReply(false);
    }
  };

  const handleSendReply = async () => {
    if (!replyDraft || !lead) return;
    setSending(true);
    try {
      await campaignAPI.sendReplyDraft(campaignId, lead.id, {
        subject: replyDraft.subject,
        body: replyDraft.body,
      });
      await loadThread();
      setReplyDraft(null);
      if (onSendSuccess) onSendSuccess();
    } catch (err: any) {
      setError('Failed to send reply');
    } finally {
      setSending(false);
    }
  };

  if (!isOpen || !lead) return null;

  return (
    <div className="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
      <div className="relative top-20 mx-auto p-5 border w-full max-w-3xl shadow-lg rounded-md bg-white max-h-[90vh] overflow-y-auto">
        <div className="flex justify-between items-center mb-4 border-b pb-2">
          <h3 className="text-lg font-medium text-gray-900">{lead.name} – Conversation</h3>
          <div className="flex items-center space-x-2">
            <button onClick={handleRefresh} className="p-2 rounded-full hover:bg-gray-200" title="Refresh Thread">
              🔄
            </button>
            <button onClick={onClose} className="text-gray-400 hover:text-gray-600">✕</button>
          </div>
        </div>

        {error && <div className="bg-red-100 text-red-700 p-3 rounded mb-4">{error}</div>}

        {loadingThread ? (
          <div className="py-8 text-center text-gray-500">Loading conversation thread...</div>
        ) : (
          <div className="space-y-4 mb-6">
            {thread.map((msg) => (
              <div key={msg.id} className={`flex ${msg.isIncoming ? 'justify-start' : 'justify-end'}`}>
                <div className={`max-w-[80%] p-3 rounded-lg ${msg.isIncoming ? 'bg-white border' : 'bg-blue-50 border border-blue-200'}`}>
                  <div className="text-xs text-gray-500 mb-1">{new Date(msg.sentAt).toLocaleString()}</div>
                  <div className="text-sm font-medium">{msg.subject}</div>
                  <div className="mt-1 text-sm whitespace-pre-wrap">{msg.body}</div>
                </div>
              </div>
            ))}

            {!replyDraft && (
              <div className="flex justify-center mt-4">
                <button onClick={handleGenerateReply} disabled={generatingReply} className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                  {generatingReply ? 'Generating...' : 'Generate AI Reply'}
                </button>
              </div>
            )}

            {replyDraft && (
              <div className="bg-blue-100 p-4 rounded-lg border border-blue-300 mt-4">
                <h4 className="font-bold text-blue-900 text-sm mb-2">Suggested Reply Draft</h4>
                <p className="text-sm font-semibold">{replyDraft.subject}</p>
                <p className="text-sm whitespace-pre-wrap mt-1">{replyDraft.body}</p>
                <div className="mt-3 flex justify-end">
                  <button onClick={handleSendReply} disabled={sending} className="px-4 py-2 bg-green-600 text-white rounded text-sm hover:bg-green-700">
                    {sending ? 'Sending...' : 'Send Reply'}
                  </button>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/components/leads/LeadDrawer.tsx">
import React, { useEffect, useState } from 'react';
import { Sheet } from '../common/Sheet';
import { campaignAPI } from '../../services/api';
import { useToast } from '../../context/ToastContext';
import { Lead } from '../../types/lead';

interface LeadDrawerProps {
  isOpen: boolean;
  onClose: () => void;
  lead: Lead | null;
  campaignId?: string;
  onUpdate?: () => void;
}

export const LeadDrawer: React.FC<LeadDrawerProps> = ({
  isOpen,
  onClose,
  lead,
  campaignId,
  onUpdate,
}) => {
  const { toast } = useToast();
  const [thread, setThread] = useState<any[]>([]);
  const [scheduledEmails, setScheduledEmails] = useState<any[]>([]);
  const [replyDraft, setReplyDraft] = useState<any | null>(null);
  const [loading, setLoading] = useState(false);
  const [generating, setGenerating] = useState(false);
  const [sending, setSending] = useState(false);

  // Scheduled Email Edit State
  const [editingScheduledId, setEditingScheduledId] = useState<string | null>(null);
  const [editSubject, setEditSubject] = useState('');
  const [editBody, setEditBody] = useState('');
  const [savingScheduled, setSavingScheduled] = useState(false);
  const [sendingNowId, setSendingNowId] = useState<string | null>(null);

  const activeCampaignId = campaignId || lead?.campaignId || undefined;

  const loadData = () => {
    if (!isOpen || !lead || !activeCampaignId) return;

    setLoading(true);
    Promise.all([
      campaignAPI.getLeadThread(activeCampaignId, lead.id),
      campaignAPI.getReplyDraft(activeCampaignId, lead.id).catch(() => null),
    ])
      .then(([threadRes, draftRes]) => {
        setThread(threadRes.data?.emails || []);
        setScheduledEmails(threadRes.data?.scheduled || []);
        setReplyDraft(draftRes?.data || null);
      })
      .catch(() => {
        toast.error('Failed to load conversation history', 'Network Error');
      })
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    loadData();
  }, [isOpen, lead, activeCampaignId]);

  const handleStartEditScheduled = (item: any) => {
    setEditingScheduledId(item.id);
    setEditSubject(item.rawSubject);
    setEditBody(item.rawBody);
  };

  const handleSaveScheduled = async (pendingId: string) => {
    if (!editSubject.trim() || !editBody.trim() || !activeCampaignId) return;

    setSavingScheduled(true);
    try {
      await campaignAPI.updateScheduledEmail(activeCampaignId, pendingId, {
        subject: editSubject.trim(),
        body: editBody.trim(),
      });
      toast.success('Scheduled email updated and variables preserved', 'Saved');
      setEditingScheduledId(null);
      loadData();
    } catch {
      toast.error('Could not save scheduled email', 'Error');
    } finally {
      setSavingScheduled(false);
    }
  };

  const handleSendNow = async (pendingId: string) => {
    if (!activeCampaignId) return;
    setSendingNowId(pendingId);
    try {
      await campaignAPI.sendScheduledEmailNow(activeCampaignId, pendingId);
      toast.success('Email dispatched immediately (pause bypassed)', 'Sent');
      loadData();
      if (onUpdate) onUpdate();
    } catch (err: any) {
      toast.error(err.response?.data?.error || 'Failed to dispatch email', 'Send Error');
    } finally {
      setSendingNowId(null);
    }
  };

  const handleGenerateReply = async () => {
    if (!lead || !activeCampaignId) return;
    setGenerating(true);
    try {
      const res = await campaignAPI.generateReplyDraft(activeCampaignId, lead.id);
      setReplyDraft(res.data);
      toast.success('AI reply drafted successfully', 'Copilot');
    } catch {
      toast.error('Could not generate AI reply draft', 'Error');
    } finally {
      setGenerating(false);
    }
  };

  const handleSendReply = async () => {
    if (!lead || !activeCampaignId || !replyDraft) return;
    setSending(true);
    try {
      await campaignAPI.sendReplyDraft(activeCampaignId, lead.id, {
        subject: replyDraft.subject,
        body: replyDraft.body,
      });
      toast.success(`Reply sent to ${lead.email}`, 'Dispatched');
      setReplyDraft(null);
      loadData();
      if (onUpdate) onUpdate();
    } catch (err: any) {
      toast.error(err.response?.data?.error || 'Failed to dispatch reply', 'Send Error');
    } finally {
      setSending(false);
    }
  };

  if (!lead) return null;

  return (
    <Sheet
      isOpen={isOpen}
      onClose={onClose}
      title={lead.name}
      description={`${lead.email} · ${lead.company || 'No Company'} · ${lead.position || 'No Title'}`}
      width="xl"
    >
      <div className="space-y-6">
        {/* Attributes */}
        <div className="flex flex-wrap gap-2 pb-4 border-b border-zinc-100">
          <span className="px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-100 text-zinc-800">
            Status: {lead.status}
          </span>
          <span className="px-2.5 py-1 text-xs font-semibold rounded-lg bg-blue-50 text-blue-700">
            Outreach: {lead.outreachStatus || 'UNCONTACTED'}
          </span>
          {lead.verificationStatus && (
            <span className={`px-2.5 py-1 text-xs font-semibold rounded-lg ${
              lead.verificationStatus === 'VALID' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'
            }`}>
              {lead.verificationStatus}
            </span>
          )}
        </div>

        {/* 1. UPCOMING SCHEDULED MESSAGES (With Resolved View, In-Place Edit & Send Now) */}
        {scheduledEmails.length > 0 && (
          <div className="space-y-3">
            <div className="flex items-center justify-between">
              <span className="text-xs font-bold uppercase tracking-wider text-amber-700 flex items-center gap-1.5">
                <span className="w-2 h-2 rounded-full bg-amber-500 animate-pulse" />
                Scheduled Dispatch ({scheduledEmails.length})
              </span>
              <span className="text-[10px] text-zinc-400">Waiting in queue</span>
            </div>

            {scheduledEmails.map((item) => {
              const isEditing = editingScheduledId === item.id;
              const isSending = sendingNowId === item.id;

              return (
                <div key={item.id} className="p-4 rounded-2xl bg-amber-50/60 border border-amber-200/80 space-y-3 text-xs">
                  <div className="flex items-center justify-between pb-2 border-b border-amber-200/50">
                    <span className="font-bold text-amber-900 text-[11px]">
                      {isEditing ? 'Editing Raw Template (Mustache Mode)' : 'Resolved Live Preview (As Sent)'}
                    </span>

                    <div className="flex items-center gap-2">
                      {!isEditing ? (
                        <>
                          <button
                            onClick={() => handleStartEditScheduled(item)}
                            className="px-2.5 py-1 bg-white hover:bg-zinc-100 text-zinc-700 font-bold rounded-lg border border-zinc-200 text-[10px] transition-colors"
                          >
                            Edit
                          </button>
                          <button
                            onClick={() => handleSendNow(item.id)}
                            disabled={isSending}
                            className="px-3 py-1 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg text-[10px] transition-colors disabled:opacity-50 shadow-2xs"
                          >
                            {isSending ? 'Sending...' : 'Send Now ✈'}
                          </button>
                        </>
                      ) : (
                        <div className="flex gap-1.5">
                          <button
                            onClick={() => setEditingScheduledId(null)}
                            className="px-2.5 py-1 text-zinc-500 hover:text-zinc-800 text-[10px]"
                          >
                            Cancel
                          </button>
                          <button
                            onClick={() => handleSaveScheduled(item.id)}
                            disabled={savingScheduled}
                            className="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-[10px] disabled:opacity-50"
                          >
                            {savingScheduled ? 'Saving...' : 'Save & Resolve'}
                          </button>
                        </div>
                      )}
                    </div>
                  </div>

                  {/* Body Content: Either Raw Mustache when editing, or Resolved Preview when viewing */}
                  {isEditing ? (
                    <div className="space-y-2">
                      <div>
                        <label className="block text-[10px] font-bold uppercase text-zinc-500 mb-1">Subject</label>
                        <input
                          type="text"
                          value={editSubject}
                          onChange={(e) => setEditSubject(e.target.value)}
                          className="w-full px-3 py-1.5 bg-white border border-zinc-200 rounded-lg text-xs font-mono focus:outline-none focus:border-blue-500"
                        />
                      </div>
                      <div>
                        <label className="block text-[10px] font-bold uppercase text-zinc-500 mb-1">Body Text</label>
                        <textarea
                          rows={6}
                          value={editBody}
                          onChange={(e) => setEditBody(e.target.value)}
                          className="w-full p-3 bg-white border border-zinc-200 rounded-lg text-xs font-mono focus:outline-none focus:border-blue-500"
                        />
                      </div>
                    </div>
                  ) : (
                    <div className="space-y-1">
                      <p className="font-bold text-zinc-900">{item.resolvedSubject}</p>
                      <p className="whitespace-pre-wrap leading-relaxed text-zinc-700 opacity-95">{item.resolvedBody}</p>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}

        {/* 2. PAST CONVERSATION STREAM */}
        <div>
          <h3 className="text-xs font-bold uppercase tracking-wider text-zinc-400 mb-3">Conversation Stream</h3>
          {loading ? (
            <div className="py-12 text-center text-xs text-zinc-400">Loading conversation history...</div>
          ) : thread.length === 0 && scheduledEmails.length === 0 ? (
            <div className="p-6 text-center rounded-xl bg-zinc-50 border border-zinc-100 text-xs text-zinc-500">
              No emails sent or queued yet for this lead.
            </div>
          ) : (
            <div className="space-y-3">
              {thread.map((msg) => (
                <div
                  key={msg.id}
                  className={`p-4 rounded-2xl text-xs space-y-1.5 ${
                    msg.isIncoming
                      ? 'bg-zinc-100/80 border border-zinc-200 text-zinc-900 mr-6'
                      : 'bg-blue-600 text-white ml-6 shadow-sm'
                  }`}
                >
                  <div className="flex items-center justify-between opacity-75 text-[10px]">
                    <span className="font-bold">{msg.isIncoming ? 'Prospect Reply' : 'Outbound Dispatch'}</span>
                    <span>{new Date(msg.sentAt).toLocaleString()}</span>
                  </div>
                  <p className="font-bold">{msg.subject}</p>
                  <p className="whitespace-pre-wrap leading-relaxed opacity-95">{msg.body}</p>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* 3. AI REPLY COPILOT */}
        {activeCampaignId && (
          <div className="pt-4 border-t border-zinc-100">
            <div className="flex items-center justify-between mb-3">
              <span className="text-xs font-bold uppercase tracking-wider text-zinc-700">AI Response Copilot</span>
              {!replyDraft && (
                <button
                  onClick={handleGenerateReply}
                  disabled={generating}
                  className="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition-colors disabled:opacity-50"
                >
                  {generating ? 'Drafting...' : '✨ Generate Smart Reply'}
                </button>
              )}
            </div>

            {replyDraft && (
              <div className="p-4 bg-blue-50 border border-blue-200 rounded-2xl space-y-3">
                <div>
                  <p className="text-[10px] font-bold uppercase text-blue-600">Subject</p>
                  <p className="text-xs font-semibold text-zinc-900">{replyDraft.subject}</p>
                </div>
                <div>
                  <p className="text-[10px] font-bold uppercase text-blue-600">Body</p>
                  <p className="text-xs text-zinc-800 whitespace-pre-wrap">{replyDraft.body}</p>
                </div>
                <div className="flex justify-end gap-2 pt-2 border-t border-blue-200/60">
                  <button
                    onClick={() => setReplyDraft(null)}
                    className="px-3 py-1 text-xs text-zinc-600 hover:text-zinc-900"
                  >
                    Discard
                  </button>
                  <button
                    onClick={handleSendReply}
                    disabled={sending}
                    className="px-4 py-1.5 bg-blue-600 text-white text-xs font-bold rounded-lg hover:bg-blue-700 disabled:opacity-50"
                  >
                    {sending ? 'Sending...' : 'Approve & Send Reply'}
                  </button>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </Sheet>
  );
};
</file>

<file path="src/context/AuthContext.tsx">
import React, { createContext, useState, useEffect, useContext } from 'react';
import { useAuth as useClerkAuth, useUser } from '@clerk/clerk-react';
import api from '../services/api';

interface User {
  id: string;
  email: string;
  name?: string;
}

interface AuthContextType {
  user: User | null;
  loading: boolean;
  signIn: (email: string, password: string) => Promise<void>;
  signUp: (email: string, password: string, name?: string) => Promise<void>;
  signOut: () => Promise<void>;
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const { isLoaded, isSignedIn, signOut: clerkSignOut, getToken } = useClerkAuth();
  const { user: clerkUser, isLoaded: isUserLoaded } = useUser();
  const [user, setUser] = useState<User | null>(null);

  // Register the Clerk JWT token interceptor dynamically onto our custom API Axios instance
  useEffect(() => {
    if (!isLoaded) return;

    const interceptor = api.interceptors.request.use(async (config) => {
      try {
        const token = await getToken();
        if (token) {
          config.headers.Authorization = `Bearer ${token}`;
        }
      } catch (err) {
        console.error('Error attaching Clerk session token:', err);
      }
      return config;
    });

    return () => {
      api.interceptors.request.eject(interceptor);
    };
  }, [isLoaded, getToken]);

  // Map Clerk's reactive user model directly to the existing User interface to prevent any refactoring regressions
  useEffect(() => {
    if (isLoaded && isSignedIn && clerkUser) {
      setUser({
        id: clerkUser.id,
        email: clerkUser.primaryEmailAddress?.emailAddress || '',
        name: clerkUser.fullName || clerkUser.primaryEmailAddress?.emailAddress.split('@')[0],
      });
    } else {
      setUser(null);
    }
  }, [isLoaded, isSignedIn, clerkUser]);

  const signIn = async () => {
    throw new Error('Use Clerk UI components directly to sign in.');
  };

  const signUp = async () => {
    throw new Error('Use Clerk UI components directly to sign up.');
  };

  const signOut = async () => {
    await clerkSignOut();
  };

  // Crucial Fix: We are only "done loading" when BOTH Clerk's auth AND user details are fully populated and mapped.
  // This prevents the split-second session propagation delay from prematurely triggering a redirect to "/login".
  const loading = !isLoaded || (isSignedIn && (!isUserLoaded || !user));

  return (
    <AuthContext.Provider
      value={{
        user,
        loading,
        signIn,
        signUp,
        signOut,
      }}
    >
      {children}
    </AuthContext.Provider>
  );
};

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (!context) throw new Error('useAuth must be used within AuthProvider');
  return context;
};
</file>

<file path="src/context/ToastContext.tsx">
import React, { createContext, useContext, useState, useCallback, useMemo } from 'react';

export interface Toast {
  id: string;
  type: 'success' | 'error' | 'info' | 'warning';
  title?: string;
  message: string;
  duration?: number;
  action?: {
    label: string;
    onClick: () => void;
  };
}

interface ToastContextType {
  toast: {
    success: (message: string, title?: string, action?: Toast['action']) => void;
    error: (message: string, title?: string) => void;
    info: (message: string, title?: string) => void;
    warning: (message: string, title?: string) => void;
  };
}

const ToastContext = createContext<ToastContextType | undefined>(undefined);

export const ToastProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [toasts, setToasts] = useState<Toast[]>([]);

  const addToast = useCallback((type: Toast['type'], message: string, title?: string, action?: Toast['action']) => {
    const id = `toast-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`;
    const newToast: Toast = { id, type, message, title, action, duration: 5000 };

    setToasts((prev) => [...prev, newToast]);

    setTimeout(() => {
      setToasts((prev) => prev.filter((t) => t.id !== id));
    }, newToast.duration);
  }, []);

  const removeToast = useCallback((id: string) => {
    setToasts((prev) => prev.filter((t) => t.id !== id));
  }, []);

  // Stabilize toast reference so it NEVER triggers re-renders in consumers
  const toast = useMemo(
    () => ({
      success: (message: string, title?: string, action?: Toast['action']) => addToast('success', message, title, action),
      error: (message: string, title?: string) => addToast('error', message, title),
      info: (message: string, title?: string) => addToast('info', message, title),
      warning: (message: string, title?: string) => addToast('warning', message, title),
    }),
    [addToast]
  );

  const getToastStyles = (type: Toast['type']) => {
    switch (type) {
      case 'success':
        return 'bg-emerald-950/90 border-emerald-500/40 text-emerald-200';
      case 'error':
        return 'bg-rose-950/90 border-rose-500/40 text-rose-200';
      case 'warning':
        return 'bg-amber-950/90 border-amber-500/40 text-amber-200';
      case 'info':
      default:
        return 'bg-zinc-900/90 border-zinc-700/60 text-zinc-200';
    }
  };

  return (
    <ToastContext.Provider value={{ toast }}>
      {children}
      <div className="fixed bottom-5 right-5 z-[100] flex flex-col gap-2.5 max-w-md w-full pointer-events-none px-4 sm:px-0">
        {toasts.map((t) => (
          <div
            key={t.id}
            className={`pointer-events-auto flex items-start justify-between gap-3 p-4 rounded-xl border shadow-2xl backdrop-blur-md transition-all animate-in slide-in-from-bottom-3 duration-200 ${getToastStyles(
              t.type
            )}`}
          >
            <div className="flex-1 min-w-0">
              {t.title && <p className="text-xs font-bold uppercase tracking-wider mb-0.5 opacity-90">{t.title}</p>}
              <p className="text-sm font-medium leading-relaxed break-words">{t.message}</p>
              {t.action && (
                <button
                  onClick={() => {
                    t.action?.onClick();
                    removeToast(t.id);
                  }}
                  className="mt-2 text-xs font-bold underline hover:opacity-80 transition-opacity"
                >
                  {t.action.label}
                </button>
              )}
            </div>
            <button
              onClick={() => removeToast(t.id)}
              className="text-xs opacity-60 hover:opacity-100 transition-opacity p-1 -mr-1"
            >
              ✕
            </button>
          </div>
        ))}
      </div>
    </ToastContext.Provider>
  );
};

export const useToast = () => {
  const context = useContext(ToastContext);
  if (!context) throw new Error('useToast must be used within a ToastProvider');
  return context;
};
</file>

