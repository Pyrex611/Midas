const GONG_WRITABLE_FIELDS = [
  'description', 'cadence', 'templateStyle',
  'welcomeEmailEnabled', 'welcomeSubject', 'welcomeBody',
  'embedTheme', 'accentColor', 'headline', 'subheadline', 'buttonText', 'successMessage',
] as const;

function cleanSlug(raw: string): string {
  return raw.toLowerCase().trim().replace(/[^a-z0-9_-]/g, '-');
}

export const createGong = async (req: AuthRequest, res: Response, next: NextFunction) => {
  try {
    const userId = req.user!.id;
    const { name, slug, dedicatedSenderId, knowledgeBaseId } = req.body;
    if (!name?.trim()) return res.status(400).json({ error: 'Gong channel name is required' });

    let validSenderId: string | null = null;
    if (dedicatedSenderId && typeof dedicatedSenderId === 'string' && dedicatedSenderId.trim()) {
      const sender = await prisma.sender.findFirst({
        where: { id: dedicatedSenderId.trim(), userId },
        select: { id: true },
      });
      if (!sender) return res.status(404).json({ error: 'Selected dedicated mailbox sender was not found on your account' });
      validSenderId = sender.id;
    }

    let validKbId: string | null = null;
    if (knowledgeBaseId && typeof knowledgeBaseId === 'string' && knowledgeBaseId.trim()) {
      const kb = await prisma.knowledgeBase.findFirst({
        where: { id: knowledgeBaseId.trim(), userId },
        select: { id: true },
      });
      if (!kb) return res.status(404).json({ error: 'Selected Knowledge Base not found' });
      validKbId = kb.id;
    }

    const data: any = {
      userId,
      name: name.trim(),
      slug: cleanSlug(slug || name),
      dedicatedSenderId: validSenderId,
      knowledgeBaseId: validKbId,
    };
    for (const field of GONG_WRITABLE_FIELDS) {
      if (req.body[field] !== undefined) data[field] = req.body[field];
    }

    const gong = await prisma.gong.create({
      data,
      include: {
        dedicatedSender: {
          select: {
            id: true,
            localPart: true,
            displayName: true,
            domain: { select: { domainName: true } },
          },
        },
      },
    });
    res.status(201).json({ success: true, gong });
  } catch (error: any) {
    if (error.code === 'P2002') return res.status(409).json({ error: 'A Gong with this slug already exists' });
    next(error);
  }
};

export const updateGong = async (req: AuthRequest, res: Response, next: NextFunction) => {
  try {
    const userId = req.user!.id;
    const { id } = req.params;
    const data: Record<string, any> = {};

    if (req.body.name?.trim()) data.name = req.body.name.trim();
    if (req.body.slug) data.slug = cleanSlug(req.body.slug);

    if (req.body.dedicatedSenderId !== undefined) {
      if (!req.body.dedicatedSenderId) {
        data.dedicatedSenderId = null;
      } else {
        const sender = await prisma.sender.findFirst({
          where: { id: String(req.body.dedicatedSenderId).trim(), userId },
          select: { id: true },
        });
        if (!sender) return res.status(404).json({ error: 'Selected dedicated mailbox sender was not found on your account' });
        data.dedicatedSenderId = sender.id;
      }
    }

    if (req.body.knowledgeBaseId !== undefined) {
      if (!req.body.knowledgeBaseId) {
        data.knowledgeBaseId = null;
      } else {
        const kb = await prisma.knowledgeBase.findFirst({
          where: { id: String(req.body.knowledgeBaseId).trim(), userId },
          select: { id: true },
        });
        if (!kb) return res.status(404).json({ error: 'Selected Knowledge Base not found' });
        data.knowledgeBaseId = kb.id;
      }
    }

    for (const field of GONG_WRITABLE_FIELDS) {
      if (req.body[field] !== undefined) data[field] = req.body[field];
    }

    const result = await prisma.gong.updateMany({ where: { id, userId }, data });
    if (result.count === 0) return res.status(404).json({ error: 'Gong channel not found' });

    const gong = await prisma.gong.findUnique({
      where: { id },
      include: {
        dedicatedSender: {
          select: {
            id: true,
            localPart: true,
            displayName: true,
            domain: { select: { domainName: true } },
          },
        },
      },
    });
    res.json({ success: true, gong });
  } catch (error: any) {
    if (error.code === 'P2002') return res.status(409).json({ error: 'A Gong with this slug already exists' });
    next(error);
  }
};

export const deleteGong = async (req: AuthRequest, res: Response, next: NextFunction) => {
  try {
    await prisma.gong.deleteMany({ where: { id: req.params.id, userId: req.user!.id } });
    res.json({ success: true });
  } catch (error) { next(error); }
};
