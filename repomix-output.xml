<file path="server/services/leadQueue.service.ts">
import prisma from '../lib/prisma';
import { logger } from '../config/logger';
import { isEmailBlocked } from '../lib/blocklist';
import Papa from 'papaparse';
import * as XLSX from 'xlsx';
import { verificationService } from './verification';
import { reconcileCampaignQueue } from './queueReconciliation.service';

interface ParsedLeadRow {
  name: string;
  email: string;
  company: string | null;
  position: string | null;
}

interface ColumnMappingConfig {
  email: string;
  nameMode?: 'single' | 'split';
  nameCol?: string;
  firstNameCol?: string;
  lastNameCol?: string;
  companyCol?: string;
  positionCol?: string;
}

export class LeadQueueService {
  private parseRowWithMapping(row: any, mapping?: ColumnMappingConfig | null): ParsedLeadRow | null {
    if (!row || typeof row !== 'object') return null;

    const normalizedRow: Record<string, string> = {};
    for (const [k, v] of Object.entries(row)) {
      const cleanKey = k.replace(/^\uFEFF/, '').trim();
      normalizedRow[cleanKey] = v !== null && v !== undefined ? String(v).trim() : '';
    }

    let email = '';
    let name = '';
    let company: string | null = null;
    let position: string | null = null;

    if (mapping?.email && normalizedRow[mapping.email]) {
      email = normalizedRow[mapping.email].toLowerCase();
    } else {
      const emailKey = Object.keys(normalizedRow).find(k =>
        /^(work_?email|corporate_?email|business_?email|primary_?email|contact_?email|email_?address|email)$/i.test(k) ||
        (/email/i.test(k) && !/domain|status|valid/i.test(k))
      );
      if (emailKey) email = normalizedRow[emailKey].toLowerCase();
    }

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      return null;
    }

    if (mapping?.nameMode === 'split' && (mapping.firstNameCol || mapping.lastNameCol)) {
      const first = mapping.firstNameCol ? normalizedRow[mapping.firstNameCol] || '' : '';
      const last = mapping.lastNameCol ? normalizedRow[mapping.lastNameCol] || '' : '';
      name = `${first} ${last}`.trim();
    } else if (mapping?.nameCol && normalizedRow[mapping.nameCol]) {
      name = normalizedRow[mapping.nameCol];
    } else {
      const fullNameKey = Object.keys(normalizedRow).find(k =>
        /^(full_?name|contact_?name|lead_?name|prospect_?name|name)$/i.test(k) && !/company|domain/i.test(k)
      );
      if (fullNameKey && normalizedRow[fullNameKey]) {
        name = normalizedRow[fullNameKey];
      } else {
        const firstKey = Object.keys(normalizedRow).find(k => /^(first_?name|first|fname|given_?name)$/i.test(k));
        const lastKey = Object.keys(normalizedRow).find(k => /^(last_?name|last|lname|surname|family_?name)$/i.test(k));
        const first = firstKey ? normalizedRow[firstKey] || '' : '';
        const last = lastKey ? normalizedRow[lastKey] || '' : '';
        name = `${first} ${last}`.trim();
      }
    }

    if (!name) name = email.split('@')[0];

    if (mapping?.companyCol && normalizedRow[mapping.companyCol]) {
      company = normalizedRow[mapping.companyCol];
    } else {
      const companyKey = Object.keys(normalizedRow).find(k =>
        /^(company_?name|company|organization|account_?name|account|employer|firm)$/i.test(k)
      );
      if (companyKey) company = normalizedRow[companyKey] || null;
    }

    if (mapping?.positionCol && normalizedRow[mapping.positionCol]) {
      position = normalizedRow[mapping.positionCol];
    } else {
      const positionKey = Object.keys(normalizedRow).find(k =>
        /^(job_?title|title|position|role|designation|headline)$/i.test(k)
      );
      if (positionKey) position = normalizedRow[positionKey] || null;
    }

    if (company && /^(n\/a|none|null|undefined|-)$/i.test(company)) company = null;
    if (position && /^(n\/a|none|null|undefined|-)$/i.test(position)) position = null;

    return { name, email, company, position };
  }

  async processPendingUploads(): Promise<{ jobsProcessed: number }> {
    let jobsProcessed = 0;
    try {
      await prisma.$executeRaw`
        UPDATE "UploadJob"
        SET status = 'PENDING'
        WHERE status = 'PROCESSING'
        AND updated_at < NOW() - INTERVAL '15 minutes'
      `;

      let jobIds: string[] = [];
      try {
        jobIds = await prisma.$transaction(async (tx) => {
          const lockedJobs = await tx.$queryRaw<{ id: string }[]>`
            SELECT id FROM "UploadJob"
            WHERE status IN ('PENDING', 'VERIFYING')
            ORDER BY created_at ASC
            LIMIT 5
            FOR UPDATE SKIP LOCKED
          `;

          if (lockedJobs.length === 0) return [];
          const ids = lockedJobs.map(j => j.id);

          await tx.uploadJob.updateMany({
            where: { id: { in: ids }, status: 'PENDING' },
            data: { status: 'PROCESSING' }
          });

          return ids;
        }, { maxWait: 5000, timeout: 8000 });
      } catch (txErr: any) {
        logger.warn({ err: txErr?.message }, 'Upload job claim transaction timed out');
        return { jobsProcessed: 0 };
      }

      if (jobIds.length === 0) return { jobsProcessed: 0 };

      for (const jobId of jobIds) {
        const job = await prisma.uploadJob.findUnique({ where: { id: jobId } });
        if (!job) continue;

        try {
          if (job.status === 'PROCESSING') {
            const response = await fetch(job.blobUrl);
            const arrayBuffer = await response.arrayBuffer();
            const buffer = Buffer.from(arrayBuffer);

            let rawLeads: any[] = [];
            const isExcel = job.filename.endsWith('.xlsx') || job.filename.endsWith('.xls');

            if (isExcel) {
              const workbook = XLSX.read(buffer, { type: 'buffer' });
              const sheetName = workbook.SheetNames[0];
              rawLeads = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName]);
            } else {
              const csvText = buffer.toString('utf8');
              const parsed = Papa.parse(csvText, { header: true, skipEmptyLines: true });
              rawLeads = parsed.data as any[];
            }

            let mappingConfig: ColumnMappingConfig | null = null;
            if (job.columnMapping) {
              try { mappingConfig = JSON.parse(job.columnMapping); } catch { mappingConfig = null; }
            }

            const blocklist = await prisma.blocklist.findMany({ where: { userId: job.userId } });

            const validRows: ParsedLeadRow[] = [];
            let blockedCount = 0;

            for (const row of rawLeads) {
              const parsedRow = this.parseRowWithMapping(row, mappingConfig);
              if (!parsedRow) continue;

              if (isEmailBlocked(parsedRow.email, blocklist)) {
                blockedCount++;
                continue;
              }
              validRows.push(parsedRow);
            }

            if (validRows.length === 0) {
              await prisma.uploadJob.update({
                where: { id: job.id },
                data: { status: 'COMPLETED', totalRows: rawLeads.length, blockedLeads: blockedCount },
              });
              jobsProcessed++;
              continue;
            }

            if (!job.verifyEmails || !verificationService.isAvailable()) {
              await this.insertLeads(
                job.id,
                job.userId,
                validRows.map(r => ({ ...r, verificationStatus: 'UNVERIFIED' })),
                { totalRows: rawLeads.length, blockedLeads: blockedCount, catchAllLeads: 0, invalidLeads: 0 },
                job.campaignId
              );
              jobsProcessed++;
              continue;
            }

            const emailsToVerify = validRows.map(r => r.email);
            const verificationId = await verificationService.submitBulkJob(emailsToVerify);

            await prisma.uploadJob.update({
              where: { id: job.id },
              data: {
                status: 'VERIFYING',
                verificationId,
                totalRows: rawLeads.length,
                blockedLeads: blockedCount,
                pendingRows: JSON.stringify(validRows),
              },
            });
            jobsProcessed++;
            logger.info(`Job ${job.id} sent to ${verificationService.providerName} for verification.`);
          }
          else if (job.status === 'VERIFYING' && job.verificationId) {
            const rawRows: ParsedLeadRow[] = JSON.parse(job.pendingRows || '[]');
            const emails = rawRows.map(r => r.email);

            const { isComplete, results } = await verificationService.getBulkJobResults(job.verificationId, emails);

            if (!isComplete) {
              logger.debug(`Job ${job.id} still verifying...`);
              continue;
            }

            let catchAllCount = 0;
            let invalidCount = 0;
            const leadsToInsert: (ParsedLeadRow & { verificationStatus: string })[] = [];

            for (const row of rawRows) {
              const vResult = results.find(r => r.email === row.email);
              if (!vResult) continue;

              if (vResult.status === 'INVALID') invalidCount++;
              else if (vResult.status === 'CATCH_ALL') catchAllCount++;

              if (vResult.status === 'VALID' || vResult.status === 'CATCH_ALL') {
                leadsToInsert.push({ ...row, verificationStatus: vResult.status });
              }
            }

            await this.insertLeads(
              job.id,
              job.userId,
              leadsToInsert,
              {
                totalRows: job.totalRows,
                blockedLeads: job.blockedLeads,
                catchAllLeads: catchAllCount,
                invalidLeads: invalidCount,
              },
              job.campaignId
            );
            jobsProcessed++;
          }
        } catch (jobError: any) {
          logger.error({ err: jobError.message, jobId: job.id }, 'Upload job processing failure');
          await prisma.uploadJob.update({
            where: { id: job.id },
            data: { status: 'FAILED', error: jobError.message },
          });
        }
      }
    } catch (error) {
      logger.error({ error }, 'Lead Queue processing error');
    }
    return { jobsProcessed };
  }

  private async insertLeads(
    jobId: string,
    userId: string,
    leads: (ParsedLeadRow & { verificationStatus: string })[],
    counts: { totalRows: number; blockedLeads: number; catchAllLeads: number; invalidLeads: number },
    campaignId?: string | null
  ) {
    const CHUNK_SIZE = 500;
    let insertedCount = 0;
    let duplicatesCount = 0;

    for (let i = 0; i < leads.length; i += CHUNK_SIZE) {
      const chunk = leads.slice(i, i + CHUNK_SIZE).map(l => ({
        ...l,
        userId,
        campaignId: campaignId || null,
        outreachStatus: campaignId ? 'PENDING' : null,
      }));
      const insertResult = await prisma.lead.createMany({ data: chunk, skipDuplicates: true });
      insertedCount += insertResult.count;
      duplicatesCount += (chunk.length - insertResult.count);
    }

    await prisma.uploadJob.update({
      where: { id: jobId },
      data: {
        status: 'COMPLETED',
        totalRows: counts.totalRows,
        blockedLeads: counts.blockedLeads,
        validLeads: insertedCount,
        catchAllLeads: counts.catchAllLeads,
        invalidLeads: counts.invalidLeads,
        duplicates: duplicatesCount,
        pendingRows: null,
        error: null,
      },
    });

    if (campaignId) {
      reconcileCampaignQueue(campaignId, userId).catch(err => {
        logger.error({ err, campaignId }, 'Failed to reconcile queue after lead ingestion');
      });
    }

    logger.info(`Job ${jobId} completed. Inserted ${insertedCount} leads.`);
  }
}

export const leadQueueService = new LeadQueueService();
</file>

<file path="server/services/personalisation.service.ts">
export interface ComplianceOptions {
  companyName?: string | null;
  physicalAddress?: string | null;
  customOptOutText?: string | null;
  artifacts?: Record<string, { url: string; type: string; title: string }>;
}

export class PersonalisationService {
  private resolveSpintax(text: string): string {
    const spintaxRegex = /\{([^{}]+?\|[^{}]+?)\}/g;
    let result = text;
    let iterations = 0;
    const maxIterations = 50;

    while (spintaxRegex.test(result) && iterations < maxIterations) {
      result = result.replace(spintaxRegex, (_, choices) => {
        const options = choices.split('|');
        return options[Math.floor(Math.random() * options.length)] || '';
      });
      iterations++;
    }
    return result;
  }

  private resolveVariablesAndFallbacks(
    text: string,
    vars: Record<string, { value: string | null | undefined; defaultFallback: string }>
  ): string {
    let output = text;

    for (const [varName, cfg] of Object.entries(vars)) {
      const val = cfg.value && cfg.value.trim() ? cfg.value.trim() : null;

      const doublePipeRegex = new RegExp(`\\{\\{${varName}\\|([^}]+)\\}\\}`, 'gi');
      output = output.replace(doublePipeRegex, (_, fallback) => val || fallback.trim());

      const doubleRegex = new RegExp(`\\{\\{${varName}\\}\\}`, 'gi');
      output = output.replace(doubleRegex, val || cfg.defaultFallback);

      const singlePipeRegex = new RegExp(`\\{${varName}\\|([^}]+)\\}`, 'gi');
      output = output.replace(singlePipeRegex, (_, fallback) => val || fallback.trim());

      const singleRegex = new RegExp(`\\{${varName}\\}`, 'gi');
      output = output.replace(singleRegex, val || cfg.defaultFallback);
    }

    return output;
  }

  private resolveArtifacts(
    text: string,
    artifacts?: Record<string, { url: string; type: string; title: string }>
  ): string {
    if (!artifacts) return text;
    return text.replace(/\{\{artifact:([a-z0-9_-]+)\}\}/gi, (_match, rawSlug) => {
      const entry = artifacts[String(rawSlug).toLowerCase()];
      return entry ? entry.url : '';
    });
  }

  personalise(
    lead: any,
    subject: string,
    body: string,
    reference?: string | null,
    senderName?: string | null,
    unsubscribeUrl?: string | null,
    compliance?: ComplianceOptions
  ): { subject: string; body: string } {
    const safeName = lead?.name && lead.name.trim() ? lead.name.trim() : 'there';
    const firstName = safeName === 'there' ? 'there' : safeName.split(' ')[0];
    const lastName = safeName.includes(' ') ? safeName.split(' ').slice(1).join(' ') : '';

    const vars: Record<string, { value: string | null | undefined; defaultFallback: string }> = {
      name: { value: safeName, defaultFallback: 'there' },
      firstName: { value: firstName, defaultFallback: 'there' },
      first_name: { value: firstName, defaultFallback: 'there' },
      lastName: { value: lastName, defaultFallback: '' },
      last_name: { value: lastName, defaultFallback: '' },
      company: { value: lead?.company, defaultFallback: 'your company' },
      companyName: { value: lead?.company, defaultFallback: 'your company' },
      company_name: { value: lead?.company, defaultFallback: 'your company' },
      position: { value: lead?.position, defaultFallback: 'your role' },
      role: { value: lead?.position, defaultFallback: 'your role' },
      title: { value: lead?.position, defaultFallback: 'your role' },
      senderName: { value: senderName, defaultFallback: 'The Team' },
      sender_name: { value: senderName, defaultFallback: 'The Team' },
    };

    let pSubject = this.resolveVariablesAndFallbacks(subject, vars);
    let pBody = this.resolveVariablesAndFallbacks(body, vars);

    // Resolve {{artifact:slug}} tokens into CDN/hosted URLs (auto-tracked at send time)
    pSubject = this.resolveArtifacts(pSubject, compliance?.artifacts);
    pBody = this.resolveArtifacts(pBody, compliance?.artifacts);

    if (!reference) {
      pBody = pBody.split('\n').filter(line => !line.includes('reference_company')).join('\n');
    } else {
      pBody = pBody.replace(/\{\{?reference_company\}?\}/gi, 'a recent partner');
      pSubject = pSubject.replace(/\{\{?reference_company\}?\}/gi, 'a recent partner');
    }

    pSubject = this.resolveSpintax(pSubject);
    pBody = this.resolveSpintax(pBody);

    pSubject = pSubject.replace(/\{\{[^}]+\}\}/g, '').trim();
    pBody = pBody.replace(/\{\{[^}]+\}\}/g, '').trim();

    if (unsubscribeUrl) {
      const optOutLabel = compliance?.customOptOutText || "Don't want to receive these emails?";
      const legalLines: string[] = [];

      if (compliance?.companyName || compliance?.physicalAddress) {
        const entity = [compliance.companyName, compliance.physicalAddress].filter(Boolean).join(' · ');
        legalLines.push(entity);
      }

      legalLines.push(`${optOutLabel} Unsubscribe: ${unsubscribeUrl}`);
      pBody = `${pBody}\n\n---\n${legalLines.join('\n')}`;
    }

    return { subject: pSubject, body: pBody };
  }
}

export const personalisationService = new PersonalisationService();
</file>

<file path="server/services/webhooks.service.ts">
import crypto from 'crypto';
import prisma from '../lib/prisma';
import { logger } from '../config/logger';
import { tryDecrypt } from '../lib/encryption';
import { sequenceAgentService } from './sequenceAgent.service';
import { notificationService } from './notification.service';
import { webhookDispatchService } from './webhookDispatch.service';

export class WebhooksService {

  verifyMailgunSignature(timestamp: string, token: string, signature: string): boolean {
    const webhookKey = process.env.MAILGUN_WEBHOOK_KEY;
    if (!webhookKey) return false;

    const encodedToken = crypto
      .createHmac('sha256', webhookKey)
      .update(timestamp.concat(token))
      .digest('hex');

    const a = Buffer.from(encodedToken, 'utf8');
    const b = Buffer.from(signature || '', 'utf8');
    return a.length === b.length && crypto.timingSafeEqual(a, b);
  }

  verifyCustomInboundToken(domainId: string, providedToken?: string): boolean {
    if (!providedToken) return false;
    const secret = process.env.ENCRYPTION_KEY || process.env.CRON_SECRET || '';
    if (!secret) return false;
    const expected = crypto.createHmac('sha256', secret).update(`inbound:${domainId}`).digest('hex');
    const a = Buffer.from(expected, 'utf8');
    const b = Buffer.from(providedToken.trim(), 'utf8');
    return a.length === b.length && crypto.timingSafeEqual(a, b);
  }

  /**
   * Normalizes Resend Svix webhooks:
   * - `email.received`: fetches full text/html & headers via GET /emails/receiving/:id
   * - `email.opened` / `email.clicked` / `email.bounced` / `email.complained`: maps into processDeliverabilityEvent
   */
  async processResendWebhook(payload: any) {
    const eventType: string = payload?.type || '';
    const data = payload?.data || {};

    if (eventType === 'email.received') {
      const toList: string[] = Array.isArray(data.to) ? data.to : data.to ? [String(data.to)] : [];
      const firstTo = toList[0] || '';
      const recipientAddr = (firstTo.match(/<(.+)>/)?.[1] || firstTo).trim().toLowerCase();
      const recipientDomainName = recipientAddr.split('@')[1];

      let fetchedBodyText = '';
      let fetchedBodyHtml = '';
      let inReplyTo: string | null = null;
      let references: string | null = null;
      let messageId: string | null = data.message_id || null;

      if (recipientDomainName && data.email_id) {
        const domain = await prisma.domain.findFirst({
          where: { domainName: recipientDomainName, espProvider: 'resend' },
          select: { mailgunApiKeyEncrypted: true },
        });
        const resendKey = tryDecrypt(domain?.mailgunApiKeyEncrypted);

        if (resendKey) {
          try {
            const res = await fetch(`https://api.resend.com/emails/receiving/${encodeURIComponent(data.email_id)}`, {
              headers: { Authorization: `Bearer ${resendKey}` },
              signal: AbortSignal.timeout(8_000),
            });
            if (res.ok) {
              const fullEmail: any = await res.json();
              fetchedBodyText = fullEmail.text || '';
              fetchedBodyHtml = fullEmail.html || '';
              const hdrs = fullEmail.headers || {};
              inReplyTo = hdrs['in-reply-to'] || hdrs['In-Reply-To'] || null;
              references = hdrs['references'] || hdrs['References'] || null;
              messageId = fullEmail.message_id || messageId;
            }
          } catch (err: any) {
            logger.warn({ err: err?.message, emailId: data.email_id }, '[RESEND-INBOUND] Failed to fetch receiving body');
          }
        }
      }

      await this.processInboundEmail({
        'Message-Id': messageId,
        'In-Reply-To': inReplyTo,
        References: references,
        from: data.from,
        to: firstTo,
        subject: data.subject || 'Re: Outreach',
        'stripped-text': fetchedBodyText,
        'stripped-html': fetchedBodyHtml,
        timestamp: Math.floor(new Date(payload.created_at || Date.now()).getTime() / 1000),
      });
      return;
    }

    const tags = data.tags;
    let outboundEmailId: string | undefined;
    if (tags && typeof tags === 'object' && !Array.isArray(tags)) {
      outboundEmailId = tags.outbound_email_id;
    } else if (Array.isArray(tags)) {
      outboundEmailId = tags.find((t: any) => t.name === 'outbound_email_id')?.value;
    }

    if (!outboundEmailId) return;

    const eventMap: Record<string, string> = {
      'email.opened': 'opened',
      'email.clicked': 'clicked',
      'email.bounced': 'bounced',
      'email.complained': 'complained',
      'email.delivery_delayed': 'failed',
    };

    const mapped = eventMap[eventType];
    if (!mapped) return;

    await this.processDeliverabilityEvent({
      'event-data': {
        event: mapped,
        timestamp: Math.floor(new Date(payload.created_at || Date.now()).getTime() / 1000),
        'user-variables': { outbound_email_id: outboundEmailId },
        'delivery-status': { message: data.bounce?.message || data.reason || eventType },
      },
    });
  }

  async processDeliverabilityEvent(payload: any) {
    const eventData = payload['event-data'];
    if (!eventData) return;

    const outboundEmailId = eventData['user-variables']?.outbound_email_id;
    if (!outboundEmailId) return;

    const eventType = eventData.event;
    const now = new Date((eventData.timestamp || Math.floor(Date.now() / 1000)) * 1000);

    try {
      if (outboundEmailId.startsWith('tc_')) {
        const queueItemId = outboundEmailId.replace(/^tc_/, '');
        const queueItem = await prisma.newsletterQueueItem.findUnique({ where: { id: queueItemId } });
        if (!queueItem) return;

        let resolvedDomainId = eventData['user-variables']?.domain_id;
        if (!resolvedDomainId && eventData.domain) {
          const domain = await prisma.domain.findFirst({ where: { domainName: eventData.domain }, select: { id: true } });
          resolvedDomainId = domain?.id;
        }

        if (eventType === 'bounced' || eventType === 'failed') {
          await prisma.newsletterQueueItem.update({
            where: { id: queueItemId },
            data: { status: 'FAILED', error: eventData['delivery-status']?.message || 'Bounced' },
          });
          await prisma.newsletterRecipient.update({
            where: { id: queueItem.recipientId },
            data: { status: 'BOUNCED' },
          });
          if (resolvedDomainId) await this.updateDomainHealth(resolvedDomainId, 'bounce');
        } else if (eventType === 'complained') {
          await prisma.newsletterRecipient.update({
            where: { id: queueItem.recipientId },
            data: { status: 'UNSUBSCRIBED' },
          });
          if (resolvedDomainId) await this.updateDomainHealth(resolvedDomainId, 'complaint');
        }
        return;
      }

      const email = await prisma.outboundEmail.findUnique({
        where: { id: outboundEmailId },
        include: { domain: true },
      });
      if (!email) return;

      if (eventType === 'opened' && !email.openedAt) {
        await prisma.outboundEmail.update({ where: { id: outboundEmailId }, data: { openedAt: now } });
      } else if (eventType === 'clicked' && !email.clickedAt) {
        await prisma.outboundEmail.update({ where: { id: outboundEmailId }, data: { clickedAt: now } });
      } else if (eventType === 'bounced' || eventType === 'failed') {
        await prisma.outboundEmail.update({ where: { id: outboundEmailId }, data: { bouncedAt: now, status: 'BOUNCED' } });
        await prisma.lead.update({ where: { id: email.leadId }, data: { outreachStatus: 'BOUNCED', status: 'BOUNCED' } });
        if (email.domainId) await this.updateDomainHealth(email.domainId, 'bounce');
      } else if (eventType === 'complained') {
        await prisma.outboundEmail.update({ where: { id: outboundEmailId }, data: { spamComplaint: true } });
        await prisma.lead.update({ where: { id: email.leadId }, data: { status: 'UNSUBSCRIBED', outreachStatus: 'UNSUBSCRIBED' } });
        if (email.domainId) await this.updateDomainHealth(email.domainId, 'complaint');
      }
    } catch (error) {
      logger.error({ error }, 'Deliverability webhook processing error');
    }
  }

  private async updateDomainHealth(domainId: string, type: 'bounce' | 'complaint') {
    const domain = await prisma.domain.findUnique({ where: { id: domainId } });
    if (!domain) return;

    const totalSent = await prisma.outboundEmail.count({
      where: { domainId, status: { in: ['SENT', 'BOUNCED'] } },
    }) || 1;

    const newBounceRate = type === 'bounce' ? (domain.bounceRate * totalSent + 1) / (totalSent + 1) : domain.bounceRate;
    const newComplaintRate = type === 'complaint' ? (domain.complaintRate * totalSent + 1) / (totalSent + 1) : domain.complaintRate;

    let status = domain.status;
    if (newBounceRate >= 0.05 || newComplaintRate >= 0.003) {
      status = 'paused_health_risk';
      logger.warn({ domainId, newBounceRate, newComplaintRate }, 'AUTO-PAUSE KILLSWITCH ACTIVATED FOR DOMAIN');

      notificationService.create({
        userId: domain.userId,
        title: `Deliverability Circuit Breaker Tripped: ${domain.domainName}`,
        message: `Sending halted. Bounce rate ${(newBounceRate * 100).toFixed(1)}% or complaint rate ${(newComplaintRate * 100).toFixed(2)}%.`,
        type: 'URGENT',
        link: '/domains',
        metadata: { domainId, newBounceRate, newComplaintRate },
      }).catch(() => {});

      webhookDispatchService.dispatch({
        userId: domain.userId,
        event: 'deliverability.circuit_tripped',
        payload: {
          domainId: domain.id,
          domainName: domain.domainName,
          bounceRate: newBounceRate,
          complaintRate: newComplaintRate,
          status,
          trippedAt: new Date().toISOString(),
        },
      }).catch(() => {});
    }

    await prisma.domain.update({
      where: { id: domainId },
      data: { bounceRate: newBounceRate, complaintRate: newComplaintRate, status },
    });
  }

  async processInboundEmail(payload: any) {
    try {
      const messageId = payload['Message-Id'] || payload['message-id'];
      const rawInReplyTo = payload['In-Reply-To'] || payload['in-reply-to'] || payload['References'] || payload['references'];
      const from = payload.sender || payload.from;
      const to = payload.recipient || payload.to;
      const subject = payload.subject || 'Re: Outreach';
      const body = payload['stripped-text'] || payload['body-plain'] || payload['stripped-html'] || '';

      const cleanInReplyTo = rawInReplyTo ? String(rawInReplyTo).replace(/^<|>$/g, '').trim() : null;

      if (to) {
        const recipientAddress = (String(to).match(/<(.+)>/)?.[1] || String(to)).trim().toLowerCase();
        if (recipientAddress.startsWith('connectivity@')) {
          const recipientDomainName = recipientAddress.split('@')[1];
          const domain = await prisma.domain.findFirst({
            where: { domainName: recipientDomainName, receivingTestCode: { not: null } },
          });
          if (domain && domain.receivingTestCode && body.includes(domain.receivingTestCode)) {
            await prisma.domain.update({
              where: { id: domain.id },
              data: { receivingConfirmedAt: new Date() },
            });
            notificationService.create({
              userId: domain.userId,
              title: `Domain Receiving Confirmed: ${domain.domainName}`,
              message: `Inbound route verified successfully. Prospects can now reply directly to your mailboxes.`,
              type: 'SUCCESS',
              link: '/domains',
            }).catch(() => {});
          }
          return;
        }
      }

      let originalEmail: any = null;
      if (cleanInReplyTo) {
        originalEmail = await prisma.outboundEmail.findFirst({
          where: {
            isIncoming: false,
            OR: [{ messageId: cleanInReplyTo }, { messageId: `<${cleanInReplyTo}>` }],
          },
          select: { id: true, leadId: true, campaignId: true, userId: true, domainId: true, senderId: true, draftId: true },
        });
      }

      if (!originalEmail && from && to) {
        const senderEmailMatch = String(from).match(/<(.+)>/)?.[1]?.trim().toLowerCase() || String(from).trim().toLowerCase();
        const recipientAddress = String(to).match(/<(.+)>/)?.[1]?.trim().toLowerCase() || String(to).trim().toLowerCase();
        const recipientDomainName = recipientAddress.split('@')[1];

        const owningDomain = recipientDomainName
          ? await prisma.domain.findFirst({
              where: { domainName: recipientDomainName },
              select: { userId: true },
            })
          : null;

        if (owningDomain) {
          const matchedLead = await prisma.lead.findFirst({
            where: { email: senderEmailMatch, userId: owningDomain.userId },
            include: {
              sentEmails: {
                where: { isIncoming: false },
                orderBy: { sentAt: 'desc' },
                take: 1,
              },
            },
          });
          if (matchedLead && matchedLead.sentEmails.length > 0) {
            const latestSent = matchedLead.sentEmails[0];
            originalEmail = {
              id: latestSent.id,
              leadId: matchedLead.id,
              campaignId: latestSent.campaignId,
              userId: latestSent.userId,
              domainId: latestSent.domainId,
              senderId: latestSent.senderId,
              draftId: latestSent.draftId,
            };
          }
        }
      }

      if (!originalEmail) {
        logger.debug({ rawInReplyTo, from }, 'Could not map inbound email to outbound campaign');
        return;
      }

      const inboundEmail = await prisma.outboundEmail.create({
        data: {
          userId: originalEmail.userId,
          domainId: originalEmail.domainId,
          senderId: originalEmail.senderId || null,
          leadId: originalEmail.leadId,
          campaignId: originalEmail.campaignId,
          subject,
          body,
          isIncoming: true,
          messageId: messageId ? String(messageId).replace(/^<|>$/g, '').trim() : null,
          inReplyTo: cleanInReplyTo,
          fromAddress: from,
          toAddress: to,
          replyToId: originalEmail.id,
          sentAt: new Date(payload.timestamp ? parseInt(payload.timestamp, 10) * 1000 : Date.now()),
          status: 'DELIVERED',
        },
      });

      await prisma.outboundEmail.update({
        where: { id: originalEmail.id },
        data: { repliedAt: new Date() },
      });

      if (originalEmail.draftId) {
        await prisma.draft.update({
          where: { id: originalEmail.draftId },
          data: { replyCount: { increment: 1 } },
        }).catch(() => {});
      }

      const lead = await prisma.lead.update({
        where: { id: originalEmail.leadId },
        data: { outreachStatus: 'REPLIED', status: 'REPLIED' },
      });

      await prisma.leadActivityEvent.create({
        data: {
          leadId: lead.id,
          campaignId: originalEmail.campaignId || null,
          eventType: 'EMAIL_REPLIED',
          metadata: {
            inboundEmailId: inboundEmail.id,
            subject,
            fromAddress: from,
          },
        },
      }).catch(() => {});

      notificationService.create({
        userId: originalEmail.userId,
        title: `New Reply from ${lead.name}`,
        message: `${subject}: "${body.slice(0, 90).replace(/\s+/g, ' ')}..."`,
        type: 'INBOUND_REPLY',
        link: `/inbox`,
        metadata: { leadId: lead.id, emailId: inboundEmail.id },
      }).catch(() => {});

      webhookDispatchService.dispatch({
        userId: originalEmail.userId,
        event: 'lead.replied',
        payload: {
          leadId: lead.id,
          leadEmail: lead.email,
          leadName: lead.name,
          campaignId: originalEmail.campaignId || null,
          emailId: inboundEmail.id,
          subject,
          snippet: body.slice(0, 240),
          repliedAt: inboundEmail.sentAt.toISOString(),
        },
      }).catch(() => {});

      if (originalEmail.campaignId) {
        sequenceAgentService.processInboundTransition(
          originalEmail.leadId,
          originalEmail.campaignId,
          inboundEmail.id,
          body
        ).catch(err => {
          logger.error({ err: err?.message }, '[STATE-GRAPH] Transition execution failure');
        });
      }
    } catch (error) {
      logger.error({ error }, 'Failed to process inbound email');
    }
  }
}

export const webhooksService = new WebhooksService();
