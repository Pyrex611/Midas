<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Midas Core Models ---
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String    @unique
  password      String?   
  clerkId       String?   @unique @map("clerk_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  leads          Lead[]
  campaigns      Campaign[]
  drafts         Draft[]
  settings       UserSettings?
  domains        Domain[]
  outboundEmails OutboundEmail[]
  pendingEmails  PendingEmail[]
  uploadJobs     UploadJob[]
  blocklist      Blocklist[]

  @@map("users")
}

// --- Domain & Deliverability Engine ---
model Domain {
  id             String   @id @default(cuid())
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  domainName     String   @unique @map("domain_name")
  status         String   @default("unverified") 
  
  dkimStatus     Boolean  @default(false)
  spfStatus      Boolean  @default(false)
  mxStatus       Boolean  @default(false)
  trackingStatus Boolean  @default(false)
  dnsRecords     String?  @db.Text 
  
  warmupDay      Int      @default(1)
  dailyLimit     Int      @default(20) 
  sentCountToday Int      @default(0)
  bounceRate     Float    @default(0.0)
  complaintRate  Float    @default(0.0)
  lastSentReset  DateTime @default(now()) @map("last_sent_reset")
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  campaigns              CampaignDomain[]
  outboundEmails         OutboundEmail[]  @relation("OutboundEmailDomain")
  pendingEmails          PendingEmail[]   @relation("PendingEmailDomain")
  preferredPendingEmails PendingEmail[]   @relation("PendingEmailPreferred")

  @@index([userId])
}

model CampaignDomain {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  domainId   String   @map("domain_id")
  domain     Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now()) @map("added_at")
  @@unique([campaignId, domainId])
}

enum CampaignRole {
  OWNER
  EDITOR
  VIEWER
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String       @map("campaign_id")
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String       @map("user_id") @db.Uuid
  role       CampaignRole @default(EDITOR)
  joinedAt   DateTime     @default(now()) @map("joined_at")

  @@unique([campaignId, userId])
  @@index([userId])
}

model CampaignInvite {
  id         String       @id @default(cuid())
  campaignId String       @map("campaign_id")
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId   String       @map("sender_id") @db.Uuid
  email      String
  role       CampaignRole @default(EDITOR)
  token      String       @unique
  accepted   Boolean      @default(false)
  expiresAt  DateTime     @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([email])
}

model Campaign {
  id               String   @id @default(cuid())
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  context          String?
  reference        String?
  senderName       String?  @map("sender_name")
  status           String   @default("DRAFT")
  createdAt        DateTime @default(now()) @map("created_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  lastDomainIndex  Int      @default(0) @map("last_domain_index")
  autoReplyEnabled Boolean  @default(false) @map("auto_reply_enabled")
