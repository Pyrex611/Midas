TO authenticated
WITH CHECK (user_id = auth.uid());

CREATE POLICY "Users can update their own leads"
ON "Lead"
FOR UPDATE
TO authenticated
USING (user_id = auth.uid())
WITH CHECK (user_id = auth.uid());

CREATE POLICY "Users can delete their own leads"
ON "Lead"
FOR DELETE
TO authenticated
USING (user_id = auth.uid());

-- =====================================================
-- CAMPAIGN TABLE POLICIES
