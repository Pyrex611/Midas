    background-color: #F3EBF6;
    color: #1F1124;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  hr {
    border-color: rgba(212, 175, 55, 0.42);
  }

  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  [role="button"]:focus-visible {
    outline: 2px solid #D4AF37;
    outline-offset: 2px;
  }
}

@layer components {
  .card-midas {
    background-color: #FFFFFF;
    border: 1px solid rgba(212, 175, 55, 0.32);
    box-shadow: 0 1px 3px rgba(31, 17, 36, 0.05);
    transition: border-color 180ms ease, box-shadow 220ms ease, transform 180ms ease;
  }

  .card-midas:hover {
    border-color: rgba(212, 175, 55, 0.72);
    box-shadow: 0 0 0 1px rgba(212, 175, 55, 0.35), 0 8px 24px -4px rgba(212, 175, 55, 0.28);
  }

  .btn-royal {
    background: linear-gradient(135deg, #4A2559 0%, #6D3B82 100%);
    color: #FFFFFF;
    border: 1px solid rgba(212, 175, 55, 0.42);
    box-shadow: 0 2px 6px rgba(74, 37, 89, 0.2);
    transition: all 180ms ease;
  }

  .btn-royal:hover:not(:disabled) {
    background: linear-gradient(135deg, #33183E 0%, #5B2E6E 100%);
    border-color: rgba(212, 175, 55, 0.85);
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.22), 0 6px 18px -2px rgba(212, 175, 55, 0.35);
  }

  .btn-royal:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .glow-gold-hover {
    transition: border-color 180ms ease, box-shadow 220ms ease;
  }

  .glow-gold-hover:hover {
    border-color: rgba(212, 175, 55, 0.65);
    box-shadow: 0 0 0 1px rgba(212, 175, 55, 0.3), 0 6px 20px -4px rgba(212, 175, 55, 0.28);
  }

  .divider-gold {
    border-color: rgba(212, 175, 55, 0.42);
  }
}

@media print {
  body {
    background-color: #ffffff !important;
    color: #000000 !important;
  }

  aside, header, nav, .no-print {
    display: none !important;
  }

  main {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  section {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
    margin-bottom: 24px !important;
  }

  pre, code {
    white-space: pre-wrap !important;
    word-break: break-word !important;
    border: 1px solid #d4d4d8 !important;
    background-color: #f4f4f5 !important;
    color: #18181b !important;
  }
}
