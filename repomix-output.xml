<file path="scripts/baseline-migrations.js">
// scripts/baseline-migrations.js
//
// Resolves all migration folders as "already applied" in _prisma_migrations.
// Resolves Prisma error P3005 when tables already exist from `prisma db push`.

const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const MIGRATIONS_DIR = path.join(__dirname, '..', 'prisma', 'migrations');
const CONNECTIVITY_ERROR_CODES = ['P1001', 'P1002', 'P1017'];

const folders = fs
  .readdirSync(MIGRATIONS_DIR, { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .map((entry) => entry.name)
  .sort();

console.log(`Found ${folders.length} migration folder(s). Baselining all migrations into _prisma_migrations:\n`);

let skipped = 0;
let applied = 0;

for (const name of folders) {
  console.log(`--> npx prisma migrate resolve --applied ${name}`);
  try {
    const output = execSync(`npx prisma migrate resolve --applied ${name}`, {
      stdio: 'pipe',
      encoding: 'utf8',
    });
    process.stdout.write(output);
    applied++;
  } catch (err) {
    const combined = `${err.stdout || ''}\n${err.stderr || ''}`;

    const isConnectivityError = CONNECTIVITY_ERROR_CODES.some((code) => combined.includes(code));
    if (isConnectivityError) {
      console.error(`\nConnectivity error encountered on "${name}". Check DATABASE_URL and network connection.`);
      process.exit(1);
    }

    // Already marked applied or baseline acknowledged
    console.log(`(Migration "${name}" is already marked applied or resolved, continuing)\n`);
    skipped++;
  }
}

console.log(`\nDone. Applied/Verified: ${applied}, Already Handled: ${skipped}.`);
console.log('Now run: npx prisma migrate status');
</file>

<file path="server/config/logger.ts">
import winston from 'winston';

function serializeErrors(info: any): any {
  if (info instanceof Error) {
    return {
      message: info.message,
      stack: info.stack,
      name: info.name,
      ...(info as any),
    };
  }
  if (typeof info === 'object' && info !== null) {
    const serialized: any = Array.isArray(info) ? [] : {};
    for (const key of Object.keys(info)) {
      const val = info[key];
      if (val instanceof Error) {
        serialized[key] = {
          message: val.message,
          stack: val.stack,
          name: val.name,
          ...(val as any),
        };
      } else if (typeof val === 'object' && val !== null) {
        serialized[key] = serializeErrors(val);
      } else {
        serialized[key] = val;
      }
    }
    return serialized;
  }
  return info;
}

const baseLogger = winston.createLogger({
  level: process.env.NODE_ENV === 'production' ? 'info' : 'debug',
  format: winston.format.combine(
    winston.format.timestamp(),
    winston.format.printf(({ timestamp, level, message, ...meta }) => {
      const metaClean = Object.keys(meta).length ? JSON.stringify(serializeErrors(meta)) : '';
      const msgClean = typeof message === 'object' ? JSON.stringify(serializeErrors(message)) : message;
      return JSON.stringify({
        timestamp,
        level,
        message: msgClean,
        ...(metaClean ? { meta: JSON.parse(metaClean) } : {}),
      });
    })
  ),
  transports: [new winston.transports.Console()],
});

export const logger = {
  info: (msg: string | object, meta?: any) => {
    baseLogger.info(serializeErrors(msg), serializeErrors(meta));
  },
  error: (msg: string | object, meta?: any) => {
    baseLogger.error(serializeErrors(msg), serializeErrors(meta));
  },
  warn: (msg: string | object, meta?: any) => {
    baseLogger.warn(serializeErrors(msg), serializeErrors(meta));
  },
  debug: (msg: string | object, meta?: any) => {
    baseLogger.debug(serializeErrors(msg), serializeErrors(meta));
  },
};
</file>

