@import "tailwindcss";

@theme {
  /* Royal Thistle & Pastel Purple Palette (WCAG AA Accessible) */
  --color-thistle-canvas: #F3EBF6;
  --color-thistle-50: #FCFAFD;
  --color-thistle-100: #F7F1F7;
  --color-thistle-200: #EDE2ED;
  --color-thistle-300: #D8BFD8;
  --color-thistle-400: #C39BC3;
  --color-thistle-500: #7A4E7A;
  --color-royal-600: #6D3B82;
  --color-royal-700: #4A2559;
  --color-royal-800: #33183E;
  --color-royal-950: #1F1124;

  /* Metallic Gold Accent & Separator Tokens */
  --color-gold-200: #FAF0CA;
  --color-gold-300: #F3D98B;
  --color-gold-400: #E5C158;
  --color-gold-500: #D4AF37;
  --color-gold-600: #B59024;
  --color-gold-line: rgba(212, 175, 55, 0.42);
}

@layer base {
