import crypto from 'crypto';
import prisma from '../lib/prisma';
import { logger } from '../config/logger';
import { sequenceAgentService } from './sequenceAgent.service';

export class WebhooksService {

  verifyMailgunSignature(timestamp: string, token: string, signature: string): boolean {
    const webhookKey = process.env.MAILGUN_WEBHOOK_KEY;
    if (!webhookKey) return false;

    const encodedToken = crypto
      .createHmac('sha256', webhookKey)
      .update(timestamp.concat(token))
      .digest('hex');

    return encodedToken === signature;
  }

  async processDeliverabilityEvent(payload: any) {
    const eventData = payload['event-data'];
    if (!eventData) return;

    const outboundEmailId = eventData['user-variables']?.outbound_email_id;
    if (!outboundEmailId) return;

    const eventType = eventData.event;

    try {
      const email = await prisma.outboundEmail.findUnique({
        where: { id: outboundEmailId },
        include: { domain: true }
      });
      if (!email) return;

      const now = new Date(eventData.timestamp * 1000);

      if (eventType === 'opened' && !email.openedAt) {
        await prisma.outboundEmail.update({ where: { id: outboundEmailId }, data: { openedAt: now } });
      }
      else if (eventType === 'clicked' && !email.clickedAt) {
        await prisma.outboundEmail.update({ where: { id: outboundEmailId }, data: { clickedAt: now } });
      }
      else if (eventType === 'bounced' || eventType === 'failed') {
        await prisma.outboundEmail.update({ where: { id: outboundEmailId }, data: { bouncedAt: now, status: 'BOUNCED' } });
        await prisma.lead.update({ where: { id: email.leadId }, data: { outreachStatus: 'BOUNCED', status: 'BOUNCED' } });
        if (email.domainId) await this.updateDomainHealth(email.domainId, 'bounce');
      }
      else if (eventType === 'complained') {
        await prisma.outboundEmail.update({ where: { id: outboundEmailId }, data: { spamComplaint: true } });
        await prisma.lead.update({ where: { id: email.leadId }, data: { status: 'UNSUBSCRIBED', outreachStatus: 'UNSUBSCRIBED' } });
        if (email.domainId) await this.updateDomainHealth(email.domainId, 'complaint');
      }
    } catch (error) {
      logger.error({ error }, 'Deliverability webhook processing error');
    }
  }

  private async updateDomainHealth(domainId: string, type: 'bounce' | 'complaint') {
    const domain = await prisma.domain.findUnique({ where: { id: domainId }});
    if (!domain) return;

    const totalSent = await prisma.outboundEmail.count({
      where: { domainId, status: { in: ['SENT', 'BOUNCED'] } },
    }) || 1;

    const newBounceRate = type === 'bounce' ? (domain.bounceRate * totalSent + 1) / (totalSent + 1) : domain.bounceRate;
    const newComplaintRate = type === 'complaint' ? (domain.complaintRate * totalSent + 1) / (totalSent + 1) : domain.complaintRate;

    let status = domain.status;
    if (newBounceRate >= 0.05 || newComplaintRate >= 0.003) {
      status = 'paused_health_risk';
      logger.warn({ domainId, newBounceRate, newComplaintRate }, 'AUTO-PAUSE KILLSWITCH ACTIVATED FOR DOMAIN');
    }

    await prisma.domain.update({
      where: { id: domainId },
      data: {
        bounceRate: newBounceRate,
        complaintRate: newComplaintRate,
        status,
      }
    });
  }

  async processInboundEmail(payload: any) {
    try {
      const messageId = payload['Message-Id'] || payload['message-id'];
      const rawInReplyTo = payload['In-Reply-To'] || payload['in-reply-to'] || payload['References'] || payload['references'];
      const from = payload.sender || payload.from;
      const to = payload.recipient || payload.to;
      const subject = payload.subject || 'Re: Outreach';
      const body = payload['stripped-text'] || payload['body-plain'] || payload['stripped-html'] || '';

      const cleanInReplyTo = rawInReplyTo ? rawInReplyTo.replace(/^<|>$/g, '').trim() : null;

      // Intercept domain connectivity receiving tests
      if (to) {
        const recipientAddress = (to.match(/<(.+)>/)?.[1] || to).trim().toLowerCase();
        if (recipientAddress.startsWith('connectivity@')) {
          const recipientDomainName = recipientAddress.split('@')[1];
          const domain = await prisma.domain.findFirst({
            where: { domainName: recipientDomainName, receivingTestCode: { not: null } },
          });
          if (domain && domain.receivingTestCode && body.includes(domain.receivingTestCode)) {
            await prisma.domain.update({
              where: { id: domain.id },
              data: { receivingConfirmedAt: new Date() },
            });
            logger.info({ domainId: domain.id, domainName: recipientDomainName }, 'Domain receiving test confirmed');
          }
          return;
        }
      }

      let originalEmail: any = null;
      if (cleanInReplyTo) {
        originalEmail = await prisma.outboundEmail.findFirst({
          where: {
            isIncoming: false,
            OR: [
              { messageId: cleanInReplyTo },
              { messageId: `<${cleanInReplyTo}>` }
            ]
          },
          select: { id: true, leadId: true, campaignId: true, userId: true, domainId: true, draftId: true }
        });
      }

      if (!originalEmail && from && to) {
        const senderEmailMatch = from.match(/<(.+)>/)?.[1]?.trim().toLowerCase() || from.trim().toLowerCase();
        const recipientAddress = to.match(/<(.+)>/)?.[1]?.trim().toLowerCase() || to.trim().toLowerCase();
        const recipientDomainName = recipientAddress.split('@')[1];

        const owningDomain = recipientDomainName
          ? await prisma.domain.findFirst({
              where: { domainName: recipientDomainName },
              select: { userId: true },
            })
          : null;

        if (owningDomain) {
          const matchedLead = await prisma.lead.findFirst({
            where: { email: senderEmailMatch, userId: owningDomain.userId },
            include: {
              sentEmails: {
                where: { isIncoming: false },
                orderBy: { sentAt: 'desc' },
                take: 1
              }
            }
          });
          if (matchedLead && matchedLead.sentEmails.length > 0) {
            const latestSent = matchedLead.sentEmails[0];
            originalEmail = {
              id: latestSent.id,
              leadId: matchedLead.id,
              campaignId: latestSent.campaignId,
              userId: latestSent.userId,
              domainId: latestSent.domainId,
              draftId: latestSent.draftId,
            };
          }
        }
      }

      if (!originalEmail) {
        logger.debug({ rawInReplyTo, from }, 'Could not map inbound email to outbound campaign');
        return;
      }

      const inboundEmail = await prisma.outboundEmail.create({
        data: {
          userId: originalEmail.userId,
          domainId: originalEmail.domainId,
          leadId: originalEmail.leadId,
          campaignId: originalEmail.campaignId,
          subject,
          body,
          isIncoming: true,
          messageId: messageId ? messageId.replace(/^<|>$/g, '').trim() : null,
          inReplyTo: cleanInReplyTo,
          fromAddress: from,
          toAddress: to,
          replyToId: originalEmail.id,
          sentAt: new Date(payload.timestamp ? parseInt(payload.timestamp) * 1000 : Date.now()),
          status: 'DELIVERED',
        }
      });

      await prisma.outboundEmail.update({
        where: { id: originalEmail.id },
        data: { repliedAt: new Date() }
      });

      // Atomically increment Draft.replyCount to track copy conversion
      if (originalEmail.draftId) {
        await prisma.draft.update({
          where: { id: originalEmail.draftId },
          data: { replyCount: { increment: 1 } },
        }).catch(() => {});
      }

      await prisma.lead.update({
        where: { id: originalEmail.leadId },
        data: {
          outreachStatus: 'REPLIED',
          status: 'REPLIED'
        }
      });

      // Route through State-Graph Engine
      if (originalEmail.campaignId) {
        sequenceAgentService.processInboundTransition(
          originalEmail.leadId,
          originalEmail.campaignId,
          inboundEmail.id,
          body
        ).catch(err => {
          logger.error({ err: err?.message }, '[STATE-GRAPH] Transition execution failure');
        });
      }

    } catch (error) {
      logger.error({ error }, 'Failed to process inbound Mailgun email');
    }
  }
}

export const webhooksService = new WebhooksService();
</file>

<file path="src/pages/AdminDashboard.tsx">
import React, { useEffect, useState, useRef, useCallback } from 'react';
import { adminAPI, userAPI, getErrorMessage } from '../services/api';
import { useToast } from '../context/ToastContext';

export const AdminDashboard: React.FC = () => {
  const { toast } = useToast();

  // Operator Clearance State
  const [isUnlocked, setIsUnlocked] = useState(false);
  const [passphraseInput, setPassphraseInput] = useState('');
  const [verifyingPassphrase, setVerifyingPassphrase] = useState(false);
  const [sessionRemainingMinutes, setSessionRemainingMinutes] = useState(60);

  // Live Services Observability State
  const [servicesHealth, setServicesHealth] = useState<any>(null);
  const [probingServices, setProbingServices] = useState(false);

  // Action Protection Modal State
  const [actionTargetDomain, setActionTargetDomain] = useState<{ id: string; name: string; type: 'pause' | 'unpause' } | null>(null);
  const [actionConfirmPassphrase, setActionConfirmPassphrase] = useState('');
  const [submittingAction, setSubmittingAction] = useState(false);

  // Admin Data State
  const [stats, setStats] = useState<any>(null);
  const [users, setUsers] = useState<any[]>([]);
  const [domains, setDomains] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const lastActivityRef = useRef<number>(Date.now());
  const inactivityTimerRef = useRef<NodeJS.Timeout | null>(null);

  const lockSession = useCallback(() => {
    sessionStorage.removeItem('midas_operator_token');
    sessionStorage.removeItem('midas_operator_expires_at');
    setIsUnlocked(false);
    window.dispatchEvent(new Event('operator_auth_changed'));
    toast.warning('Operator session locked due to 60 minutes of inactivity', 'Session Expired');
  }, [toast]);

  const recordActivity = useCallback(() => {
    lastActivityRef.current = Date.now();
  }, []);

  const fetchServicesHealth = async () => {
    setProbingServices(true);
    try {
      const res = await adminAPI.getServicesHealth();
      setServicesHealth(res.data);
    } catch {
      // Handled in UI
    } finally {
      setProbingServices(false);
    }
  };

  const fetchAll = async () => {
    setLoading(true);
    setError(null);
    try {
      const [statsRes, usersRes, domainsRes] = await Promise.all([
        adminAPI.getStats(),
        adminAPI.listUsers(),
        adminAPI.listDomains(),
      ]);
      setStats(statsRes.data);
      setUsers(usersRes.data || []);
      setDomains(domainsRes.data || []);
      await fetchServicesHealth();
    } catch (err: any) {
      const msg = getErrorMessage(err, 'Failed to load operator metrics');
      setError(msg);
      if (err.response?.status === 403) {
        lockSession();
      }
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    userAPI.getProfile()
      .then(res => {
        if (res.data?.user?.isAdmin) {
          setIsUnlocked(true);
          fetchAll();
          return;
        }

        const token = sessionStorage.getItem('midas_operator_token');
        const expiresAt = Number(sessionStorage.getItem('midas_operator_expires_at') || 0);

        if (token && expiresAt > Date.now()) {
          setIsUnlocked(true);
          fetchAll();
        }
      })
      .catch(() => {});

    window.addEventListener('mousemove', recordActivity);
    window.addEventListener('keydown', recordActivity);
    window.addEventListener('scroll', recordActivity);
    window.addEventListener('click', recordActivity);

    inactivityTimerRef.current = setInterval(() => {
      const elapsed = Date.now() - lastActivityRef.current;
      const remaining = Math.max(0, 60 - Math.floor(elapsed / (60 * 1000)));
      setSessionRemainingMinutes(remaining);

      if (elapsed > 60 * 60 * 1000) {
        lockSession();
      }
    }, 30000);

    return () => {
      window.removeEventListener('mousemove', recordActivity);
      window.removeEventListener('keydown', recordActivity);
      window.removeEventListener('scroll', recordActivity);
      window.removeEventListener('click', recordActivity);
      if (inactivityTimerRef.current) clearInterval(inactivityTimerRef.current);
    };
  }, [lockSession, recordActivity]);

  const handleUnlock = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!passphraseInput.trim()) return;

    setVerifyingPassphrase(true);
    try {
      const res = await adminAPI.unlock(passphraseInput.trim());
      sessionStorage.setItem('midas_operator_token', res.data.token);
      sessionStorage.setItem('midas_operator_expires_at', String(res.data.expiresAt));
      lastActivityRef.current = Date.now();
      setIsUnlocked(true);
      setPassphraseInput('');
      window.dispatchEvent(new Event('operator_auth_changed'));
      toast.success('Operator clearance authorized for 60 minutes', 'Session Active');
      await fetchAll();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Passphrase rejected. Default is midas_operator_2026'), 'Access Denied');
    } finally {
      setVerifyingPassphrase(false);
    }
  };

  const handleClearLock = async (lockName: string) => {
    try {
      await adminAPI.clearLock(lockName);
      toast.success(`Cleared lock for "${lockName}"`, 'Lock Released');
      await fetchServicesHealth();
    } catch {
      toast.error('Could not clear cron lock', 'Error');
    }
  };

  const handleExecuteProtectedAction = async () => {
    if (!actionTargetDomain || !actionConfirmPassphrase.trim()) return;

    setSubmittingAction(true);
    try {
      if (actionTargetDomain.type === 'pause') {
        await adminAPI.pauseDomain(actionTargetDomain.id, actionConfirmPassphrase.trim());
        toast.warning(`Circuit breaker armed: ${actionTargetDomain.name} paused`, 'Action Executed');
      } else {
        await adminAPI.unpauseDomain(actionTargetDomain.id, actionConfirmPassphrase.trim());
        toast.success(`Domain ${actionTargetDomain.name} reactivated`, 'Circuit Cleared');
      }
      setActionTargetDomain(null);
      setActionConfirmPassphrase('');
      await fetchAll();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Action protection passphrase rejected'), 'Unauthorized');
    } finally {
      setSubmittingAction(false);
    }
  };

  // 1. LOCKED CLEARANCE GATEWAY
  if (!isUnlocked) {
    return (
      <div className="min-h-[calc(100vh-64px)] flex items-center justify-center p-4 bg-zinc-50">
        <div className="w-full max-w-md bg-white border border-zinc-200 rounded-3xl p-8 shadow-xl space-y-6 animate-in zoom-in-95 duration-150">
          <div className="w-12 h-12 rounded-2xl bg-zinc-900 text-white flex items-center justify-center mx-auto shadow-md">
            <svg className="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.75}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>

          <div className="text-center space-y-1">
            <h2 className="text-xl font-black text-zinc-900 tracking-tight">Operator Clearance Required</h2>
            <p className="text-xs text-zinc-500">
              Enter your platform master passphrase to unlock cross-tenant deliverability controls.
            </p>
          </div>

          <form onSubmit={handleUnlock} className="space-y-4">
            <div>
              <label className="block text-[10px] font-bold text-zinc-500 uppercase tracking-wider mb-1">
                Master Passphrase
              </label>
              <input
                type="password"
                value={passphraseInput}
                onChange={(e) => setPassphraseInput(e.target.value)}
                placeholder="••••••••••••••••"
                required
                className="w-full px-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-sm font-mono focus:outline-none focus:border-blue-500"
                autoFocus
              />
              <p className="text-[10px] text-zinc-400 mt-1">Default passphrase: <code className="bg-zinc-100 px-1 py-0.5 rounded font-mono font-bold text-zinc-700">midas_operator_2026</code></p>
            </div>

            <button
              type="submit"
              disabled={verifyingPassphrase}
              className="w-full py-2.5 bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-bold rounded-xl transition-colors shadow-xs disabled:opacity-50"
            >
              {verifyingPassphrase ? 'Verifying Clearance...' : 'Authenticate Operator'}
            </button>
          </form>
        </div>
      </div>
    );
  }

  // 2. UNLOCKED OPERATOR WAR ROOM
  return (
    <div className="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
      {/* Top Banner */}
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 className="text-2xl sm:text-3xl font-black text-zinc-900 tracking-tight">Platform Deliverability Command</h1>
          <p className="text-xs text-zinc-500 mt-1">Cross-tenant operator visibility, live infrastructure telemetry, and circuit breaker controls.</p>
        </div>

        <div className="flex items-center gap-3">
          <div className="text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60 px-3 py-1.5 rounded-xl flex items-center gap-2">
            <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
            <span>Active Session ({sessionRemainingMinutes}m idle lock)</span>
          </div>
          <button
            onClick={lockSession}
            className="px-3 py-1.5 border border-zinc-200 text-zinc-600 hover:bg-zinc-100 text-xs font-bold rounded-xl transition-colors"
          >
            Lock Dashboard
          </button>
        </div>
      </div>

      {loading && <div className="py-20 text-center text-xs text-zinc-400">Loading operator metrics...</div>}
      {error && <div className="p-4 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-700">{error}</div>}

      {/* 
        INFRASTRUCTURE & SERVICES OBSERVABILITY HUB:
        Live status gauges for AI Engine, PostgreSQL, and Distributed CronLocks.
      */}
      <div className="bg-white border border-zinc-200 rounded-2xl p-6 shadow-xs space-y-4">
        <div className="flex items-center justify-between">
          <div>
            <h2 className="text-base font-black text-zinc-900 tracking-tight">Core Infrastructure Telemetry</h2>
            <p className="text-xs text-zinc-500 mt-0.5">Live operational status across database compute, AI provider endpoints, and worker locks.</p>
          </div>
          <button
            onClick={fetchServicesHealth}
            disabled={probingServices}
            className="px-3 py-1.5 bg-zinc-100 hover:bg-zinc-200 text-zinc-800 rounded-xl text-xs font-bold transition-colors disabled:opacity-50"
          >
            {probingServices ? 'Probing Services...' : '⚡ Probe All Services'}
          </button>
        </div>

        {servicesHealth && (
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 border-t border-zinc-100 text-xs">
            {/* 1. Database Health */}
            <div className="p-4 bg-zinc-50 border border-zinc-200 rounded-xl space-y-2">
              <div className="flex items-center justify-between">
                <span className="text-[10px] font-bold uppercase text-zinc-400">Database Engine</span>
                <span className={`px-2 py-0.5 rounded-full text-[9px] font-bold ${
                  servicesHealth.database?.status === 'HEALTHY' ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700'
                }`}>
                  {servicesHealth.database?.status || 'UNKNOWN'}
                </span>
              </div>
              <p className="font-bold text-zinc-900">Neon Serverless PostgreSQL</p>
              <p className="text-[11px] text-zinc-500">
                Ping Latency: <strong className="text-zinc-800 font-mono">{servicesHealth.database?.latencyMs ?? '—'} ms</strong>
              </p>
            </div>

            {/* 2. AI Engine Health */}
            <div className="p-4 bg-zinc-50 border border-zinc-200 rounded-xl space-y-2">
              <div className="flex items-center justify-between">
                <span className="text-[10px] font-bold uppercase text-zinc-400">AI Synthesis Engine</span>
                <span className={`px-2 py-0.5 rounded-full text-[9px] font-bold ${
                  servicesHealth.aiEngine?.status === 'HEALTHY' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'
                }`}>
                  {servicesHealth.aiEngine?.status || 'DEGRADED'}
                </span>
              </div>
              <p className="font-bold text-zinc-900">
                Provider: <span className="uppercase text-blue-600 font-mono">{servicesHealth.aiEngine?.configuredProvider || 'mock'}</span>
              </p>
              <p className="text-[11px] text-zinc-500">
                {servicesHealth.aiEngine?.latencyMs
                  ? `Response Latency: ${servicesHealth.aiEngine.latencyMs} ms`
                  : servicesHealth.aiEngine?.errorDetail
                  ? `Rejection: ${servicesHealth.aiEngine.errorDetail.substring(0, 45)}...`
                  : 'Operating on built-in Mock provider'}
              </p>
            </div>

            {/* 3. Distributed CronLocks */}
            <div className="p-4 bg-zinc-50 border border-zinc-200 rounded-xl space-y-2">
              <span className="text-[10px] font-bold uppercase text-zinc-400">Worker CronLocks</span>
              <div className="space-y-1">
                {(servicesHealth.cronLocks || []).map((lock: any) => {
                  const isLocked = Boolean(lock.lockedAt);
                  return (
                    <div key={lock.name} className="flex items-center justify-between text-[11px]">
                      <span className="font-mono font-bold text-zinc-800">{lock.name}</span>
                      <div className="flex items-center gap-1.5">
                        <span className={`px-1.5 py-0.2 rounded text-[9px] font-bold ${
                          isLocked ? 'bg-amber-100 text-amber-800' : 'bg-emerald-50 text-emerald-700'
                        }`}>
                          {isLocked ? 'LOCKED' : 'FREE'}
                        </span>
                        {isLocked && (
                          <button
                            onClick={() => handleClearLock(lock.name)}
                            className="text-[9px] text-rose-600 font-bold hover:underline"
                          >
                            Clear
                          </button>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Aggregate Metric Tiles */}
      {stats && (
        <div className="grid grid-cols-2 md:grid-cols-6 gap-3">
          {[
            ['Users', stats.userCount],
            ['Sequences', stats.campaignCount],
            ['Total Leads', stats.leadCount],
            ['Domains', stats.domainCount],
            ['Sent Today', stats.sentToday],
            ['In Queue', stats.pendingCount],
          ].map(([label, value]) => (
            <div key={label as string} className="p-4 bg-white border border-zinc-200 rounded-2xl shadow-xs text-center">
              <p className="text-2xl font-black text-zinc-900">{value as number}</p>
              <p className="text-[10px] font-bold uppercase tracking-wider text-zinc-400 mt-1">{label}</p>
            </div>
          ))}
        </div>
      )}

      {/* Cross-Tenant Domains Table with Action Protection */}
      <div className="bg-white border border-zinc-200 rounded-2xl p-6 shadow-xs space-y-4">
        <div>
          <h2 className="text-base font-black text-zinc-900 tracking-tight">Cross-Tenant Sending Domains</h2>
          <p className="text-xs text-zinc-500 mt-0.5">Automated circuit breakers trigger auto-pause at &gt;5% bounce rate or &gt;0.3% complaint rate.</p>
        </div>

        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-zinc-100 text-left text-xs">
            <thead className="bg-zinc-50/75 text-zinc-500 font-bold uppercase tracking-wider">
              <tr>
                <th className="py-3 px-4">Domain</th>
                <th className="py-3 px-4">Owner</th>
                <th className="py-3 px-4">Status</th>
                <th className="py-3 px-4">Bounce</th>
                <th className="py-3 px-4">Complaint</th>
                <th className="py-3 px-4">Mailboxes</th>
                <th className="py-3 px-4 text-right">Protected Action</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-zinc-100 font-medium text-zinc-700">
              {domains.map((d) => (
                <tr key={d.id} className="hover:bg-zinc-50/80">
                  <td className="py-3 px-4 font-mono font-bold text-zinc-900">{d.domainName}</td>
                  <td className="py-3 px-4 text-zinc-500">{d.user?.email}</td>
                  <td className="py-3 px-4">
                    <span className={`px-2 py-0.5 rounded-full font-bold text-[10px] ${
