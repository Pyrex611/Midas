<file path="server/services/lead.service.ts">
import prisma from '../lib/prisma';
import { logger } from '../config/logger';

export class LeadService {
  async createLeads(userId: string, leads: { name: string; email: string; company?: string | null; position?: string | null }[], skipDuplicates = true) {
    const result: {
      created: number;
      duplicates: number;
      failed: number;
      errors: { email: string; error: string }[];
      createdLeads: any[];
    } = { created: 0, duplicates: 0, failed: 0, errors: [], createdLeads: [] };

    for (const lead of leads) {
      try {
        const existing = await prisma.lead.findFirst({
          where: { userId, email: lead.email },
        });
        if (existing) {
          if (skipDuplicates) {
            result.duplicates++;
            continue;
          } else {
            const updated = await prisma.lead.update({
              where: { id: existing.id },
              data: { name: lead.name, company: lead.company ?? existing.company, position: lead.position ?? existing.position },
            });
            result.created++;
            result.createdLeads.push(updated);
            continue;
          }
        }
        const created = await prisma.lead.create({ data: { ...lead, userId } });
        result.created++;
        result.createdLeads.push(created);
      } catch (error: any) {
        result.failed++;
        result.errors.push({ email: lead.email, error: error.message || 'Unknown error' });
        logger.error({ error: error.message, lead }, 'Lead creation failed');
      }
    }
    return result;
  }

  async getLeads(userId: string, page: number, pageSize: number, status?: string, campaignId?: string) {
    const where: any = { userId };
    if (status && status !== 'all') where.status = status;
    if (campaignId && campaignId !== 'all') where.campaignId = campaignId;

    const [leads, total] = await Promise.all([
      prisma.lead.findMany({
        where,
        skip: (page - 1) * pageSize,
        take: pageSize,
        orderBy: { createdAt: 'desc' },
      }),
      prisma.lead.count({ where }),
    ]);

    return { data: leads, pagination: { page, pageSize, total, totalPages: Math.ceil(total / pageSize) } };
  }

  async deleteLead(userId: string, id: string) {
    await prisma.lead.delete({ where: { id, userId } });
    return { success: true };
  }
}

export const leadService = new LeadService();
</file>

<file path="server/services/migration.service.ts">
import { Pool } from 'pg';
import { logger } from '../config/logger';

const TABLE_ORDER = [
  'users',
  'Subscription',
  'Domain',
  'DomainHealthSnapshot',
  'Sender',
  'UserSettings',
  'KnowledgeBase',
  'KnowledgeResource',
  'Campaign',
  'CampaignSender',
  'CampaignMember',
  'CampaignInvite',
  'Blocklist',
  'UploadJob',
  'Lead',
  'LeadActivityEvent',
  'Draft',
  'FollowUpStep',
  'OutboundEmail',
  'PendingEmail',
  'ApiKey',
  'Gong',
  'NewsletterRecipient',
  'NewsletterBroadcast',
  'NewsletterQueueItem',
  'Artifact',
  'Notification',
  'WebhookSubscription',
  'WebhookDelivery',
  'CronLock',
];

export interface TableMigrationResult {
  table: string;
  sourceRows: number;
  insertedRows: number;
  status: 'MIGRATED' | 'EMPTY' | 'SKIPPED';
}

export class MigrationService {
  private async getColumnTypes(pool: Pool, tableName: string): Promise<Map<string, string>> {
    const res = await pool.query<{ column_name: string; data_type: string }>(
      `SELECT column_name, data_type
       FROM information_schema.columns
       WHERE table_schema = 'public' AND table_name = $1`,
      [tableName]
    );
    const map = new Map<string, string>();
    for (const row of res.rows) {
      map.set(row.column_name, row.data_type.toLowerCase());
    }
    return map;
  }

  async migrateFromNeon(sourceDatabaseUrl: string): Promise<{
    success: boolean;
    durationMs: number;
    totalSourceRows: number;
    totalInsertedRows: number;
    tables: TableMigrationResult[];
  }> {
    const cleanSource = (sourceDatabaseUrl || '').trim();
    if (!/^postgres(ql)?:\/\//i.test(cleanSource)) {
      throw new Error('Source database URL must start with postgresql:// or postgres://');
    }

    const targetUrl =
      process.env.POSTGRES_URL_NON_POOLING ||
      process.env.DIRECT_URL ||
      process.env.DATABASE_URL_POOLED ||
      process.env.DATABASE_URL;

    if (!targetUrl) {
      throw new Error('Target Supabase DATABASE_URL is not configured on this server.');
    }

    const source = new Pool({
      connectionString: cleanSource,
      ssl: { rejectUnauthorized: false },
      connectionTimeoutMillis: 8_000,
      max: 2,
    });

    const target = new Pool({
      connectionString: targetUrl,
      ssl: { rejectUnauthorized: false },
      connectionTimeoutMillis: 8_000,
      max: 2,
    });

    const startedAt = Date.now();
    const results: TableMigrationResult[] = [];
    let totalSourceRows = 0;
    let totalInsertedRows = 0;

    try {
      await source.query('SELECT 1');
      await target.query('SELECT 1');

      for (const table of TABLE_ORDER) {
        const [targetColTypes, sourceColTypes] = await Promise.all([
          this.getColumnTypes(target, table),
          this.getColumnTypes(source, table),
        ]);

        if (targetColTypes.size === 0 || sourceColTypes.size === 0) {
          results.push({ table, sourceRows: 0, insertedRows: 0, status: 'SKIPPED' });
          continue;
        }

        const sharedColumns = Array.from(targetColTypes.keys()).filter((c) => sourceColTypes.has(c));
        if (sharedColumns.length === 0) {
          results.push({ table, sourceRows: 0, insertedRows: 0, status: 'SKIPPED' });
          continue;
        }

        const selectColsSql = sharedColumns.map((c) => `"${c}"`).join(', ');
        const orderClause =
          table === 'OutboundEmail' && sourceColTypes.has('reply_to_id')
            ? ` ORDER BY "reply_to_id" NULLS FIRST, "sent_at" ASC`
            : '';

        const { rows } = await source.query(`SELECT ${selectColsSql} FROM "${table}"${orderClause}`);

        if (rows.length === 0) {
          results.push({ table, sourceRows: 0, insertedRows: 0, status: 'EMPTY' });
          continue;
        }

        const BATCH_SIZE = 300;
        let inserted = 0;

        for (let i = 0; i < rows.length; i += BATCH_SIZE) {
          const batch = rows.slice(i, i + BATCH_SIZE);
          const values: any[] = [];
          const valueClauses: string[] = [];
          let paramIdx = 1;

          for (const row of batch) {
            const placeholders: string[] = [];
            for (const col of sharedColumns) {
              let val = row[col];
              const dtype = targetColTypes.get(col);
              if (val !== null && val !== undefined && (dtype === 'json' || dtype === 'jsonb')) {
                val = typeof val === 'string' ? val : JSON.stringify(val);
              }
              values.push(val);
              placeholders.push(`$${paramIdx++}`);
            }
            valueClauses.push(`(${placeholders.join(', ')})`);
          }

          const insertSql = `INSERT INTO "${table}" (${selectColsSql}) VALUES ${valueClauses.join(', ')} ON CONFLICT DO NOTHING`;
          const insertRes = await target.query(insertSql, values);
          inserted += insertRes.rowCount || 0;
        }

        totalSourceRows += rows.length;
        totalInsertedRows += inserted;
        results.push({ table, sourceRows: rows.length, insertedRows: inserted, status: 'MIGRATED' });
      }

      const durationMs = Date.now() - startedAt;
      logger.info({ durationMs, totalSourceRows, totalInsertedRows }, '[MIGRATION] On-platform Neon -> Supabase transfer completed');

      return {
        success: true,
        durationMs,
        totalSourceRows,
        totalInsertedRows,
        tables: results,
      };
    } finally {
      await source.end().catch(() => {});
      await target.end().catch(() => {});
    }
  }
}

export const migrationService = new MigrationService();
</file>

<file path="server/services/sender.service.ts">
import prisma from '../lib/prisma';

export class SenderService {
  /**
   * Evaluates whether a sender has crossed into a new calendar day (UTC)
   * relative to its lastSentReset timestamp. If so, atomically resets
   * sentCountToday to 0, advances warmupDay by 1, and increases dailyLimit by 5.
   * Returns the fresh, updated sender record.
   */
  async ensureSenderDailyReset(senderId: string): Promise<any> {
    const sender = await prisma.sender.findUnique({
      where: { id: senderId },
      include: { domain: true },
    });
    if (!sender) return null;

    const today = new Date().toISOString().split('T')[0];
    const lastReset = new Date(sender.lastSentReset).toISOString().split('T')[0];

    if (today !== lastReset) {
      return prisma.sender.update({
        where: { id: sender.id },
        data: {
          sentCountToday: 0,
          lastSentReset: new Date(),
          warmupDay: { increment: 1 },
          dailyLimit: { increment: 5 },
        },
        include: { domain: true },
      });
    }

    return sender;
  }

  async createSender(
    userId: string,
    domainId: string,
    localPart: string,
    displayName?: string | null,
    dailyLimit: number = 20
  ) {
    const domain = await prisma.domain.findFirst({ where: { id: domainId, userId } });
    if (!domain) throw new Error('Domain not found');
    if (!domain.sendTestPassedAt) {
      throw new Error("This domain hasn't passed its send test yet — run the connectivity test before adding senders.");
    }

    const clean = localPart.toLowerCase().trim().replace(/[^a-z0-9._-]/g, '');
    if (!clean) throw new Error('Invalid sender address');

    return prisma.sender.create({
      data: {
        domainId,
        userId,
        localPart: clean,
        displayName: displayName || null,
        dailyLimit,
      },
      include: { domain: true },
    });
  }

  async listSendersForDomain(userId: string, domainId: string) {
    return prisma.sender.findMany({
      where: { domainId, userId },
      orderBy: { createdAt: 'asc' },
    });
  }

  /** Every sender the user has, across all their domains — used to populate a campaign's sender picker. */
  async listAllSendersForUser(userId: string) {
    return prisma.sender.findMany({
      where: { userId },
      include: { domain: { select: { domainName: true, status: true, sendTestPassedAt: true } } },
      orderBy: { createdAt: 'asc' },
    });
  }

  async updateSender(
    userId: string,
    senderId: string,
    data: { displayName?: string; dailyLimit?: number; status?: 'active' | 'paused' }
  ) {
    const result = await prisma.sender.updateMany({
      where: { id: senderId, userId },
      data,
    });
    if (result.count === 0) throw new Error('Sender not found');
    return prisma.sender.findUnique({ where: { id: senderId } });
  }

  async deleteSender(userId: string, senderId: string) {
    const result = await prisma.sender.deleteMany({ where: { id: senderId, userId } });
    if (result.count === 0) throw new Error('Sender not found');
  }
}

export const senderService = new SenderService();
</file>

<file path="server/utils/fileParser.ts">
import Papa from 'papaparse';
import * as XLSX from 'xlsx';

export interface ParseResult {
  leads: { name: string; email: string; company: string | null; position: string | null }[];
  errors: { row: number; message: string }[];
}

export class ColumnMapper {
  public nameCols: { type: 'full' | 'first' | 'last'; index: number }[] = [];
  public emailCols: { index: number; type: string; priority: number }[] = [];
  public companyCols: number[] = [];
  public positionCols: number[] = [];

  constructor(private headers: string[]) {
    this.headers = headers.map(h => h.trim().toLowerCase());
    this.analyze();
  }

  private analyze() {
    this.headers.forEach((header, idx) => {
      if (/\b(full ?name|name)\b/.test(header) && !header.includes('company')) {
        this.nameCols.push({ type: 'full', index: idx });
      } else if (/\bfirst ?name\b/.test(header)) {
        this.nameCols.push({ type: 'first', index: idx });
      } else if (/\blast ?name\b/.test(header)) {
        this.nameCols.push({ type: 'last', index: idx });
      }

      if (header.includes('email')) {
        let type = 'other';
        let priority = 10;
        if (header.includes('work') || header.includes('company')) { type = 'work'; priority = 1; }
        if (header.includes('personal')) { type = 'personal'; priority = 2; }
        this.emailCols.push({ index: idx, type, priority });
      }

      if (/\b(company|organization|account)\b/.test(header)) this.companyCols.push(idx);
      if (/\b(job ?title|title|position|role)\b/.test(header)) this.positionCols.push(idx);
    });

    this.emailCols.sort((a, b) => a.priority - b.priority);
  }

  extractName(row: string[]): string | null {
    const fullNameCol = this.nameCols.find(c => c.type === 'full');
    if (fullNameCol !== undefined) {
      const val = row[fullNameCol.index]?.trim();
      if (val) return val;
    }

    const firstCol = this.nameCols.find(c => c.type === 'first');
    const lastCol = this.nameCols.find(c => c.type === 'last');
    if (firstCol && lastCol) {
      const first = row[firstCol.index]?.trim() || '';
      const last = row[lastCol.index]?.trim() || '';
      if (first || last) return `${first} ${last}`.trim();
    }
    return null;
  }

  extractEmailCandidates(row: string[]): { email: string; type: string }[] {
    const candidates: { email: string; type: string }[] = [];
    for (const col of this.emailCols) {
      const val = row[col.index]?.trim();
      if (val && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
        candidates.push({ email: val, type: col.type });
      }
    }
    const seen = new Set<string>();
    return candidates.filter(c => {
      if (seen.has(c.email)) return false;
      seen.add(c.email);
      return true;
    });
  }

  extractCompany(row: string[]): string | null {
    for (const idx of this.companyCols) {
      const val = row[idx]?.trim();
      if (val) return val;
    }
    return null;
  }

  extractPosition(row: string[]): string | null {
    for (const idx of this.positionCols) {
      const val = row[idx]?.trim();
      if (val) return val;
    }
    return null;
  }

  hasEssentialCapability(): boolean {
    return this.nameCols.length > 0 && this.emailCols.length > 0;
  }
}

export async function parseLeadFile(buffer: Buffer, mimeType: string): Promise<ParseResult> {
  const errors: ParseResult['errors'] = [];
  let rows: any[] = [];

  try {
    if (mimeType.includes('csv') || mimeType.includes('text/plain')) {
      const csvString = buffer.toString('utf-8');
      const { data, errors: parseErrors } = Papa.parse(csvString, { header: true, skipEmptyLines: true });
      parseErrors.forEach(err => {
        errors.push({ row: (err.row ?? 0) + 1, message: `CSV error: ${err.message}` });
      });
      rows = data;
    } else if (mimeType.includes('spreadsheet') || mimeType.includes('excel') || mimeType.includes('xlsx')) {
      const workbook = XLSX.read(buffer, { type: 'buffer' });
      const sheet = workbook.Sheets[workbook.SheetNames[0]];
      rows = XLSX.utils.sheet_to_json(sheet);
    }
  } catch (err: any) {
    errors.push({ row: 0, message: `File parsing failed: ${err.message}` });
    return { leads: [], errors };
  }

  if (rows.length === 0) return { leads: [], errors };

  const headers = Object.keys(rows[0]);
  const mapper = new ColumnMapper(headers);
  const leads: ParseResult['leads'] = [];

  rows.forEach((row, idx) => {
    const rowValues = headers.map(h => row[h]?.toString() || '');
    const name = mapper.extractName(rowValues);
    const candidates = mapper.extractEmailCandidates(rowValues);

    if (name && candidates.length > 0) {
      leads.push({
        name,
        email: candidates[0].email.toLowerCase(),
        company: mapper.extractCompany(rowValues),
        position: mapper.extractPosition(rowValues),
      });
    }
  });

  return { leads, errors };
}
</file>

<file path="src/components/AddToCampaignModal.tsx">
import React, { useState, useEffect } from 'react';
import { campaignAPI, getErrorMessage } from '../services/api';
import { CreateCampaignModal } from './CreateCampaignModal';
import { useToast } from '../context/ToastContext';
import { Icons } from '../lib/icons';

interface Props {
  isOpen: boolean;
  onClose: () => void;
  leadIds: string[];
  availableCampaigns: any[];
  onSuccess: (campaignId: string) => void;
  onRefresh?: () => void;
}

export const AddToCampaignModal: React.FC<Props> = ({
  isOpen,
  onClose,
  leadIds,
  availableCampaigns,
  onSuccess,
  onRefresh,
}) => {
  const { toast } = useToast();
  const [selectedCampaignId, setSelectedCampaignId] = useState<string>('');
  const [adding, setAdding] = useState(false);
  const [showCreateModal, setShowCreateModal] = useState(false);
  const [localCampaigns, setLocalCampaigns] = useState(availableCampaigns);

  useEffect(() => {
    setLocalCampaigns(availableCampaigns);
  }, [availableCampaigns]);

  const handleAddToExisting = async () => {
    if (!selectedCampaignId) return;
    setAdding(true);
    try {
      await campaignAPI.addLeads(selectedCampaignId, leadIds);
      onSuccess(selectedCampaignId);
      onClose();
    } catch (error: any) {
      toast.error(getErrorMessage(error, 'Could not add leads to campaign'), 'Error');
    } finally {
      setAdding(false);
    }
  };

  const refreshCampaigns = async () => {
    try {
      const res = await campaignAPI.getAll();
      setLocalCampaigns(res.data || []);
      if (onRefresh) onRefresh();
    } catch {}
  };

  const handleCreateSuccess = async () => {
    setShowCreateModal(false);
    await refreshCampaigns();
    onClose();
  };

  if (!isOpen) return null;

  return (
    <>
      <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div className="fixed inset-0 bg-royal-950/65 backdrop-blur-sm" onClick={onClose} />

        <div className="relative w-full max-w-md bg-white border border-gold-500/45 rounded-3xl shadow-2xl p-6 z-10 animate-in zoom-in-95 duration-150">
          <div className="flex justify-between items-center pb-3 mb-4 border-b border-gold-500/35">
            <h3 className="text-base font-black text-royal-950">Add to Outreach Campaign</h3>
            <button onClick={onClose} className="text-thistle-500 hover:text-royal-950 p-1">
              <Icons.Close />
            </button>
          </div>

          <p className="text-xs text-royal-950/75 mb-4">
            <strong>{leadIds.length}</strong> lead(s) selected. Choose an active sequence or create a new campaign.
          </p>

          {localCampaigns.length > 0 ? (
            <div className="mb-4">
              <label className="block text-[10px] font-bold uppercase text-thistle-500 mb-1.5">
                Select Existing Campaign
              </label>
              <select
                value={selectedCampaignId}
                onChange={(e) => setSelectedCampaignId(e.target.value)}
                className="w-full px-3.5 py-2 bg-thistle-50 border border-gold-500/40 rounded-xl text-xs font-semibold text-royal-950 focus:outline-none focus:border-gold-500"
              >
                <option value="">-- Choose a campaign --</option>
                {localCampaigns.map((c) => (
                  <option key={c.id} value={c.id}>
                    {c.name} ({c.status}) – {c._count?.leads || 0} leads
                  </option>
                ))}
              </select>
            </div>
          ) : (
            <p className="text-xs text-amber-800 bg-amber-50 border border-gold-400/50 rounded-xl p-3 mb-4">
              No campaigns found. Create a new sequence below.
            </p>
          )}

          <div className="flex flex-col space-y-2.5 pt-2 border-t border-gold-500/35">
            {localCampaigns.length > 0 && (
              <button
                onClick={handleAddToExisting}
                disabled={!selectedCampaignId || adding}
                className="w-full px-4 py-2 btn-royal rounded-xl text-xs font-bold"
              >
                {adding ? 'Adding...' : 'Add to Selected Campaign'}
              </button>
            )}
            <button
              onClick={() => setShowCreateModal(true)}
              className="w-full px-4 py-2 bg-thistle-100 hover:bg-thistle-200 border border-gold-500/40 text-royal-800 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5"
            >
              <Icons.Plus className="text-gold-600" />
              <span>Create New Campaign</span>
            </button>
            <button
              onClick={onClose}
              className="w-full px-4 py-2 text-xs font-bold text-thistle-500 hover:text-royal-950"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>

      <CreateCampaignModal
        isOpen={showCreateModal}
        onClose={() => setShowCreateModal(false)}
        onSuccess={handleCreateSuccess}
        initialLeadIds={leadIds}
      />
    </>
  );
};
</file>

<file path="src/components/artifacts/ArtifactsPanel.tsx">
import React, { useEffect, useState, useRef } from 'react';
import { artifactAPI, getErrorMessage } from '../../services/api';
import { useToast } from '../../context/ToastContext';
import { ConfirmDialog } from '../common/ConfirmDialog';
import { Icons } from '../../lib/icons';

interface ArtifactsPanelProps {
  campaignId?: string;
  gongId?: string;
  broadcastId?: string;
  canEdit?: boolean;
  compact?: boolean;
}

export const ArtifactsPanel: React.FC<ArtifactsPanelProps> = ({
  campaignId,
  gongId,
  broadcastId,
  canEdit = true,
  compact = false,
}) => {
  const { toast } = useToast();
  const fileRef = useRef<HTMLInputElement | null>(null);

  const [artifacts, setArtifacts] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [mode, setMode] = useState<'LINK' | 'UPLOAD'>('LINK');

  const [title, setTitle] = useState('');
  const [slug, setSlug] = useState('');
  const [description, setDescription] = useState('');
  const [usagePrompt, setUsagePrompt] = useState('');
  const [attachmentMode, setAttachmentMode] = useState<'LINK' | 'MIME_ATTACHMENT'>('LINK');
  const [isOneTime, setIsOneTime] = useState(Boolean(broadcastId));
  const [linkUrl, setLinkUrl] = useState('');
  const [saving, setSaving] = useState(false);

  const [copiedSlug, setCopiedSlug] = useState<string | null>(null);
  const [deleteId, setDeleteId] = useState<string | null>(null);
  const [deleting, setDeleting] = useState(false);

  const fetchArtifacts = async () => {
    try {
      const res = await artifactAPI.list({ campaignId, gongId, broadcastId });
      setArtifacts(res.data || []);
    } catch {} finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchArtifacts();
  }, [campaignId, gongId, broadcastId]);

  const handleAddLink = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!title.trim() || !linkUrl.trim()) return;
    setSaving(true);
    try {
      await artifactAPI.createLink({
        title: title.trim(),
        slug: slug.trim() || undefined,
        description: description.trim() || undefined,
        usagePrompt: usagePrompt.trim() || undefined,
        url: linkUrl.trim(),
        type: 'LINK',
        attachmentMode: 'LINK',
        isOneTime,
        campaignId: campaignId || null,
        gongId: gongId || null,
        broadcastId: broadcastId || null,
      });
      toast.success('Artifact link saved', 'Artifact Added');
      setTitle(''); setSlug(''); setDescription(''); setUsagePrompt(''); setLinkUrl('');
      await fetchArtifacts();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Failed to save artifact link'), 'Plan Limit');
    } finally {
      setSaving(false);
    }
  };

  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setSaving(true);
    try {
      await artifactAPI.uploadFile(file, {
        title: title.trim() || file.name,
        slug: slug.trim() || undefined,
        description: description.trim() || undefined,
        usagePrompt: usagePrompt.trim() || undefined,
        attachmentMode,
        isOneTime,
        campaignId: campaignId || null,
        gongId: gongId || null,
        broadcastId: broadcastId || null,
      });
      toast.success(
        attachmentMode === 'MIME_ATTACHMENT'
          ? `Attached "${file.name}" for direct MIME delivery`
          : `Hosted "${file.name}" as tracked smart link`,
        'Artifact Uploaded'
      );
      setTitle(''); setSlug(''); setDescription(''); setUsagePrompt('');
      await fetchArtifacts();
    } catch (err: any) {
      toast.error(getErrorMessage(err, 'Upload failed'), 'Plan Limit');
    } finally {
      setSaving(false);
      if (fileRef.current) fileRef.current.value = '';
    }
  };

  const copyToken = (targetSlug: string) => {
    const token = `{{artifact:${targetSlug}}}`;
    navigator.clipboard.writeText(token);
    setCopiedSlug(targetSlug);
    toast.success(`Copied ${token}`, 'Token Ready');
    setTimeout(() => setCopiedSlug(null), 2000);
  };

  const handleConfirmDelete = async () => {
    if (!deleteId) return;
    setDeleting(true);
    try {
      await artifactAPI.delete(deleteId);
      toast.info('Artifact deleted', 'Deleted');
      setDeleteId(null);
      await fetchArtifacts();
    } catch {
      toast.error('Could not delete artifact', 'Error');
    } finally {
      setDeleting(false);
    }
  };

  return (
    <div className={`${compact ? 'p-4 bg-thistle-50/70 border border-gold-500/35 rounded-2xl' : 'p-6 card-midas rounded-2xl'} space-y-4`}>
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2.5 border-b border-gold-500/35">
        <div>
          <div className="flex items-center gap-2">
            <Icons.Link className="text-gold-600" />
            <h4 className="text-sm font-black text-royal-950 tracking-tight">Artifacts &amp; AI Attachments</h4>
          </div>
          <p className="text-[11px] text-thistle-500 mt-0.5">
            Define assets with usage rules so MIDAS AI knows when to insert smart links or send one-time broadcast file attachments.
          </p>
        </div>
        <span className="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-thistle-100 text-royal-800 border border-gold-500/30 self-start">
          {artifacts.length} Asset(s)
        </span>
      </div>

      {canEdit && (
        <div className="p-3.5 bg-thistle-50/70 border border-gold-500/35 rounded-xl space-y-3 text-xs">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <div className="flex p-1 bg-thistle-200/60 rounded-xl gap-1">
              <button
                type="button"
                onClick={() => { setMode('LINK'); setAttachmentMode('LINK'); }}
                className={`px-3 py-1 font-bold rounded-lg ${mode === 'LINK' ? 'bg-royal-700 text-white' : 'text-royal-800'}`}
              >
                Smart Link
              </button>
              <button
                type="button"
                onClick={() => setMode('UPLOAD')}
                className={`px-3 py-1 font-bold rounded-lg ${mode === 'UPLOAD' ? 'bg-royal-700 text-white' : 'text-royal-800'}`}
              >
                Upload File
              </button>
            </div>

            {mode === 'UPLOAD' && (
              <div className="flex items-center gap-3">
                <select
                  value={attachmentMode}
                  onChange={(e) => setAttachmentMode(e.target.value as any)}
                  className="px-2.5 py-1 bg-white border border-gold-500/35 rounded-lg text-[11px] font-bold text-royal-800"
                >
                  <option value="LINK">Tracked Link (Cold-Safe)</option>
                  <option value="MIME_ATTACHMENT">Direct Email File Attachment (Broadcasts/Gongs)</option>
                </select>
                <label className="flex items-center gap-1.5 text-[11px] font-semibold text-royal-950 cursor-pointer">
                  <input type="checkbox" checked={isOneTime} onChange={(e) => setIsOneTime(e.target.checked)} className="rounded text-royal-700" />
                  <span>One-Time Delivery</span>
                </label>
              </div>
            )}
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <input
              type="text"
              value={title}
              onChange={(e) => setTitle(e.target.value)}
              placeholder="Title * (e.g. Case Study PDF)"
              className="px-3 py-1.5 bg-white border border-gold-500/35 rounded-lg"
            />
            <input
              type="text"
              value={slug}
              onChange={(e) => setSlug(e.target.value.toLowerCase().replace(/[^a-z0-9_-]/g, '-'))}
              placeholder="Slug (e.g. case-study)"
              className="px-3 py-1.5 bg-white border border-gold-500/35 rounded-lg font-mono"
            />
            <input
              type="text"
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              placeholder="Short description of this asset"
              className="px-3 py-1.5 bg-white border border-gold-500/35 rounded-lg"
            />
            <input
              type="text"
              value={usagePrompt}
              onChange={(e) => setUsagePrompt(e.target.value)}
              placeholder="AI Usage Prompt (e.g. Attach when prospect asks for pricing)"
              className="px-3 py-1.5 bg-white border border-gold-500/35 rounded-lg"
            />
          </div>

          {mode === 'LINK' ? (
            <div className="flex gap-2">
              <input
                type="url"
                value={linkUrl}
                onChange={(e) => setLinkUrl(e.target.value)}
                placeholder="https://cal.com/team/demo"
                className="flex-1 px-3 py-1.5 bg-white border border-gold-500/35 rounded-lg font-mono"
              />
              <button
                type="button"
                onClick={handleAddLink}
                disabled={saving || !title.trim() || !linkUrl.trim()}
                className="px-4 py-1.5 btn-royal rounded-lg font-bold"
              >
                {saving ? '...' : 'Save Link'}
              </button>
            </div>
          ) : (
            <div>
              <input
                ref={fileRef}
                type="file"
                accept=".pdf,.png,.jpg,.jpeg,.webp,.svg,.docx,.md"
                onChange={handleFileUpload}
                className="hidden"
              />
              <button
                type="button"
                onClick={() => fileRef.current?.click()}
                disabled={saving}
                className="w-full px-3 py-2 btn-royal rounded-lg font-bold flex items-center justify-center gap-1.5"
              >
                <Icons.Upload className="text-gold-300" />
                <span>{saving ? 'Uploading...' : 'Select & Attach File'}</span>
              </button>
            </div>
          )}
        </div>
      )}

      {loading ? (
        <p className="py-4 text-center text-xs text-thistle-500">Loading artifacts...</p>
      ) : artifacts.length === 0 ? (
        <p className="py-4 text-center text-[11px] text-thistle-500 italic">No artifacts configured yet.</p>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {artifacts.map((a) => (
            <div key={a.id} className="p-3 bg-white border border-gold-500/35 rounded-xl flex items-start justify-between gap-2 text-xs">
              <div className="min-w-0 space-y-0.5">
                <div className="flex items-center gap-1.5 flex-wrap">
                  <span className="font-bold text-royal-950 truncate">{a.title}</span>
                  <span className={`px-1.5 py-0.2 rounded text-[9px] font-bold border ${
                    a.attachmentMode === 'MIME_ATTACHMENT'
                      ? 'bg-royal-700 text-gold-300 border-gold-400/50'
                      : 'bg-emerald-50 text-emerald-700 border-emerald-200'
                  }`}>
                    {a.attachmentMode === 'MIME_ATTACHMENT' ? 'MIME FILE' : 'SMART LINK'}
                  </span>
                  {a.isOneTime && (
                    <span className="px-1.5 py-0.2 rounded text-[9px] font-bold bg-amber-50 text-amber-800 border border-gold-400/50">
                      1-TIME
                    </span>
                  )}
                </div>
                <code className="text-[10px] font-mono text-royal-700 block truncate">{`{{artifact:${a.slug}}}`}</code>
                {a.usagePrompt && <p className="text-[10px] text-thistle-500 line-clamp-1">AI Rule: {a.usagePrompt}</p>}
              </div>

              <div className="flex items-center gap-1.5 shrink-0">
                <button
                  type="button"
                  onClick={() => copyToken(a.slug)}
                  className="px-2 py-1 bg-thistle-100 hover:bg-thistle-200 border border-gold-500/35 text-royal-800 rounded-lg text-[10px] font-bold flex items-center gap-1"
                >
                  {copiedSlug === a.slug ? <Icons.CheckCircle className="text-emerald-600" /> : <Icons.Copy className="text-gold-600" />}
                  <span>Token</span>
                </button>
                {canEdit && (
                  <button type="button" onClick={() => setDeleteId(a.id)} className="p-1 text-thistle-500 hover:text-rose-600">
                    <Icons.Trash />
                  </button>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

      <ConfirmDialog
        isOpen={Boolean(deleteId)}
        onClose={() => setDeleteId(null)}
        onConfirm={handleConfirmDelete}
        title="Delete Artifact"
        description="Remove this artifact from drafts and future dispatches?"
        confirmLabel="Delete"
        loading={deleting}
      />
    </div>
  );
};
</file>

<file path="src/components/campaigns/CampaignHeader.tsx">
import React, { useState } from 'react';
import { Link } from 'react-router-dom';
import { Icons } from '../../lib/icons';

interface CampaignHeaderProps {
  campaign: any;
  role: 'OWNER' | 'EDITOR' | 'VIEWER';
  canEdit: boolean;
  canDelete: boolean;
  onUploadLeadsClick: () => void;
  onInviteClick: () => void;
  onTogglePauseResume: () => void;
  onReconcileQueue: () => void;
  onRepersonalizeQueue: () => void;
  onRenameClick: () => void;
  onStrategyClick: () => void;
  onDeleteClick: () => void;
  isReconciling: boolean;
  isRepersonalizing: boolean;
}

export const CampaignHeader: React.FC<CampaignHeaderProps> = ({
  campaign,
  role,
  canEdit,
  canDelete,
  onUploadLeadsClick,
  onInviteClick,
  onTogglePauseResume,
  onReconcileQueue,
  onRepersonalizeQueue,
  onRenameClick,
  onStrategyClick,
  onDeleteClick,
  isReconciling,
  isRepersonalizing,
}) => {
  const [menuOpen, setMenuOpen] = useState(false);

  return (
    <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <Link
          to="/campaigns"
          className="text-xs font-bold text-thistle-500 hover:text-royal-800 flex items-center gap-1 mb-1 transition-colors"
        >
          <Icons.ChevronLeft />
          <span>Campaigns</span>
        </Link>
        <div className="flex items-center gap-3 flex-wrap">
          <h1 className="text-2xl font-black text-royal-950 tracking-tight">{campaign.name}</h1>
          <span
            className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${
              campaign.status === 'ACTIVE'
                ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                : campaign.status === 'PAUSED'
                ? 'bg-amber-50 text-amber-800 border-gold-400/50'
                : 'bg-thistle-100 text-royal-800 border-thistle-300'
            }`}
          >
            {campaign.status}
          </span>
          {role === 'VIEWER' && (
            <span className="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-thistle-100 text-royal-700 border border-gold-500/35 flex items-center gap-1">
              <Icons.Eye className="text-[12px]" />
              <span>View-Only Access</span>
            </span>
          )}
        </div>
      </div>

      <div className="flex items-center gap-2.5 flex-wrap">
        <span className="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-xl border border-emerald-200">
          {campaign.queuedCount || 0} In Queue
        </span>

        {canEdit && (
          <button
            onClick={onUploadLeadsClick}
            className="px-3.5 py-1.5 btn-royal rounded-xl text-xs font-bold flex items-center gap-1.5"
          >
            <Icons.Plus className="text-gold-300" />
            <span>Upload Leads</span>
          </button>
        )}

        {canEdit && (
          <button
            onClick={onInviteClick}
            className="px-3.5 py-1.5 bg-white hover:bg-thistle-100 text-royal-800 border border-gold-500/40 rounded-xl text-xs font-bold glow-gold-hover flex items-center gap-1.5"
          >
            <Icons.Users className="text-gold-600" />
            <span>Invite</span>
          </button>
        )}

        {canEdit && (
          <div className="relative">
            <button
              onClick={() => setMenuOpen(!menuOpen)}
              className="p-2 rounded-xl border border-gold-500/40 bg-white hover:bg-thistle-50 text-royal-800 glow-gold-hover"
              title="Campaign Actions"
            >
              <Icons.Settings />
            </button>

            {menuOpen && (
              <div className="absolute right-0 mt-2 w-60 bg-white rounded-2xl shadow-2xl border border-gold-500/45 py-1.5 z-30 animate-in fade-in zoom-in-95 duration-100">
                <button
                  onClick={() => {
                    setMenuOpen(false);
                    onTogglePauseResume();
                  }}
                  className="w-full text-left px-4 py-2 text-xs font-bold text-royal-950 hover:bg-thistle-50 border-b border-gold-500/30 flex items-center gap-2"
                >
                  <Icons.Bolt className="text-gold-600" />
                  <span>{campaign.status === 'PAUSED' ? 'Resume Campaign' : 'Pause Campaign'}</span>
                </button>

                <button
                  onClick={() => {
                    setMenuOpen(false);
                    onReconcileQueue();
                  }}
                  disabled={isReconciling}
                  className="w-full text-left px-4 py-2 text-xs font-medium text-royal-700 hover:bg-thistle-50 flex items-center gap-2"
                >
                  <Icons.Bolt className="text-gold-600" />
                  <span>{isReconciling ? 'Reconciling...' : 'Reconcile & Queue Leads'}</span>
                </button>

                <button
                  onClick={() => {
                    setMenuOpen(false);
                    onRepersonalizeQueue();
                  }}
                  disabled={isRepersonalizing}
                  className="w-full text-left px-4 py-2 text-xs font-medium text-amber-800 hover:bg-thistle-50 border-b border-gold-500/25 flex items-center gap-2"
                >
                  <Icons.Refresh className="text-gold-600" />
                  <span>{isRepersonalizing ? 'Refreshing...' : 'Refresh Queue from Reserves'}</span>
                </button>

                <button
                  onClick={() => {
                    setMenuOpen(false);
                    onRenameClick();
                  }}
                  className="block w-full text-left px-4 py-2 text-xs font-medium text-royal-950 hover:bg-thistle-50"
                >
                  Rename Campaign
                </button>
                <button
                  onClick={() => {
                    setMenuOpen(false);
                    onStrategyClick();
                  }}
                  className="block w-full text-left px-4 py-2 text-xs font-medium text-royal-950 hover:bg-thistle-50"
                >
                  Refine SDR Strategy
                </button>
                {canDelete && (
                  <button
                    onClick={() => {
                      setMenuOpen(false);
                      onDeleteClick();
                    }}
                    className="w-full text-left px-4 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50 border-t border-gold-500/25 flex items-center gap-2 mt-1"
                  >
                    <Icons.Trash />
                    <span>Delete Campaign</span>
                  </button>
                )}
              </div>
            )}
          </div>
