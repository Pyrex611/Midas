{
  "name": "@midas-aem/client",
  "version": "1.2.0",
  "description": "Zero-dependency universal SDK, React modal wrappers, and CLI scaffolder for Midas AEM & Town Crier.",
  "license": "Apache-2.0",
  "author": "Pyrexx <gamboclifford11@gmail.com>",
  "homepage": "https://midas-aem.vercel.app/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pyrex611/Midas.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/Pyrex611/Midas/issues"
  },
  "keywords": [
    "email",
    "newsletter",
    "outreach",
    "midas",
    "mailgun",
    "sdk",
    "react",
    "cli"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "midas": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "react": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}