datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- Midas Core Models ---
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String    @unique
  password      String?   
  clerkId       String?   @unique @map("clerk_id")
  isAdmin       Boolean   @default(false) @map("is_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  leads          Lead[]
  campaigns      Campaign[]
  drafts         Draft[]
  settings       UserSettings?
  domains        Domain[]
  outboundEmails OutboundEmail[]
  pendingEmails  PendingEmail[]
  uploadJobs     UploadJob[]
  blocklist      Blocklist[]
  memberships    CampaignMember[]
  invitesSent    CampaignInvite[]

  apiKeys              ApiKey[]
  gongs                Gong[]
  newsletterRecipients NewsletterRecipient[]
  newsletterBroadcasts NewsletterBroadcast[]
  newsletterQueueItems NewsletterQueueItem[]
  notifications        Notification[]
  webhookSubscriptions WebhookSubscription[]

  @@map("users")
}

// --- Domain & Deliverability Engine ---
model Domain {
  id               String   @id @default(cuid())
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  domainName       String   @unique @map("domain_name")
  status           String   @default("pending_setup")
  
  dkimStatus       Boolean  @default(false)
  spfStatus        Boolean  @default(false)
  mxStatus         Boolean  @default(false)
  trackingStatus   Boolean  @default(false)
  dnsRecords       String?  @db.Text 
  mailgunApiKeyEncrypted String? @db.Text @map("mailgun_api_key_encrypted")
  mailgunRegion    String?  @map("mailgun_region")

  sendTestPassedAt     DateTime? @map("send_test_passed_at")
  receivingTestCode    String?   @map("receiving_test_code")
  receivingTestAddress String?   @map("receiving_test_address")
  receivingConfirmedAt DateTime? @map("receiving_confirmed_at")

  bounceCount      Int      @default(0) @map("bounce_count")
  replyCount       Int      @default(0) @map("reply_count")
  bounceRate       Float    @default(0.0)
  complaintRate    Float    @default(0.0)

  routeId          String?  @map("route_id")

  bimiEnabled      Boolean  @default(false) @map("bimi_enabled")
  bimiSvgUrl       String?  @map("bimi_svg_url")
  bimiVmcUrl       String?  @map("bimi_vmc_url")
  dmarcPolicy      String?  @map("dmarc_policy")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  senders                Sender[]
  outboundEmails         OutboundEmail[]  @relation("OutboundEmailDomain")
  pendingEmails          PendingEmail[]   @relation("PendingEmailDomain")

  @@index([userId])
}

model Sender {
  id               String    @id @default(cuid())
  domainId         String    @map("domain_id")
  domain           Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  userId           String    @map("user_id") @db.Uuid
  localPart        String    @map("local_part")
  displayName      String?   @map("display_name")
  status           String    @default("active")
  warmupDay        Int       @default(1) @map("warmup_day")
  dailyLimit       Int       @default(20) @map("daily_limit")
  sentCountToday   Int       @default(0) @map("sent_count_today")
  lastSentReset    DateTime  @default(now()) @map("last_sent_reset")
  lastDispatchedAt DateTime? @map("last_dispatched_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  campaignLinks          CampaignSender[]
  preferredPendingEmails PendingEmail[]   @relation("PendingEmailPreferredSender")
  dedicatedSettings      UserSettings[]   @relation("DedicatedNewsletterSender")

  @@unique([domainId, localPart])
  @@index([userId])
}

model CampaignSender {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId   String   @map("sender_id")
  sender     Sender   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now()) @map("added_at")
  @@unique([campaignId, senderId])
}

enum CampaignRole {
  OWNER
  EDITOR
  VIEWER
}

model CampaignMember {
  id         String       @id @default(cuid())
  campaignId String       @map("campaign_id")
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       CampaignRole @default(EDITOR)
  joinedAt   DateTime     @default(now()) @map("joined_at")

  @@unique([campaignId, userId])
  @@index([userId])
}

model CampaignInvite {
  id         String       @id @default(cuid())
  campaignId String       @map("campaign_id")
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId   String       @map("sender_id") @db.Uuid
  sender     User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  email      String
  role       CampaignRole @default(EDITOR)
  token      String       @unique
  accepted   Boolean      @default(false)
  expiresAt  DateTime     @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([email])
}

model Campaign {
  id                String   @id @default(cuid())
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  context           String?
  reference         String?
  senderName        String?  @map("sender_name")
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now()) @map("created_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  lastDomainIndex   Int      @default(0) @map("last_domain_index")
  autoReplyEnabled  Boolean  @default(false) @map("auto_reply_enabled")
  sendHourUTC       Int      @default(9) @map("send_hour_utc")
  activeStartHour   Int?     @map("active_start_hour")
  activeEndHour     Int?     @map("active_end_hour")
  timezone          String?
  objective         String?
  targetTool        String?  @map("target_tool")
  extendedObjective String?  @map("extended_objective")

  followUpSteps FollowUpStep[]
  leads         Lead[]
  emails        OutboundEmail[]
  drafts        Draft[]
  pendingEmails PendingEmail[]
  senderLinks   CampaignSender[] 
  members       CampaignMember[]
  invites       CampaignInvite[]

  @@index([userId])
}

model Blocklist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern   String   
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId, pattern])
}

model UploadJob {
  id             String   @id @default(cuid())
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename       String
  blobUrl        String   @db.Text
  status         String   @default("PENDING") 
  error          String?  @db.Text
  totalRows      Int      @default(0)
  validLeads     Int      @default(0)
  catchAllLeads  Int      @default(0)
  invalidLeads   Int      @default(0)
  blockedLeads   Int      @default(0)
  duplicates     Int      @default(0)
  verificationId String?  
  verifyEmails   Boolean  @default(false) @map("verify_emails")
  pendingRows    String?  @db.Text
  columnMapping  String?  @db.Text @map("column_mapping")
  campaignId     String?  @map("campaign_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([userId])
  @@index([status])
}

model Lead {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id") @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  email              String
  company            String?
  position           String?
  status             String   @default("NEW")
  outreachStatus     String?  @map("outreach_status")
  verificationStatus String   @default("UNVERIFIED") @map("verification_status")
  unsubscribeToken   String?  @unique @map("unsubscribe_token")
  campaignId         String?  @map("campaign_id")
  campaign           Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  
  sentEmails     OutboundEmail[]
  replyDrafts    Draft[]         @relation("LeadDrafts")
  pendingEmails  PendingEmail[]
  activityEvents LeadActivityEvent[]

  @@unique([userId, email])
  @@index([userId])
  @@index([campaignId])
  @@index([status])
}

model LeadActivityEvent {
  id         String   @id @default(cuid())
  leadId     String   @map("lead_id")
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId String?  @map("campaign_id")
  eventType  String   @map("event_type")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([leadId, eventType])
  @@index([campaignId, createdAt])
}

model Draft {
  id           String   @id @default(cuid())
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  body         String
  tone         String
  useCase      String   @map("use_case")
  version      Int      @default(1)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  campaignId   String?  @map("campaign_id")
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  leadId       String?  @map("lead_id")
  lead         Lead?    @relation("LeadDrafts", fields: [leadId], references: [id], onDelete: SetNull)
  isReplyDraft Boolean  @default(false) @map("is_reply_draft")
  stepNumber   Int?     @map("step_number") 
  sentCount    Int      @default(0) @map("sent_count")
  replyCount   Int      @default(0) @map("reply_count")

  emails        OutboundEmail[]
  followUpSteps FollowUpStep[]
  pendingEmails PendingEmail[]
}

model FollowUpStep {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepNumber Int
  delayDays  Int
  draftId    String?  @map("draft_id")
  draft      Draft?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@unique([campaignId, stepNumber])
}

model OutboundEmail {
  id          String   @id @default(cuid())
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId    String?  @map("domain_id")
  domain      Domain?  @relation("OutboundEmailDomain", fields: [domainId], references: [id], onDelete: SetNull)
  leadId      String   @map("lead_id")
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId  String?  @map("campaign_id")
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  draftId     String?  @map("draft_id")
  draft       Draft?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  
  subject     String
  body        String
  sentAt      DateTime @default(now()) @map("sent_at")
  status      String   @default("SENT")
  error       String?

  openedAt      DateTime? @map("opened_at")
  clickedAt     DateTime? @map("clicked_at") 
  bouncedAt     DateTime? @map("bounced_at") 
  spamComplaint Boolean   @default(false) @map("spam_complaint") 
  repliedAt     DateTime? @map("replied_at")
  replyText     String?   @map("reply_text")

  replyToId     String?         @map("reply_to_id")
  replyTo       OutboundEmail?  @relation("Replies", fields: [replyToId], references: [id])
  replies       OutboundEmail[] @relation("Replies")
  isIncoming    Boolean         @default(false) @map("is_incoming")
  messageId     String?         @map("message_id")
  references    String?
  inReplyTo     String?         @map("in_reply_to")
  fromAddress   String?         @map("from_address")
  toAddress     String?         @map("to_address")
  sentiment     String?
  intent        String?
  analysis      String?

  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
  @@index([messageId])
}

model PendingEmail {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id") @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId           String?  @map("domain_id")
  domain             Domain?  @relation("PendingEmailDomain", fields: [domainId], references: [id], onDelete: SetNull)
  campaignId         String   @map("campaign_id")
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId             String   @map("lead_id")
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  draftId            String?  @map("draft_id")
  draft              Draft?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  subject            String
  body               String
  inReplyTo          String?  @map("in_reply_to")
  scheduledAt        DateTime? @map("scheduled_at")
  status             String   @default("PENDING") 
  error              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  priority           Int      @default(2)
  preferredSenderId  String?  @map("preferred_sender_id")
  preferredSender    Sender?  @relation("PendingEmailPreferredSender", fields: [preferredSenderId], references: [id], onDelete: SetNull)
  @@index([status, scheduledAt])
  @@index([userId])
  @@index([campaignId])
  @@index([leadId])
}

model UserSettings {
  userId            String   @id @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendLimit         Int?     @map("send_limit")
  sendPeriod        String?  @map("send_period")
  companyName       String?  @map("company_name")
  physicalAddress   String?  @map("physical_address")
  customOptOutText  String?  @map("custom_opt_out_text")
  
  aiProvider        String?  @map("ai_provider")
  aiModel           String?  @map("ai_model")
  aiApiKeyEncrypted String?  @db.Text @map("ai_api_key_encrypted")
  aiGatewayUrl      String?  @map("ai_gateway_url")
  aiIntegrations    Json?    @map("ai_integrations")

  brandColorHex     String?  @map("brand_color_hex")
  brandInitials     String?  @map("brand_initials")
  logoUrl           String?  @map("logo_url")
  brandingEnabled   Boolean  @default(false) @map("branding_enabled")

  dedicatedNewsletterSenderId String? @map("dedicated_newsletter_sender_id")
  dedicatedNewsletterSender   Sender? @relation("DedicatedNewsletterSender", fields: [dedicatedNewsletterSenderId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
}

// --- DEVELOPER API KEYS (SCOPED GLOBALLY) ---

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @map("key_hash")
  scopes     String[]  @default(["*"])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([keyPrefix])
}

// --- TOWN CRIER "GONG" CHANNELS & NEWSLETTER MODELS ---

model Gong {
  id                   String                 @id @default(cuid())
  userId               String                 @map("user_id") @db.Uuid
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  description          String?
  cadence              String                 @default("weekly")
  templateStyle        String                 @default("card") @map("template_style") // card | editorial | minimal | plain
  
  // Welcome Autoresponder
  welcomeEmailEnabled  Boolean                @default(false) @map("welcome_email_enabled")
  welcomeSubject       String?                @map("welcome_subject")
  welcomeBody          String?                @db.Text @map("welcome_body")
  
  // Embed Styling
  embedTheme           String                 @default("minimal") @map("embed_theme") // minimal | card | dark | floating
  accentColor          String                 @default("#2563EB") @map("accent_color")
  headline             String                 @default("Join our newsletter")
  subheadline          String                 @default("Get the latest updates delivered to your inbox.")
  buttonText           String                 @default("Subscribe") @map("button_text")
  successMessage       String                 @default("Thank you for subscribing!") @map("success_message")
  tags                 String[]               @default([])

  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  recipients           NewsletterRecipient[]
  broadcasts           NewsletterBroadcast[]

  @@unique([userId, slug])
  @@index([userId])
}

model NewsletterRecipient {
  id               String   @id @default(cuid())
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gongId           String?  @map("gong_id")
  gong             Gong?    @relation(fields: [gongId], references: [id], onDelete: SetNull)
  email            String
  name             String?
  cadence          String   @default("weekly")
  status           String   @default("SUBSCRIBED") // SUBSCRIBED | UNSUBSCRIBED | BOUNCED
  source           String   @default("ui")         // ui | api | import | form_embed
  tags             String[] @default([])
  metadata         Json?
  unsubscribeToken String?  @unique @map("unsubscribe_token")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, email])
  @@index([userId])
  @@index([gongId])
}

model NewsletterBroadcast {
  id            String                @id @default(cuid())
  userId        String                @map("user_id") @db.Uuid
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gongId        String?               @map("gong_id")
  gong          Gong?                 @relation(fields: [gongId], references: [id], onDelete: SetNull)
  subject       String
  body          String
  status        String                @default("DRAFT") // DRAFT | QUEUED | SENDING | COMPLETED
  templateStyle String                @default("card") @map("template_style") // card | editorial | minimal | plain
  tagFilter     String?               @map("tag_filter")
  queuedAt      DateTime?             @map("queued_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  queueItems    NewsletterQueueItem[]

  @@index([userId])
  @@index([gongId])
}

model NewsletterQueueItem {
  id          String              @id @default(cuid())
  broadcastId String              @map("broadcast_id")
  broadcast   NewsletterBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  recipientId String              @map("recipient_id")
  userId      String              @map("user_id") @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String              @default("PENDING") // PENDING | PROCESSING | SENT | FAILED
  error       String?
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([broadcastId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | URGENT | INBOUND_REPLY
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// --- BI-DIRECTIONAL OUTBOUND WEBHOOKS ---

model WebhookSubscription {
  id         String            @id @default(cuid())
  userId     String            @map("user_id") @db.Uuid
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetUrl  String            @map("target_url")
  secret     String            // whsec_...
  events     String[]          @default(["*"])
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String              @map("subscription_id")
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  statusCode     Int?                @map("status_code")
  responseBody   String?             @db.Text @map("response_body")
  error          String?             @db.Text
  attempts       Int                 @default(1)
  status         String              @default("DELIVERED") // DELIVERED | FAILED
  durationMs     Int?                @map("duration_ms")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([subscriptionId, createdAt])
}

model CronLock {
  name      String    @id
  lockedAt  DateTime? @map("locked_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
}