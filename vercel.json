{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/queue", "schedule": "0 9 * * *" },
    { "path": "/api/cron/leads", "schedule": "0 10 * * *" },
    { "path": "/api/cron/followups", "schedule": "0 11 * * *" }
  ],
  "functions": {
    "api/**/*.ts": { "maxDuration": 30 }
  }
}
